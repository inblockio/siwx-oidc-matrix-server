# siwx-oidc-matrix-server — environment configuration reference
#
# Two deployment shapes are supported:
#
#   1. PRODUCTION                docker-compose.yml + start-matrix.sh + Caddy on portal-net
#      Real DNS for three hostnames, TLS via Caddy/Let's Encrypt, secrets
#      auto-generated by start-matrix.sh into .env (chmod 600).
#
#   2. LOCAL DEVELOPMENT         docker-compose.local.yml + Caddyfile.local
#      Localhost ports, HTTP only, no DNS, an inline Caddy in the compose
#      file. Generate secrets yourself (helper snippet at the bottom).
#
# Copy this file to:
#   .env        for production (start-matrix.sh will create one for you if missing)
#   .env.local  for local development
#
# Every variable used by any container is documented below. Defaults shown
# are what `docker-compose.local.yml` falls back to when the variable is
# unset, so you only need to set what you want to override.

# ============================================================================
# Required for BOTH production and local
# ============================================================================

# [secret, required] Random shared secret used by Synapse to authenticate
# its MSC3861 introspection calls to siwx-oidc. start-matrix.sh
# auto-generates one for production. Local: generate via
# `openssl rand -hex 32`.
# MAS_SHARED_SECRET=

# [secret, required] ES256 PKCS#8 PEM signing key for issued OIDC tokens.
# Single-line, newline-escaped (Docker Compose converts `\n` back to real
# newlines for the container). Regenerating invalidates every token ever
# issued.  Local: generate via the helper at the bottom of this file.
# SIWEOIDC_SIGNING_KEY_PEM=

# Logging — verbose: siwx_oidc=debug,tower_http=trace
RUST_LOG=siwx_oidc=info,tower_http=info

# Synapse retention window (e.g. 4w, 90d, "forever" via setting to a very large value)
MATRIX_MESSAGE_LIFETIME=4w

# Synapse anonymized stats opt-in (yes|no)
MATRIX_REPORT_STATS=no

# Optional: auto-promote this DID to server admin on every boot (idempotent).
# User must complete at least one OIDC login before the promotion has
# anything to operate on. Validated against ^did:[a-z]+:[a-z0-9]+:[a-z0-9]+:0x[0-9a-fA-F]{40}$.
# MATRIX_ADMIN_DID=did:pkh:eip155:1:0xYourEthereumAddress

# ============================================================================
# Production (docker-compose.yml + start-matrix.sh)
# ============================================================================

# Public hostnames — must resolve via DNS to the host's public IP.
# SIWEOIDC_HOST=siwx-oidc.example.com
# SIWEOIDC_BASE_URL=https://siwx-oidc.example.com
# MATRIX_HOST=matrix.example.com
# MATRIX_BASE_URL=https://matrix.example.com
# CLIENT_HOST=element.example.com

# Internal container listen ports — change only if these conflict with
# something else on the portal-net network. The reverse proxy upstream
# config must match.
# SIWEOIDC_PORT=8081
# MATRIX_PORT=8080

# ============================================================================
# Local development (docker-compose.local.yml + Caddyfile.local)
# ============================================================================
#
# The compose file ships defaults for all of these; uncomment only to
# override.

# --- Host-facing ports (what Caddy publishes from localhost) -----------------
# CLIENT_HOST_PORT=8088     # http://localhost:8088  → Element Web client
# MATRIX_HOST_PORT=8080     # http://localhost:8080  → Synapse (with MSC3861 routing)
# SIWEOIDC_HOST_PORT=8081   # http://localhost:8081  → siwx-oidc (OIDC discovery)

# --- Container-internal listen ports (rarely changed) ------------------------
# SIWEOIDC_PORT=8081
# MATRIX_PORT=8080

# --- URLs services advertise to each other and to the browser ----------------
# SIWEOIDC_HOST=localhost:8081
# SIWEOIDC_BASE_URL=http://localhost:8081
# MATRIX_HOST=localhost                          # Synapse server_name → MXIDs become @user:localhost
# MATRIX_BASE_URL=http://localhost:8080

# ============================================================================
# Helper — generate the two required secrets for local development
# ============================================================================
#
# Run inside the repo root:
#
#   echo "MAS_SHARED_SECRET=$(openssl rand -hex 32)" >> .env.local
#   PEM=$(openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 2>/dev/null)
#   PEM_LINE=$(printf '%s' "$PEM" | sed ':a;N;$!ba;s/\n/\\n/g')
#   echo "SIWEOIDC_SIGNING_KEY_PEM=\"${PEM_LINE}\"" >> .env.local
#   chmod 600 .env.local
#
# Then bring up the stack:
#
#   docker compose -f docker-compose.local.yml --env-file .env.local up --build
#
# Resetting state during development:
#
#   docker compose -f docker-compose.local.yml --env-file .env.local down -v
#   rm .env.local
#   # (re-run helper above, then `up --build` again)

# ---------------------------------------------------------------------------
# AQUA_WEBAUTHN_REDIS_URL — aqua-auth 0.7.0 shared passkey credential store.
#
# Unset or empty (the default) = OFF: siwx-oidc uses only its own legacy
# webauthn:credential/* namespace, exactly as before.
#
# Set to a Redis URL (redis://redis on this stack) = ON: passkey credentials
# are dual-written into aqua-auth's aqua:webauthn:* namespace and read back
# read-through, so the store can be shared with aqua-node and aquafier-rs.
#
# Before turning it on, run the backfill (it is additive, idempotent, and a
# dry run by default):
#     docker exec <siwx-oidc> migrate-credentials --source-redis redis://redis
#     docker exec <siwx-oidc> migrate-credentials --source-redis redis://redis --apply
#
# After turning it on, confirm the actual mode in the log -- the service prints
# "credential store: dual-write ENABLED -> <url>" at boot and refuses to start
# if the URL names a Redis it cannot open.
#
# Rolling back is a flip back to empty plus a restart: every write also goes to
# the legacy namespace, so siwx-oidc loses nothing. It does leave the mirrored
# rows behind in aqua:webauthn:*, which matters only once that namespace is
# shared with another service.
# ---------------------------------------------------------------------------
AQUA_WEBAUTHN_REDIS_URL=
