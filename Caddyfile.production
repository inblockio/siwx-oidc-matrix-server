:80 {
    respond "OK" 200
}

matrix.inblock.io {
    encode zstd gzip

    handle /.well-known/matrix/server {
        respond `{"m.server": "matrix.inblock.io:443"}`
    }
    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin *
        respond `{"m.homeserver": {"base_url": "https://matrix.inblock.io"}, "m.authentication": {"issuer": "https://siwx-oidc.inblock.io"}}`
    }

    handle /_matrix/client/v3/login {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
    handle /_matrix/client/v3/logout {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
    handle /_matrix/client/v3/refresh {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }

    # MSC4108: QR code login rendezvous.
    handle /_matrix/client/unstable/org.matrix.msc4108/* {
        reverse_proxy matrix_synapse:8080
    }
    handle /_synapse/client/rendezvous/* {
        reverse_proxy matrix_synapse:8080
    }

    handle {
        reverse_proxy matrix_synapse:8080
    }
}

siwx-oidc.inblock.io {
    encode zstd gzip

    header Access-Control-Allow-Origin "https://element.inblock.io"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization"

    @options method OPTIONS
    handle @options {
        respond 204
    }

    handle {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
}

element.inblock.io {
    encode zstd gzip
    reverse_proxy element-web:8080
}

openwitness.org {
    encode zstd gzip
    reverse_proxy timestamp:8080
}

timestamps.inblock.io {
    redir https://openwitness.org{uri} permanent
}

agentic.inblock.io {
    encode zstd gzip
    reverse_proxy portal:8080
}
