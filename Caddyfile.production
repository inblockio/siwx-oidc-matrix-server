# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# NEEDS THE caddy-ratelimit MODULE (applied 2026-09-27).
#
# Since 42dac7b this file carries `rate_limit` blocks (the edge limiter for the
# public GET /resolve on the siwx vhost). `rate_limit` is NOT stock Caddy: it
# needs the caddy-ratelimit module, which only the CI-built caddy-l4 image
# from 42dac7b onward contains (ghcr.io/inblockio/siwx-oidc-matrix-server/
# caddy-l4, dockerfiles/Dockerfile.caddy-l4). A Caddy without the module
# REFUSES TO PARSE this file, so a reload fails (at best) or a restart takes
# every vhost on the box down.
#
# 2026-09-27: prod (portal-caddy-1, /home/portal/portal/Caddyfile) now runs
# caddy-l4@sha256:1c9825f346b1d45a001c9a7a8d7cf082403da8a0875a3a33064f0372203fabae
# (main 0a58e7e: Caddy v2.11.4 + caddy-l4 v0.1.2 + caddy-ratelimit 5625512),
# and this file is live there. Any future edge image swap must keep the module:
# check `caddy list-modules | grep rate_limit` in the NEW image BEFORE the swap.
# Reload in place, never `mv` over the bind-mounted file (inode trap).
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

{
    # TURN-over-TLS SNI split (2026-08-03 prod promotion; see repo
    # docs/superpowers/plans/2026-08-03-turn-tls-edge-termination.md).
    # layer4 must precede tls: it reads the raw ClientHello SNI. Only the
    # TURN hostname is diverted; all other 443 traffic is untouched.
    servers :443 {
        listener_wrappers {
            layer4 {
                # matching_timeout raised from the 3s caddy-l4 default
                # (2026-08-18 RCA): the default silently killed any conn whose
                # ClientHello had not fully arrived within 3s (zero-byte close,
                # logged as "aborted matching according to timeout"). Lossy or
                # reduced-MTU mobile links routinely straggle past 3s (browser
                # post-quantum ClientHello spans a full-MSS segment; Windows TCP
                # blackhole probing needs ~3-5s), which broke every fresh
                # wss:// LiveKit SFU join ("ServerUnreachable") while
                # warm-connection /sync kept working. 10s restores pre-layer4
                # tolerance; junk connections still get dropped, just later.
                matching_timeout 10s
                @turn_sni tls sni turn.matrix.inblock.io
                route @turn_sni {
                    tls
                    proxy tcp/livekit:5349
                }
            }
            tls
        }
    }
}

# Shared basic-auth gate for the non-public previews (user: website).
# Single source of truth - rotate the hash here and every vhost that
# imports it follows. Generate with: caddy hash-password
# Credential is supplied via the environment (WEBSITE_BASICAUTH_HASH,
# a bcrypt hash from `caddy hash-password`). NEVER commit the literal
# hash: this file is version-controlled.
(website_gate) {
	basic_auth {
		website {env.WEBSITE_BASICAUTH_HASH}
	}
}

# HSTS for the prod vhosts flagged by the aqua-ops header scanner
# (2026-09-29, approved by Tim). One year, deliberately WITHOUT
# includeSubDomains and WITHOUT preload: both are hard to undo and would
# reach subdomains these site blocks do not control. Set immediately, NOT
# deferred with `?`: a deferred header is lost on responses Caddy writes
# from an error (the website_gate 401, the siwx 429), so those would go
# out without HSTS. None of these upstreams sends HSTS itself (checked
# 2026-09-29), so nothing is doubled; if one ever starts to, drop it here.
# matrix.inblock.io and element.inblock.io carry their own inline HSTS.
(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

:80 {
    respond "OK" 200
}

# TURN cert-automation host: every :443 connection with this SNI is diverted
# to LiveKit by the layer4 wrapper above; this site exists so Caddy obtains/
# renews the LE cert the l4 tls terminator uses. TLS-ALPN-01 would be
# intercepted by the SNI matcher, so issuance is HTTP-01 (port 80) only.
turn.matrix.inblock.io {
    tls {
        issuer acme {
            disable_tlsalpn_challenge
        }
    }
    respond "TURN-over-TLS termination endpoint" 200
}

matrix.inblock.io {
    encode zstd gzip

    # Stage-B2 hardening (2026-07-31): HSTS. See
    # docs/2026-07-31-element-deploy-audit-checklist.md, "Chosen fix
    # locations" section. No snippet infrastructure exists in this live
    # file (unlike the repo copy / Caddyfile.dev-aquafire), so the
    # directive is inlined here rather than introducing one.
    header ?Strict-Transport-Security "max-age=31536000"

    handle /.well-known/matrix/server {
        respond `{"m.server": "matrix.inblock.io:443"}`
    }
    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin *
        respond `{"m.homeserver": {"base_url": "https://matrix.inblock.io"}, "m.authentication": {"issuer": "https://siwx-oidc.inblock.io/", "account": "https://siwx-oidc.inblock.io/account"}, "org.matrix.msc4143.rtc_foci": [{"type": "livekit", "livekit_service_url": "https://matrix.inblock.io/livekit/jwt"}]}`
    }
    # Stage-B2 hardening (2026-07-31): MSC1929 (ratified) support-contact
    # discovery. Checklist S6, Section 4 — 404 confirmed live 2026-07-31.
    # Same JSON as Caddyfile.dev-aquafire. Contact =
    # tim.bansemer@inblock.io (operator org address; no support_page
    # exists so that key is omitted).
    handle /.well-known/matrix/support {
        header Content-Type application/json
        header Access-Control-Allow-Origin *
        respond `{"contacts":[{"email_address":"tim.bansemer@inblock.io","role":"m.role.admin"},{"email_address":"tim.bansemer@inblock.io","role":"m.role.security"}]}`
    }

    handle /_matrix/client/v3/login {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
    handle /_matrix/client/v3/logout {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
    handle /_matrix/client/v3/refresh {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }

    # MSC4108: QR code login rendezvous.
    # Stage-B2 hardening (2026-07-31): header_down -Server on these two
    # Synapse-proxying handles + the catch-all below (checklist Section 5
    # — confirmed live "Server: Synapse/1.154.0"). Scoped to
    # matrix_synapse:8080 only; the siwx-oidc handles elsewhere in this
    # block are untouched (out of scope, and their CORS header_down
    # lines are load-bearing — do not add -Server there).
    handle /_matrix/client/unstable/org.matrix.msc4108/* {
        reverse_proxy matrix_synapse:8080 {
            header_down -Server
        }
    }
    handle /_synapse/client/rendezvous/* {
        reverse_proxy matrix_synapse:8080 {
            header_down -Server
        }
    }


    # MatrixRTC: lk-jwt-service (OpenID -> LiveKit JWT exchange)
    handle_path /livekit/jwt {
        reverse_proxy lk-jwt-service:8080
    }
    handle_path /livekit/jwt/* {
        reverse_proxy lk-jwt-service:8080
    }

    # MatrixRTC: LiveKit SFU. Port 7880 muxes WebSocket signaling AND the
    # Twirp management API; the edge is the only place Twirp can be
    # restricted (2026-08-03 promotion of the dev-validated hardening).
    @livekit_twirp_public {
        not remote_ip private_ranges
    }
    handle /livekit/sfu/twirp/* {
        respond @livekit_twirp_public 403
        uri strip_prefix /livekit/sfu
        reverse_proxy livekit:7880
    }
    handle_path /livekit/sfu {
        reverse_proxy livekit:7880
    }
    handle_path /livekit/sfu/* {
        reverse_proxy livekit:7880
    }
    handle /_synapse/admin/* {
        respond 404
    }
    handle /_synapse/mas/* {
        respond 404
    }
    # MSC4191: in-client device sign-out (Element "Sessions" manager) -> siwx-oidc.
    # Only DELETE on a specific device + the bulk delete_devices are redirected;
    # GET/PUT on /devices* stay on Synapse, so listing/rename are unaffected.
    @siwx_device_delete {
        method DELETE
        path /_matrix/client/v3/devices/*
    }
    handle @siwx_device_delete {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
    handle /_matrix/client/v3/delete_devices {
        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }
    handle {
        reverse_proxy matrix_synapse:8080 {
            header_down -Server
        }
    }
}

siwx-oidc.inblock.io {
    import hsts
    encode zstd gzip

    # PUBLIC KEY MATERIAL is readable from any origin; everything else on
    # this vhost stays pinned to https://element.inblock.io.
    #
    # /jwk and the OIDC discovery document are public by definition (they
    # carry the issuer's verification keys, live AND retired, and the URLs
    # to find them), hold nothing about any user, and take no credentials.
    # A browser needs them to verify the ES256 proof in a user's
    # `io.inblock.did` profile field, and that includes Element Web
    # deployments on OTHER origins verifying one of our users over
    # federation. Every other path (/resolve, /authorize, /token, account
    # pages, ...) keeps the element-only ACAO (Tim, 2026-09-28: /resolve
    # CORS unchanged).
    #
    # The two matchers are mutually exclusive on purpose, so exactly one
    # ACAO is ever set whatever order Caddy sorts these `header`
    # directives in. Upstream's own ACAO is stripped by `header_down` in
    # the reverse_proxy below, so the browser never sees two.
    @public_keys path /jwk /.well-known/openid-configuration
    @not_public_keys not path /jwk /.well-known/openid-configuration
    header @public_keys Access-Control-Allow-Origin "*"
    header @not_public_keys Access-Control-Allow-Origin "https://element.inblock.io"
    header Access-Control-Allow-Methods "GET, POST, OPTIONS"
    header Access-Control-Allow-Headers "Content-Type, Authorization"

    @options method OPTIONS
    handle @options {
        respond 204
    }

    # Upgrade to siwx-oidc 548b543 adds POST /oauth2/admin_token, which mints an
    # `urn:synapse:admin:*`-scoped token from MAS_SHARED_SECRET. Nothing in
    # production calls it over HTTP (synapse_client mints in-process; the only
    # HTTP caller is the e2e suite), so it is closed at the edge. Same idiom as
    # the /_synapse/admin/* block on matrix.inblock.io. See SEC-0006 addendum.
    handle /oauth2/admin_token {
        respond 404
    }

    handle {
        # EDGE RATE LIMIT for the public, unauthenticated GET /resolve.
        # Prod twin of the block in Caddyfile.dev-aquafire; the full
        # reasoning (why the edge and not the service, why the zone
        # matcher instead of a `handle /resolve` block, why {remote_host}
        # and not a forwarded header, where the numbers come from) is
        # written out once, there. Summary of what must not drift:
        #
        #   * `rate_limit` is NOT stock Caddy. It comes from
        #     caddy-ratelimit, pinned beside caddy-l4 in
        #     dockerfiles/Dockerfile.caddy-l4. The portal Caddy must be
        #     running that image BEFORE this file is applied, or the
        #     whole edge fails to parse its config — and this edge fronts
        #     every prod vhost, not just this one. Image first, config
        #     second.
        #   * The limiter sits INSIDE this catch-all handle so /resolve
        #     keeps the four `header_down` lines below. A
        #     `handle /resolve` block of its own would route around them
        #     and hand browsers two Access-Control-Allow-Origin headers
        #     on exactly the endpoint that is called cross-origin.
        #   * Only GET/HEAD are counted (the route is GET-only upstream);
        #     an OPTIONS preflight is already answered by the @options
        #     handle above and never reaches the limiter.
        #
        # Prod-specific note: this vhost's ACAO is pinned to
        # https://element.inblock.io, so a third-party browser consumer
        # cannot read /resolve here at all today (dev serves `*`). That
        # is an existing, deliberate prod posture — not something this
        # limiter changes — but it means the 429 body below is mostly
        # for non-browser callers here.
        #
        # Tune these two `events` values and nothing else:
        #   burst     60 / 10s = 6 req/s ceiling (no thundering herd)
        #   sustained 600 / 5m = 2 req/s average, <= 4 Synapse probes/s
        # Each distinct client IP costs ~16 KB of RAM while it is active
        # (one `[]time.Time` ring of len == events per zone); the
        # sustained zone dominates that, so it is the number to lower if
        # a botnet-scale spray is ever the concern. Full reasoning in
        # Caddyfile.dev-aquafire.
        rate_limit {
            zone siwx_resolve_burst {
                match {
                    path   /resolve
                    method GET HEAD
                }
                key         {remote_host}
                events      60
                window      10s
                ipv6_prefix 64
            }
            zone siwx_resolve_sustained {
                match {
                    path   /resolve
                    method GET HEAD
                }
                key         {remote_host}
                events      600
                window      5m
                ipv6_prefix 64
            }
        }

        reverse_proxy siwx-oidc:8081 {
            header_down -Access-Control-Allow-Origin
            header_down -Access-Control-Allow-Methods
            header_down -Access-Control-Allow-Headers
            header_down -Vary
        }
    }

    # The limiter's 429 has an empty body by default; every other error a
    # /resolve caller can see is JSON (`{"error":…,"message":…}`, from
    # siwx-oidc's ResolveError). Status-filtered on purpose so this vhost's
    # 502s keep Caddy's default error handling instead of being reported as
    # a rate limit. Retry-After and the site-level CORS headers survive into
    # this response (verified against the real module).
    handle_errors 429 {
        header Content-Type "application/json"
        respond `{"error":"rate_limited","message":"Too many requests to /resolve from this address. Retry after the interval in the Retry-After header."}` 429
    }
}

element.inblock.io {
    encode zstd gzip
    # Stage-B2 hardening (2026-07-31): HSTS (checklist Section 1, S8/S9 —
    # FAIL confirmed live before this change).
    header ?Strict-Transport-Security "max-age=31536000"
    reverse_proxy element-web:8080
}

openwitness.org {
    import hsts
    encode zstd gzip
    reverse_proxy timestamp:8080
}

timestamps.inblock.io {
    import hsts
    redir https://openwitness.org{uri} permanent
}

agentic.inblock.io {
    encode zstd gzip
    reverse_proxy portal:8080
}


audit.inblock.io {
    import hsts
    encode zstd gzip
    import website_gate
    reverse_proxy regulator:8791
}

viewer.inblock.io {
    import hsts
    # Shared-password gate for the Aqua state viewer preview (user: website).
    import website_gate

    # The viewer streams nodes over SSE. These paths must not be compressed or
    # buffered, or the graph appears to hang while frames sit in the encoder --
    # flush_interval -1 disables response buffering.
    @sse path /api/events /api/sessions/*/events
    handle @sse {
        reverse_proxy viewer:8080 {
            flush_interval -1
        }
    }

    handle {
        encode zstd gzip
        reverse_proxy viewer:8080
    }
}

projects.inblock.io {
    import hsts
    encode zstd gzip
    import website_gate
    reverse_proxy projects:8080
}

aqua-registry.inblock.io {
    import hsts
    encode zstd gzip
    reverse_proxy aqua-registry:8088
}
