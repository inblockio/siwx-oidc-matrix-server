/mount_point/
/.env
/homeserver.yaml
/proxy/
/siwx-oidc-config/
/.env.local
# Prod-only volume-bind override (see docker-compose.override.yml.example); must
# never reach local dev, where /mnt/volume_matrix_service does not exist.
/docker-compose.override.yml
# Local secrets — never commit. signing_key.pem is the OIDC signing key; .env.real
# is a real prod env file. They sat untracked-but-not-ignored, so a `git add -A`
# could have leaked them. (`/.env` above does not match `.env.real`.)
/signing_key.pem
/.env.real

# Generated e2e harness env (secrets: MAS secret, LiveKit key/secret, OIDC PEM)
/.env.e2e

# Generated self-signed federation cert for the lk-jwt -> Synapse TLS shim
# (harness-only; regenerated by scripts/gen-e2e-fed-cert.sh on bring-up).
/e2e-harness/certs/

# Real LiveKit TURN-TLS cert/key, sync-copied onto the box by
# scripts/livekit-turn-cert-sync.sh from Caddy's ACME storage (see
# docker-compose.dev-staging.yml). Never committed; same rationale as
# signing_key.pem/.env.real above.
/config/livekit-tls/
