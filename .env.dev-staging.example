# siwx-oidc-matrix-server — dev-staging environment (dev-aquafire box)
#
# Copy to .env in the deploy directory on the box (/home/dev/matrix-staging/,
# see docs/2026-07-30-dev-staging-dev-aquafire.md) and fill in every secret
# using the generation commands below. NEVER commit the filled-in file, never
# paste real secret VALUES into chat/CI logs — only the names below are meant
# to leave this machine.
#
#   cp .env.dev-staging.example .env
#   chmod 600 .env
#   # ...append the three generated secrets per the commands below...
#   docker compose -f docker-compose.dev-staging.yml --env-file .env up -d

# ============================================================================
# Compose project identity
# ============================================================================

# Keeps this stack's containers/volumes/network namespaced separately from
# any other Compose project (e.g. `matrix` on production) that might ever
# run on the same Docker daemon.
COMPOSE_PROJECT_NAME=matrix-staging

# ============================================================================
# Docker image refs (GHCR, built by CI on push to main in each repo)
# ============================================================================

# RESOLVED 2026-07-31 (root cause of the `:main` poisoning below):
# dockerfiles/Dockerfile did `FROM matrixdotorg/synapse:latest` (unpinned), so
# every CI rebuild of `:main` silently picked up whatever upstream Synapse was
# current. Upstream 1.157.1 REMOVED `experimental_features.msc3861` (hard
# startup error: "experimental_features.msc3861 was removed. Use the
# matrix_authentication_service configuration instead."), poisoning `:main`
# for this stack's schema. Fixed by pinning the Dockerfile to
# `matrixdotorg/synapse:v1.154.0` and rebuilding — see the FROM-line comment
# in dockerfiles/Dockerfile for the full note. `ghcr.io/element-hq/lk-jwt-
# service:latest` drifted similarly in the same window (see
# LIVEKIT_FULL_ACCESS_HOMESERVERS below) and remains a separate, still-open
# unpinned tag.
#
# SYNAPSE_IMAGE_REF / ELEMENT_IMAGE_REF replace the old shared `IMAGE_TAG`.
# A single tag string applied to both images cannot express two different
# digests for the same tag, and GHCR sha-tags have proven REPUBLISHABLE
# (observed 2026-07-30/31: element-web:sha-4a3d434 drifted from the bytes
# originally deployed under that tag) — so bare-tag pinning alone is not
# trustworthy. Pin each image independently, by digest:
#   SYNAPSE_IMAGE_REF=ghcr.io/inblockio/siwx-oidc-matrix-server/synapse:sha-<sha>@sha256:<digest>
#   ELEMENT_IMAGE_REF=ghcr.io/inblockio/siwx-oidc-matrix-server/element-web:sha-<sha>@sha256:<digest>
# Both default to `:main` in docker-compose.dev-staging.yml if unset here.
SYNAPSE_IMAGE_REF=ghcr.io/inblockio/siwx-oidc-matrix-server/synapse:main
ELEMENT_IMAGE_REF=ghcr.io/inblockio/siwx-oidc-matrix-server/element-web:main
# Independent: siwx-oidc repo's own tag.
SIWX_OIDC_TAG=main

# REDIS_IMAGE_REF / LK_JWT_IMAGE_REF (added 2026-07-31, S4): same
# env-overridable digest-pin pattern as SYNAPSE_IMAGE_REF/ELEMENT_IMAGE_REF
# above, applied to the two remaining floating refs (`image: redis` and
# `ghcr.io/element-hq/lk-jwt-service:latest`) in
# docker-compose.dev-staging.yml (and, independently, docker-compose.yml).
# Both are OPTIONAL here — the compose file's fallback is already a full
# tag@digest pin (production's current digest, conservative default for a
# fresh box) — set only to override it. Unlike Synapse/Element, THIS BOX
# (dev-aquafire) intentionally does NOT want the compose default applied to
# redis: dev-staging's redis has drifted ahead to 8.10.0 (digest
# 077ba791...) against prod's 8.8.0 (digest aa049e68...), each with its own
# live AOF file, so letting the default (prod's digest) apply here would
# DOWNGRADE this box's redis on the next `up -d` — a data-loss risk against
# a live AOF, not just a version bump. Set REDIS_IMAGE_REF explicitly to
# THIS BOX'S OWN current digest so that can never happen silently:
#   REDIS_IMAGE_REF=redis:latest@sha256:<this box's own digest>
# lk-jwt-service digests were verified IDENTICAL on both boxes on 2026-07-31,
# so the compose default is already correct for dev-staging too;
# LK_JWT_IMAGE_REF only needs setting for symmetry/clarity, not because the
# default would diverge:
#   LK_JWT_IMAGE_REF=ghcr.io/element-hq/lk-jwt-service:latest@sha256:<digest>
# Resolve a box's own running digest with (never trust the tag string):
#   docker inspect --format='{{.Image}}' <container> | \
#     xargs docker image inspect --format='{{join .RepoDigests ", "}}'
# REDIS_IMAGE_REF=
# LK_JWT_IMAGE_REF=

# ============================================================================
# siwx-oidc (OIDC provider)
# ============================================================================

SIWEOIDC_HOST=dev.siwx.inblock.io
SIWEOIDC_PORT=8081
SIWEOIDC_BASE_URL=https://dev.siwx.inblock.io
RUST_LOG=siwx_oidc=info,tower_http=info

# [secret, required] ES256 P-256 PKCS#8 PEM signing key for issued OIDC
# tokens. Single-line, newline-escaped (Docker Compose/godotenv converts the
# \n escapes back to real newlines for the container). Regenerating
# invalidates every token ever issued. Generate with:
#
#   PEM=$(openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 2>/dev/null)
#   PEM_LINE=$(printf '%s' "$PEM" | sed ':a;N;$!ba;s/\n/\\n/g')
#   echo "SIWEOIDC_SIGNING_KEY_PEM=\"${PEM_LINE}\"" >> .env
#
# (openssl genpkey emits PKCS#8 by default for EC keys — no separate -pkcs8
# conversion step needed, unlike `openssl ecparam -genkey` which emits SEC1.)
# SIWEOIDC_SIGNING_KEY_PEM=

# ============================================================================
# MSC3861 (Synapse <-> siwx-oidc delegated auth / introspection)
# ============================================================================

# [secret, required] Shared secret Synapse uses to authenticate its MSC3861
# introspection + admin-API calls to siwx-oidc. Generate with:
#
#   echo "MAS_SHARED_SECRET=$(openssl rand -hex 32)" >> .env
#
# MAS_SHARED_SECRET=

# ============================================================================
# Matrix Synapse
# ============================================================================

MATRIX_HOST=dev.matrix.inblock.io
MATRIX_PORT=8080
MATRIX_BASE_URL=https://dev.matrix.inblock.io
MATRIX_REPORT_STATS=no
MATRIX_MESSAGE_LIFETIME=4w

# Optional: auto-promote this DID to server admin on every boot (idempotent).
# The user must complete at least one OIDC login before promotion takes effect.
# MATRIX_ADMIN_DID=did:pkh:eip155:1:0xYourEthereumAddress

# ============================================================================
# Element Web client
# ============================================================================

# Documentation only — Caddyfile.dev-aquafire hardcodes the vhost (it is a
# static config, not templated), so nothing reads this env var at runtime.
# Kept for parity with env.example / operator readability.
CLIENT_HOST=dev.element.inblock.io

# ============================================================================
# LiveKit (MatrixRTC / Element Call)
# ============================================================================

# [secret, required] API key for the LiveKit SFU. Generate with:
#
#   echo "LIVEKIT_KEY=API$(openssl rand -hex 8)" >> .env
#
# LIVEKIT_KEY=

# [secret, required] Shared secret between lk-jwt-service and LiveKit.
# Generate with:
#
#   echo "LIVEKIT_SECRET=$(openssl rand -base64 32)" >> .env
#
# LIVEKIT_SECRET=

# Skip TLS verification for lk-jwt-service -> Synapse OpenID validation.
# Leave unset/false — this is a real TLS box (Caddy/ACME), not local dev.
# LIVEKIT_INSECURE_SKIP_VERIFY_TLS=false
