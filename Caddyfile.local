# Local-only Caddy config for docker-compose.local.yml.
#
# HTTP only, port-based virtual hosts (no DNS, no TLS). Each listening
# port maps to one logical service. The Matrix port intercepts the
# MSC3861 login/logout/refresh paths and proxies them to siwx-oidc —
# the same trick the production Caddyfile uses, just over plain HTTP
# on localhost ports.

(strip_upstream_cors) {
    header_down -Access-Control-Allow-Origin
    header_down -Access-Control-Allow-Methods
    header_down -Access-Control-Allow-Headers
    header_down -Access-Control-Allow-Credentials
    header_down -Access-Control-Expose-Headers
    header_down -Access-Control-Max-Age
    header_down -Vary
}

(public_cors) {
    @cors_preflight method OPTIONS
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, HEAD, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "X-Requested-With, Content-Type, Authorization, Date"
    header Access-Control-Max-Age "86400"
    respond @cors_preflight 204
}

# Matrix homeserver port.
:8080 {
    encode zstd gzip

    # Public host URLs (set via caddy container env; defaults match compose ports).
    # When remapping host ports (e.g. portal owns :8080), set MATRIX_PUBLIC_BASE
    # and SIWX_PUBLIC_BASE so discovery matches what the browser can reach.
    # Synapse server discovery (the homeserver delegates federation port to itself).
    handle /.well-known/matrix/server {
        respond `{"m.server": "{$MATRIX_PUBLIC_HOST:localhost:8080}"}`
    }

    # Client discovery — points Element at the OIDC issuer for MSC3861.
    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin *
        respond `{"m.homeserver": {"base_url": "{$MATRIX_PUBLIC_BASE:http://localhost:8080}"}, "m.authentication": {"issuer": "{$SIWX_PUBLIC_BASE:http://localhost:8081}/", "account": "{$SIWX_PUBLIC_BASE:http://localhost:8081}/account"}, "org.matrix.msc4143.rtc_foci": [{"type": "livekit", "livekit_service_url": "{$MATRIX_PUBLIC_BASE:http://localhost:8080}/livekit/jwt"}]}`
    }

    # MSC3861: login/logout/refresh + in-client device teardown go to siwx-oidc.
    # Synapse returns 404 for these under delegated auth; Element "Sign out this
    # session" / remove-device must hit siwx-oidc (parity with e2e/real-stack/Caddyfile
    # and production method-routes).
    handle /_matrix/client/v3/login {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    handle /_matrix/client/v3/logout {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    handle /_matrix/client/v3/logout/all {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    handle /_matrix/client/v3/delete_devices {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    # Prefix match covers DELETE /devices/{id} (owned by siwx). GET list may also
    # hit this path; compat handlers or fall-through — keep parity with real-stack edge.
    handle /_matrix/client/v3/devices/* {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    handle /_matrix/client/v3/refresh {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }

    # MSC4108: QR code login rendezvous (no compression to preserve ETags).
    handle /_matrix/client/unstable/org.matrix.msc4108/* {
        reverse_proxy matrix_synapse:8080
    }
    handle /_synapse/client/rendezvous/* {
        reverse_proxy matrix_synapse:8080
    }

    # MatrixRTC: lk-jwt-service (OpenID -> LiveKit JWT exchange)
    handle_path /livekit/jwt {
        reverse_proxy lk-jwt-service:8080
    }
    handle_path /livekit/jwt/* {
        reverse_proxy lk-jwt-service:8080
    }

    # MatrixRTC: LiveKit SFU. Port 7880 muxes WebSocket signaling AND the Twirp
    # management API, which no upstream flag can split or disable, so the edge
    # is the only place to restrict it (S3, 2026-08-01 av-hardening audit;
    # parity with Caddyfile.production, which carries the full rationale).
    # Private-range callers pass through because lk-jwt's own CreateRoom call
    # hairpins back in through here.
    @livekit_twirp_public {
        not remote_ip private_ranges
    }
    handle /livekit/sfu/twirp/* {
        respond @livekit_twirp_public 403
        uri strip_prefix /livekit/sfu
        reverse_proxy livekit:7880
    }

    # Bare path: `/livekit/sfu/*` does not match `/livekit/sfu`, so without this
    # exact-match block the bare path 404s. Same idiom as /livekit/jwt.
    handle_path /livekit/sfu {
        reverse_proxy livekit:7880
    }

    # Everything else under the SFU (/rtc, /rtc/validate, …).
    handle_path /livekit/sfu/* {
        reverse_proxy livekit:7880
    }

    # SEC-0003: never expose the Synapse admin / MAS provisioning surfaces at the
    # edge. siwx-oidc reaches them directly over the Docker network, so the deny
    # breaks nothing. Kept in parity with Caddyfile.production.
    handle /_synapse/admin/* {
        respond 404
    }
    handle /_synapse/mas/* {
        respond 404
    }

    # Everything else → Synapse.
    handle {
        reverse_proxy matrix_synapse:8080
    }
}

# siwx-oidc port — OIDC provider endpoints (authorize, token, register, .well-known/openid-configuration, etc.).
:8081 {
    encode zstd gzip
    import public_cors
    reverse_proxy siwx-oidc:8081 {
        import strip_upstream_cors
    }
}

# Element Web client port.
:8088 {
    encode zstd gzip
    reverse_proxy element-web:8080
}
