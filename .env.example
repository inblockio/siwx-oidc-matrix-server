# siwx-oidc-matrix-server environment configuration
# Copy to .env or let start-matrix.sh generate it automatically.
#
# Variables marked [required] must be set via start-matrix.sh flags.
# Variables marked [auto] are generated by start-matrix.sh if not provided.

#--- Required ---
# These are set by start-matrix.sh flags and written to .env on first run.
MATRIX_HOST=matrix.example.com
SIWEOIDC_HOST=siwx-oidc.example.com
CLIENT_HOST=element.example.com
LETSENCRYPT_EMAIL=admin@example.com

#--- SIWX-OIDC ---
SIWEOIDC_PORT=8081
SIWEOIDC_BASE_URL=https://siwx-oidc.example.com
RUST_LOG=siwx_oidc=error,tower_http=error
# [auto] OIDC client credentials (generated by start-matrix.sh):
# SIWEOIDC_DEFAULT_CLIENTS='{clientid="{\"secret\":\"clientsecret\", \"metadata\": {\"redirect_uris\": [\"https://matrix.example.com/_synapse/client/oidc/callback\"]}}"}'
# [auto] ES256 signing key (single-line \n-escaped PEM for Docker Compose):
# SIWEOIDC_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----\n"

#--- Matrix Synapse ---
MATRIX_PORT=8080
MATRIX_BASE_URL=https://matrix.example.com
MATRIX_REPORT_STATS=no
MATRIX_MESSAGE_LIFETIME=4w
# [auto] OIDC client credentials (mirrored from SIWX-OIDC section):
# MATRIX_OIDC_CLIENT_ID=
# MATRIX_OIDC_SECRET_ID=

#--- Admin ---
# Optional: auto-promote this DID to server admin on every boot (idempotent).
# The user must complete at least one OIDC login before promotion takes effect.
# MATRIX_ADMIN_DID=did:pkh:eip155:1:0xYourEthereumAddress

#--- Element Web Client ---
# Hostname for the self-hosted Element Web client with auto-SIWX login.
# CLIENT_HOST is set above in the Required section.

# Note: SIWEOIDC_SIGNING_KEY_PEM is auto-generated by start-matrix.sh and
# written to .env (chmod 600). It is passed to the container via environment
# variable, not as a file on disk. Do not delete it; tokens become invalid
# if the key changes.
