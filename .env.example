# siwx-oidc-matrix-server environment configuration
# Copy to .env or let start-matrix.sh generate it automatically.
#
# Variables marked [required] must be set via start-matrix.sh flags.
# Variables marked [auto] are generated by start-matrix.sh if not provided.
#
# The host names below are commented out. Copied as .env.local for the local
# stack (docker-compose.local.yml, see its header), that leaves its localhost
# defaults in force. For docker-compose.yml, set them to your own host names;
# start-matrix.sh writes them from its --MATRIX_HOST, --SIWEOIDC_HOST and
# --CLIENT_HOST flags.

#--- SIWX-OIDC ---
# [required] SIWEOIDC_HOST=siwx-oidc.example.org
SIWEOIDC_PORT=8081
# SIWEOIDC_BASE_URL=https://siwx-oidc.example.org
RUST_LOG=siwx_oidc=info,tower_http=info
# Allow public clients (token_endpoint_auth_method: "none") at the token endpoint.
# Default: true (require secret). Set to false for Element Web's PKCE-based flow.
SIWEOIDC_REQUIRE_SECRET=false
# DID methods accepted at sign-in. "pkh" = did:pkh (Ethereum/Ed25519/P-256), "key" = did:key.
# SIWEOIDC_SUPPORTED_DID_METHODS=["pkh","key"]
# [auto] ES256 signing key (single-line \n-escaped PEM for Docker Compose):
# SIWEOIDC_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIGH...\n-----END PRIVATE KEY-----\n"

#--- MSC3861 ---
# [auto] Shared secret for Synapse-to-siwx-oidc introspection (generated by start-matrix.sh):
# MAS_SHARED_SECRET=<generated-by-start-script>

#--- Matrix Synapse ---
# [required] MATRIX_HOST=matrix.example.org
MATRIX_PORT=8080
# MATRIX_BASE_URL=https://matrix.example.org
MATRIX_REPORT_STATS=no
MATRIX_MESSAGE_LIFETIME=4w

#--- Element Web Client ---
# Substituted into config.json permalink_prefix (Share links skip matrix.to).
# [required] CLIENT_HOST=element.example.org

#--- Admin ---
# Optional: auto-promote this DID to server admin on every boot (idempotent).
# The user must complete at least one OIDC login before promotion takes effect.
# MATRIX_ADMIN_DID=did:pkh:eip155:1:0xYourEthereumAddress

#--- E2E Test ---
# Public repo for the E2EE integration test agent.
E2E_TEST_REPO=https://github.com/inblockio/aqua-matrix-agent.git
# Local path override: if this directory exists, use it instead of cloning.
# E2E_TEST_LOCAL_PATH=/path/to/aqua-matrix-agent

#--- LiveKit (MatrixRTC / Element Call) ---
# [auto] API key for LiveKit SFU (generated by start-matrix.sh):
# LIVEKIT_KEY=API<random>
# [auto] Shared secret between lk-jwt-service and LiveKit (generated by start-matrix.sh):
# LIVEKIT_SECRET=<random-base64>
# Skip TLS verification for lk-jwt-service -> Synapse OpenID validation (local dev only):
# LIVEKIT_INSECURE_SKIP_VERIFY_TLS=true
# lk-jwt-service's LIVEKIT_FULL_ACCESS_HOMESERVERS (the allowlist of
# homeservers permitted full LiveKit room-creation access) is mandatory since
# v0.5.0 — the container exits at startup without it. There is NO key for it
# here: docker-compose.yml derives it from MATRIX_HOST, so setting it in this
# file has no effect. It must stay an explicit hostname; "*" would grant room
# creation to users of any federated homeserver.

#--- Docker Images ---
# FULL image refs for the pre-built GHCR images. These replaced the old shared
# `IMAGE_TAG` + `SIWX_OIDC_TAG` bare tags on 2026-07-31: one tag string cannot
# express two different digests, and GHCR tags have proven republishable, so
# tag-only pinning is not trustworthy. Each image is pinned independently, and
# the digest-only form is preferred for a promoted/validated build:
#   SYNAPSE_IMAGE_REF=ghcr.io/inblockio/siwx-oidc-matrix-server/synapse@sha256:<digest>
#   ELEMENT_IMAGE_REF=ghcr.io/inblockio/siwx-oidc-matrix-server/element-web@sha256:<digest>
#   SIWX_OIDC_IMAGE_REF=ghcr.io/inblockio/siwx-oidc@sha256:<digest>
# Unset, each defaults to an immutable `:sha-<commit>@sha256:<digest>` ref in
# docker-compose.yml: one CI build of a named main commit, never `:main`, so
# an unconfigured stack runs the same bytes on every pull. REDIS_IMAGE_REF,
# LIVEKIT_IMAGE_REF and LK_JWT_IMAGE_REF work the same way; their defaults
# are upstream `tag@sha256:<digest>` refs. Set one only to run another build.

#--- Logging ---
# RUST_LOG=siwx_oidc=debug,tower_http=trace

# Note: SIWEOIDC_SIGNING_KEY_PEM is auto-generated by start-matrix.sh and
# written to .env (chmod 600). It is passed to the container via environment
# variable, not as a file on disk. Keep it: access and refresh tokens survive
# a new key (they are opaque Redis entries), but ID tokens and every published
# io.inblock.did proof signed with the old key stop verifying, unless the old
# public key is listed in SIWXOIDC_RETIRED_SIGNING_KEYS_PEM (siwx-oidc's
# docs/configuration.md, "Key rotation").

# --- DID profile-field protection (see patches/synapse/README.md) -------------
# The provider-asserted DID field, protected by the vendored MSC4133 write-ACL
# patch. A THREE-SIDED wire contract: this must equal siwx-oidc's
# did_assertion::DID_PROFILE_FIELD and the siwx-oidc-auth verifier's copy.
# Changing it on one side alone silently unprotects the live field.
#SIWX_DID_PROFILE_FIELD=io.inblock.did
#
# Set to 1 to start Synapse even when it does NOT carry the write-ACL patch.
# The DID field is then user-writable: any user can overwrite their own copy
# with SOMEONE ELSE'S DID, and it is world-readable and federates. Only for a
# deliberate comparison run against a stock image.
#SIWX_ALLOW_UNPROTECTED_DID_FIELD=1
