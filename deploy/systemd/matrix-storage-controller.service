[Unit]
Description=Matrix storage controller (dynamic media retention + storage alerts)
Documentation=https://github.com/inblockio/siwx-oidc-matrix-server
# The controller talks to Synapse over docker, and reads the bounded volume.
After=docker.service
Requires=docker.service
RequiresMountsFor=/mnt/volume_matrix_service
# The controller now exits NON-ZERO whenever media retention did not run (auth
# failure, unreachable mint, admin API refusal). Without this line that non-zero
# exit only lands in the journal, where nobody looks until the volume is full —
# which is exactly the silent failure this unit exists to prevent.
OnFailure=matrix-storage-controller-alert.service

[Service]
Type=oneshot
User=deploy
# deploy is in the docker group; make sure the oneshot inherits it so
# `docker compose exec` works without a TTY or sudo.
SupplementaryGroups=docker
WorkingDirectory=/home/deploy/matrix/stack
# systemd creates /var/lib/matrix-storage-controller owned by deploy and exports
# it as $STATE_DIRECTORY; the script keeps its alert-level state there.
StateDirectory=matrix-storage-controller
ExecStart=/home/deploy/matrix/stack/scripts/matrix-storage-controller.sh tick
Nice=10
# Backstop for a hung tick. The script bounds each curl itself
# (HTTP_CONNECT_TIMEOUT / MINT_MAX_TIME / ADMIN_MAX_TIME), but a wedge anywhere
# else (docker daemon, compose exec) must still end as a FAILED unit rather than
# a tick that never returns and silently blocks every later one. Must stay
# comfortably above ADMIN_MAX_TIME (900s), since purge_media_cache is
# synchronous and legitimately slow on a large media store.
TimeoutStartSec=1800
# Tunables can be overridden here or via a drop-in, e.g.:
# Environment=WARN_PCT=80 CRIT_PCT=90 CURVE_K=2
