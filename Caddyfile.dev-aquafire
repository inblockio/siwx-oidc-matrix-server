dev.aquafire.inblock.io {
    encode zstd gzip
    # Verified 2026-07-30 (plan context, task instructions): aquafier-rs
    # listens on 3000. Still worth a quick confirm against the live nginx
    # conf during T3 since everything else on this box is unverified.
    reverse_proxy aquafier-rs:3000
}

draw.inblock.io {
    encode zstd gzip
    # TODO(T3-verify): confirm upstream against generated nginx conf before cutover.
    # "Likely 80" per plan context (typical excalidraw-docker default) — NOT
    # verified. Replace with:  reverse_proxy excalidraw:<PORT>
    respond "dev-aquafire: draw.inblock.io upstream not yet configured (T3 pending)" 503
}
