##############################################################################
# Caddyfile.dev-aquafire
#
# Static Caddy config for the dev-aquafire box (207.154.209.103). This Caddy
# REPLACES nginx-proxy + acme-companion (containers `aqua_proxy` / `aqua_acme`,
# docker-gen VIRTUAL_HOST pattern) as the box's SOLE reverse proxy + TLS
# terminator, binding 80/443 for ALL EIGHT vhosts on the box:
#
#   NEW (this repo's stack, docker-compose.dev-staging.yml):
#     dev.matrix.inblock.io    Synapse + .well-known + livekit subpaths
#     dev.siwx.inblock.io      siwx-oidc OIDC provider (CORS strip is
#                              load-bearing — see the vhost block below)
#     dev.element.inblock.io   Element Web client
#
#   MIGRATED (5 pre-existing dev-aquafire services, currently behind
#   nginx-proxy; unrelated to this stack, just sharing the box/proxy):
#     aquafier.inblock.io, aquafier-api.inblock.io, dev.aqua-node.inblock.io,
#     dev.aquafire.inblock.io, draw.inblock.io
#
# Origin: docs/superpowers/plans/2026-07-30-dev-staging-deploy-caddy-migration.md
# (siwx-oidc repo), task T2. Modeled on Caddyfile.production (this repo) for
# the Matrix/.well-known/livekit routing, and on Caddyfile.local for the
# strip_upstream_cors snippet.
#
# STATUS: VERIFIED 2026-07-30 (T3). Every upstream below was read off the LIVE
# generated nginx-proxy config on the box:
#     docker exec aqua_proxy cat /etc/nginx/conf.d/default.conf
# which resolved by container IP on `proxy_net` as:
#     aquafier-api.inblock.io   -> 172.18.0.7:3000  = deployment-aqua-container-1:3000
#     aquafier.inblock.io       -> 172.18.0.7:3600  = deployment-aqua-container-1:3600
#     dev.aqua-node.inblock.io  -> 172.18.0.2:80    = aqua-explorer:80
#     dev.aquafire.inblock.io   -> 172.18.0.6:3000  = aquafier-rs:3000
#     draw.inblock.io           -> 172.18.0.4:80    = excalidraw:80
# NOTE the two aquafier vhosts share ONE container on TWO different ports
# (3000 = API, 3600 = UI). Do not "simplify" them to the same port.
# All TODO(T3-verify) markers are resolved; no placeholder `respond 503`
# remains.
#
# Deploy: mounted read-only as /etc/caddy/Caddyfile into the `caddy` service of
# docker-compose.caddy-proxy.yml — a STANDALONE compose project (`caddy-proxy`,
# deployed to /home/dev/caddy-proxy/ on the box), deliberately NOT part of the
# matrix stack's compose project. This mirrors the lesson already learned on
# this box and recorded in the header of
# /home/dev/aquafier-rs/deployment/docker-compose-proxy.yml: when the proxy
# lived inside an application's compose project, a `docker compose down` on
# that application took every other site on the box down with it. The proxy
# owns its own project + lifecycle; apps attach by joining `proxy_net`.
#
# See docs/2026-07-30-dev-staging-dev-aquafire.md for the cutover + rollback
# procedure actually executed.
##############################################################################

{
    # VERIFIED 2026-07-30 (T3): this is the address the outgoing acme-companion
    # already had registered for these exact domains —
    #     docker inspect aqua_acme -> DEFAULT_EMAIL=hello@inblock.io
    # Reusing it keeps Let's Encrypt expiry/problem notifications flowing to the
    # same inbox across the nginx-proxy -> Caddy migration. (Caddy still creates
    # its OWN ACME account keypair; only the contact address is shared.)
    email hello@inblock.io

    # Admin API stays on Caddy's default bind (127.0.0.1:2019 inside the
    # container, never published to the host/ports: list below) — this still
    # allows `docker exec caddy caddy reload --config /etc/caddy/Caddyfile`
    # for a zero-downtime config change without exposing the admin API
    # externally. Not disabled outright ("admin off") because T3's staged
    # cutover benefits from being able to reload without a restart.
}

(strip_upstream_cors) {
    header_down -Access-Control-Allow-Origin
    header_down -Access-Control-Allow-Methods
    header_down -Access-Control-Allow-Headers
    header_down -Access-Control-Allow-Credentials
    header_down -Access-Control-Expose-Headers
    header_down -Access-Control-Max-Age
    header_down -Vary
}

(public_cors) {
    @cors_preflight method OPTIONS
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, HEAD, POST, PUT, DELETE, OPTIONS"
    header Access-Control-Allow-Headers "X-Requested-With, Content-Type, Authorization, Date"
    header Access-Control-Max-Age "86400"
    respond @cors_preflight 204
}

# HSTS — carried over from nginx-proxy, which emitted exactly
#     add_header Strict-Transport-Security "max-age=31536000" always;
# on ALL FIVE legacy vhosts (verified 2026-07-30 in the generated conf; no
# includeSubDomains, no preload). Applied here to all EIGHT vhosts.
#
# The `+` prefix means ADD, not SET, replicating nginx's `add_header`
# semantics. This matters for dev.aquafire.inblock.io, whose upstream
# (aquafier-rs) emits its OWN, STRICTER header
# ("max-age=31536000; includeSubDomains"). Under nginx the client saw both, in
# that order, and per RFC 6797 processes the first — i.e. the upstream's
# stricter policy won. A plain `header` (set) would silently DOWNGRADE that
# vhost by discarding includeSubDomains, so do not "simplify" the + away.
(hsts) {
    header +Strict-Transport-Security "max-age=31536000"
}

# Request body cap — carried over from nginx-proxy's
# /etc/nginx/conf.d/inblock_custom.conf (`client_max_body_size 200m;`, global,
# matching PROXY_BODY_SIZE=200M in docker-compose-proxy.yml; aquafier-rs
# accepts uploads up to ~200 MB). Caddy has NO default request-body limit, so
# without this the migration would silently make the box MORE permissive than
# nginx was. Applied to the five legacy vhosts only — the three new dev.*
# vhosts stay unlimited, matching Caddyfile.production (Synapse media uploads
# are already capped by Synapse's own max_upload_size).
(legacy_body_limit) {
    request_body {
        max_size 200MB
    }
}

# Bare-IP / no-SNI requests (health probes, scanners) — matches
# Caddyfile.production's catch-all instead of erroring.
#
# VERIFIED 2026-07-30 (T3) on the box with a throwaway caddy container on
# alternate ports: this host-less :80 block does NOT shadow Caddy's automatic
# HTTP->HTTPS redirects. A request for a NAMED vhost over plain HTTP still gets
# `308 Permanent Redirect -> https://...` (Caddy logs "enabling automatic
# HTTP->HTTPS redirects" for srv0); only an UNMATCHED Host falls through to
# this catch-all. nginx-proxy issued 301 for the same redirect; 308 is the
# method-preserving equivalent and is what Caddy emits — a deliberate, benign
# difference.
:80 {
    respond "OK" 200
}

# ============================================================================
# NEW: siwx-oidc-matrix-server stack (this box's primary purpose)
# ============================================================================

dev.matrix.inblock.io {
    encode zstd gzip
    import hsts

    # Synapse server discovery (federation port delegation).
    handle /.well-known/matrix/server {
        respond `{"m.server": "dev.matrix.inblock.io:443"}`
    }

    # Client discovery — points Element at the OIDC issuer for MSC3861 +
    # advertises the LiveKit MatrixRTC focus (MSC4143).
    handle /.well-known/matrix/client {
        header Access-Control-Allow-Origin *
        respond `{"m.homeserver": {"base_url": "https://dev.matrix.inblock.io"}, "m.authentication": {"issuer": "https://dev.siwx.inblock.io/", "account": "https://dev.siwx.inblock.io/account"}, "org.matrix.msc4143.rtc_foci": [{"type": "livekit", "livekit_service_url": "https://dev.matrix.inblock.io/livekit/jwt"}]}`
    }

    # MSC3861: login/logout/refresh go to siwx-oidc. Synapse returns 404 for
    # these under delegated auth.
    handle /_matrix/client/v3/login {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    handle /_matrix/client/v3/logout {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
    handle /_matrix/client/v3/refresh {
        import public_cors
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }

    # MSC4108: QR code login rendezvous (no compression to preserve ETags).
    handle /_matrix/client/unstable/org.matrix.msc4108/* {
        reverse_proxy matrix_synapse:8080
    }
    handle /_synapse/client/rendezvous/* {
        reverse_proxy matrix_synapse:8080
    }

    # MatrixRTC: lk-jwt-service (OpenID -> LiveKit JWT exchange)
    handle_path /livekit/jwt {
        reverse_proxy lk-jwt-service:8080
    }
    handle_path /livekit/jwt/* {
        reverse_proxy lk-jwt-service:8080
    }

    # MatrixRTC: LiveKit SFU WebSocket signaling
    handle_path /livekit/sfu/* {
        reverse_proxy livekit:7880
    }

    # SEC-0003: never expose the Synapse admin / MAS provisioning surfaces at
    # the edge. siwx-oidc reaches them directly over the Docker network, so
    # the deny breaks nothing. Kept in parity with Caddyfile.production.
    handle /_synapse/admin/* {
        respond 404
    }
    handle /_synapse/mas/* {
        respond 404
    }

    # Everything else -> Synapse.
    handle {
        reverse_proxy matrix_synapse:8080
    }
}

dev.siwx.inblock.io {
    encode zstd gzip
    import hsts
    import public_cors

    # Load-bearing: siwx-oidc emits its own CORS headers. Without stripping
    # them here, the browser sees TWO Access-Control-Allow-Origin headers
    # (Caddy's public_cors above + siwx-oidc's own) and CORS silently fails,
    # breaking OIDC discovery/token calls. See siwx-oidc/CLAUDE.md "CORS rule"
    # and Caddyfile.production / Caddyfile.local (strip_upstream_cors).
    handle {
        reverse_proxy siwx-oidc:8081 {
            import strip_upstream_cors
        }
    }
}

dev.element.inblock.io {
    encode zstd gzip
    import hsts
    reverse_proxy element-web:8080
}

# ============================================================================
# MIGRATED: the five pre-existing dev-aquafire services, previously behind
# nginx-proxy (aqua_proxy) + acme-companion (aqua_acme).
#
# Every upstream below is VERIFIED against the live generated nginx conf on
# 2026-07-30 (see the file header for the IP -> container mapping). All five
# containers sit on `proxy_net`, which is the only network this Caddy joins.
#
# Carried-over nginx behavior: `import hsts` (add_header Strict-Transport-
# Security max-age=31536000) and `import legacy_body_limit` (client_max_body_
# size 200m). WebSockets, HTTP/2 and HTTP/3 need no directives — they are
# Caddy defaults (nginx needed explicit `http2 on` / `listen 443 quic` /
# Upgrade-header plumbing). No per-vhost nginx snippets existed to port:
# /etc/nginx/vhost.d/ was empty.
# ============================================================================

# UI. NOTE: same container as aquafier-api below, DIFFERENT port (3600 vs 3000).
aquafier.inblock.io {
    encode zstd gzip
    import hsts
    import legacy_body_limit
    reverse_proxy deployment-aqua-container-1:3600
}

# API. NOTE: same container as aquafier above, DIFFERENT port (3000 vs 3600).
aquafier-api.inblock.io {
    encode zstd gzip
    import hsts
    import legacy_body_limit
    reverse_proxy deployment-aqua-container-1:3000
}

dev.aqua-node.inblock.io {
    encode zstd gzip
    import hsts
    import legacy_body_limit
    reverse_proxy aqua-explorer:80
}

dev.aquafire.inblock.io {
    encode zstd gzip
    import hsts
    import legacy_body_limit
    reverse_proxy aquafier-rs:3000
}

draw.inblock.io {
    encode zstd gzip
    import hsts
    import legacy_body_limit
    reverse_proxy excalidraw:80
}
