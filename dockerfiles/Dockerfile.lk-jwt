# lk-jwt-service with the vendored patches in patches/lk-jwt/ (registry:
# patches/lk-jwt/README.md). The upstream source is fetched at a pinned commit,
# each patch is applied with `git apply` (no --3way, no fuzz), so a patch that
# stops applying fails the build instead of shipping silently. The build and
# runtime stages follow upstream's own Dockerfile at the same commit.
#
# Published by the build-and-push matrix of .github/workflows/docker.yml as
# ghcr.io/inblockio/siwx-oidc-matrix-server/lk-jwt-service (issue #40), so a
# patch that stops applying fails CI, not only a local build.
FROM docker.io/library/rust:1.95-alpine@sha256:e98196986adced5602f6e21c54babdbf2a8700400c7a78868324a3630e0c5d15 AS builder

ARG LK_JWT_TAG=v0.8.0
ARG LK_JWT_COMMIT=32522b7da1889a3dafefeb1c527e86b76f19d2c3

# git for the fetch and the apply; musl-dev, cmake, make, gcc, g++, perl and
# linux-headers for the vendored aws-lc-sys and ring C code (as upstream).
RUN apk add --no-cache git musl-dev cmake make gcc g++ perl linux-headers ca-certificates

WORKDIR /proj
# Fetch by commit, then prove the tag still names it, so a moved tag fails.
RUN git init -q . \
    && git fetch -q --depth 1 https://github.com/element-hq/lk-jwt-service "refs/tags/${LK_JWT_TAG}" \
    && test "$(git rev-parse FETCH_HEAD^{commit})" = "${LK_JWT_COMMIT}" \
    && git checkout -q "${LK_JWT_COMMIT}"

COPY patches/lk-jwt/require-membership.patch /tmp/lkjwt-membership.patch
RUN git apply --verbose /tmp/lkjwt-membership.patch

RUN cargo build -p lk-jwt-service --release --locked \
    && cp target/release/lk-jwt-service /lk-jwt-service \
    && cp target/release/healthcheck /lk-jwt-service-healthcheck

FROM scratch

COPY --from=builder /lk-jwt-service /lk-jwt-service
COPY --from=builder /lk-jwt-service-healthcheck /lk-jwt-service-healthcheck
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# Like the other images of this repository, it carries our LICENSE and NOTICE
# (NOTICE states the patch's licence), plus upstream's AGPL text.
COPY --chmod=0644 LICENSE NOTICE /usr/share/licenses/siwx-oidc-matrix-server/
COPY --from=builder /proj/LICENSE /usr/share/licenses/lk-jwt-service/LICENSE

# Non-root, numeric (a scratch image has no /etc/passwd to resolve a name in).
# 65532 is the conventional "nonroot" id of distroless images. The service only
# listens on :8080 and reads its registration file read-only, so it needs no
# write access anywhere and no capability to bind a port above 1023.
USER 65532:65532

EXPOSE 8080

CMD [ "/lk-jwt-service" ]
HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD ["/lk-jwt-service-healthcheck"]
