# Builds Element Web from source at a pinned tag, applies every patch in
# patches/element-web/ (listed, in apply order, in its README.md), and serves
# the result with the inblock.io overlay (config, theme, favicons).
#
# Why from source: the prebuilt vectorim/element-web image cannot carry source
# patches, such as force-first-device-recovery's change to MatrixChat.tsx that
# makes a recoverable identity (4S recovery key) mandatory on first login.
# See docs/element-web-source-build.md.

# ---------------------------------------------------------------------------
# Deps, then (patch-tests | builder): clone element-web at the pinned tag, apply
# our patches and install (stage `deps`), then build the webapp (stage `builder`).
# Stage `patch-tests` also starts from `deps`; see it below.
# Node >= 22.18 required by upstream; node:24-bullseye matches their builder.
# TODO(bookworm): Debian bullseye left LTS on 2026-08-31.
#
# Every input here is pinned by name AND content: both base images by version
# tag plus multi-arch index digest, the upstream source by tag plus the commit
# the tag must resolve to. A tag re-pushed or moved upstream then fails the
# build instead of changing what we ship. A bump changes both halves
# (index digest: `skopeo inspect --raw docker://<image>:<tag> | sha256sum`;
# commit: `git ls-remote <repo> 'refs/tags/<tag>^{}'`).
# ---------------------------------------------------------------------------
FROM node:24.20.0-bullseye@sha256:25f3016fcdae6b5d65bd9bcb4064b7e4198ec8d49493fa40d73f9b463d04fb15 AS deps

ARG ELEMENT_WEB_TAG=v1.12.29
ARG ELEMENT_WEB_COMMIT=2d90d6b7b601ecb9ccdf81239a43b4396b4b0c9e

WORKDIR /src

# Shallow clone of the pinned tag. Keep .git: the build/version scripts run
# `git describe` to stamp the version, and the lockfile install is reproducible.
RUN git clone --depth 1 --branch "${ELEMENT_WEB_TAG}" \
      https://github.com/element-hq/element-web.git /src \
    && actual="$(git -C /src rev-parse HEAD)" \
    && if [ "$actual" != "${ELEMENT_WEB_COMMIT}" ]; then \
         echo "FATAL: ${ELEMENT_WEB_TAG} resolves to $actual, expected ELEMENT_WEB_COMMIT=${ELEMENT_WEB_COMMIT}. Bump both together, or find out why upstream moved the tag." >&2; \
         exit 1; \
       fi

# Apply our vendored patches. Fail the build loudly if any does not apply
# cleanly, so a tag bump that breaks one is caught here, not at runtime. They are
# separate files, and applied separately, so the failure names the guilty patch.
#
#  - force-first-device-recovery: OUR policy (a recovery key is mandatory).
#  - setup-encryption-busy-wedge:  an UPSTREAM Element 1.12.20 defect, carried
#    here only until it is fixed upstream. Drop this one on a tag bump that
#    already contains the fix rather than forward-porting it by reflex.
#  - honest-qr-disabled-reason:    UPSTREAM honesty defect. "Show QR code" blames
#    the account provider for a block that is actually this session's own crypto
#    state. Ours does support MSC4108 device link, so the message is simply false.
#  - offer-verify-current-session: UPSTREAM dead end. An unverified session was
#    shown a card that offered no action and no reason, leaving the DESTRUCTIVE
#    identity reset as the only visible exit.
#  - browser-eventindex:           UPSTREAM-TRACKED (element-web PR #34718).
#    Implements the stock EventIndex hook so E2EE search works in hosted
#    Element Web, behind the labs flag feature_web_event_index (default OFF).
#
# Order is load-bearing: eight of the eleven patches touch en_EN.json in different
# places (entries 1, 3-8 and 11), entry 8 builds on 7 and entry 10 on 9. Applied in
# this order every hunk lands (verified against a pristine v1.12.26 tree,
# 2026-08-30, and a pristine v1.12.29 tree, 2026-10-02).
# Registry with why/evidence/retirement per patch:
# patches/element-web/README.md — no patch ships without an entry there.
COPY patches/element-web/force-first-device-recovery.patch /tmp/ew.patch
RUN git apply --verbose /tmp/ew.patch
COPY patches/element-web/setup-encryption-busy-wedge.patch /tmp/ew-busy.patch
RUN git apply --verbose /tmp/ew-busy.patch
COPY patches/element-web/honest-qr-disabled-reason.patch /tmp/ew-qr-reason.patch
RUN git apply --verbose /tmp/ew-qr-reason.patch
COPY patches/element-web/offer-verify-current-session.patch /tmp/ew-verify-offer.patch
RUN git apply --verbose /tmp/ew-verify-offer.patch

# QR-link check-code UX (2026-08-01): auto-approve once both MSC4108 check-code
# digits are typed (the deliberate read+type is the security property, the extra
# Continue click is not) and blur the input so no caret is left blinking after
# the second digit. Same fail-loudly contract as the patch above.
COPY patches/element-web/auto-approve-check-code.patch /tmp/ew-checkcode.patch
RUN git apply --verbose /tmp/ew-checkcode.patch

# Encrypted-room search for hosted Element Web. Implements BaseEventIndexManager
# so supportsEventIndexing() is true. Gated by the ordinary labs flag
# feature_web_event_index, which DEFAULTS TO OFF: set
# features.feature_web_event_index = true in config.json to turn it on for a
# deployment, or a user turns it on for one device under Labs. The old
# feature_inblock_encrypted_search key and the STAGING_HOSTS hostname fallback
# are gone (regenerated against upstream PR #34718, 2026-09-12). The repo
# config carries the new key; prod's bind-mounted config must be renamed too.
#
# Since 2026-09-13 this patch carries increments that are AHEAD of PR #34718
# (a maintainer decision). As of 2026-09-14 there are FIVE: A, the non-blocking
# initEventIndex, so a large index cannot block app start; B, batched writes /
# O(1) getStats / sorted vocabulary / folded-text memo; C, the crawl window and
# room cap (a shouldCrawl hook in the SHARED indexing/EventIndex.ts), the
# resident and disk byte budgets, the encrypted recency manifest with its
# self-healing migration pass, and navigator.storage.persist(); D-core, the
# chunked schema v3 (binary AES-GCM chunks, event ids out of the clear) whose
# v2 databases are RESET once rather than converted; and E, the cold-tier
# streamed scan that finds on-disk content outside the resident window, plus the
# Firefox/Safari desktop-tier fix (with E-core's review cleanup since
# 2026-10-05, and the fifth carry's edit and redaction fixes of the cold tier
# since 2026-10-08). It is therefore regenerated from the provenance commit
# dd3b84ddea on inblockio/element-web branch
# integration/web-event-index-prod-20261008, NOT from the PR head. Do not
# "resync to the PR" without reading entry 6 -- that would silently revert all
# five, and the fifth carry's fixes, on prod.
#
# Touches Settings.tsx, en_EN.json, docs/labs.md, SearchWarning.tsx,
# BaseEventIndexManager.ts, indexing/EventIndex.ts and their tests as well as the
# new files, so it is neither independent of the en_EN.json ordering above nor
# confined to files only this feature owns. indexing/EventIndex.ts in particular
# drifts between tags and upstream develop (v1.12.29 now carries develop's two
# awaited addRoomCheckpoint calls), so a tag bump must re-check that the only
# delta in that file is our shouldCrawl work -- entry 6 says what to look for.
# See patches/element-web/README.md, entry 6.
COPY patches/element-web/browser-eventindex.patch /tmp/ew-eventindex.patch
RUN git apply --verbose /tmp/ew-eventindex.patch

# Show the provider-attested DID (io.inblock.did) wherever Element shows an
# identity: under the MXID in the member info panel, and under the Matrix ID in
# All settings -> Account, both with Element's own copy affordance. Applied
# SEVENTH because it also touches en_EN.json and its context was generated
# against the tree with the six above already applied — move it earlier and the
# i18n hunk stops landing. (It is no longer last: resolve-did-search follows it
# and depends on it.) Same fail-loudly contract: `git apply` without --3way, so
# a patch that no longer
# applies fails the image build instead of silently dropping the feature.
COPY patches/element-web/show-attested-did.patch /tmp/ew-attested-did.patch
RUN git apply --verbose /tmp/ew-attested-did.patch

# Resolve a DID typed into either search box (Spotlight and the invite/DM
# dialog) to the MXID it was derived from. A DID can never BE a user ID —
# Synapse's localpart grammar has no colon and no uppercase — so without this
# there is no way to look somebody up by their key at all: the user directory
# indexes only display name and user ID, never profile fields.
#
# Applied AFTER show-attested-did and DEPENDS ON IT: it moves the shared
# DID_PROFILE_FIELD constant into the new pure module and leaves that patch's
# hook re-exporting it. Reordering these two, or dropping entry 7 alone, breaks
# the build. It also adds the three DID-verification marker strings to
# en_EN.json next to entry 7's, so its i18n hunk depends on that order too.
# Same fail-loudly contract as every patch above.
COPY patches/element-web/resolve-did-search.patch /tmp/ew-did-search.patch
RUN git apply --verbose /tmp/ew-did-search.patch

# Service worker: never cache a failed /_matrix/client/versions probe
# (2026-09-28 media-404 RCA). Stock sw.js parses the /versions body without a
# status check, so a 401 for an expired access token (read from IndexedDB
# before the app's first 401-triggered refresh; our OIDC tokens live 300 s)
# was cached as "no authenticated media" for 2 h, and every media request of
# that SW instance went to the legacy endpoints, which our Synapse 404s. The
# patch retries /versions without the token, never caches a non-ok or
# malformed answer, and shares one in-flight probe between concurrent media
# requests. UPSTREAM DEFECT; the patch is byte-for-byte the upstream PR diff
# (inblockio/element-web branch fix/sw-versions-not-cached-on-error). Touches
# only apps/web/src/serviceworker/, so its position after 1-8 is free.
# See patches/element-web/README.md, entry 9.
COPY patches/element-web/sw-versions-no-cache-on-error.patch /tmp/ew-sw-versions.patch
RUN git apply --verbose /tmp/ew-sw-versions.patch

# Service worker: a media request that 401s with the stored access token waits
# (wall-clock bound 5 s, one shared waiter per rejected token) for the app to
# store a refreshed token and retries once, so the image fetched inside the
# stale-token window is not left blank. UPSTREAM DEFECT, not filed. Context
# depends on entry 9: apply it AFTER sw-versions-no-cache-on-error. Its 5 s
# bound is coupled to guard (E)'s 8 s canary timer in config/element-sw-boot.js
# (a probe that 401s must still settle before the canary calls the SW wedged).
# See patches/element-web/README.md, entry 10.
COPY patches/element-web/sw-media-401-token-retry.patch /tmp/ew-sw-media-retry.patch
RUN git apply --verbose /tmp/ew-sw-media-retry.patch

# Entry 11: Copy Markdown (siwx-oidc-matrix-server#24). Adds the right-click
# "Copy Markdown" entry above Pin and the HTML-to-Markdown converter it calls
# (utils/eventToMarkdown.ts). Touches en_EN.json, so it is applied last.
# Same fail-loudly contract as every patch above.
COPY patches/element-web/copy-markdown.patch /tmp/ew-copy-markdown.patch
RUN git apply --verbose /tmp/ew-copy-markdown.patch

# Install exactly what the lockfile pins.
RUN corepack enable && pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# patch-tests: runs the unit tests our patches carry on the tree above (tag +
# every patch + lockfile install), derived from the patches by
# scripts/element-patch-tests.sh. Never part of the image: nothing COPYs from
# this stage, so a plain build does not build it, and the final image is
# byte-for-byte what it was when this was one stage. Run it with
#   docker build --progress=plain --target patch-tests -f dockerfiles/Dockerfile.element .
# (.github/workflows/checks.yml does, on every pull request). The script and the
# patches arrive as read-only bind mounts, so they add no layer. Chromium is for
# the one patch-carried suite that needs a real browser (entry 11's conformance
# vectors; happy-dom's HTML parser is not conforming).
# ---------------------------------------------------------------------------
FROM deps AS patch-tests
ENV CI=true
# Debian 11 is past LTS: deb.debian.org still lists bullseye-security but no longer
# serves its files (404), so Chromium's system libraries come from
# archive.debian.org, where EOL releases live (its Release files have expired,
# hence Check-Valid-Until). One more thing the TODO(bookworm) above has to carry.
RUN sed -i '/bullseye-updates/d; s|http://deb.debian.org|http://archive.debian.org|' /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99archive \
    && apt-get update \
    && (cd apps/web && pnpm exec playwright install --with-deps chromium) \
    && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,source=patches/element-web,target=/patches,readonly \
    --mount=type=bind,source=scripts/element-patch-tests.sh,target=/usr/local/bin/element-patch-tests.sh,readonly \
    bash /usr/local/bin/element-patch-tests.sh /src --patches-dir /patches

# ---------------------------------------------------------------------------
# builder: the production bundle, from the same `deps` state.
# ---------------------------------------------------------------------------
FROM deps AS builder

# Build the web app. The nx target for the element-web app produces the full
# bundle at apps/web/webapp/ (index.html, bundles, vector-icons/, themes, i18n,
# config.sample.json). 6 GiB heap headroom for the bundler.
ENV NODE_OPTIONS=--max-old-space-size=6144
RUN pnpm --filter element-web build

# Provide a default config.json in the bundle (upstream ships none). Our runtime
# overlay overwrites /app/config.json, but this keeps the bundle self-consistent
# and the /config.json healthcheck path populated if the overlay is ever absent.
RUN cp /src/apps/web/config.sample.json /src/apps/web/webapp/config.json

# Fail loudly if the built webapp lost a vendored patch. patches/element-web/
# markers.tsv lists, per registry entry, fixed strings that are present in a build
# carrying the entry and absent from stock upstream (the proof is the "Marker
# discrimination record" in the registry); every row must hold in the webapp as
# built. scripts/element-patch-markers.sh runs the same rows against a served
# deployment. A row's path is relative to the webapp: `bundles/*/<file>` globs the
# bundle hash, and `i18n/<name>.json` resolves through i18n/languages.json to the
# hashed file name. A row whose file is missing counts as a missing marker.
RUN --mount=type=bind,source=patches/element-web/markers.tsv,target=/tmp/markers.tsv \
    cd /src/apps/web/webapp \
    && tab="$(printf '\t')" && rows=0 && bad=0 \
    && while IFS="$tab" read -r entry path str; do \
         case "$entry" in ''|'#'*) continue ;; esac; \
         rows=$((rows + 1)); \
         case "$path" in \
           i18n/*.json) name="${path#i18n/}"; name="${name%.json}"; \
             files="i18n/$(grep -oE "\"${name}\.[0-9a-f]+\.json\"" i18n/languages.json | head -n 1 | tr -d '"')" ;; \
           *) files="$path" ;; \
         esac; \
         found=0; \
         for f in $files; do if [ -f "$f" ] && grep -qF -- "$str" "$f"; then found=1; fi; done; \
         if [ "$found" -eq 0 ]; then echo "FATAL: entry $entry: '$str' not found in $path" >&2; bad=$((bad + 1)); fi; \
       done < /tmp/markers.tsv \
    && [ "$rows" -gt 0 ] && [ "$bad" -eq 0 ] \
    && echo "markers.tsv: $rows rows present in the built webapp"

# Not a patch marker but a precondition of a runtime delta: the bundle must still
# expose window.mxMatrixClientPeg, which sw-boot.js guard (E) polls for the SYNCING
# gate. Without that global the gate would silently wait out its 120 s deadline on
# every load instead of gating anything.
RUN grep -rqF 'mxMatrixClientPeg' /src/apps/web/webapp/bundles/

# ---------------------------------------------------------------------------
# License texts for the Alpine packages of the nginx-unprivileged base below
# (Alpine 3.24.2), busybox's GPL-2.0-only among them. Canonical texts from SPDX
# license-list-data v3.29.0, each checked against its SHA-256 as it is
# downloaded. The set is not chosen here: dockerfiles/check-alpine-licenses.sh,
# run at the end of the final stage, fails the build when an installed package
# declares a license with no text below, when a text below is declared by no
# package, or when NOTICE does not name the Alpine release. So a base bump that
# changes the licenses stops the build until this list (and NOTICE) follows.
# This list is the L: lines of /lib/apk/db/installed in the pinned base.
# A remote ADD gets mode 0600, hence --chmod.
# ---------------------------------------------------------------------------
FROM scratch AS alpine_licenses
ARG SPDX_TEXT=https://raw.githubusercontent.com/spdx/license-list-data/v3.29.0/text
ADD --chmod=0644 --checksum=sha256:074e6e32c86a4c0ef8b3ed25b721ca23aca83df277cd88106ef7177c354615ff ${SPDX_TEXT}/Apache-2.0.txt /alpine/Apache-2.0.txt
ADD --chmod=0644 --checksum=sha256:f32fb3b417a194167cfad068223fc975ba96c5960513a10f66a3c28720aec1df ${SPDX_TEXT}/BSD-2-Clause.txt /alpine/BSD-2-Clause.txt
ADD --chmod=0644 --checksum=sha256:5a93d5831e1297ab10fe643e1a631e83be392896da14ee2951285a79012df69d ${SPDX_TEXT}/BSD-3-Clause.txt /alpine/BSD-3-Clause.txt
ADD --chmod=0644 --checksum=sha256:aaf135472f81c5b4a0dca9367e5bb5e9750032b5bebe5442b36e4c0a47430df3 ${SPDX_TEXT}/GPL-2.0-only.txt /alpine/GPL-2.0-only.txt
ADD --chmod=0644 --checksum=sha256:aaf135472f81c5b4a0dca9367e5bb5e9750032b5bebe5442b36e4c0a47430df3 ${SPDX_TEXT}/GPL-2.0-or-later.txt /alpine/GPL-2.0-or-later.txt
ADD --chmod=0644 --checksum=sha256:fb981668c18a279e285fc4d83fba1e836cc84dd4daa73c9697d3cfd2d8aca6e0 ${SPDX_TEXT}/GPL-3.0-or-later.txt /alpine/GPL-3.0-or-later.txt
ADD --chmod=0644 --checksum=sha256:5749785c8bdefafcb5d798270ed0a967036fe2ca63dcedade1627565dfef81d2 ${SPDX_TEXT}/LGPL-2.1-or-later.txt /alpine/LGPL-2.1-or-later.txt
ADD --chmod=0644 --checksum=sha256:b05785f9f18e6716bab63424b11454513b9943a222595b70411009202fc592b5 ${SPDX_TEXT}/MIT.txt /alpine/MIT.txt
ADD --chmod=0644 --checksum=sha256:66a3107d5ad6a058aab753eaac2047ccb2ed0e39465dd0fe5844da3e300d5172 ${SPDX_TEXT}/MPL-2.0.txt /alpine/MPL-2.0.txt
ADD --chmod=0644 --checksum=sha256:bfb1112d49db5b1daecdfef24bd7e2f3ea0bafb33aa67aa0ab51e2bf8407c03d ${SPDX_TEXT}/Zlib.txt /alpine/Zlib.txt

# ---------------------------------------------------------------------------
# Runtime: unprivileged nginx (same base family as vectorim/element-web), with
# the inblock.io overlay applied exactly as the previous config-only image did.
# nginx-unprivileged serves on 8080 as the `nginx` user. Pinned like the
# builder (version tag plus index digest; was the moving `alpine-slim`, which
# resolved to this same 1.31.6 mainline build when it was pinned).
# ---------------------------------------------------------------------------
FROM nginxinc/nginx-unprivileged:1.31.6-alpine-slim@sha256:c81a27f28bc2d9c2da8998444e653c7b85b9bbbaa92e44ef18d8920784e06507

USER root

# Source-built web app bundle.
COPY --from=builder /src/apps/web/webapp /app

# Serve the unhashed files that name content-hashed ones (index.html,
# i18n/languages.json) with no-cache, so browsers always revalidate them and
# load the current bundles instead of hitting the stale-bundle TDZ crash
# ("Your Element is misconfigured"). Replaces the stock nginx-unprivileged
# conf.d/default.conf and changes zero bundle bytes; config/element-nginx.conf
# gives every location's Cache-Control and its reason.
COPY config/element-nginx.conf /etc/nginx/conf.d/default.conf

# Security-headers include. Must land in conf.d/
# with a NON-.conf suffix: the base image's nginx.conf auto-includes
# conf.d/*.conf at the http level (`include /etc/nginx/conf.d/*.conf;`), so a
# .conf name would get this file loaded TWICE — once automatically at http
# level, and again via our own explicit
# `include /etc/nginx/conf.d/element-security-headers.inc;` inside
# config/element-nginx.conf's server/location blocks (needed there per-location
# because add_header does not inherit into a location that sets its own
# add_header — see the inheritance comment in element-nginx.conf). The .inc
# suffix keeps this file include-only: nginx never auto-loads it, so the
# explicit include is the ONLY place it is pulled in.
COPY config/element-nginx-security-headers.inc /etc/nginx/conf.d/element-security-headers.inc

# inblock.io overlay (identical to the previous Dockerfile.element).
COPY config/element-config.json /app/config.json
COPY config/element-theme-overrides.css /app/element-theme-overrides.css
COPY config/inblockio_logo_dark.png /app/inblockio_logo_dark.png
COPY config/element-welcome-background.svg /app/welcome-background.svg
COPY config/favicon.ico /app/favicon.ico
COPY config/favicon-24.png /app/favicon-24.png
COPY config/favicon-120.png /app/favicon-120.png
COPY config/favicon-144.png /app/favicon-144.png
COPY config/favicon-152.png /app/favicon-152.png
COPY config/favicon-180.png /app/favicon-180.png
COPY config/favicon-512.png /app/favicon-512.png
COPY config/favicon-1024.png /app/favicon-1024.png
COPY entrypoints/element_entrypoint.sh /docker-entrypoint.sh

# LICENSE and NOTICE travel with the image. It redistributes this repository's
# files (Apache-2.0 §4(a) and (d)); NOTICE states the license of the patches
# built into the bundle, and it carries the BSD notice that the nginx skeleton
# in config/element-nginx.conf requires in a binary distribution.
COPY --chmod=0644 LICENSE NOTICE /usr/share/licenses/siwx-oidc-matrix-server/
# Element Web's own license texts, from the upstream checkout the bundle was
# built from. The bundle is sent to every browser that loads it, so it is
# conveyed, and its license travels with it.
COPY --chmod=0644 --from=builder /src/LICENSE-AGPL-3.0 /src/LICENSE-GPL-3.0 /usr/share/licenses/element-web/
# The base image's Alpine packages carry their own licenses (stage
# alpine_licenses); the check keeps texts, packages and NOTICE in step.
COPY --from=alpine_licenses /alpine/ /usr/share/licenses/alpine/
RUN --mount=type=bind,source=dockerfiles/check-alpine-licenses.sh,target=/tmp/check-alpine-licenses.sh \
    sh /tmp/check-alpine-licenses.sh

# Service-worker media-auth boot shim (2026-07-31 download RCA). Must be a
# separate same-origin file: index.html ships a CSP with script-src 'self' and
# no 'unsafe-inline', so an inline script would be blocked. Injected into
# <head> so its listener registers before any app bundle executes (bundles
# load at the end of body). The grep fails the build loudly if the upstream
# index.html shape ever stops matching the sed anchor.
COPY config/element-sw-boot.js /app/sw-boot.js
RUN sed -i 's|<head>|<head><script src="sw-boot.js"></script>|' /app/index.html \
    && grep -q '<head><script src="sw-boot.js"></script>' /app/index.html

# Per-build sw.js identity stamp (2026-07-31 wedged-SW incident). Browsers only
# replace an installed service worker when sw.js's BYTES change; our source
# builds produce byte-identical sw.js across deploys (verified: prod and dev
# sw.js shared one sha1), so a wedged registration — respondWith() that never
# settles, silently hanging every media fetch forever — survives every deploy
# with no user-visible error. Upstream's sw.js calls skipWaiting() on the
# install event and clients.claim() on the activate event, so a byte change
# alone evicts a wedged instance on the user's next navigation with zero user
# action. This re-lands the concept from b781b89 that 9f67ed9 reverted as
# "dead weight" — the incident proved it load-bearing. Stamp combines the
# index.html bundle hash with a build-UTC timestamp so even two builds with
# identical bundles still differ. Locally, with a warm Docker layer cache, a
# fully-unchanged build reuses this cached layer (and therefore the image
# digest) unchanged, which is not a new deploy, so no stamp change happens
# there. CI (.github/workflows/docker.yml) configures no cache-from/cache-to,
# so every CI build starts cold and stamps a fresh timestamp — and therefore
# a fresh digest — on every run regardless of whether the tree changed; that
# is expected and harmless, since a fresh sw.js still evicts any wedged
# instance, it just also does so on an unchanged rebuild. The `test -s` guard
# makes a missing /app/sw.js (upstream ever stops shipping one) fail the
# build loudly here rather than silently produce a stamp-only file. sw.js is
# served with Cache-Control public, max-age=14400, must-revalidate
# (config/element-nginx.conf), but browsers bypass the HTTP cache for SW
# update checks by default (updateViaCache "imports"), so the stamp still
# reaches clients on their next navigation regardless of that max-age.
RUN test -s /app/sw.js && printf '\n// build: %s %s\n' "$(sha1sum /app/index.html | cut -c1-20)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> /app/sw.js

# nginx-unprivileged's default server serves /usr/share/nginx/html. Point that
# at /app via a symlink (same as upstream element-web's app Dockerfile) so the
# source-built bundle is served without touching the nginx config, and the
# entrypoint can keep writing to /app.
RUN rm -rf /usr/share/nginx/html && ln -s /app /usr/share/nginx/html

# The entrypoint mutates /app/index.html and /app/config.json at runtime
# (sed -i) and serves as the `nginx` user, so /app must be writable+readable by
# that user. Make the entrypoint executable and grant nginx ownership of /app.
RUN chmod +x /docker-entrypoint.sh && chown -R nginx:nginx /app

ENTRYPOINT ["/docker-entrypoint.sh"]

# Harmless content marker: proved that the `dev` branch CI trigger produced a
# genuinely new, distinct :dev image (not a coalesced/reused build from a
# simultaneous `main` push). The `dev` branch was folded into `main` on
# 2026-09-01; the labels have been inert since.
LABEL io.inblock.dev-branch-ci-test="2026-07-31"
LABEL io.inblock.dev-branch-ci-test-s5-live-check="2026-07-31T00:48Z"
