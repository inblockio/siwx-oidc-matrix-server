 func (r *RoomManager) getIceConfig(roomName livekit.RoomName, participant types.LocalParticipant) *livekit.ICEConfig {
+	// A relay-policy client starts where upstream ends after ICE failures:
+	// TURN/TLS only, forced relay (see relaypolicy.go).
+	if name, ok := r.relayPolicy.Match(participant.GetClientInfo().GetAddress()); ok {
+		participant.GetLogger().Infow("relay policy matched", "policy", name)
+		return &livekit.ICEConfig{
+			PreferenceSubscriber: livekit.ICECandidateType_ICT_TLS,
+			PreferencePublisher:  livekit.ICECandidateType_ICT_TLS,
+		}
+	}
 	return r.iceConfigCache.Get(iceConfigCacheKey{roomName, participant.Identity()})
 }
 
