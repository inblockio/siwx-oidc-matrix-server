+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package service
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/logger"
+
+	"github.com/livekit/livekit-server/pkg/config"
+	"github.com/livekit/livekit-server/pkg/rtc/types/typesfakes"
+	sutils "github.com/livekit/livekit-server/pkg/utils"
+)
+
+const testRelayPolicy = `name: test-carriers
+description: test
+asns: [64500]
+manual_prefixes:
+  - 2001:db8:1::/48
+prefixes:
+  - 192.0.2.0/24
+  - 198.51.100.0/25
+`
+
+func writeRelayPolicyFile(t *testing.T, dir, file, content string) {
+	t.Helper()
+	require.NoError(t, os.WriteFile(filepath.Join(dir, file), []byte(content), 0o644))
+}
+
+type relayPolicyClock struct{ t time.Time }
+
+func (c *relayPolicyClock) now() time.Time { return c.t }
+
+func newTestRelayPolicy(t *testing.T, files map[string]string) (*RelayPolicy, string, *relayPolicyClock) {
+	t.Helper()
+	dir := t.TempDir()
+	for file, content := range files {
+		writeRelayPolicyFile(t, dir, file, content)
+	}
+	clock := &relayPolicyClock{t: time.Unix(1_700_000_000, 0)}
+	p, err := newRelayPolicy(dir, clock.now)
+	require.NoError(t, err)
+	return p, dir, clock
+}
+
+func TestRelayPolicyMatch(t *testing.T) {
+	p, _, _ := newTestRelayPolicy(t, map[string]string{"test.yaml": testRelayPolicy})
+
+	for _, tc := range []struct {
+		addr  string
+		match bool
+	}{
+		{"192.0.2.17", true},
+		{"198.51.100.127", true},
+		{"198.51.100.128", false},
+		{"2001:db8:1::5", true},
+		{"2001:db8:2::5", false},
+		{"::ffff:192.0.2.17", true},
+		{"fe80::1%eth0", false},
+		{"192.0.2.17, 10.0.0.1", true},
+		{"10.0.0.1, 192.0.2.17", false},
+		{"192.0.2.17:4433", true},
+		{"[2001:db8:1::5]:4433", true},
+		{"203.0.113.1", false},
+		{"", false},
+		{"not-an-ip", false},
+	} {
+		name, ok := p.Match(tc.addr)
+		require.Equal(t, tc.match, ok, tc.addr)
+		if tc.match {
+			require.Equal(t, "test-carriers", name, tc.addr)
+		}
+	}
+}
+
+func TestRelayPolicyNilMatchesNothing(t *testing.T) {
+	var p *RelayPolicy
+	_, ok := p.Match("192.0.2.17")
+	require.False(t, ok)
+}
+
+func TestRelayPolicyFromEnv(t *testing.T) {
+	t.Setenv(relayPolicyDirEnv, "")
+	p, err := NewRelayPolicyFromEnv()
+	require.NoError(t, err)
+	require.Nil(t, p)
+
+	dir := t.TempDir()
+	writeRelayPolicyFile(t, dir, "test.yaml", testRelayPolicy)
+	t.Setenv(relayPolicyDirEnv, dir)
+	p, err = NewRelayPolicyFromEnv()
+	require.NoError(t, err)
+	_, ok := p.Match("192.0.2.1")
+	require.True(t, ok)
+}
+
+func TestRelayPolicyNeedsTURNTLS(t *testing.T) {
+	dir := t.TempDir()
+	writeRelayPolicyFile(t, dir, "test.yaml", testRelayPolicy)
+	t.Setenv(relayPolicyDirEnv, dir)
+
+	turnTLS := func() *config.Config {
+		c := &config.Config{}
+		c.TURN.Enabled = true
+		c.TURN.Domain = "turn.example.org"
+		c.TURN.TLSPort = 5349
+		return c
+	}
+	p, err := newRelayPolicyForConfig(turnTLS())
+	require.NoError(t, err)
+	require.NotNil(t, p)
+
+	for name, change := range map[string]func(c *config.Config){
+		"turn off":   func(c *config.Config) { c.TURN.Enabled = false },
+		"no tls leg": func(c *config.Config) { c.TURN.TLSPort = 0 },
+		"no domain":  func(c *config.Config) { c.TURN.Domain = "" },
+	} {
+		c := turnTLS()
+		change(c)
+		p, err := newRelayPolicyForConfig(c)
+		require.NoError(t, err, name)
+		require.Nil(t, p, name)
+	}
+
+	// A broken policy is still a startup error, whatever the TURN config.
+	writeRelayPolicyFile(t, dir, "test.yaml", "name: [\n")
+	_, err = newRelayPolicyForConfig(&config.Config{})
+	require.Error(t, err)
+}
+
+func TestRelayPolicyStartupErrors(t *testing.T) {
+	for name, files := range map[string]map[string]string{
+		"invalid prefix": {"a.yaml": "name: a\nprefixes: [192.0.2.0/33]\n"},
+		"missing name":   {"a.yaml": "prefixes: [192.0.2.0/24]\n"},
+		"unknown field":  {"a.yaml": "name: a\nprefix: [192.0.2.0/24]\n"},
+		"duplicate name": {"a.yaml": "name: a\n", "b.yaml": "name: a\n"},
+		"not yaml":       {"a.yaml": "name: [\n"},
+	} {
+		dir := t.TempDir()
+		for file, content := range files {
+			writeRelayPolicyFile(t, dir, file, content)
+		}
+		_, err := NewRelayPolicy(dir)
+		require.Error(t, err, name)
+	}
+
+	_, err := NewRelayPolicy(filepath.Join(t.TempDir(), "missing"))
+	require.Error(t, err, "missing directory")
+}
+
+func TestRelayPolicyEmptyDirMatchesNothing(t *testing.T) {
+	p, _, _ := newTestRelayPolicy(t, nil)
+	_, ok := p.Match("192.0.2.17")
+	require.False(t, ok)
+}
+
+func TestRelayPolicyReload(t *testing.T) {
+	p, dir, clock := newTestRelayPolicy(t, map[string]string{"test.yaml": testRelayPolicy})
+
+	// A new file is picked up, but only after the recheck interval.
+	writeRelayPolicyFile(t, dir, "other.yaml", "name: other\nprefixes: [203.0.113.0/24]\n")
+	_, ok := p.Match("203.0.113.1")
+	require.False(t, ok)
+	clock.t = clock.t.Add(relayPolicyRecheckInterval)
+	name, ok := p.Match("203.0.113.1")
+	require.True(t, ok)
+	require.Equal(t, "other", name)
+
+	// A changed file is picked up.
+	writeRelayPolicyFile(t, dir, "other.yaml", "name: other\nprefixes: [203.0.113.0/25]\n")
+	clock.t = clock.t.Add(relayPolicyRecheckInterval)
+	_, ok = p.Match("203.0.113.200")
+	require.False(t, ok)
+
+	// A broken file keeps the previous policy.
+	writeRelayPolicyFile(t, dir, "other.yaml", "name: other\nprefixes: [nonsense]\n")
+	clock.t = clock.t.Add(relayPolicyRecheckInterval)
+	_, ok = p.Match("203.0.113.1")
+	require.True(t, ok)
+	_, ok = p.Match("192.0.2.1")
+	require.True(t, ok)
+
+	// A fixed file is picked up again.
+	writeRelayPolicyFile(t, dir, "other.yaml", "name: other\nprefixes: [198.18.0.0/15]\n")
+	clock.t = clock.t.Add(relayPolicyRecheckInterval)
+	_, ok = p.Match("198.18.0.1")
+	require.True(t, ok)
+
+	// A removed file is dropped.
+	require.NoError(t, os.Remove(filepath.Join(dir, "other.yaml")))
+	clock.t = clock.t.Add(relayPolicyRecheckInterval)
+	_, ok = p.Match("198.18.0.1")
+	require.False(t, ok)
+}
+
+func TestGetIceConfigRelayPolicy(t *testing.T) {
+	p, _, _ := newTestRelayPolicy(t, map[string]string{"test.yaml": testRelayPolicy})
+	r := &RoomManager{
+		relayPolicy:    p,
+		iceConfigCache: sutils.NewIceConfigCache[iceConfigCacheKey](0),
+	}
+	cached := &livekit.ICEConfig{PreferenceSubscriber: livekit.ICECandidateType_ICT_TCP}
+	r.iceConfigCache.Put(iceConfigCacheKey{"room", "alice"}, cached)
+
+	participant := &typesfakes.FakeLocalParticipant{}
+	participant.IdentityReturns("alice")
+	participant.GetLoggerReturns(logger.GetLogger())
+
+	participant.GetClientInfoReturns(&livekit.ClientInfo{Address: "192.0.2.17"})
+	iceConfig := r.getIceConfig("room", participant)
+	require.Equal(t, livekit.ICECandidateType_ICT_TLS, iceConfig.PreferenceSubscriber)
+	require.Equal(t, livekit.ICECandidateType_ICT_TLS, iceConfig.PreferencePublisher)
+
+	participant.GetClientInfoReturns(&livekit.ClientInfo{Address: "203.0.113.1"})
+	require.Equal(t, livekit.ICECandidateType_ICT_TCP, r.getIceConfig("room", participant).PreferenceSubscriber)
+
+	r.relayPolicy = nil
+	participant.GetClientInfoReturns(&livekit.ClientInfo{Address: "192.0.2.17"})
+	require.Equal(t, livekit.ICECandidateType_ICT_TCP, r.getIceConfig("room", participant).PreferenceSubscriber)
+}
