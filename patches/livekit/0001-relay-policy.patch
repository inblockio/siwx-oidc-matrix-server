+// limitations under the License.
+
+package service
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"net/netip"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/livekit/protocol/logger"
+
+	"github.com/livekit/livekit-server/pkg/config"
+)
+
+// The relay policy makes clients that connect from configured IP ranges use
+// relay-only ICE over TURN/TLS from the first second, instead of only after an
+// ICE failure. It exists for networks that filter UDP media (VoIP blocking).
+// The ranges live in a directory of YAML files, one file per policy:
+//
+//	name: ae-carriers          # required, unique across files
+//	description: ...           # free text
+//	asns: [5384]               # input for the refresh tool, not matched here
+//	manual_prefixes: []        # hand-maintained CIDRs
+//	prefixes: [2.48.0.0/14]    # generated CIDRs
+//
+// Unset LIVEKIT_RELAY_POLICY_DIR means no policy and upstream behaviour.
+const (
+	relayPolicyDirEnv          = "LIVEKIT_RELAY_POLICY_DIR"
+	relayPolicyRecheckInterval = 30 * time.Second
+)
+
+type relayPolicyFile struct {
+	Name           string   `yaml:"name"`
+	Description    string   `yaml:"description"`
+	ASNs           []uint32 `yaml:"asns"`
+	ManualPrefixes []string `yaml:"manual_prefixes"`
+	Prefixes       []string `yaml:"prefixes"`
+}
+
+type relayPolicyEntry struct {
+	name     string
+	prefixes []netip.Prefix
+}
+
+// relayPolicySnapshot is immutable once stored.
+type relayPolicySnapshot struct {
+	fingerprint string
+	entries     []relayPolicyEntry
+}
+
+type RelayPolicy struct {
+	dir string
+	now func() time.Time
+
+	snapshot  atomic.Pointer[relayPolicySnapshot]
+	nextCheck atomic.Int64 // unix nanoseconds
+
+	reloadMu          sync.Mutex
+	failedFingerprint string // guarded by reloadMu
+}
+
+// NewRelayPolicyFromEnv returns nil (no policy) when LIVEKIT_RELAY_POLICY_DIR
+// is unset or empty. A set but unusable directory is a startup error.
+func NewRelayPolicyFromEnv() (*RelayPolicy, error) {
+	dir := strings.TrimSpace(os.Getenv(relayPolicyDirEnv))
+	if dir == "" {
+		return nil, nil
+	}
+	return NewRelayPolicy(dir)
+}
+
+// newRelayPolicyForConfig is NewRelayPolicyFromEnv for a server that can honour
+// the policy: forcing relay without a TURN/TLS leg would leave a matching client
+// with no candidate at all, so without one the policy is ignored, loudly.
+func newRelayPolicyForConfig(conf *config.Config) (*RelayPolicy, error) {
+	p, err := NewRelayPolicyFromEnv()
+	if err != nil || p == nil {
+		return nil, err
+	}
+	if !conf.TURN.Enabled || conf.TURN.TLSPort == 0 || conf.TURN.Domain == "" {
+		logger.Warnw("relay policy ignored: it needs embedded TURN with a TLS leg (turn.enabled, turn.domain, turn.tls_port)", nil, "dir", p.dir)
+		return nil, nil
+	}
+	return p, nil
+}
+
+func NewRelayPolicy(dir string) (*RelayPolicy, error) {
+	return newRelayPolicy(dir, time.Now)
+}
+
+func newRelayPolicy(dir string, now func() time.Time) (*RelayPolicy, error) {
+	p := &RelayPolicy{dir: dir, now: now}
+	fingerprint, err := relayPolicyFingerprint(dir)
+	if err != nil {
+		return nil, fmt.Errorf("relay policy: %w", err)
+	}
+	snapshot, err := loadRelayPolicy(dir, fingerprint)
+	if err != nil {
+		return nil, fmt.Errorf("relay policy: %w", err)
+	}
+	p.snapshot.Store(snapshot)
+	p.nextCheck.Store(now().Add(relayPolicyRecheckInterval).UnixNano())
+	logRelayPolicy("relay policy loaded", dir, snapshot)
+	return p, nil
+}
+
+// Match reports the name of the first policy whose ranges contain addr, the
+// client address as GetClientIP returns it (an X-Forwarded-For list counts by
+// its first element). A nil policy matches nothing.
+func (p *RelayPolicy) Match(addr string) (string, bool) {
+	if p == nil {
+		return "", false
+	}
+	p.maybeReload()
+
+	ip, ok := parseRelayPolicyAddr(addr)
+	if !ok {
+		return "", false
+	}
+	for _, entry := range p.snapshot.Load().entries {
+		for _, prefix := range entry.prefixes {
+			if prefix.Contains(ip) {
+				return entry.name, true
+			}
+		}
+	}
+	return "", false
+}
+
+// maybeReload re-reads the directory when its file set or file contents
+// changed, at most once per recheck interval. A reload that fails keeps
+// the previous policy.
+func (p *RelayPolicy) maybeReload() {
+	now := p.now()
+	if now.UnixNano() < p.nextCheck.Load() {
+		return
+	}
+	if !p.reloadMu.TryLock() {
+		return
+	}
+	defer p.reloadMu.Unlock()
+	p.nextCheck.Store(now.Add(relayPolicyRecheckInterval).UnixNano())
+
+	fingerprint, err := relayPolicyFingerprint(p.dir)
+	if err != nil {
+		logger.Errorw("relay policy: cannot read directory, keeping the previous policy", err, "dir", p.dir)
+		return
+	}
+	if fingerprint == p.snapshot.Load().fingerprint || fingerprint == p.failedFingerprint {
+		return
+	}
+	snapshot, err := loadRelayPolicy(p.dir, fingerprint)
+	if err != nil {
+		p.failedFingerprint = fingerprint
+		logger.Errorw("relay policy: reload failed, keeping the previous policy", err, "dir", p.dir)
+		return
+	}
+	p.failedFingerprint = ""
+	p.snapshot.Store(snapshot)
+	logRelayPolicy("relay policy reloaded", p.dir, snapshot)
+}
+
+func relayPolicyFiles(dir string) ([]string, error) {
+	files, err := filepath.Glob(filepath.Join(dir, "*.yaml"))
+	if err != nil {
+		return nil, err
+	}
+	if _, err := os.Stat(dir); err != nil {
+		return nil, err
+	}
+	sort.Strings(files)
+	return files, nil
+}
+
+func relayPolicyFingerprint(dir string) (string, error) {
+	files, err := relayPolicyFiles(dir)
+	if err != nil {
+		return "", err
+	}
+	// Content hashes, not modification times: a same-size edit within the
+	// file system's timestamp granularity must not be missed. The files are
+	// small and read at most once per recheck interval.
+	var b strings.Builder
+	for _, file := range files {
+		data, err := os.ReadFile(file)
+		if err != nil {
+			return "", err
+		}
+		fmt.Fprintf(&b, "%s|%x\n", filepath.Base(file), sha256.Sum256(data))
+	}
+	return b.String(), nil
+}
+
+func loadRelayPolicy(dir, fingerprint string) (*relayPolicySnapshot, error) {
+	files, err := relayPolicyFiles(dir)
+	if err != nil {
+		return nil, err
+	}
+	snapshot := &relayPolicySnapshot{fingerprint: fingerprint}
+	names := map[string]string{}
+	for _, file := range files {
+		entry, err := loadRelayPolicyFile(file)
+		if err != nil {
+			return nil, fmt.Errorf("%s: %w", file, err)
+		}
+		if other, ok := names[entry.name]; ok {
+			return nil, fmt.Errorf("%s: policy name %q already used by %s", file, entry.name, other)
+		}
+		names[entry.name] = file
+		snapshot.entries = append(snapshot.entries, entry)
+	}
+	return snapshot, nil
+}
+
+func loadRelayPolicyFile(file string) (relayPolicyEntry, error) {
+	data, err := os.ReadFile(file)
+	if err != nil {
+		return relayPolicyEntry{}, err
+	}
+	var pf relayPolicyFile
+	decoder := yaml.NewDecoder(bytes.NewReader(data))
+	decoder.KnownFields(true)
+	if err := decoder.Decode(&pf); err != nil {
+		return relayPolicyEntry{}, err
+	}
+	name := strings.TrimSpace(pf.Name)
+	if name == "" {
+		return relayPolicyEntry{}, errors.New("missing name")
+	}
+	entry := relayPolicyEntry{name: name}
+	for _, s := range append(append([]string{}, pf.Prefixes...), pf.ManualPrefixes...) {
+		prefix, err := netip.ParsePrefix(strings.TrimSpace(s))
+		if err != nil {
+			return relayPolicyEntry{}, fmt.Errorf("policy %q: %w", name, err)
+		}
+		entry.prefixes = append(entry.prefixes, prefix.Masked())
+	}
+	return entry, nil
+}
+
+func parseRelayPolicyAddr(addr string) (netip.Addr, bool) {
+	first, _, _ := strings.Cut(addr, ",")
+	first = strings.TrimSpace(first)
+	if first == "" {
+		return netip.Addr{}, false
+	}
+	ip, err := netip.ParseAddr(first)
+	if err != nil {
+		addrPort, err := netip.ParseAddrPort(first)
+		if err != nil {
+			return netip.Addr{}, false
+		}
+		ip = addrPort.Addr()
+	}
+	return ip.WithZone("").Unmap(), true
+}
+
+func logRelayPolicy(msg, dir string, snapshot *relayPolicySnapshot) {
+	names := make([]string, 0, len(snapshot.entries))
+	count := 0
+	for _, entry := range snapshot.entries {
+		names = append(names, entry.name)
+		count += len(entry.prefixes)
+	}
+	if len(names) == 0 {
+		logger.Warnw(msg+": directory holds no policy", nil, "dir", dir)
+		return
+	}
+	logger.Infow(msg, "dir", dir, "policies", names, "prefixes", count)
+}
diff --git a/pkg/service/relaypolicy_test.go b/pkg/service/relaypolicy_test.go
