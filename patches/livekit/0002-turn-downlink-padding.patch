+// limitations under the License.
+
+package service
+
+import "testing"
+
+func TestParseTurnDownlinkPadEnv(t *testing.T) {
+	t.Setenv(turnDownlinkPadEnv, "")
+	for _, tc := range []struct {
+		name string
+		val  string
+		want int32
+	}{
+		{"unset means disabled", "", 0},
+		{"whitespace means disabled", "   ", 0},
+		{"a normal target", "1300", 1300},
+		{"the floor", "64", 64},
+		{"the ceiling", "60000", 60000},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv(turnDownlinkPadEnv, tc.val)
+			got, err := parseTurnDownlinkPadEnv()
+			if err != nil {
+				t.Fatalf("parse %q: %v", tc.val, err)
+			}
+			if got != tc.want {
+				t.Fatalf("parse %q = %d, want %d", tc.val, got, tc.want)
+			}
+		})
+	}
+
+	for _, tc := range []struct {
+		name string
+		val  string
+	}{
+		{"not a number", "1300x"},
+		{"signed number", "-1300"},
+		{"below the floor", "63"},
+		{"above the ceiling", "60001"},
+		{"a size hint", "1.3KB"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Setenv(turnDownlinkPadEnv, tc.val)
+			if _, err := parseTurnDownlinkPadEnv(); err == nil {
+				t.Fatalf("parse %q unexpectedly succeeded", tc.val)
+			}
+		})
+	}
+}
