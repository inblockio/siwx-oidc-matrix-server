+
+package service
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/pion/turn/v5"
+
+	"github.com/livekit/protocol/logger"
+)
+
+const (
+	// turnDownlinkPadEnv sets the fixed size, in bytes, that every
+	// server-to-client TURN media message is padded up to (see
+	// patches/pion-turn/0001-downlink-padding.patch in the image build).
+	// Unset/empty disables it: upstream behaviour.
+	turnDownlinkPadEnv = "LIVEKIT_TURN_DOWNLINK_PAD_BYTES"
+
+	turnDownlinkPadMin = 64
+	turnDownlinkPadMax = 60000
+)
+
+// parseTurnDownlinkPadEnv validates turnDownlinkPadEnv. A set but invalid
+// value is a startup error, so a typo can never half-enable padding.
+func parseTurnDownlinkPadEnv() (int32, error) {
+	v := strings.TrimSpace(os.Getenv(turnDownlinkPadEnv))
+	if v == "" {
+		return 0, nil
+	}
+	n, err := strconv.ParseInt(v, 10, 32)
+	if err != nil {
+		return 0, fmt.Errorf("invalid %s %q: %w", turnDownlinkPadEnv, v, err)
+	}
+	if n < turnDownlinkPadMin || n > turnDownlinkPadMax {
+		return 0, fmt.Errorf("%s must be between %d and %d, got %d",
+			turnDownlinkPadEnv, turnDownlinkPadMin, turnDownlinkPadMax, n)
+	}
+	return int32(n), nil
+}
+
+// applyTurnDownlinkPad wires the parsed env into the TURN server. It must run
+// before the TURN server is created: the padding target is read server-wide
+// by the patched module, and a value applied after allocations exist is not
+// guaranteed to take effect.
+func applyTurnDownlinkPad() (int32, error) {
+	n, err := parseTurnDownlinkPadEnv()
+	if err != nil {
+		return 0, err
+	}
+	if n > 0 {
+		turn.SetDownlinkPadTarget(n)
+		logger.Infow("TURN downlink padding enabled", "bytes", n)
+	}
+	return n, nil
+}
