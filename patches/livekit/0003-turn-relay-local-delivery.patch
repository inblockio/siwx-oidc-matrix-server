+// collectInterfaceIPs returns this host's routable interface addresses
+// (loopback, link-local and unspecified excluded), the addresses a packet
+// addressed to this very host is actually delivered on.
+func collectInterfaceIPs() map[netip.Addr]struct{} {
+	ips := make(map[netip.Addr]struct{})
+	ifAddrs, err := net.InterfaceAddrs()
+	if err != nil {
+		return ips
+	}
+	for _, ifAddr := range ifAddrs {
+		ipNet, ok := ifAddr.(*net.IPNet)
+		if !ok {
+			continue
+		}
+		addr, ok := netip.AddrFromSlice(ipNet.IP)
+		if !ok {
+			continue
+		}
+		addr = addr.Unmap().WithZone("")
+		// link-local and unspecified addresses are not delivery targets; the
+		// loopback IS one (a service bound to it is on this very host).
+		if addr.IsLinkLocalUnicast() || addr.IsUnspecified() {
+			continue
+		}
+		ips[addr] = struct{}{}
 	}
+	return ips
 }
 
