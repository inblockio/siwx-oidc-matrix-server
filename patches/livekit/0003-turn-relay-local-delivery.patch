+func TestTURNRelayPolicy_LocalDeliveryRewritesMappedMediaPort(t *testing.T) {
+	// A relayed write to this host's mapped (public) address on an RTC media
+	// port is delivered on an interface address instead, so it never needs the
+	// host's published port for the media range.
+	relay := listenUDP(t)
+	mediaPeer := listenUDP(t)
+	mediaPort := uint16(mediaPeer.LocalAddr().(*net.UDPAddr).Port)
+
+	mapped := netip.MustParseAddr("8.8.8.8") // stand-in for the public/NAT IP
+	policy := newTURNRelayPolicy(
+		&fakeRelayAddressGenerator{conn: relay},
+		map[netip.Addr]struct{}{mapped: {}, netip.MustParseAddr("127.0.0.1"): {}},
+		[]portRange{{mediaPort, mediaPort}},
+	)
+	policy.interfaceIPs = map[netip.Addr]struct{}{netip.MustParseAddr("127.0.0.1"): {}}
+
+	conn, _, err := policy.AllocatePacketConn(turn.AllocateListenerConfig{UserID: "PA_ld"})
+	require.NoError(t, err)
+
+	buf := make([]byte, 64)
+	_, err = conn.WriteTo([]byte("delivered"), &net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: int(mediaPort)})
+	require.NoError(t, err)
+
+	require.NoError(t, mediaPeer.SetReadDeadline(time.Now().Add(2*time.Second)))
+	n, _, err := mediaPeer.ReadFrom(buf)
+	require.NoError(t, err)
+	require.Equal(t, "delivered", string(buf[:n]))
+
+	// The same write to a non-media port on the mapped address is still
+	// dropped by the policy, rewrite or not.
+	require.NoError(t, relay.SetReadDeadline(time.Now().Add(100*time.Millisecond)))
+	_, _, err = relay.ReadFrom(buf)
+	require.Error(t, err) // nothing hairpinned out through the relay socket
+}
+
+func TestTURNRelayPolicy_LocalDeliveryCases(t *testing.T) {
+	mapped := netip.MustParseAddr("8.8.8.8")
+	iface := netip.MustParseAddr("172.21.0.2")
+	other := netip.MustParseAddr("1.2.3.4")
+	policy := &turnRelayPolicy{
+		localIPs:     map[netip.Addr]struct{}{mapped: {}, iface: {}},
+		mediaPorts:   []portRange{{uint16(20100), uint16(20200)}},
+		interfaceIPs: map[netip.Addr]struct{}{iface: {}},
+	}
+
+	// mapped address, media port: rewritten, port kept
+	got := policy.localDelivery(&net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20123})
+	require.Equal(t, &net.UDPAddr{IP: net.IP(iface.AsSlice()), Port: 20123}, got)
+
+	// already an interface address: unchanged
+	same := &net.UDPAddr{IP: net.IP(iface.AsSlice()), Port: 20123}
+	require.Same(t, same, policy.localDelivery(same))
+
+	// another host's address: unchanged
+	ext := &net.UDPAddr{IP: net.IP(other.AsSlice()), Port: 20123}
+	require.Same(t, ext, policy.localDelivery(ext))
+
+	// own mapped address, but not a media port: unchanged
+	nonMedia := &net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20201}
+	require.Same(t, nonMedia, policy.localDelivery(nonMedia))
+
+	// no interface addresses known: unchanged rather than a guess
+	policy.interfaceIPs = nil
+	require.Same(t, nonMedia, policy.localDelivery(nonMedia))
+
+	// no same-family interface address: unchanged
+	v6mapped := netip.MustParseAddr("2001:db8::1")
+	policy.localIPs[v6mapped] = struct{}{}
+	policy.interfaceIPs = map[netip.Addr]struct{}{iface: {}}
+	v6dst := &net.UDPAddr{IP: net.IP(v6mapped.AsSlice()), Port: 20100}
+	require.Same(t, v6dst, policy.localDelivery(v6dst))
+}
+
+func TestCollectInterfaceIPs(t *testing.T) {
+	ips := collectInterfaceIPs()
+	require.NotEmpty(t, ips, "a host has at least one routable interface address")
+	for addr := range ips {
+		require.False(t, addr.IsLinkLocalUnicast() || addr.IsUnspecified())
+	}
+}
