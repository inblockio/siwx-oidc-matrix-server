+// localDelivery (inblock.io) rewrites a relayed write that targets this
+// host's own mapped address (its public or 1:1-NAT IP, what the SFU
+// advertises with use_external_ip) on an RTC media port to one of this
+// host's interface addresses, so the packet is delivered locally. Without
+// it the write hairpins out of the container to the host's published port
+// for the media range (docker-proxy), which is exactly the publish a
+// relay-only deployment wants closed: a client's relayed ICE checks address
+// the SFU's advertised candidate, and nothing else can carry them once the
+// publish is gone. Own-address writes that already name an interface
+// address, and writes to any other address, pass through unchanged.
+func (g *turnRelayPolicy) localDelivery(addr net.Addr) net.Addr {
+	udpAddr, ok := addr.(*net.UDPAddr)
+	if !ok || len(g.interfaceIPs) == 0 {
+		return addr
+	}
+	dst := udpAddr.AddrPort().Addr().Unmap().WithZone("")
+	if _, ok := g.interfaceIPs[dst]; ok {
+		return addr // already delivered locally
+	}
+	if _, ok := g.localIPs[dst]; !ok {
+		return addr // not this host's mapped address
+	}
+	if !g.isMediaPort(uint16(udpAddr.Port)) {
+		return addr
+	}
+	target, ok := g.interfaceAddrFor(dst)
+	if !ok {
+		return addr // no interface address of the same family to deliver on
+	}
+	return &net.UDPAddr{IP: net.IP(target.AsSlice()), Port: udpAddr.Port}
+}
+
+// setExcludedCIDRs applies rtc.ips.excludes (and the inverse of
+// rtc.ips.includes) to the rewrite target choice. A malformed entry is an
+// error: silently ignoring half the list would let local delivery pick an
+// address the ICE stack ignores.
+func (g *turnRelayPolicy) setExcludedCIDRs(excludes []string) error {
+	cidrs := make([]*net.IPNet, 0, len(excludes))
+	for _, c := range excludes {
+		_, ipnet, err := net.ParseCIDR(c)
+		if err != nil {
+			return errors.Wrapf(err, "invalid CIDR %q in rtc.ips.excludes", c)
+		}
+		cidrs = append(cidrs, ipnet)
+	}
+	g.excludedCIDRs = cidrs
+	return nil
+}
+
+// interfaceAddrFor picks a deterministic interface address of the same
+// address family as the mapped destination. The loopback is never a
+// delivery target: the ICE stack drops remote peers on loopback addresses
+// (its IP filter), so a check delivered via 127.0.0.1 is received by the
+// media socket and silently discarded - observed live on dev-aquafire, where
+// rewritten checks reached the SFU on 127.0.0.1 and every join still failed.
+// Addresses inside rtc.ips.excludes are equally invalid targets: the ICE
+// stack gathers no candidate there either.
+func (g *turnRelayPolicy) interfaceAddrFor(dst netip.Addr) (netip.Addr, bool) {
+	var candidates []netip.Addr
+	for addr := range g.interfaceIPs {
+		if addr.IsLoopback() || addr.IsLinkLocalUnicast() || g.isExcluded(addr) {
+			continue
+		}
+		if addr.Is4() == dst.Is4() {
+			candidates = append(candidates, addr)
+		}
+	}
+	if len(candidates) == 0 {
+		return netip.Addr{}, false
+	}
+	slices.SortFunc(candidates, func(a, b netip.Addr) int { return a.Compare(b) })
+	return candidates[0], true
+}
+
+func (g *turnRelayPolicy) isExcluded(addr netip.Addr) bool {
+	ip := net.IP(addr.AsSlice())
+	for _, ipnet := range g.excludedCIDRs {
+		if ipnet.Contains(ip) {
 			return true
 		}
 	}
