+func firstNonLoopbackInterfaceIP(t *testing.T) netip.Addr {
+	t.Helper()
+	for addr := range collectInterfaceIPs() {
+		if addr.Is4() && !addr.IsLoopback() && !addr.IsLinkLocalUnicast() {
+			return addr
+		}
+	}
+	t.Fatal("no non-loopback IPv4 interface address available")
+	return netip.Addr{}
+}
+
+func TestTURNRelayPolicy_LocalDeliveryRewritesMappedMediaPort(t *testing.T) {
+	// A relayed write to this host's mapped (public) address on an RTC media
+	// port is delivered on an interface address instead, so it never needs the
+	// host's published port for the media range.
+	relay := listenUDP(t)
+	iface := firstNonLoopbackInterfaceIP(t)
+	mediaPeer, err := net.ListenPacket("udp4", iface.String()+":0")
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = mediaPeer.Close() })
+	mediaPort := uint16(mediaPeer.LocalAddr().(*net.UDPAddr).Port)
+
+	mapped := netip.MustParseAddr("8.8.8.8") // stand-in for the public/NAT IP
+	policy := newTURNRelayPolicy(
+		&fakeRelayAddressGenerator{conn: relay},
+		map[netip.Addr]struct{}{mapped: {}, iface: {}},
+		[]portRange{{mediaPort, mediaPort}},
+	)
+	// the loopback is a valid local delivery address but must never be chosen
+	// as the rewrite target: the ICE stack drops loopback remote peers.
+	policy.interfaceIPs = map[netip.Addr]struct{}{netip.MustParseAddr("127.0.0.1"): {}, iface: {}}
+
+	conn, _, err := policy.AllocatePacketConn(turn.AllocateListenerConfig{UserID: "PA_ld"})
+	require.NoError(t, err)
+
+	buf := make([]byte, 64)
+	_, err = conn.WriteTo([]byte("delivered"), &net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: int(mediaPort)})
+	require.NoError(t, err)
+
+	require.NoError(t, mediaPeer.SetReadDeadline(time.Now().Add(2*time.Second)))
+	n, _, err := mediaPeer.ReadFrom(buf)
+	require.NoError(t, err)
+	require.Equal(t, "delivered", string(buf[:n]))
+	// the packet arrived at the media peer listening on the interface address,
+	// i.e. the rewrite chose it over the loopback that sorts lower
+
+	// The same write to a non-media port on the mapped address is still
+	// dropped by the policy, rewrite or not.
+	require.NoError(t, relay.SetReadDeadline(time.Now().Add(100*time.Millisecond)))
+	_, _, err = relay.ReadFrom(buf)
+	require.Error(t, err) // nothing hairpinned out through the relay socket
+}
+
+func TestTURNRelayPolicy_LocalDeliveryNeverRewritesToLoopback(t *testing.T) {
+	// Only a loopback interface address: no rewrite at all (the ICE stack
+	// drops loopback remote peers, so delivering there would silently break
+	// the join this patch exists to fix).
+	mapped := netip.MustParseAddr("8.8.8.8")
+	policy := &turnRelayPolicy{
+		localIPs:     map[netip.Addr]struct{}{mapped: {}, netip.MustParseAddr("127.0.0.1"): {}},
+		mediaPorts:   []portRange{{uint16(20100), uint16(20200)}},
+		interfaceIPs: map[netip.Addr]struct{}{netip.MustParseAddr("127.0.0.1"): {}},
+	}
+	dst := &net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20100}
+	require.Same(t, dst, policy.localDelivery(dst))
+}
+
+func TestTURNRelayPolicy_LocalDeliverySkipsExcludedCIDRs(t *testing.T) {
+	// rtc.ips.excludes names networks the ICE stack gathers no candidate on
+	// (on the deployment: the proxy network's subnet). A rewrite there reads
+	// fine at the socket and is dropped by the agent, so the choice must skip
+	// it - observed live when the rewritten checks landed on 172.18.0.4.
+	mapped := netip.MustParseAddr("8.8.8.8")
+	bridge := netip.MustParseAddr("172.21.0.2")
+	proxynet := netip.MustParseAddr("172.18.0.4")
+	policy := &turnRelayPolicy{
+		localIPs:     map[netip.Addr]struct{}{mapped: {}, bridge: {}, proxynet: {}},
+		mediaPorts:   []portRange{{uint16(20100), uint16(20200)}},
+		interfaceIPs: map[netip.Addr]struct{}{bridge: {}, proxynet: {}}, // proxynet sorts lower
+	}
+	require.NoError(t, policy.setExcludedCIDRs([]string{"172.18.0.0/16"}))
+
+	got := policy.localDelivery(&net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20100})
+	require.Equal(t, &net.UDPAddr{IP: net.IP(bridge.AsSlice()), Port: 20100}, got)
+
+	// all candidates excluded: no rewrite
+	require.NoError(t, policy.setExcludedCIDRs([]string{"172.18.0.0/16", "172.21.0.0/16"}))
+	dst := &net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20100}
+	require.Same(t, dst, policy.localDelivery(dst))
+
+	// a malformed exclude is an error, never half a list
+	require.Error(t, policy.setExcludedCIDRs([]string{"172.18.0.0/16", "not-a-cidr"}))
+}
+
+func TestTURNRelayPolicy_LocalDeliveryCases(t *testing.T) {
+	mapped := netip.MustParseAddr("8.8.8.8")
+	iface := netip.MustParseAddr("172.21.0.2")
+	other := netip.MustParseAddr("1.2.3.4")
+	loAddr := netip.MustParseAddr("127.0.0.1")
+	policy := &turnRelayPolicy{
+		localIPs:     map[netip.Addr]struct{}{mapped: {}, iface: {}},
+		mediaPorts:   []portRange{{uint16(20100), uint16(20200)}},
+		interfaceIPs: map[netip.Addr]struct{}{iface: {}},
+	}
+
+	// mapped address, media port: rewritten, port kept
+	got := policy.localDelivery(&net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20123})
+	require.Equal(t, &net.UDPAddr{IP: net.IP(iface.AsSlice()), Port: 20123}, got)
+
+	// already an interface address: unchanged
+	same := &net.UDPAddr{IP: net.IP(iface.AsSlice()), Port: 20123}
+	require.Same(t, same, policy.localDelivery(same))
+
+	// the loopback is a local delivery address in its own right: unchanged
+	policy.interfaceIPs = map[netip.Addr]struct{}{iface: {}, loAddr: {}}
+	policy.localIPs[loAddr] = struct{}{}
+	lo := &net.UDPAddr{IP: net.IP(loAddr.AsSlice()), Port: 20123}
+	require.Same(t, lo, policy.localDelivery(lo))
+
+	// another host's address: unchanged
+	policy.interfaceIPs = map[netip.Addr]struct{}{iface: {}}
+	ext := &net.UDPAddr{IP: net.IP(other.AsSlice()), Port: 20123}
+	require.Same(t, ext, policy.localDelivery(ext))
+
+	// own mapped address, but not a media port: unchanged
+	nonMedia := &net.UDPAddr{IP: net.IP(mapped.AsSlice()), Port: 20201}
+	require.Same(t, nonMedia, policy.localDelivery(nonMedia))
+
+	// no interface addresses known: unchanged rather than a guess
+	policy.interfaceIPs = nil
+	require.Same(t, nonMedia, policy.localDelivery(nonMedia))
+
+	// no same-family interface address: unchanged
+	v6mapped := netip.MustParseAddr("2001:db8::1")
+	policy.localIPs[v6mapped] = struct{}{}
+	policy.interfaceIPs = map[netip.Addr]struct{}{iface: {}}
+	v6dst := &net.UDPAddr{IP: net.IP(v6mapped.AsSlice()), Port: 20100}
+	require.Same(t, v6dst, policy.localDelivery(v6dst))
+}
+
+func TestCollectInterfaceIPs(t *testing.T) {
+	ips := collectInterfaceIPs()
+	require.NotEmpty(t, ips, "a host has at least one interface address")
+	for addr := range ips {
+		require.False(t, addr.IsLinkLocalUnicast() || addr.IsUnspecified())
+	}
+}
