+
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import * as ComponentsCore from "@livekit/components-core";
+
+import { ObservableScope } from "./ObservableScope";
+import { AudioOutput, headsetOutputId } from "./MediaDevices";
+import { audioOutput as audioOutputSetting } from "../settings/settings";
+import { withTestScheduler } from "../utils/test";
+
+const dev = (
+  kind: MediaDeviceKind,
+  deviceId: string,
+  label: string,
+  groupId: string,
+): MediaDeviceInfo => ({ kind, deviceId, label, groupId }) as MediaDeviceInfo;
+
+// Chrome on Windows 10 with a Sony headset: Windows splits it into a Stereo and a Hands-Free endpoint.
+const STEREO = dev("audiooutput", "s1", "Headphones (WH-1000XM4 Stereo)", "gS");
+const HANDS_FREE = dev(
+  "audiooutput",
+  "h1",
+  "Headset (WH-1000XM4 Hands-Free AG Audio)",
+  "gH",
+);
+const SPEAKERS = dev("audiooutput", "r1", "Speakers (Realtek(R) Audio)", "gR");
+const HF_MIC = dev(
+  "audioinput",
+  "m1",
+  "Headset (WH-1000XM4 Hands-Free AG Audio)",
+  "gH",
+);
+const LAPTOP_MIC = dev(
+  "audioinput",
+  "m2",
+  "Microphone Array (Realtek(R) Audio)",
+  "gR",
+);
+const as = (
+  id: "default" | "communications",
+  d: MediaDeviceInfo,
+  prefix = id === "default" ? "Default" : "Communications",
+): MediaDeviceInfo => ({ ...d, deviceId: id, label: `${prefix} - ${d.label}` });
+
+const WIN10_OUTPUTS = [
+  as("default", STEREO),
+  as("communications", HANDS_FREE),
+  STEREO,
+  HANDS_FREE,
+  SPEAKERS,
+];
+const WIN10_INPUTS = [
+  as("default", HF_MIC),
+  as("communications", HF_MIC),
+  HF_MIC,
+  LAPTOP_MIC,
+];
+
+describe("headsetOutputId", () => {
+  it("plays on the hands-free output while the headset's microphone is in use (Windows 10)", () => {
+    expect(headsetOutputId(WIN10_OUTPUTS, WIN10_INPUTS, "default", true)).toBe(
+      "communications",
+    );
+    // chosen by its own id, too
+    expect(headsetOutputId(WIN10_OUTPUTS, WIN10_INPUTS, "m1", true)).toBe(
+      "communications",
+    );
+  });
+
+  it("uses the hands-free output itself when communications points elsewhere", () => {
+    const outputs = [
+      as("default", STEREO),
+      as("communications", SPEAKERS),
+      STEREO,
+      HANDS_FREE,
+      SPEAKERS,
+    ];
+    expect(headsetOutputId(outputs, WIN10_INPUTS, "default", true)).toBe("h1");
+  });
+
+  it("reads localized prefixes", () => {
+    const outputs = [
+      as("default", STEREO, "Standard"),
+      as("communications", HANDS_FREE, "Kommunikation"),
+      STEREO,
+      HANDS_FREE,
+    ];
+    const inputs = [as("default", HF_MIC, "Standard"), HF_MIC];
+    expect(headsetOutputId(outputs, inputs, "default", true)).toBe(
+      "communications",
+    );
+  });
+
+  it("leaves the default alone with the laptop microphone and the headset as stereo headphones", () => {
+    const inputs = [as("default", LAPTOP_MIC), HF_MIC, LAPTOP_MIC];
+    expect(headsetOutputId(WIN10_OUTPUTS, inputs, "default", true)).toBe(
+      undefined,
+    );
+  });
+
+  it("leaves the default alone when it already plays on the headset (Windows 11, one endpoint)", () => {
+    const out = dev("audiooutput", "u1", "Headset (WH-1000XM4)", "gU");
+    const mic = dev("audioinput", "u2", "Headset (WH-1000XM4)", "gU");
+    expect(
+      headsetOutputId(
+        [as("default", out), as("communications", out), out, SPEAKERS],
+        [as("default", mic), mic],
+        "default",
+        true,
+      ),
+    ).toBe(undefined);
+  });
+
+  it("does nothing off Windows, without a microphone or without names", () => {
+    expect(headsetOutputId(WIN10_OUTPUTS, WIN10_INPUTS, "default", false)).toBe(
+      undefined,
+    );
+    expect(headsetOutputId(WIN10_OUTPUTS, WIN10_INPUTS, undefined, true)).toBe(
+      undefined,
+    );
+    const blank = (d: MediaDeviceInfo): MediaDeviceInfo => ({
+      ...d,
+      label: "",
+    });
+    expect(
+      headsetOutputId(
+        WIN10_OUTPUTS.map(blank),
+        WIN10_INPUTS.map(blank),
+        "default",
+        true,
+      ),
+    ).toBe(undefined);
+  });
+});
+
+vi.mock("@livekit/components-core", () => ({
+  createMediaDeviceObserver: vi.fn(),
+}));
+
+describe("AudioOutput with a Windows headset", () => {
+  let testScope: ObservableScope;
+
+  beforeEach(() => {
+    testScope = new ObservableScope();
+    audioOutputSetting.setValue(undefined);
+    vi.spyOn(navigator, "userAgent", "get").mockReturnValue(
+      "Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/141.0.0.0 Safari/537.36",
+    );
+  });
+
+  afterEach(() => {
+    testScope.end();
+    vi.restoreAllMocks();
+  });
+
+  it("selects the hands-free output while nothing is chosen, and a choice still wins", () => {
+    withTestScheduler(({ behavior, cold, schedule, expectObservable }) => {
+      vi.mocked(ComponentsCore.createMediaDeviceObserver).mockReturnValue(
+        cold("a", { a: WIN10_OUTPUTS }),
+      );
+      const audioOutput = new AudioOutput(
+        behavior("a", { a: true }),
+        testScope,
+        {
+          availableRaw$: behavior("a", { a: WIN10_INPUTS }),
+          selected$: behavior("a", {
+            a: { id: "default", hardwareDeviceChange$: cold("") },
+          }),
+        },
+      );
+      schedule("--a", { a: () => audioOutput.select(SPEAKERS.deviceId) });
+      expectObservable(audioOutput.selected$).toBe("a-b", {
+        a: { id: "communications", virtualEarpiece: false },
+        b: { id: SPEAKERS.deviceId, virtualEarpiece: false },
+      });
+    });
+  });
+});
