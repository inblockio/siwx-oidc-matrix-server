+/*
+Copyright 2026 Aqua Meet contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import { EventEmitter } from "events";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { BehaviorSubject } from "rxjs";
+import { Room, RoomEvent, ParticipantEvent, Track } from "livekit-client";
+import { logger } from "matrix-js-sdk/lib/logger";
+
+import {
+  guardAudioOutput,
+  SETTLE_MS,
+  soundBlocked$,
+  turnSoundOn,
+} from "./audioOutputGuard";
+import { type SelectedAudioOutputDevice } from "./MediaDevices";
+
+const dev = (
+  kind: MediaDeviceKind,
+  deviceId: string,
+  label: string,
+): MediaDeviceInfo =>
+  ({ kind, deviceId, label, groupId: deviceId }) as MediaDeviceInfo;
+const flush = async (): Promise<void> => {
+  for (let i = 0; i < 20; i++) await Promise.resolve();
+};
+const choice = (id: string): SelectedAudioOutputDevice => ({
+  id,
+  virtualEarpiece: false,
+});
+
+describe("guardAudioOutput with LiveKit's own device handling (Firefox)", () => {
+  let devices: MediaDeviceInfo[];
+  beforeEach(() => {
+    vi.spyOn(navigator, "userAgent", "get").mockReturnValue(
+      "Mozilla/5.0 (X11; Linux x86_64; rv:151.0) Gecko/20100101 Firefox/151.0",
+    );
+    const mediaDevices = Object.assign(new EventTarget(), {
+      enumerateDevices: async (): Promise<MediaDeviceInfo[]> =>
+        Promise.resolve(devices),
+    });
+    Object.defineProperty(navigator, "mediaDevices", {
+      value: mediaDevices,
+      configurable: true,
+    });
+    Object.defineProperty(HTMLMediaElement.prototype, "setSinkId", {
+      value: async (): Promise<void> => {},
+      configurable: true,
+    });
+    // Firefox lists no "default" output; Element Call chooses the browser default "" (element-call#4244)
+    devices = [
+      dev("audiooutput", "bt-a2dp", "WH-1000XM4"),
+      dev("audiooutput", "laptop", "Built-in Speakers"),
+      dev("audioinput", "laptop-mic", "Built-in Mic"),
+    ];
+  });
+  afterEach(() => {
+    vi.restoreAllMocks();
+    Reflect.deleteProperty(navigator, "mediaDevices");
+    Reflect.deleteProperty(HTMLMediaElement.prototype, "setSinkId");
+  });
+
+  // The headset opens its microphone and changes mode: its output is replaced, the browser reports a device change.
+  const headsetChangesMode = async (): Promise<void> => {
+    await Room.getLocalDevices(undefined, false);
+    devices = [
+      dev("audiooutput", "bt-hfp", "WH-1000XM4 (hands-free)"),
+      dev("audiooutput", "laptop", "Built-in Speakers"),
+      dev("audioinput", "bt-hfp-mic", "WH-1000XM4 (hands-free)"),
+      dev("audioinput", "laptop-mic", "Built-in Mic"),
+    ];
+    navigator.mediaDevices.dispatchEvent(new Event("devicechange"));
+    await flush();
+  };
+
+  it("without the guard, LiveKit pins the call to the first listed output", async () => {
+    const room = new Room({ audioOutput: { deviceId: "" } });
+    await room.switchActiveDevice("audiooutput", "");
+    await headsetChangesMode();
+    expect(room.getActiveDevice("audiooutput")).toBe("bt-hfp");
+    expect(room.options.audioOutput?.deviceId).toBe("bt-hfp");
+  });
+
+  it("with the guard, the call stays on the browser default", async () => {
+    const room = new Room({ audioOutput: { deviceId: "" } });
+    guardAudioOutput(room, new BehaviorSubject(choice("")), logger);
+    await room.switchActiveDevice("audiooutput", "");
+    await headsetChangesMode();
+    expect(room.getActiveDevice("audiooutput")).toBe("");
+    // what participants who join later are given
+    expect(room.options.audioOutput?.deviceId).toBe("");
+  });
+});
+
+// A stand-in for the parts of a LiveKit room the guard uses.
+class FakeRoom extends EventEmitter {
+  public active = "default";
+  public canPlaybackAudio = true;
+  public readonly switches: string[] = [];
+  public failing = new Set<string>();
+  public readonly remoteParticipants = new Map<string, unknown>();
+  public mic: { isMuted: boolean; readyState: string } | undefined;
+  public readonly localParticipant = Object.assign(new EventEmitter(), {
+    getTrackPublication: (): unknown =>
+      this.mic && {
+        isMuted: this.mic.isMuted,
+        track: { mediaStreamTrack: { readyState: this.mic.readyState } },
+      },
+  });
+  public startAudio = vi.fn(async (): Promise<void> => {
+    this.canPlaybackAudio = true;
+    return Promise.resolve();
+  });
+  public getActiveDevice(): string {
+    return this.active;
+  }
+  public async switchActiveDevice(_kind: string, id: string): Promise<void> {
+    this.switches.push(id);
+    if (this.failing.has(id))
+      return Promise.reject(new Error(`NotFoundError ${id}`));
+    this.active = id;
+    this.emit(RoomEvent.ActiveDeviceChanged, "audiooutput", id);
+    return Promise.resolve();
+  }
+  public addElement(element: object): void {
+    const track = { attachedElements: [element] };
+    this.remoteParticipants.set(`p${this.remoteParticipants.size}`, {
+      audioTrackPublications: new Map([["a", { track }]]),
+    });
+  }
+}
+const asRoom = (r: FakeRoom): Room => r as unknown as Room;
+
+const element = (
+  paused: boolean,
+  play: () => Promise<void> = async (): Promise<void> => {},
+): {
+  srcObject: object;
+  paused: boolean;
+  sinkId: string;
+  assigned: number;
+  play: ReturnType<typeof vi.fn>;
+  setSinkId: ReturnType<typeof vi.fn>;
+} => {
+  let src: object = { stream: 1 };
+  const el = {
+    paused,
+    sinkId: "bt-a2dp",
+    assigned: 0,
+    play: vi.fn(play),
+    setSinkId: vi.fn(async (id: string): Promise<void> => {
+      el.sinkId = id;
+      return Promise.resolve();
+    }),
+    get srcObject(): object {
+      return src;
+    },
+    set srcObject(v: object) {
+      el.assigned++;
+      if (v) src = v;
+    },
+  };
+  return el;
+};
+
+describe("guardAudioOutput", () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => {
+    vi.useRealTimers();
+    Reflect.deleteProperty(window, "GestureEvent");
+  });
+
+  it("puts the call back on its output whenever something moves it", async () => {
+    const room = new FakeRoom();
+    guardAudioOutput(asRoom(room), new BehaviorSubject(choice("")), logger);
+    await flush();
+    expect(room.switches).toEqual([]); // "default" and "" both mean the browser default
+    await room.switchActiveDevice("audiooutput", "laptop");
+    await flush();
+    expect(room.active).toBe("");
+  });
+
+  it("tries a failed switch once more, then falls back to the browser default, and tries the choice again on a device change", async () => {
+    const room = new FakeRoom();
+    room.failing.add("headset");
+    guardAudioOutput(
+      asRoom(room),
+      new BehaviorSubject(choice("headset")),
+      logger,
+    );
+    await flush();
+    expect(room.switches).toEqual(["headset"]);
+    vi.advanceTimersByTime(SETTLE_MS);
+    await flush();
+    expect(room.switches).toEqual(["headset", "headset", ""]);
+    room.failing.clear();
+    room.emit(RoomEvent.MediaDevicesChanged);
+    await flush();
+    expect(room.active).toBe("headset");
+  });
+
+  it("keeps the choice when a switch fails only once (grok F1: another switch in flight)", async () => {
+    const room = new FakeRoom();
+    room.failing.add("headset");
+    guardAudioOutput(
+      asRoom(room),
+      new BehaviorSubject(choice("headset")),
+      logger,
+    );
+    await flush();
+    room.failing.clear();
+    vi.advanceTimersByTime(SETTLE_MS);
+    await flush();
+    expect(room.active).toBe("headset");
+    expect(room.switches).not.toContain("");
+  });
+
+  it("plays every remote element afresh on its output once the microphone opened", async () => {
+    const room = new FakeRoom();
+    const el = element(false);
+    room.addElement(el);
+    guardAudioOutput(asRoom(room), new BehaviorSubject(choice("")), logger);
+    room.localParticipant.emit(ParticipantEvent.LocalTrackPublished, {
+      source: Track.Source.Microphone,
+    });
+    vi.advanceTimersByTime(SETTLE_MS - 1);
+    await flush();
+    expect(el.play).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(1);
+    await flush();
+    expect(el.setSinkId).toHaveBeenCalledWith("");
+    expect(el.assigned).toBe(2); // the stream was taken off and put back
+    expect(el.play).toHaveBeenCalledOnce();
+  });
+
+  it("leaves a chosen output that has gone without a device change (Firefox)", async () => {
+    Object.defineProperty(navigator, "mediaDevices", {
+      value: {
+        enumerateDevices: async (): Promise<MediaDeviceInfo[]> =>
+          Promise.resolve([dev("audiooutput", "laptop", "Built-in Speakers")]),
+      },
+      configurable: true,
+    });
+    const room = new FakeRoom();
+    guardAudioOutput(
+      asRoom(room),
+      new BehaviorSubject(choice("headset")),
+      logger,
+    );
+    await flush();
+    expect(room.active).toBe("headset");
+    room.localParticipant.emit(ParticipantEvent.LocalTrackPublished, {
+      source: Track.Source.Microphone,
+    });
+    vi.advanceTimersByTime(SETTLE_MS);
+    await flush();
+    expect(room.active).toBe("");
+    Reflect.deleteProperty(navigator, "mediaDevices");
+  });
+
+  it("settles once after a burst of device changes", async () => {
+    const room = new FakeRoom();
+    const el = element(false);
+    room.addElement(el);
+    guardAudioOutput(asRoom(room), new BehaviorSubject(choice("")), logger);
+    room.emit(RoomEvent.MediaDevicesChanged);
+    vi.advanceTimersByTime(SETTLE_MS / 2);
+    room.emit(RoomEvent.MediaDevicesChanged);
+    vi.advanceTimersByTime(SETTLE_MS);
+    await flush();
+    expect(el.play).toHaveBeenCalledOnce();
+  });
+
+  it("on Safari with the microphone closed only resumes a paused element", async () => {
+    Object.defineProperty(window, "GestureEvent", {
+      value: class {},
+      configurable: true,
+    });
+    const room = new FakeRoom();
+    const playing = element(false);
+    const paused = element(true);
+    room.addElement(playing);
+    room.addElement(paused);
+    guardAudioOutput(
+      asRoom(room),
+      new BehaviorSubject<SelectedAudioOutputDevice | undefined>(undefined),
+      logger,
+    );
+    room.emit(RoomEvent.MediaDevicesChanged);
+    vi.advanceTimersByTime(SETTLE_MS);
+    await flush();
+    expect(playing.play).not.toHaveBeenCalled();
+    expect(paused.play).toHaveBeenCalledOnce();
+    expect(paused.assigned).toBe(0);
+    expect(paused.setSinkId).not.toHaveBeenCalled(); // Safari: Element Call chooses no output
+  });
+
+  it("reports a blocked call and lets a click turn the sound on", async () => {
+    const room = new FakeRoom();
+    const notAllowed = Object.assign(new Error("blocked"), {
+      name: "NotAllowedError",
+    });
+    room.addElement(element(true, async () => Promise.reject(notAllowed)));
+    guardAudioOutput(asRoom(room), new BehaviorSubject(choice("")), logger);
+    room.emit(RoomEvent.MediaDevicesChanged);
+    vi.advanceTimersByTime(SETTLE_MS);
+    await flush();
+    expect(soundBlocked$.value).toBe(true);
+    turnSoundOn();
+    await flush();
+    expect(room.startAudio).toHaveBeenCalledOnce();
+    expect(soundBlocked$.value).toBe(false);
+  });
+
+  it("follows the choice only while connected and LiveKit's playback status", () => {
+    const room = new FakeRoom();
+    const selected$ = new BehaviorSubject(choice(""));
+    guardAudioOutput(asRoom(room), selected$, logger);
+    // grok F2: a room that never connects keeps no subscription
+    expect(selected$.observed).toBe(false);
+    room.emit(RoomEvent.Connected);
