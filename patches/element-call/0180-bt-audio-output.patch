+/*
+Copyright 2026 Aqua Meet contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+import {
+  type LocalTrackPublication,
+  ParticipantEvent,
+  type RemoteAudioTrack,
+  type Room,
+  RoomEvent,
+  Track,
+} from "livekit-client";
+import { BehaviorSubject, type Subscription } from "rxjs";
+import { type Logger } from "matrix-js-sdk/lib/logger";
+
+import { type SelectedAudioOutputDevice } from "./MediaDevices";
+import { type Behavior } from "./Behavior";
+
+/** How long a headset takes to settle in its new mode before the call is played afresh. */
+export const SETTLE_MS = 1500;
+
+/** True while the browser refuses to play the call's sound until the viewer clicks (see turnSoundOn). */
+export const soundBlocked$ = new BehaviorSubject<boolean>(false);
+const blockedRooms = new Set<Room>();
+const setBlocked = (room: Room, blocked: boolean): void => {
+  if (blocked) blockedRooms.add(room);
+  else blockedRooms.delete(room);
+  if (soundBlocked$.value !== blockedRooms.size > 0)
+    soundBlocked$.next(blockedRooms.size > 0);
+};
+
+/** For a click handler: asks every call whose sound the browser blocked to play it. */
+export function turnSoundOn(): void {
+  for (const room of blockedRooms) {
+    void room.startAudio().then(() => setBlocked(room, !room.canPlaybackAudio));
+  }
+}
+
+// "" and "default" both mean the browser's default output (Firefox and Safari know only "")
+const isDefault = (id: string | undefined): boolean =>
+  id === "" || id === "default";
+const same = (a: string | undefined, b: string | undefined): boolean =>
+  a === b || (isDefault(a) && isDefault(b));
+// eslint-disable-next-line @typescript-eslint/no-explicit-any
+const isSafari = (): boolean => !!(window as any).GestureEvent; // as in MediaDevices.ts
+
+/**
+ * aqua-meet: keeps a call audible while a Bluetooth headset changes mode. Opening a headset's microphone switches it
+ * from its stereo mode to its hands-free mode, closing it switches it back, and either switch can retire the output
+ * the call plays on. For one LiveKit room the guard
+ * - holds the remote audio on the output Element Call chose (`selected$`: the browser default unless the viewer
+ *   picked one). LiveKit itself moves it to the first listed device on every device change when the choice is the
+ *   browser default "" (Firefox), and an output pinned like that stays silent once the headset changes mode;
+ * - tries a failed switch once more after a pause while the output is listed (another switch can be in flight),
+ *   and falls back to the browser default when the output cannot be used or has gone;
+ * - plays the call afresh on its output once a device change, a microphone change or the microphone opening has
+ *   settled, as a player can go on feeding an output that went away;
+ * - reports when the browser refuses to play the call's sound without a click (soundBlocked$).
+ * It follows `selected$` while the room is connected; a room that never connects keeps no subscription.
+ */
+export function guardAudioOutput(
+  room: Room,
+  selected$: Behavior<SelectedAudioOutputDevice | undefined>,
+  logger: Logger,
+): void {
+  const log = logger.getChild("[aqua-meet audio output]");
+  // What Element Call chose; what the guard holds the room on (the choice, or the default once it failed).
+  let chosen = selected$.value?.id;
+  let held = chosen;
+  // A switch to a listed output failed once; the next failure gives up on it.
+  let retried = false;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let subscription: Subscription | undefined;
+
+  // Whether an output is still there. Firefox can lose one without a device change (a headset changing mode), and
+  // setSinkId does not fail for the id an element already has, so the list is asked.
+  const listed = async (id: string): Promise<boolean> => {
+    if (isDefault(id) || id === "communications") return true;
+    const devices = await navigator.mediaDevices
+      ?.enumerateDevices?.()
+      .catch(() => undefined);
+    return (
+      !devices ||
+      devices.some((d) => d.kind === "audiooutput" && d.deviceId === id)
+    );
+  };
+
+  const fallBack = async (target: string, e: unknown): Promise<void> => {
+    log.warn(`output ${target} cannot be used, using the browser default`, e);
+    held = "";
+    retried = false;
+    await room
+      .switchActiveDevice("audiooutput", "")
+      .catch((e2: unknown) => log.error("the browser default failed too", e2));
+  };
+
+  const hold = async (): Promise<void> => {
+    const target = held;
+    if (
+      target === undefined ||
+      same(room.getActiveDevice("audiooutput"), target)
+    )
+      return;
+    try {
+      await room.switchActiveDevice("audiooutput", target);
+      retried = false;
+    } catch (e) {
+      if (isDefault(target) || held !== target) return;
+      if (!retried && (await listed(target))) {
+        retried = true;
+        log.warn(`switching to output ${target} failed, trying again`, e);
+        settle("a failed switch");
+      } else {
+        await fallBack(target, e);
+      }
+    }
+  };
+
+  const micLive = (): boolean => {
+    const mic = room.localParticipant.getTrackPublication(
+      Track.Source.Microphone,
+    );
+    return (
+      !!mic && !mic.isMuted && mic.track?.mediaStreamTrack.readyState === "live"
+    );
+  };
+
+  // Each remote audio element: back on the held output, its stream assigned again (so the browser opens the output
+  // afresh) and played. Safari plays without a click only while the microphone is open, so there it only resumes.
+  const replay = (): void => {
+    const restart = !isSafari() || micLive();
+    for (const participant of room.remoteParticipants.values()) {
+      for (const publication of participant.audioTrackPublications.values()) {
+        const track = publication.track as RemoteAudioTrack | undefined;
+        for (const element of track?.attachedElements ?? []) {
+          const sinkElement = element as HTMLMediaElement & {
+            sinkId?: string;
+            setSinkId?: (id: string) => Promise<void>;
+          };
+          if (
+            held !== undefined &&
+            sinkElement.setSinkId &&
+            !same(sinkElement.sinkId, held)
+          )
+            sinkElement.setSinkId(held).catch((e: unknown) => {
+              log.warn(`could not put an element on output ${held}`, e);
+            });
+          if (restart && element.srcObject) {
+            const stream = element.srcObject;
+            element.srcObject = null;
+            element.srcObject = stream;
+          }
+          if (restart || element.paused)
+            element.play().catch((e: unknown) => {
+              if ((e as Error | undefined)?.name === "NotAllowedError")
+                setBlocked(room, true);
+            });
+        }
+      }
+    }
+  };
+
+  // Some time after a change: the choice again (unless it has gone), held, and every element played afresh.
+  function settle(why: string): void {
+    clearTimeout(timer);
+    timer = setTimeout(() => {
+      log.info(`playing the call afresh after ${why}`);
+      const target = chosen;
+      void (async (): Promise<void> => {
+        const there = target === undefined || (await listed(target));
+        if (chosen !== target) return; // a newer choice holds itself
+        if (!there)
+          log.warn(`output ${target} is gone, using the browser default`);
+        held = there ? target : "";
+        await hold();
+        replay();
+      })();
+    }, SETTLE_MS);
+  }
+
+  void hold();
+
+  room
+    .on(RoomEvent.ActiveDeviceChanged, (kind: MediaDeviceKind, id: string) => {
+      if (kind === "audiooutput") {
+        if (held !== undefined && !same(id, held)) {
+          log.info(`LiveKit moved the output to ${id}, holding ${held}`);
+          void hold();
+        }
+      } else if (kind === "audioinput") {
+        settle("a microphone change");
+      }
+    })
+    .on(RoomEvent.MediaDevicesChanged, () => {
+      // a device came or went: try the choice again (it may be back), then hold whatever can be used
+      held = chosen;
+      void hold();
+      settle("a device change");
+    })
+    .on(RoomEvent.AudioPlaybackStatusChanged, () =>
+      setBlocked(room, !room.canPlaybackAudio),
+    )
+    .on(RoomEvent.Connected, () => {
+      subscription ??= selected$.subscribe((device) => {
+        chosen = device?.id;
+        held = chosen;
+        retried = false;
+        void hold();
+      });
+    })
+    .on(RoomEvent.Disconnected, () => {
+      subscription?.unsubscribe();
+      subscription = undefined;
+      clearTimeout(timer);
+      setBlocked(room, false);
+    });
+
+  // The microphone stays open while muted (stopMicTrackOnMute: false), so the headset changes mode when it opens.
+  room.localParticipant.on(
+    ParticipantEvent.LocalTrackPublished,
+    (publication: LocalTrackPublication) => {
+      if (publication.source === Track.Source.Microphone)
+        settle("the microphone opened");
+    },
+  );
+}
