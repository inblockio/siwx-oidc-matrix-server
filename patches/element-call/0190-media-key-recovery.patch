+
+const USER_ID = "@alice:example.org";
+const DEVICE_ID = "ALICEDEVICE";
+const ROOM_ID = "!room:example.org";
+const STATE_KEY = `_${USER_ID}_${DEVICE_ID}_m.call`;
+const SLOT = { application: "m.call", id: "ROOM" };
+const SECRET_KEY = "c2VjcmV0LW1lZGlhLWtleS1ub3QtZm9yLWxvZ3M=";
+const SECRET_KEY_1 = "c2Vjb25kLW1lZGlhLWtleS1ub3QtZm9yLWxvZ3M=";
+
+const PEER = { userId: "@bob:example.org", deviceId: "BOBDEVICE" };
+const PEER_2 = { userId: "@carol:example.org", deviceId: "CAROLDEVICE" };
+const PAYLOAD = keyPayload(0);
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date("2026-10-24T12:00:00Z"));
+  vi.spyOn(logger, "info").mockImplementation(() => {});
+  vi.spyOn(logger, "warn").mockImplementation(() => {});
+});
+
+afterEach(() => {
+  uninstallKeyRecovery();
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+describe("SessionGate", () => {
+  it("starts a new generation and tells the listeners on every join and leave", () => {
+    const gate = new SessionGate();
+    const listener = vi.fn();
+    const stop = gate.onReset(listener);
+
+    expect(gate.isJoined()).toBe(false);
+    const idle = gate.generation;
+    gate.setJoined(true);
+    expect(gate.isJoined()).toBe(true);
+    expect(gate.isCurrent(gate.generation)).toBe(true);
+    expect(gate.isCurrent(idle)).toBe(false);
+    expect(listener).toHaveBeenCalledTimes(1);
+
+    // no change, no new generation
+    gate.setJoined(true);
+    expect(listener).toHaveBeenCalledTimes(1);
+
+    const joinedAs = gate.generation;
+    gate.setJoined(false);
+    expect(gate.isCurrent(joinedAs)).toBe(false);
+    gate.setJoined(true);
+    expect(gate.isCurrent(joinedAs)).toBe(false);
+    expect(listener).toHaveBeenCalledTimes(3);
+
+    stop();
+    gate.setJoined(false);
+    expect(listener).toHaveBeenCalledTimes(3);
+  });
+});
+
+describe("wrapKeySend", () => {
+  it("settles with a successful first attempt at once, no timer is waited for", async () => {
+    const { client } = keySendClient();
+    wrapKeySend(client, joinedGate());
+
+    let settled = false;
+    const result = sendKey(client, [PEER]).then(() => {
+      settled = true;
+    });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(settled).toBe(true);
+    await result;
+  });
+
+  it("rejects with the first attempt's error at once and retries in the background", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout 1"));
+    send.mockRejectedValueOnce(new Error("timeout 2"));
+    wrapKeySend(client, joinedGate());
+
+    let outcome: unknown;
+    void sendKey(client, [PEER])
+      .then(
+        () => "resolved",
+        (e: unknown) => e,
+      )
+      .then((o) => {
+        outcome = o;
+      });
+    // Not one tick of the clock: the caller has its answer already.
+    await vi.advanceTimersByTimeAsync(0);
+    expect(outcome).toEqual(new Error("timeout 1"));
+    expect(send).toHaveBeenCalledTimes(1);
+
+    await vi.advanceTimersByTimeAsync(1_999);
+    expect(send).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(9_999);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(3);
+  });
+
+  it("gives up after three failed attempts and sends nothing later", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValue(new Error("down"));
+    wrapKeySend(client, joinedGate());
+
+    await expect(sendKey(client, [PEER])).rejects.toThrow("down");
+    await vi.advanceTimersByTimeAsync(120_000);
+    expect(send).toHaveBeenCalledTimes(3);
+    expect(logger.warn).toHaveBeenCalledWith(
+      expect.stringContaining("failed for good"),
+    );
+  });
+
+  it("does not retry a host without to-device support", async () => {
+    const { client, send } = keySendClient();
+    const unsupported = new Error("this action is not supported");
+    send.mockRejectedValue(unsupported);
+    wrapKeySend(client, joinedGate());
+
+    await expect(sendKey(client, [PEER])).rejects.toBe(unsupported);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(1);
+  });
+
+  it("sends the same key again 5 s and 15 s after it got through", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, [PEER]);
+    expect(send).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(4_999);
+    expect(send).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(9_999);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(3);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(3);
+
+    for (const call of send.mock.calls) {
+      expect(call).toEqual([
+        EventType.CallEncryptionKeysPrefix,
+        [PEER],
+        PAYLOAD,
+      ]);
+    }
+  });
+
+  it("repeats and retries although the client says it is not running (the widget client never starts)", async () => {
+    const { client, send } = keySendClient();
+    const widgetLikeClient = Object.assign(client, { clientRunning: false });
+    wrapKeySend(widgetLikeClient, joinedGate());
+
+    await sendKey(widgetLikeClient, [PEER]);
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(3);
+
+    send.mockClear();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    await sendKey(widgetLikeClient, [PEER], keyPayload(1)).catch(() => {});
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(4);
+  });
+
+  it("counts the repeated sends from the send that got through", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, [PEER]).catch(() => {});
+    await vi.advanceTimersByTimeAsync(2_000);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(5_000);
+    expect(send).toHaveBeenCalledTimes(3);
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(send).toHaveBeenCalledTimes(4);
+  });
+
+  it("repeats the send for 8 target devices but not for 9", async () => {
+    const eight = peers(8);
+    const nine = peers(9);
+    const { client, send } = keySendClient();
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, eight);
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(3);
+
+    send.mockClear();
+    await sendKey(client, nine, keyPayload(1));
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(1);
+  });
+
+  it("still retries a failed send to more than 8 devices", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, peers(9)).catch(() => {});
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(2);
+  });
+
+  it("leaves other event types untouched", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValue(new Error("nope"));
+    wrapKeySend(client, joinedGate());
+
+    await expect(
+      client.encryptAndSendToDevice("m.call.invite", [PEER], { a: 1 }),
+    ).rejects.toThrow("nope");
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+    expect(send).toHaveBeenCalledWith("m.call.invite", [PEER], { a: 1 });
+  });
+
+  it("repeats nothing in a session that was never joined", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client, new SessionGate());
+
+    await sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("stops repeating once we left", async () => {
+    const { client, send } = keySendClient();
+    const gate = joinedGate();
+    wrapKeySend(client, gate);
+
+    await sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(4_999);
+    gate.setJoined(false);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("stops retrying once we left", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValue(new Error("timeout"));
+    const gate = joinedGate();
+    wrapKeySend(client, gate);
+
+    await sendKey(client, [PEER]).catch(() => {});
+    await vi.advanceTimersByTimeAsync(1_000);
+    gate.setJoined(false);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("does not let a key of an earlier join overwrite the key of the new join", async () => {
+    // after an in-page rejoin the encryption manager starts again at index 0
+    const oldKey = keyPayload(0, SECRET_KEY);
+    const newKey = keyPayload(0, SECRET_KEY_1);
+    const { client, send } = keySendClient();
+    const gate = joinedGate();
+    wrapKeySend(client, gate);
+
+    await sendKey(client, [PEER], oldKey);
+    await vi.advanceTimersByTimeAsync(1_000);
+    gate.setJoined(false);
+    gate.setJoined(true);
+    await sendKey(client, [PEER], newKey);
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(send.mock.calls.map((call) => call[2])).toEqual([
+      oldKey,
+      newKey,
+      newKey,
+      newKey,
+    ]);
+  });
+
+  it("drops the pending copies of the earlier join before the new join sent a key", async () => {
+    const { client, send } = keySendClient();
+    const gate = joinedGate();
+    wrapKeySend(client, gate);
+
+    await sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(1_000);
+    gate.setJoined(false);
+    gate.setJoined(true);
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("stops the retries of a send that was in flight when we left", async () => {
+    const { client, send } = keySendClient();
+    const gate = joinedGate();
+    let fail: (e: Error) => void = () => {};
+    send.mockReturnValueOnce(
+      new Promise<void>((_resolve, reject) => {
+        fail = reject;
+      }),
+    );
+    wrapKeySend(client, gate);
+
+    const result = sendKey(client, [PEER]).catch(() => {});
+    gate.setJoined(false);
+    fail(new Error("timeout"));
+    await result;
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("drops the pending copies of an older key when a newer key goes out", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, [PEER], keyPayload(0, SECRET_KEY));
+    await vi.advanceTimersByTimeAsync(3_000);
+    await sendKey(client, [PEER], keyPayload(1, SECRET_KEY_1));
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(send.mock.calls.map((call) => call[2].keys.index)).toEqual([
+      0, 1, 1, 1,
+    ]);
+  });
+
+  it("drops the retry of an older key when a newer key goes out", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, [PEER], keyPayload(0, SECRET_KEY)).catch(() => {});
+    await vi.advanceTimersByTimeAsync(1_000);
+    await sendKey(client, [PEER], keyPayload(1, SECRET_KEY_1));
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(send.mock.calls.map((call) => call[2].keys.index)).toEqual([
+      0, 1, 1, 1,
+    ]);
+  });
+
+  it("drops the retry of an older key that was still in flight when a newer key goes out", async () => {
+    const { client, send } = keySendClient();
+    let fail: (e: Error) => void = () => {};
+    send.mockReturnValueOnce(
+      new Promise<void>((_resolve, reject) => {
+        fail = reject;
+      }),
+    );
+    wrapKeySend(client, joinedGate());
+
+    const first = sendKey(client, [PEER], keyPayload(0, SECRET_KEY)).catch(
+      () => {},
+    );
+    await sendKey(client, [PEER], keyPayload(1, SECRET_KEY_1));
+    fail(new Error("timeout"));
+    await first;
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    expect(send.mock.calls.map((call) => call[2].keys.index)).toEqual([
+      0, 1, 1, 1,
+    ]);
+  });
+
+  it("keeps the copies of a key that goes out again to other devices", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(1_000);
+    await sendKey(client, [PEER_2]);
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    const targets = send.mock.calls.map((call) => call[1][0].userId);
+    expect(targets.filter((t) => t === PEER.userId)).toHaveLength(3);
+    expect(targets.filter((t) => t === PEER_2.userId)).toHaveLength(3);
+  });
+
+  it("wraps a client only once", async () => {
+    const { client, send } = keySendClient();
+    const gate = joinedGate();
+    const unwrap = wrapKeySend(client, gate);
+    expect(wrapKeySend(client, gate)).toBe(unwrap);
+
+    await sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(3);
+  });
+
+  it("restores the client and drops what is pending when unwrapped", async () => {
+    const { client, send } = keySendClient();
+    const stock = client.encryptAndSendToDevice;
+    const unwrap = wrapKeySend(client, joinedGate());
+    expect(client.encryptAndSendToDevice).not.toBe(stock);
+
+    await sendKey(client, [PEER]);
+    unwrap();
+    expect(client.encryptAndSendToDevice).toBe(stock);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("never logs the key", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client, joinedGate());
+
+    await sendKey(client, [PEER]).catch(() => {});
+    await vi.advanceTimersByTimeAsync(20_000);
+    await sendKey(client, [PEER], keyPayload(1, SECRET_KEY_1));
+    await vi.advanceTimersByTimeAsync(20_000);
+
+    const logged = [
+      ...vi.mocked(logger.info).mock.calls,
+      ...vi.mocked(logger.warn).mock.calls,
+    ];
+    expect(logged.length).toBeGreaterThan(0);
+    expect(JSON.stringify(logged)).not.toContain(SECRET_KEY);
+    expect(JSON.stringify(logged)).not.toContain(SECRET_KEY_1);
+  });
+});
+
+describe("KeyRecoveryWatchdog", () => {
+  it("runs the recovery action once when no key arrives within 8 s", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(7_999);
+    expect(recover).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledExactlyOnceWith("bob");
+  });
+
+  it("does nothing when the key arrives within 8 s", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(5_000);
+    watchdog.onKeyReceived("bob", 0);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(recover).not.toHaveBeenCalled();
+  });
+
+  it("is driven by the first error, later errors change nothing", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(5_000);
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(2_999);
+    expect(recover).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledOnce();
+    // livekit sends no more errors, the second action comes anyway
+    await vi.advanceTimersByTimeAsync(15_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+  });
+
+  it("spaces the two actions of an episode 15 s apart and stops there", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(recover).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(14_999);
+    expect(recover).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledTimes(2);
+
+    // more errors in the same episode start nothing
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(30_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+  });
+
+  it("closes a spent episode 60 s after its last action, a later failure starts a new one", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(23_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+
+    // still the same episode, the error is ignored
+    await vi.advanceTimersByTimeAsync(59_999);
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledTimes(2);
+
+    // closed now
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
