+describe("key recovery", () => {
+  function watchdogSpies(): {
+    onEncryptionError: ReturnType<typeof vi.fn>;
+    onParticipantGone: ReturnType<typeof vi.fn>;
+    onConnectionClosed: ReturnType<typeof vi.fn>;
+  } {
