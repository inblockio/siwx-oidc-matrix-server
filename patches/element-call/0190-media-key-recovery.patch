+
+import { EventEmitter } from "node:events";
+
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { renderHook, waitFor } from "@testing-library/react";
+import { KnownMembership } from "matrix-js-sdk/lib/@types/membership";
+import { SyncState, type MatrixClient } from "matrix-js-sdk";
+import { MatrixRTCSessionEvent } from "matrix-js-sdk/lib/matrixrtc";
+
+import { useLoadGroupCall } from "./useLoadGroupCall";
+import { installKeyRecovery, uninstallKeyRecovery } from "../e2ee/keyRecovery";
+
+const ROOM_ID = "!room:example.org";
+
+/** The parts of a MatrixRTCSession that the loading and key recovery use. */
+class FakeSession extends EventEmitter {
+  public memberships: unknown[] = [];
+  public readonly slotDescription = { application: "m.call", id: "ROOM" };
+  public isJoined(): boolean {
+    return false;
+  }
+}
+
+function loadableClient(session: FakeSession): MatrixClient {
+  return {
+    getSyncState: () => SyncState.Syncing,
+    getRoom: () => ({
+      roomId: ROOM_ID,
+      getMyMembership: () => KnownMembership.Join,
+    }),
+    waitUntilRoomReadyForGroupCalls: async () => Promise.resolve(),
+    matrixRTC: { getRoomSession: () => session },
+    on: vi.fn(),
+    off: vi.fn(),
+  } as unknown as MatrixClient;
+}
+
+afterEach(() => {
+  uninstallKeyRecovery();
+});
+
+describe("useLoadGroupCall", () => {
+  it("hands the session of the call to the media key recovery", async () => {
+    installKeyRecovery(
+      {
+        encryptAndSendToDevice: vi.fn(),
+        getRoom: vi.fn(),
+        getUserId: vi.fn(),
+        getDeviceId: vi.fn(),
+        sendStateEvent: vi.fn(),
+      },
+      ROOM_ID,
+    );
+    const session = new FakeSession();
+
+    const { result } = renderHook(() =>
+      useLoadGroupCall(loadableClient(session), ROOM_ID, []),
+    );
+    await waitFor(() => expect(result.current.kind).toBe("loaded"));
+
+    expect(session.listenerCount(MatrixRTCSessionEvent.JoinStateChanged)).toBe(
+      1,
+    );
+    expect(
+      session.listenerCount(MatrixRTCSessionEvent.EncryptionKeyChanged),
+    ).toBe(1);
+  });
+
+  it("leaves the session alone when media key recovery is not installed", async () => {
+    const session = new FakeSession();
+
+    const { result } = renderHook(() =>
+      useLoadGroupCall(loadableClient(session), ROOM_ID, []),
+    );
+    await waitFor(() => expect(result.current.kind).toBe("loaded"));
+
+    expect(session.listenerCount(MatrixRTCSessionEvent.JoinStateChanged)).toBe(
+      0,
+    );
+  });
+});
