@@ -0,0 +1,370 @@
+/*
+Copyright 2026 Aqua Meet contributors
+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+/**
+ * Key recovery on the real path of a call in the widget: the actual js-sdk
+ * RoomWidgetClient (with a mocked widget API), the actual MatrixRTCSession with
+ * its MembershipManager, ToDeviceKeyTransport and RTCEncryptionManager. Only the
+ * host (widget API) and the room state are faked.
+ */
+
+import { EventEmitter } from "node:events";
+
+import {
+  afterEach,
+  beforeEach,
+  describe,
+  expect,
+  it,
+  type Mock,
+  vi,
+} from "vitest";
+import {
+  createRoomWidgetClient,
+  EventType,
+  MatrixEvent,
+  RoomState,
+  type MatrixClient,
+  type Room,
+} from "matrix-js-sdk";
+import { logger } from "matrix-js-sdk/lib/logger";
+import {
+  MatrixRTCSession,
+  MatrixRTCSessionEvent,
+} from "matrix-js-sdk/lib/matrixrtc";
+import { type WidgetApi } from "matrix-widget-api";
+
+import {
+  bindKeyRecoverySession,
+  getKeyRecoveryWatchdog,
+  installKeyRecovery,
+  ownMembershipStateKey,
+  uninstallKeyRecovery,
+} from "./keyRecovery";
+
+const ROOM_ID = "!room:example.org";
+const ALICE = { userId: "@alice:example.org", deviceId: "ALICEDEVICE" };
+const BOB = { userId: "@bob:example.org", deviceId: "BOBDEVICE" };
+const SLOT = { application: "m.call", id: "ROOM" };
+const KEY_DELAY_MS = 1_000;
+
+interface SentToDevice {
+  eventType: string;
+  encrypted: boolean;
+  content: Record<
+    string,
+    Record<string, { keys?: { index: number; key: string } }>
+  >;
+}
+
+let widgetApi: MockWidgetApi;
+let client: MatrixClient;
+let state: RoomState;
+let session: MatrixRTCSession;
+
+/** The host side of the widget API: records what the widget sends, can fail it. */
+class MockWidgetApi extends EventEmitter {
+  public start = vi.fn().mockResolvedValue(undefined);
+  public getClientVersions = vi.fn().mockResolvedValue([]);
+  public requestCapability = vi.fn().mockResolvedValue(undefined);
+  public requestCapabilityForRoomTimeline = vi
+    .fn()
+    .mockResolvedValue(undefined);
+  public requestCapabilityToSendEvent = vi.fn().mockResolvedValue(undefined);
+  public requestCapabilityToReceiveEvent = vi.fn().mockResolvedValue(undefined);
+  public requestCapabilityToSendState = vi.fn().mockResolvedValue(undefined);
+  public requestCapabilityToReceiveState = vi.fn().mockResolvedValue(undefined);
+  public requestCapabilityToSendToDevice = vi.fn().mockResolvedValue(undefined);
+  public requestCapabilityToReceiveToDevice = vi
+    .fn()
+    .mockResolvedValue(undefined);
+  public cancelScheduledDelayedEvent = vi.fn().mockResolvedValue(undefined);
+  public restartScheduledDelayedEvent = vi.fn().mockResolvedValue(undefined);
+  public sendScheduledDelayedEvent = vi.fn().mockResolvedValue(undefined);
+  public sendContentLoaded = vi.fn().mockResolvedValue(undefined);
+  public transport = { send: vi.fn(), sendComplete: vi.fn() };
+
+  public sendToDevice = vi.fn(
+    async (
+      _eventType: string,
+      _encrypted: boolean,
+      _content: SentToDevice["content"],
+    ): Promise<void> => Promise.resolve(),
+  );
+
+  /** Writes the event into the room state like the host would echo it. */
+  public sendStateEvent = vi.fn(
+    async (
+      eventType: string,
+      stateKey: string,
+      content: object,
+      _roomId?: string,
+      delay?: number,
+      parentDelayId?: string,
+    ): Promise<{ delay_id?: string; event_id?: string }> => {
+      if (delay !== undefined || parentDelayId !== undefined)
+        return Promise.resolve({ delay_id: `delay-${Math.random()}` });
+      const eventId = `$${Math.random()}`;
+      state.setStateEvents([
+        new MatrixEvent({
+          event_id: eventId,
+          type: eventType,
+          state_key: stateKey,
+          sender: ALICE.userId,
+          room_id: ROOM_ID,
+          content,
+        }),
+      ]);
+      return Promise.resolve({ event_id: eventId });
+    },
+  );
+}
+
+/** loglevel, which the js-sdk logger is, has these; the typings do not show them. */
+interface LevelControl {
+  getLevel: () => number;
+  setLevel: (level: number) => void;
+  levels: { SILENT: number };
+}
+const logLevels = logger as unknown as LevelControl;
+let logLevel: number;
+
+beforeEach(() => {
+  // the js-sdk logs every membership action
+  logLevel = logLevels.getLevel();
+  logLevels.setLevel(logLevels.levels.SILENT);
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date("2026-10-24T12:00:00Z"));
+  vi.spyOn(logger, "info").mockImplementation(() => {});
+  vi.spyOn(logger, "debug").mockImplementation(() => {});
+  vi.spyOn(logger, "warn").mockImplementation(() => {});
+
+  widgetApi = new MockWidgetApi();
+  client = createRoomWidgetClient(
+    widgetApi as unknown as WidgetApi,
+    { sendToDevice: [EventType.CallEncryptionKeysPrefix] },
+    ROOM_ID,
+    {
+      baseUrl: "https://hs.example.org",
+      userId: ALICE.userId,
+      deviceId: ALICE.deviceId,
+    },
+    false,
+  );
+  vi.spyOn(client, "doesServerSupportUnstableFeature").mockResolvedValue(true);
+
+  state = new RoomState(ROOM_ID);
+  const room = Object.assign(new EventEmitter(), {
+    roomId: ROOM_ID,
+    currentState: state,
+    getVersion: () => "10",
+    hasMembershipState: () => true,
+    getLiveTimeline: () => ({ getState: () => state }),
+    _unstable_getStickyEvents: () => [],
+  }) as unknown as Room;
+  client.store.storeRoom(room);
+
+  installKeyRecovery(client, ROOM_ID);
+  session = new MatrixRTCSession(client, room, SLOT);
+  bindKeyRecoverySession(session);
+});
+
+afterEach(async () => {
+  await session.leaveRoomSession(1).catch(() => {});
+  uninstallKeyRecovery();
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  logLevels.setLevel(logLevel);
+});
+
+async function join(): Promise<void> {
+  session.joinRTCSession(
+    { ...ALICE, memberId: `${ALICE.userId}:${ALICE.deviceId}` },
+    [],
+    {
+      type: "livekit",
+      livekit_service_url: "https://sfu.example.org",
+    },
+    {
+      manageMediaKeys: true,
+      makeKeyDelay: KEY_DELAY_MS,
+      delayedLeaveEventDelayMs: 8_000,
+      delayedLeaveEventRestartMs: 4_000,
+    },
+  );
+  await vi.advanceTimersByTimeAsync(0);
+}
+
+/** Bob is in the call, as the host's state echo would tell. */
+async function bobJoins(): Promise<void> {
+  state.setStateEvents([
+    new MatrixEvent({
+      event_id: "$bob-membership",
+      type: EventType.GroupCallMemberPrefix,
+      state_key: `_${BOB.userId}_${BOB.deviceId}_m.call`,
+      sender: BOB.userId,
+      room_id: ROOM_ID,
+      content: {
+        application: "m.call",
+        call_id: "",
+        scope: "m.room",
+        device_id: BOB.deviceId,
+        created_ts: Date.now(),
+        expires: 14_400_000,
+        focus_active: { type: "livekit", focus_selection: "oldest_membership" },
+        foci_preferred: [
+          { type: "livekit", livekit_service_url: "https://sfu.example.org" },
+        ],
+      },
+    }),
+  ]);
+  await session._onRTCSessionMemberUpdate();
+  await vi.advanceTimersByTimeAsync(0);
+}
+
+function keySends(): SentToDevice[] {
+  return (widgetApi.sendToDevice as Mock).mock.calls
+    .filter((call) => call[0] === EventType.CallEncryptionKeysPrefix)
+    .map(([eventType, encrypted, content]) => ({
+      eventType,
+      encrypted,
+      content,
+    }));
+}
+
+function sentKeys(): string[] {
+  return keySends().map(
+    (send) => Object.values(send.content[BOB.userId])[0].keys!.key,
+  );
+}
+
+function membershipWrites(): { stateKey: string; content: object }[] {
+  return widgetApi.sendStateEvent.mock.calls
+    .filter(
+      ([eventType, , , , delay, parent]) =>
+        eventType === EventType.GroupCallMemberPrefix &&
+        delay === undefined &&
+        parent === undefined,
+    )
+    .map(([, stateKey, content]) => ({ stateKey, content }));
+}
+
+describe("key recovery with the real widget client and session", () => {
+  it("runs on a client that never started, where clientRunning stays false", async () => {
+    expect(client.clientRunning).toBe(false);
+    expect(client.encryptAndSendToDevice).not.toBe(
+      Object.getPrototypeOf(client).encryptAndSendToDevice,
+    );
+
+    await join();
+    await bobJoins();
+    await vi.advanceTimersByTimeAsync(KEY_DELAY_MS);
+
+    // The first copy of the key goes out at once.
+    const first = keySends();
+    expect(first).toHaveLength(1);
+    expect(first[0].encrypted).toBe(true);
+    expect(Object.keys(first[0].content)).toEqual([BOB.userId]);
+
+    // The same key goes out again after 5 s and after 15 s.
+    await vi.advanceTimersByTimeAsync(4_000);
+    expect(keySends()).toHaveLength(2);
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(keySends()).toHaveLength(3);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(keySends()).toHaveLength(3);
+    expect(new Set(sentKeys()).size).toBe(1);
+  });
+
+  it("does not hold the key distribution while the host fails the sends", async () => {
+    widgetApi.sendToDevice.mockRejectedValue(new Error("host timeout"));
+    const ownKeys = vi.fn();
+    session.on(MatrixRTCSessionEvent.EncryptionKeyChanged, ownKeys);
+
+    await join();
+    await bobJoins();
+    // our own key is rolled out after the key delay, not after the retries
+    await vi.advanceTimersByTimeAsync(KEY_DELAY_MS + 100);
+
+    expect(widgetApi.sendToDevice).toHaveBeenCalledTimes(1);
+    expect(ownKeys).toHaveBeenCalled();
+
+    // the retries go on in the background
+    await vi.advanceTimersByTimeAsync(2_000);
+    expect(widgetApi.sendToDevice).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(widgetApi.sendToDevice).toHaveBeenCalledTimes(3);
+  });
+
+  it("derives the state key that the real MembershipManager writes", async () => {
+    await join();
+    await bobJoins();
+
+    const [written] = membershipWrites();
+    expect(written.stateKey).toBe(
+      ownMembershipStateKey(ALICE.userId, ALICE.deviceId, SLOT, "10"),
+    );
+  });
+
+  it("makes the peers send their keys again by refreshing our membership", async () => {
+    await join();
+    await bobJoins();
+    const before = membershipWrites();
+    expect(before).toHaveLength(1);
+
+    getKeyRecoveryWatchdog()?.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+
+    const after = membershipWrites();
+    expect(after).toHaveLength(2);
+    expect(after[1].stateKey).toBe(before[0].stateKey);
+    expect(after[1].content).toEqual({
+      ...before[0].content,
+      created_ts: Date.now(),
+    });
+  });
+
+  it("sends no membership after we left, not even from a timer that was running", async () => {
+    await join();
+    await bobJoins();
+    const writes = membershipWrites().length;
+
+    getKeyRecoveryWatchdog()?.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(3_000);
+    await session.leaveRoomSession(1_000);
+    await vi.advanceTimersByTimeAsync(120_000);
+
+    expect(membershipWrites()).toHaveLength(writes);
+    // the repeats of our key stopped as well
+    expect(keySends().length).toBeLessThanOrEqual(2);
+  });
+
+  it("does not send the key of the old join again after an in-page rejoin", async () => {
+    await join();
+    await bobJoins();
+    await vi.advanceTimersByTimeAsync(KEY_DELAY_MS);
+    const [oldKey] = sentKeys();
+
+    await vi.advanceTimersByTimeAsync(2_000);
+    await session.leaveRoomSession(1_000);
+    await join();
+    // the old copies (5 s and 15 s after the first send) are due now, while
+    // the new join has not sent a key yet
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(sentKeys()).toEqual([oldKey]);
+    await bobJoins();
+    await vi.advanceTimersByTimeAsync(60_000);
+
+    const keys = sentKeys();
+    const lastOldKey = keys.lastIndexOf(oldKey);
+    const firstNewKey = keys.findIndex((key) => key !== oldKey);
+    expect(firstNewKey).toBeGreaterThan(-1);
+    // nothing of the old key after the new one went out
+    expect(lastOldKey).toBeLessThan(firstNewKey);
+    expect(keys.filter((key) => key === oldKey)).toHaveLength(1);
+  });
+});
