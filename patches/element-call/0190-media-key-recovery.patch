+function joinedGate(): SessionGate {
+  const gate = new SessionGate();
+  gate.setJoined(true);
+  return gate;
+}
+
+function joinedSession(): {
+  isJoined: Mock<() => boolean>;
+  slotDescription: typeof SLOT;
+} {
+  return { isJoined: vi.fn(() => true), slotDescription: SLOT };
+}
+
+function keyPayload(
+  index: number,
+  key = SECRET_KEY,
+): { keys: { index: number; key: string }; sent_ts: number } {
+  return { keys: { index, key }, sent_ts: 1 };
+}
+
+function keySendClient(): {
+  client: KeySendClient;
+  send: Mock<KeySendClient["encryptAndSendToDevice"]>;
+} {
+  const send = vi
+    .fn<KeySendClient["encryptAndSendToDevice"]>()
+    .mockResolvedValue(undefined);
+  return { client: { encryptAndSendToDevice: send }, send };
+}
+
+async function sendKey(
+  client: KeySendClient,
+  devices: { userId: string; deviceId: string }[],
+  payload: object = PAYLOAD,
+): Promise<void> {
+  await client.encryptAndSendToDevice(
+    EventType.CallEncryptionKeysPrefix,
+    devices,
+    payload,
+  );
+}
+
+function peers(count: number): { userId: string; deviceId: string }[] {
+  return Array.from({ length: count }, (_, i) => ({
+    userId: `@peer${i}:example.org`,
+    deviceId: `PEER${i}`,
+  }));
+}
+
+function newWatchdog(): {
+  watchdog: KeyRecoveryWatchdog;
+  recover: Mock<(identity: string) => Promise<unknown>>;
+  unavailable: Mock<(identity: string) => string | undefined>;
+} {
+  const recover = vi
+    .fn<(identity: string) => Promise<unknown>>()
+    .mockResolvedValue(undefined);
+  const unavailable = vi
+    .fn<(identity: string) => string | undefined>()
+    .mockReturnValue(undefined);
+  return {
+    watchdog: new KeyRecoveryWatchdog(recover, unavailable),
+    recover,
+    unavailable,
+  };
+}
+
+function membershipContent(extra: IContent = {}): IContent {
+  return {
+    application: "m.call",
+    call_id: "",
+    scope: "m.room",
+    device_id: DEVICE_ID,
+    membershipID: `${USER_ID}:${DEVICE_ID}`,
+    expires: 14_400_000,
+    focus_active: { type: "livekit", focus_selection: "oldest_membership" },
+    foci_preferred: [
+      { type: "livekit", livekit_service_url: "https://sfu.example.org" },
+    ],
+    ...extra,
+  };
+}
+
+function membershipEvent(
+  content: IContent,
+  {
+    sender = USER_ID,
+    stateKey = STATE_KEY,
+  }: { sender?: string; stateKey?: string } = {},
+): MatrixEvent {
+  return new MatrixEvent({
+    type: EventType.GroupCallMemberPrefix,
+    room_id: ROOM_ID,
+    sender,
+    state_key: stateKey,
+    content,
+  });
+}
+
+function ownMembershipClient(
+  events: MatrixEvent[],
+  roomVersion = "10",
+): {
+  client: OwnMembershipClient;
+  sendStateEvent: Mock<OwnMembershipClient["sendStateEvent"]>;
+  state: RoomState;
+} {
+  const state = new RoomState(ROOM_ID);
+  state.setStateEvents(events);
+  const sendStateEvent = vi
+    .fn<OwnMembershipClient["sendStateEvent"]>()
+    .mockResolvedValue({ event_id: "$new" });
+  const client: OwnMembershipClient = {
+    getRoom: (roomId) =>
+      roomId === ROOM_ID
+        ? ({
+            currentState: state,
+            getVersion: () => roomVersion,
+          } as unknown as Room)
+        : null,
+    getUserId: () => USER_ID,
+    getDeviceId: () => DEVICE_ID,
+    sendStateEvent,
+  };
+  return { client, sendStateEvent, state };
+}
+
+function installableClient(): {
+  client: KeySendClient & OwnMembershipClient;
+  send: Mock<KeySendClient["encryptAndSendToDevice"]>;
+  sendStateEvent: Mock<OwnMembershipClient["sendStateEvent"]>;
+  state: RoomState;
+} {
+  const { client: sendClient, send } = keySendClient();
+  const {
+    client: stateClient,
+    sendStateEvent,
+    state,
+  } = ownMembershipClient([membershipEvent(membershipContent())]);
+  return {
+    client: Object.assign(sendClient, stateClient),
+    send,
+    sendStateEvent,
+    state,
+  };
+}
