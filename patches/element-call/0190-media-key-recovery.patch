+
+SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE in the repository root for full details.
+*/
+
+/**
+ * Recovery from a lost call media key.
+ *
+ * A member's media key is sent once to each new joiner (MatrixRTC, per user,
+ * device and created_ts). If that single to-device message does not get through,
+ * nothing sends it again in a 1:1 call: the media stays undecryptable until
+ * someone rejoins. This module closes that gap in two layers:
+ *
+ * 1. {@link wrapKeySend} retries a failed key send and repeats a successful one,
+ *    in the background: the caller sees exactly what the first attempt did.
+ * 2. {@link KeyRecoveryWatchdog} notices a participant whose media cannot be
+ *    decrypted and whose key does not show up, and makes the peers send their
+ *    keys again by refreshing our own membership with a new `created_ts`
+ *    ({@link refreshOwnMembership}); a peer treats that as a new joiner.
+ *
+ * Everything that happens later than the first send is bound to the join state
+ * of our own MatrixRTC session ({@link SessionGate}, fed by
+ * {@link bindKeyRecoverySession}), never to `client.clientRunning`: the
+ * embedded (widget) client never starts the sync loop, so that flag stays false.
+ */
+
+import { EventType, type MatrixClient, type MatrixEvent } from "matrix-js-sdk";
+import { logger } from "matrix-js-sdk/lib/logger";
+import {
+  type MatrixRTCSession,
+  MatrixRTCSessionEvent,
+  type SessionMembershipData,
+  type SlotDescription,
+} from "matrix-js-sdk/lib/matrixrtc";
+
+/** Waits after a failed key send before the 2nd and the 3rd attempt. */
+const SEND_RETRY_DELAYS_MS = [2_000, 10_000];
+/** Delays, counted from the successful send, at which the same key is sent again. */
+const RESEND_DELAYS_MS = [5_000, 15_000];
+/** A larger call keeps the plain single send, the extra copies would add up. */
+const MAX_RESEND_TARGETS = 8;
+
+/** How long a key may take to arrive after the first decryption error. */
+const KEY_WAIT_MS = 8_000;
+/** Time between the two recovery actions of one episode. */
+const ACTION_SPACING_MS = 15_000;
+const MAX_ACTIONS_PER_EPISODE = 2;
+const MAX_ACTIONS_PER_CALL = 6;
+/**
+ * An episode that has no action left is closed this long after its last action,
+ * so that a later failure of the same participant can start a new one (still
+ * bounded by the per call cap).
+ */
+const SPENT_EPISODE_CLOSE_MS = 60_000;
+/**
+ * The membership refresh makes every peer treat us as a new joiner and rotate its
+ * key, which costs about N^2 to-device messages. Above this many members the
+ * refresh is not worth it and is not done.
+ */
+const MAX_MEMBERS_FOR_REFRESH = 8;
+
+type SendToDevice = MatrixClient["encryptAndSendToDevice"];
+type SendToDeviceArgs = Parameters<SendToDevice>;
+type Timer = ReturnType<typeof setTimeout>;
+
+export type KeySendClient = Pick<MatrixClient, "encryptAndSendToDevice">;
+export type OwnMembershipClient = Pick<
+  MatrixClient,
+  "getRoom" | "getUserId" | "getDeviceId" | "sendStateEvent"
+>;
+/** What key recovery needs from the MatrixRTC session of the call. */
+export type KeyRecoverySession = Pick<
+  MatrixRTCSession,
+  "isJoined" | "memberships" | "slotDescription" | "on" | "off"
+>;
+
+/**
+ * Whether OUR MatrixRTC session is joined, and which join it is. Every join and
+ * every leave starts a new generation and tells the listeners, which drop all
+ * pending work of the generation that ended: after an in-page rejoin the new
+ * encryption manager starts again at key index 0, an old send of index 0 would
+ * overwrite the new key at the receivers.
+ */
+export class SessionGate {
+  private joined = false;
+  private currentGeneration = 0;
+  private readonly resetListeners = new Set<() => void>();
+
+  public isJoined(): boolean {
+    return this.joined;
+  }
+
+  public get generation(): number {
+    return this.currentGeneration;
+  }
+
+  /** Whether work started in `generation` may still run: still joined, same join. */
+  public isCurrent(generation: number): boolean {
+    return this.joined && generation === this.currentGeneration;
+  }
+
+  public setJoined(joined: boolean): void {
+    if (joined === this.joined) return;
+    this.joined = joined;
+    this.currentGeneration++;
+    for (const listener of this.resetListeners) listener();
+  }
+
+  /** Called on every join and every leave. Returns the function that removes it. */
+  public onReset(listener: () => void): () => void {
+    this.resetListeners.add(listener);
+    return () => this.resetListeners.delete(listener);
+  }
+}
+
+interface PendingSend {
+  /** Identifies the key (index and material) in the payload. Never logged. */
+  readonly keyId: string;
+  readonly generation: number;
+  readonly args: SendToDeviceArgs;
+  readonly timers: Set<Timer>;
+}
+
+/**
+ * The call key sending of one client. The first attempt of a send is exactly the
+ * stock call, its outcome and timing reach the caller unchanged. Retries (after
+ * a failure) and repeats (after a success) run in the background, only for the
+ * LATEST key sent in the current generation of the session.
+ */
+class KeySender {
+  private readonly pending = new Set<PendingSend>();
+  private latestKeyId: string | undefined;
+
+  public constructor(
+    private readonly client: KeySendClient,
+    private readonly send: SendToDevice,
+    private readonly gate: SessionGate,
+  ) {}
+
+  public async sendKey(args: SendToDeviceArgs): Promise<void> {
+    const entry: PendingSend = {
+      keyId: keyIdOf(args[2]),
+      generation: this.gate.generation,
+      args,
+      timers: new Set(),
+    };
+    this.latestKeyId = entry.keyId;
+    // A newer key makes the copies of an older one obsolete. A late copy of an
+    // old key would also make a receiver believe the recovery has worked.
+    for (const other of this.pending) {
+      if (other.keyId !== entry.keyId) this.cancel(other);
+    }
+
+    try {
+      await this.send.apply(this.client, args);
+    } catch (e) {
+      this.scheduleRetry(entry, 0, e);
+      throw e;
+    }
+    this.scheduleRepeats(entry);
+  }
+
+  public cancelAll(): void {
+    for (const entry of this.pending) this.cancel(entry);
+    this.latestKeyId = undefined;
+  }
+
+  private cancel(entry: PendingSend): void {
+    for (const timer of entry.timers) clearTimeout(timer);
+    entry.timers.clear();
+    this.pending.delete(entry);
+  }
+
+  private isLive(entry: PendingSend): boolean {
+    return (
+      entry.keyId === this.latestKeyId && this.gate.isCurrent(entry.generation)
+    );
+  }
+
+  /** Runs `action` later, if the send is still the latest of its generation. */
+  private schedule(
+    entry: PendingSend,
+    delay: number,
+    action: () => Promise<void>,
+  ): void {
+    const timer = setTimeout(() => {
+      entry.timers.delete(timer);
+      if (this.isLive(entry)) {
+        // The action never rejects.
+        void action().finally(() => this.settle(entry));
+      } else {
+        this.settle(entry);
+      }
+    }, delay);
+    entry.timers.add(timer);
+    this.pending.add(entry);
+  }
+
+  private settle(entry: PendingSend): void {
+    if (entry.timers.size === 0) this.pending.delete(entry);
+  }
+
+  private scheduleRetry(
+    entry: PendingSend,
+    attempt: number,
+    cause: unknown,
+  ): void {
+    const devices = entry.args[1].length;
+    // A host without to-device support is reported by the key transport as a
+    // permanent condition, retrying would only delay that.
+    if (isUnsupportedByHost(cause) || !this.isLive(entry)) return;
+    const delay = SEND_RETRY_DELAYS_MS[attempt];
+    if (delay === undefined) {
+      logger.warn(
+        `[KeyRecovery] call key send to ${devices} device(s) failed for good: ${errorMessage(cause)}`,
+      );
+      return;
+    }
+    logger.info(
+      `[KeyRecovery] call key send to ${devices} device(s) failed, retrying in ${delay} ms: ${errorMessage(cause)}`,
+    );
+    this.schedule(entry, delay, async () => {
+      try {
+        await this.send.apply(this.client, entry.args);
+      } catch (e) {
+        this.scheduleRetry(entry, attempt + 1, e);
+        return;
+      }
+      this.scheduleRepeats(entry);
+    });
+  }
+
+  private scheduleRepeats(entry: PendingSend): void {
+    if (entry.args[1].length > MAX_RESEND_TARGETS || !this.isLive(entry))
+      return;
+    for (const delay of RESEND_DELAYS_MS) {
+      this.schedule(entry, delay, async () => {
+        logger.info(
+          `[KeyRecovery] sending the call key again to ${entry.args[1].length} device(s), ${delay} ms after it got through`,
+        );
+        try {
+          await this.send.apply(this.client, entry.args);
+        } catch (e) {
+          logger.warn(
+            `[KeyRecovery] repeated call key send to ${entry.args[1].length} device(s) failed: ${errorMessage(e)}`,
+          );
+        }
+      });
+    }
+  }
+}
+
+/** The key and its index of a call key payload, as one string, for comparing. */
+function keyIdOf(payload: SendToDeviceArgs[2]): string {
+  return JSON.stringify(payload["keys"] ?? null);
+}
+
+const wrappedClients = new WeakMap<object, () => void>();
+
+/**
+ * Makes the sending of call media keys more robust. Only the key event type is
+ * touched, every other to-device message passes through as before.
+ *
+ * The first attempt to send a key is exactly what the client does without this:
+ * the returned promise settles with its outcome as soon as it is known (js-sdk
+ * holds its key distribution and rotation on that promise). After that, in the
+ * background and only while the session is joined, for the latest key only:
+ *
+ * - A rejected send is retried after 2 s and again after 10 s. (Without this a
+ *   failed send is swallowed by the key transport and counted as delivered.)
+ * - A successful send, or a retry that got through, is repeated after 5 s and
+ *   after 15 s, so that a first copy the receiver could not decrypt (for example
+ *   an Olm session that was repaired meanwhile) is covered. Equal keys are
+ *   harmless for receivers. Only for up to 8 target devices.
+ *
+ * Wrap a client once, right after creating it. A second call changes nothing.
+ *
+ * @returns A function that cancels everything pending and restores the client.
+ */
+export function wrapKeySend(
+  client: KeySendClient,
+  gate: SessionGate,
+): () => void {
+  const existing = wrappedClients.get(client);
+  if (existing !== undefined) return existing;
+
+  const send = client.encryptAndSendToDevice;
+  const sender = new KeySender(client, send, gate);
+  const wrapper: SendToDevice = async (...args) => {
+    if (args[0] === EventType.CallEncryptionKeysPrefix)
+      return sender.sendKey(args);
+    return send.apply(client, args);
+  };
+  client.encryptAndSendToDevice = wrapper;
+  const stopListening = gate.onReset(() => sender.cancelAll());
+
+  const unwrap = (): void => {
+    stopListening();
+    sender.cancelAll();
+    if (client.encryptAndSendToDevice === wrapper)
+      client.encryptAndSendToDevice = send;
+    wrappedClients.delete(client);
+  };
+  wrappedClients.set(client, unwrap);
+  return unwrap;
+}
+
+/** The same test as ToDeviceKeyTransport uses for NotSupportedError. */
+function isUnsupportedByHost(e: unknown): boolean {
+  const message = errorMessage(e);
+  return (
+    (message.includes("unknown variant") &&
+      message.includes("send_to_device")) ||
+    message.includes("not supported")
+  );
+}
+
+function errorMessage(e: unknown): string {
+  return e instanceof Error ? e.message : String(e);
+}
+
+/**
+ * Watches for remote participants whose media cannot be decrypted because
+ * their key never arrived, and runs a recovery action for them.
+ *
+ * An episode starts with the FIRST decryption error of a participant. If no new
+ * key for that participant arrives within 8 s, the recovery action runs, and once
+ * more after 15 s if there is still none. An episode ends when a new key for the
+ * participant arrives, when the participant leaves or the connection it was
+ * seen on closes, and 60 s after its last action. At most 2 actions per episode
+ * and 6 per call.
+ *
+ * A "new" key is one with a higher index than every key installed for that
+ * participant before: LiveKit's errors do not say which index is missing, and a
+ * delayed copy of an older key (that is already installed) does not mean that the
+ * key in use has arrived. The count of indexes starts anew for a participant that
+ * left.
+ *
+ * The watchdog is driven by timers, not by a stream of errors: livekit
+ * throttles its encryption errors and stops emitting them once a key index
+ * is marked invalid.
+ */
+export class KeyRecoveryWatchdog {
+  private readonly episodes = new Map<string, Episode>();
+  private readonly highestKeyIndex = new Map<string, number>();
+  private actionsInCall = 0;
+
+  /**
+   * @param recover - The recovery action. Called with the LiveKit identity of
+   *   the participant that cannot be decrypted.
+   * @param unavailable - Tells why the recovery action cannot be done right
+   *   now, or `undefined` if it can. Such a round is logged and does not count
+   *   against the episode or the call.
+   */
+  public constructor(
+    private readonly recover: (identity: string) => Promise<unknown>,
+    private readonly unavailable: (
+      identity: string,
+    ) => string | undefined = () => undefined,
+  ) {}
+
+  /**
+   * A decryption error for a remote participant, given by LiveKit identity.
+   * @param source - What reported it (the LiveKit room), see {@link onConnectionClosed}.
+   */
+  public onEncryptionError(identity: string, source?: object): void {
+    // Later errors of a running episode change nothing, the timers drive it.
+    if (this.episodes.has(identity)) return;
+    const episode: Episode = { actions: 0, timer: undefined, source };
+    this.episodes.set(identity, episode);
+    this.scheduleAction(identity, episode, KEY_WAIT_MS);
+  }
+
+  /** A key for the participant was installed. */
+  public onKeyReceived(identity: string, keyIndex: number): void {
+    const highest = this.highestKeyIndex.get(identity);
+    // A copy of a key we already have says nothing about the one in use.
+    if (highest !== undefined && keyIndex <= highest) return;
+    this.highestKeyIndex.set(identity, keyIndex);
+    this.endEpisode(identity);
+  }
+
+  public onParticipantGone(identity: string): void {
+    this.endEpisode(identity);
+    this.highestKeyIndex.delete(identity);
+  }
+
+  /**
+   * A LiveKit connection is closed. LiveKit does not report the participants of
+   * a room that is disconnected as gone, so the episodes seen on it end here.
+   */
+  public onConnectionClosed(source: object): void {
+    for (const [identity, episode] of this.episodes) {
+      if (episode.source === source) this.endEpisode(identity);
+    }
+  }
+
+  /** Drops all running episodes, the key indexes seen and the call's action count. */
+  public reset(): void {
+    for (const episode of this.episodes.values()) clearTimeout(episode.timer);
+    this.episodes.clear();
+    this.highestKeyIndex.clear();
+    this.actionsInCall = 0;
+  }
+
+  private endEpisode(identity: string): void {
+    clearTimeout(this.episodes.get(identity)?.timer);
+    this.episodes.delete(identity);
+  }
+
+  private scheduleAction(
+    identity: string,
+    episode: Episode,
+    delay: number,
+  ): void {
+    episode.timer = setTimeout(() => {
+      this.runAction(identity, episode);
+    }, delay);
+  }
+
+  /** Keeps a spent episode for a while, then closes it. */
+  private closeLater(identity: string, episode: Episode): void {
+    episode.timer = setTimeout(() => {
+      if (this.episodes.get(identity) === episode)
+        this.episodes.delete(identity);
+    }, SPENT_EPISODE_CLOSE_MS);
+  }
+
+  private runAction(identity: string, episode: Episode): void {
+    const reason = this.unavailable(identity);
+    if (reason !== undefined) {
+      logger.info(
+        `[KeyRecovery] still no key from ${identity}, no recovery action: ${reason}`,
+      );
+      this.closeLater(identity, episode);
+      return;
+    }
+    if (this.actionsInCall >= MAX_ACTIONS_PER_CALL) {
+      logger.warn(
+        `[KeyRecovery] still no key from ${identity}, giving up (${MAX_ACTIONS_PER_CALL} recovery actions used in this call)`,
+      );
+      this.closeLater(identity, episode);
+      return;
+    }
+    episode.actions++;
+    this.actionsInCall++;
+    logger.info(
+      `[KeyRecovery] no key from ${identity} after a decryption error, recovery action ${episode.actions} of ${MAX_ACTIONS_PER_EPISODE} (${this.actionsInCall} of ${MAX_ACTIONS_PER_CALL} in this call)`,
+    );
+    this.recover(identity).catch((e: unknown) => {
+      logger.warn(`[KeyRecovery] recovery action failed: ${errorMessage(e)}`);
+    });
+    if (episode.actions < MAX_ACTIONS_PER_EPISODE) {
+      this.scheduleAction(identity, episode, ACTION_SPACING_MS);
+    } else {
+      this.closeLater(identity, episode);
+    }
+  }
+}
+
+interface Episode {
+  actions: number;
+  timer: Timer | undefined;
+  source: object | undefined;
+}
+
+/**
+ * The state key of our own call membership, the same one MembershipManager
+ * writes (`makeMembershipStateKey`): `_<user>_<device>_<application><slot id>`
+ * (no leading underscore in the two old room versions), the slot id empty for
+ * the default `m.call` / `ROOM` slot.
+ */
+export function ownMembershipStateKey(
+  userId: string,
+  deviceId: string,
+  slot: SlotDescription,
+  roomVersion: string,
+): string {
+  const slotId =
+    slot.application === "m.call" && slot.id === "ROOM" ? "" : slot.id;
+  const key = `${userId}_${deviceId}_${slot.application}${slotId}`;
+  return /^org\.matrix\.msc(3757|3779)\b/.test(roomVersion) ? key : `_${key}`;
+}
+
+/**
+ * Our own call membership state event of the session, if there is one with
+ * content: none in sticky event mode (the membership is not a state event), and
+ * an empty one once we left.
+ */
+function findOwnMembership(
+  client: OwnMembershipClient,
+  session: Pick<KeyRecoverySession, "slotDescription">,
+  roomId: string,
+): MatrixEvent | undefined {
+  const userId = client.getUserId();
+  const deviceId = client.getDeviceId();
+  const room = client.getRoom(roomId);
+  if (!userId || !deviceId || !room) return undefined;
+  const event = room.currentState.getStateEvents(
+    EventType.GroupCallMemberPrefix,
+    ownMembershipStateKey(
+      userId,
+      deviceId,
+      session.slotDescription,
+      room.getVersion(),
+    ),
+  );
+  if (event === null || event.getSender() !== userId) return undefined;
+  return Object.keys(event.getContent()).length > 0 ? event : undefined;
+}
+
+/**
+ * Sends our own call membership state event again with a fresh `created_ts`.
+ * The peers see a member they do not know (user, device and created_ts are new)
+ * and send us their media key again. Our delayed leave event stays in place.
+ *
+ * Does nothing, with a warning, when there is no such state event with content
+ * (sticky event mode, or we left), and nothing when the session is not joined:
+ * the check is made right before the event is sent, a refresh after the leave
+ * would put a ghost member into the room.
+ *
+ * @returns Whether the event was sent.
+ */
+export async function refreshOwnMembership(
+  client: OwnMembershipClient,
+  session: Pick<KeyRecoverySession, "isJoined" | "slotDescription">,
+  roomId: string,
+): Promise<boolean> {
+  const membership = findOwnMembership(client, session, roomId);
+  const stateKey = membership?.getStateKey();
+  if (membership === undefined || stateKey === undefined) {
+    logger.warn(
+      "[KeyRecovery] no call membership state event of our own, cannot refresh it",
+    );
+    return false;
+  }
+  if (!session.isJoined()) {
+    logger.info(
+      "[KeyRecovery] we left the call, not refreshing the membership",
+    );
+    return false;
+  }
+
+  await client.sendStateEvent(
+    roomId,
+    EventType.GroupCallMemberPrefix,
+    {
+      ...membership.getContent<SessionMembershipData>(),
+      created_ts: Date.now(),
+    },
+    stateKey,
+  );
+  logger.info(
+    "[KeyRecovery] sent our call membership again with a new created_ts",
+  );
+  return true;
+}
+
+/** Everything of one installed key recovery. */
+class KeyRecovery {
+  public readonly gate = new SessionGate();
+  public readonly watchdog: KeyRecoveryWatchdog;
+  private session: KeyRecoverySession | undefined;
+  private unbindSession: (() => void) | undefined;
+  private readonly unwrap: () => void;
+  private readonly stopListening: () => void;
+
+  public constructor(
+    private readonly client: KeySendClient & OwnMembershipClient,
+    private readonly roomId: string,
+  ) {
+    this.watchdog = new KeyRecoveryWatchdog(
+      async () =>
+        this.session !== undefined &&
+        (await refreshOwnMembership(this.client, this.session, this.roomId)),
+      () => this.refreshBlocker(),
+    );
+    this.unwrap = wrapKeySend(client, this.gate);
+    // Every join and every leave: nothing of the call before may go on.
+    this.stopListening = this.gate.onReset(() => this.watchdog.reset());
+  }
+
+  /** Follows the join state and the incoming keys of the call's session. */
+  public bind(session: KeyRecoverySession): void {
+    if (this.session === session) return;
+    this.unbindSession?.();
+    this.session = session;
+    const onJoinStateChanged = (joined: boolean): void =>
+      this.gate.setJoined(joined);
+    const onEncryptionKeyChanged = (
+      _key: unknown,
+      keyIndex: number,
+      _membership: unknown,
+      rtcBackendIdentity: string,
+    ): void => this.watchdog.onKeyReceived(rtcBackendIdentity, keyIndex);
+    session.on(MatrixRTCSessionEvent.JoinStateChanged, onJoinStateChanged);
+    session.on(
+      MatrixRTCSessionEvent.EncryptionKeyChanged,
+      onEncryptionKeyChanged,
+    );
+    this.gate.setJoined(session.isJoined());
+    this.unbindSession = (): void => {
+      session.off(MatrixRTCSessionEvent.JoinStateChanged, onJoinStateChanged);
+      session.off(
+        MatrixRTCSessionEvent.EncryptionKeyChanged,
+        onEncryptionKeyChanged,
+      );
+      this.session = undefined;
+      this.gate.setJoined(false);
+    };
+  }
+
+  public dispose(): void {
+    this.unbindSession?.();
+    this.stopListening();
+    this.unwrap();
+    this.watchdog.reset();
+  }
+
+  /** Why the membership refresh cannot be done now, if it cannot. */
+  private refreshBlocker(): string | undefined {
+    const session = this.session;
+    if (session === undefined || !this.gate.isJoined() || !session.isJoined())
+      return "we are not in the call";
+    const members = session.memberships.length;
+    if (members > MAX_MEMBERS_FOR_REFRESH)
+      return `the call has ${members} members and a refresh would make every one of them rotate its key`;
+    if (findOwnMembership(this.client, session, this.roomId) === undefined)
+      return "no call membership state event of our own (sticky event mode, or we left)";
+    return undefined;
+  }
+}
+
+let active: KeyRecovery | undefined;
+
+/**
+ * Switches key recovery on for the (widget) client of a call: wraps its key
+ * sending and sets up the watchdog whose recovery action refreshes the
+ * membership of this client in the room. Nothing is retried or repeated, and no
+ * recovery runs, until {@link bindKeyRecoverySession} has told it which session
+ * is the call and that session is joined.
+ */
+export function installKeyRecovery(
+  client: KeySendClient & OwnMembershipClient,
+  roomId: string,
+): void {
+  uninstallKeyRecovery();
+  active = new KeyRecovery(client, roomId);
+}
+
+/** Switches key recovery off again and restores the client. */
+export function uninstallKeyRecovery(): void {
+  active?.dispose();
+  active = undefined;
+}
+
+/**
+ * Tells the installed key recovery which MatrixRTC session is the call. It
+ * follows the join state of the session and the keys it receives from then on.
+ * Does nothing when key recovery is not installed (not in a widget).
+ */
+export function bindKeyRecoverySession(session: KeyRecoverySession): void {
+  active?.bind(session);
+}
+
+/** The watchdog of the installed key recovery, if any (not in a plain page). */
+export function getKeyRecoveryWatchdog(): KeyRecoveryWatchdog | undefined {
+  return active?.watchdog;
+}
