+/** The parts of a MatrixRTCSession that key recovery uses, with a join and a leave. */
+class FakeSession extends EventEmitter {
+  public joined = false;
+  public memberships: unknown[] = [{}, {}];
+  public readonly slotDescription = SLOT;
+
+  public isJoined(): boolean {
+    return this.joined;
+  }
+
+  public join(): void {
+    this.joined = true;
+    this.emit(MatrixRTCSessionEvent.JoinStateChanged, true);
+  }
+
+  public leave(): void {
+    this.joined = false;
+    this.emit(MatrixRTCSessionEvent.JoinStateChanged, false);
+  }
+
+  public receiveKey(index: number, identity: string): void {
+    this.emit(
+      MatrixRTCSessionEvent.EncryptionKeyChanged,
+      new Uint8Array(16),
+      index,
+      { userId: "@bob:example.org", deviceId: "BOBDEVICE", memberId: "m" },
+      identity,
+    );
+  }
+
+  public asSession(): KeyRecoverySession {
+    return this as unknown as KeyRecoverySession;
+  }
+}
