+      fakeLivekitRoom,
+    );
+  });
+
+  it("ignores encryption errors of our own participant or of nobody", () => {
+    const { onEncryptionError } = watchdogSpies();
+
+    fakeLivekitRoom.emit(RoomEvent.EncryptionError, new Error("no key"), {
+      ...fakeLocalParticipant,
+      isLocal: true,
+    } as unknown as LocalParticipant);
+    fakeLivekitRoom.emit(RoomEvent.EncryptionError, new Error("no key"));
+
+    expect(onEncryptionError).not.toHaveBeenCalled();
+  });
+
+  it("reports a remote participant that left", () => {
+    const { onParticipantGone } = watchdogSpies();
+    const bob = mockRemoteParticipant({ identity: "@bob:example.org:DEV111" });
+
+    fakeLivekitRoom.emit(RoomEvent.ParticipantDisconnected, bob);
+
+    expect(onParticipantGone).toHaveBeenCalledExactlyOnceWith(
+      "@bob:example.org:DEV111",
+    );
+  });
+
+  it("reports the room as closed when LiveKit disconnects it (no ParticipantDisconnected comes then)", () => {
+    const { onConnectionClosed, onParticipantGone } = watchdogSpies();
+
+    fakeLivekitRoom.emit(RoomEvent.Disconnected);
+
+    expect(onConnectionClosed).toHaveBeenCalledExactlyOnceWith(fakeLivekitRoom);
+    expect(onParticipantGone).not.toHaveBeenCalled();
+  });
+
+  it("reports the room as closed when the connection's scope ends", () => {
+    const { onConnectionClosed } = watchdogSpies();
+
+    testScope.end();
+
+    expect(onConnectionClosed).toHaveBeenCalledExactlyOnceWith(fakeLivekitRoom);
+    // and the connection listens no more
+    fakeLivekitRoom.emit(RoomEvent.Disconnected);
+    expect(onConnectionClosed).toHaveBeenCalledOnce();
+  });
+});
