+import {
+  afterEach,
+  beforeEach,
+  describe,
+  expect,
+  it,
+  type Mock,
+  vi,
+} from "vitest";
+import {
+  EventType,
+  type IContent,
+  MatrixEvent,
+  type Room,
+  RoomState,
+} from "matrix-js-sdk";
+import { logger } from "matrix-js-sdk/lib/logger";
+
+import {
+  getKeyRecoveryWatchdog,
+  installKeyRecovery,
+  type KeySendClient,
+  KeyRecoveryWatchdog,
+  type OwnMembershipClient,
+  refreshOwnMembership,
+  wrapKeySend,
+} from "./keyRecovery";
+
+const USER_ID = "@alice:example.org";
+const DEVICE_ID = "ALICEDEVICE";
+const ROOM_ID = "!room:example.org";
+const STATE_KEY = `_${USER_ID}_${DEVICE_ID}_m.call`;
+const SECRET_KEY = "c2VjcmV0LW1lZGlhLWtleS1ub3QtZm9yLWxvZ3M=";
+
+const PEER = { userId: "@bob:example.org", deviceId: "BOBDEVICE" };
+const PAYLOAD = { keys: { index: 0, key: SECRET_KEY }, sent_ts: 1 };
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.setSystemTime(new Date("2026-10-24T12:00:00Z"));
+  vi.spyOn(logger, "info").mockImplementation(() => {});
+  vi.spyOn(logger, "warn").mockImplementation(() => {});
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+});
+
+describe("wrapKeySend", () => {
+  it("retries a failed key send after 2 s and again after 10 s", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout 1"));
+    send.mockRejectedValueOnce(new Error("timeout 2"));
+    wrapKeySend(client);
+
+    const result = sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(1_999);
+    expect(send).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(9_999);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(3);
+    await expect(result).resolves.toBeUndefined();
+  });
+
+  it("rejects with the last error after three failed attempts", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("first"));
+    send.mockRejectedValueOnce(new Error("second"));
+    send.mockRejectedValueOnce(new Error("third"));
+    wrapKeySend(client);
+
+    const result = sendKey(client, [PEER]).catch((e: unknown) => e);
+    await vi.advanceTimersByTimeAsync(12_000);
+    expect(await result).toEqual(new Error("third"));
+
+    // No fourth attempt, and nothing is sent again later.
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(3);
+  });
+
+  it("does not retry a host without to-device support", async () => {
+    const { client, send } = keySendClient();
+    const unsupported = new Error("this action is not supported");
+    send.mockRejectedValue(unsupported);
+    wrapKeySend(client);
+
+    await expect(sendKey(client, [PEER])).rejects.toBe(unsupported);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(1);
+  });
+
+  it("sends the same key again 5 s and 15 s after it got through", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client);
+
+    await sendKey(client, [PEER]);
+    expect(send).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(4_999);
+    expect(send).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(9_999);
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(send).toHaveBeenCalledTimes(3);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(3);
+
+    for (const call of send.mock.calls) {
+      expect(call).toEqual([
+        EventType.CallEncryptionKeysPrefix,
+        [PEER],
+        PAYLOAD,
+      ]);
+    }
+  });
+
+  it("counts the repeated sends from the send that got through", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client);
+
+    const result = sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(2_000);
+    await result;
+    expect(send).toHaveBeenCalledTimes(2);
+    await vi.advanceTimersByTimeAsync(5_000);
+    expect(send).toHaveBeenCalledTimes(3);
+    await vi.advanceTimersByTimeAsync(10_000);
+    expect(send).toHaveBeenCalledTimes(4);
+  });
+
+  it("repeats the send for 8 target devices but not for 9", async () => {
+    const eight = peers(8);
+    const nine = peers(9);
+    const { client, send } = keySendClient();
+    wrapKeySend(client);
+
+    await sendKey(client, eight);
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(3);
+
+    send.mockClear();
+    await sendKey(client, nine);
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(1);
+  });
+
+  it("still retries a failed send to more than 8 devices", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client);
+
+    const result = sendKey(client, peers(9));
+    await vi.advanceTimersByTimeAsync(2_000);
+    await result;
+    await vi.advanceTimersByTimeAsync(20_000);
+    expect(send).toHaveBeenCalledTimes(2);
+  });
+
+  it("leaves other event types untouched", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValue(new Error("nope"));
+    wrapKeySend(client);
+
+    await expect(
+      client.encryptAndSendToDevice("m.call.invite", [PEER], { a: 1 }),
+    ).rejects.toThrow("nope");
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+    expect(send).toHaveBeenCalledWith("m.call.invite", [PEER], { a: 1 });
+  });
+
+  it("does not repeat a send once the client has stopped", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client);
+
+    await sendKey(client, [PEER]);
+    client.clientRunning = false;
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledOnce();
+  });
+
+  it("swallows a failed repeated send without retrying it", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client);
+
+    await sendKey(client, [PEER]);
+    send.mockRejectedValue(new Error("timeout"));
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(3);
+  });
+
+  it("wraps a client only once", async () => {
+    const { client, send } = keySendClient();
+    wrapKeySend(client);
+    wrapKeySend(client);
+
+    await sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(send).toHaveBeenCalledTimes(3);
+  });
+
+  it("never logs the key", async () => {
+    const { client, send } = keySendClient();
+    send.mockRejectedValueOnce(new Error("timeout"));
+    wrapKeySend(client);
+
+    const result = sendKey(client, [PEER]);
+    await vi.advanceTimersByTimeAsync(2_000);
+    await result;
+    await vi.advanceTimersByTimeAsync(20_000);
+
+    const logged = [
+      ...vi.mocked(logger.info).mock.calls,
+      ...vi.mocked(logger.warn).mock.calls,
+    ];
+    expect(logged.length).toBeGreaterThan(0);
+    expect(JSON.stringify(logged)).not.toContain(SECRET_KEY);
+  });
+});
+
+describe("KeyRecoveryWatchdog", () => {
+  it("runs the recovery action once when no key arrives within 8 s", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(7_999);
+    expect(recover).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledExactlyOnceWith("bob");
+  });
+
+  it("does nothing when the key arrives within 8 s", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(5_000);
+    watchdog.onKeyReceived("bob");
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(recover).not.toHaveBeenCalled();
+  });
+
+  it("is driven by the first error, later errors change nothing", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(5_000);
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(2_999);
+    expect(recover).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledOnce();
+    // livekit sends no more errors, the second action comes anyway
+    await vi.advanceTimersByTimeAsync(15_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+  });
+
+  it("spaces the two actions of an episode 15 s apart and stops there", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(recover).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(14_999);
+    expect(recover).toHaveBeenCalledTimes(1);
+    await vi.advanceTimersByTimeAsync(1);
+    expect(recover).toHaveBeenCalledTimes(2);
+
+    // more errors in the same episode start nothing
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(120_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+  });
+
+  it("ends the episode when the key arrives after the first action", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+    watchdog.onKeyReceived("bob");
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(recover).toHaveBeenCalledTimes(1);
+  });
+
+  it("starts a new episode with a new error after the key arrived", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(23_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+    watchdog.onKeyReceived("bob");
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(23_000);
+    expect(recover).toHaveBeenCalledTimes(4);
+  });
+
+  it("ends the episode when the participant leaves", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(3_000);
+    watchdog.onParticipantGone("bob");
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(recover).not.toHaveBeenCalled();
+
+    // a participant that comes back with the same identity starts afresh
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(recover).toHaveBeenCalledOnce();
+  });
+
+  it("tracks each participant on its own", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    watchdog.onEncryptionError("carol");
+    watchdog.onKeyReceived("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(recover).toHaveBeenCalledExactlyOnceWith("carol");
+  });
+
+  it("allows at most 6 recovery actions per call", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    for (const identity of ["a", "b", "c", "d"]) {
+      watchdog.onEncryptionError(identity);
+      await vi.advanceTimersByTimeAsync(23_000);
+      watchdog.onKeyReceived(identity);
+    }
+    // a, b and c used the 6, d got none
+    expect(recover).toHaveBeenCalledTimes(6);
+    expect(recover).not.toHaveBeenCalledWith("d");
+  });
+
+  it("logs a failing recovery action and carries on", async () => {
+    const { watchdog, recover } = newWatchdog();
+    recover.mockRejectedValue(new Error("homeserver down"));
+
+    watchdog.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(23_000);
+    expect(recover).toHaveBeenCalledTimes(2);
+    expect(logger.warn).toHaveBeenCalledWith(
+      expect.stringContaining("homeserver down"),
+    );
+  });
+
+  it("drops running episodes on dispose", async () => {
+    const { watchdog, recover } = newWatchdog();
+
+    watchdog.onEncryptionError("bob");
+    watchdog.dispose();
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(recover).not.toHaveBeenCalled();
+  });
+});
+
+describe("refreshOwnMembership", () => {
+  it("sends the same content again with a new created_ts", async () => {
+    vi.setSystemTime(new Date("2026-10-24T12:00:00Z"));
+    const content = membershipContent({ created_ts: 1_000 });
+    const { client, sendStateEvent } = ownMembershipClient([
+      membershipEvent(content),
+    ]);
+
+    await expect(refreshOwnMembership(client, ROOM_ID)).resolves.toBe(true);
+
+    expect(sendStateEvent).toHaveBeenCalledExactlyOnceWith(
+      ROOM_ID,
+      EventType.GroupCallMemberPrefix,
+      { ...content, created_ts: Date.now() },
+      STATE_KEY,
+    );
+    expect(Date.now()).toBeGreaterThan(1_000);
+  });
+
+  it("adds a created_ts to a membership that has none", async () => {
+    const content = membershipContent();
+    const { client, sendStateEvent } = ownMembershipClient([
+      membershipEvent(content),
+    ]);
+
+    await refreshOwnMembership(client, ROOM_ID);
+
+    expect(sendStateEvent).toHaveBeenCalledExactlyOnceWith(
+      ROOM_ID,
+      EventType.GroupCallMemberPrefix,
+      { ...content, created_ts: Date.now() },
+      STATE_KEY,
+    );
+  });
+
+  it("does nothing when the membership is empty", async () => {
+    const { client, sendStateEvent } = ownMembershipClient([
+      membershipEvent({}),
+    ]);
+
+    await expect(refreshOwnMembership(client, ROOM_ID)).resolves.toBe(false);
+
+    expect(sendStateEvent).not.toHaveBeenCalled();
+    expect(logger.warn).toHaveBeenCalledOnce();
+  });
+
+  it("does nothing when we have no membership state event", async () => {
+    // sticky event mode: the room has no call member state event of ours
+    const { client, sendStateEvent } = ownMembershipClient([]);
+
+    await expect(refreshOwnMembership(client, ROOM_ID)).resolves.toBe(false);
+
+    expect(sendStateEvent).not.toHaveBeenCalled();
+    expect(logger.warn).toHaveBeenCalledOnce();
+  });
+
+  it("ignores the memberships of other users and other devices", async () => {
+    const { client, sendStateEvent } = ownMembershipClient([
+      membershipEvent(membershipContent(), {
+        sender: "@bob:example.org",
+        stateKey: `_@bob:example.org_${DEVICE_ID}_m.call`,
+      }),
+      membershipEvent(membershipContent({ device_id: "OTHERDEVICE" }), {
+        stateKey: `_${USER_ID}_OTHERDEVICE_m.call`,
+      }),
+      // the legacy format has no device_id at the top level
+      membershipEvent(
+        { memberships: [{ device_id: DEVICE_ID }] },
+        { stateKey: USER_ID },
+      ),
+    ]);
+
+    await expect(refreshOwnMembership(client, ROOM_ID)).resolves.toBe(false);
+    expect(sendStateEvent).not.toHaveBeenCalled();
+  });
+
+  it("rejects when the state event cannot be sent", async () => {
+    const { client, sendStateEvent } = ownMembershipClient([
+      membershipEvent(membershipContent()),
+    ]);
+    sendStateEvent.mockRejectedValue(new Error("forbidden"));
+
+    await expect(refreshOwnMembership(client, ROOM_ID)).rejects.toThrow(
+      "forbidden",
+    );
+  });
+});
+
+describe("installKeyRecovery", () => {
+  it("refreshes our membership when a participant's key does not arrive", async () => {
+    const { client, send, sendStateEvent } = installableClient();
+
+    installKeyRecovery(client, ROOM_ID);
+    await sendKey(client, [PEER]);
+    expect(send).toHaveBeenCalledOnce();
+
+    getKeyRecoveryWatchdog()?.onEncryptionError("bob");
+    await vi.advanceTimersByTimeAsync(8_000);
+    expect(sendStateEvent).toHaveBeenCalledOnce();
+  });
+
+  it("replaces the watchdog of an earlier install", async () => {
+    const { client, sendStateEvent } = installableClient();
+
+    installKeyRecovery(client, ROOM_ID);
+    const first = getKeyRecoveryWatchdog();
+    first?.onEncryptionError("bob");
+    installKeyRecovery(client, ROOM_ID);
+
+    expect(getKeyRecoveryWatchdog()).not.toBe(first);
+    await vi.advanceTimersByTimeAsync(60_000);
+    expect(sendStateEvent).not.toHaveBeenCalled();
+  });
+});
+
+function keySendClient(): {
+  client: KeySendClient;
+  send: Mock<KeySendClient["encryptAndSendToDevice"]>;
+} {
+  const send = vi
+    .fn<KeySendClient["encryptAndSendToDevice"]>()
+    .mockResolvedValue(undefined);
+  return {
+    client: { encryptAndSendToDevice: send, clientRunning: true },
+    send,
+  };
+}
+
+async function sendKey(
+  client: KeySendClient,
+  devices: { userId: string; deviceId: string }[],
+): Promise<void> {
+  await client.encryptAndSendToDevice(
+    EventType.CallEncryptionKeysPrefix,
+    devices,
+    PAYLOAD,
+  );
+}
+
+function peers(count: number): { userId: string; deviceId: string }[] {
+  return Array.from({ length: count }, (_, i) => ({
+    userId: `@peer${i}:example.org`,
+    deviceId: `PEER${i}`,
+  }));
+}
+
+function newWatchdog(): {
+  watchdog: KeyRecoveryWatchdog;
+  recover: Mock<(identity: string) => Promise<unknown>>;
+} {
+  const recover = vi
+    .fn<(identity: string) => Promise<unknown>>()
+    .mockResolvedValue(undefined);
+  return { watchdog: new KeyRecoveryWatchdog(recover), recover };
+}
+
+function membershipContent(extra: IContent = {}): IContent {
+  return {
+    application: "m.call",
+    call_id: "",
+    scope: "m.room",
+    device_id: DEVICE_ID,
+    membershipID: `${USER_ID}:${DEVICE_ID}`,
+    expires: 14_400_000,
+    focus_active: { type: "livekit", focus_selection: "oldest_membership" },
+    foci_preferred: [
+      { type: "livekit", livekit_service_url: "https://sfu.example.org" },
+    ],
+    ...extra,
+  };
+}
+
+function membershipEvent(
+  content: IContent,
+  {
+    sender = USER_ID,
+    stateKey = STATE_KEY,
+  }: { sender?: string; stateKey?: string } = {},
+): MatrixEvent {
+  return new MatrixEvent({
+    type: EventType.GroupCallMemberPrefix,
+    room_id: ROOM_ID,
+    sender,
+    state_key: stateKey,
+    content,
+  });
+}
+
+function ownMembershipClient(events: MatrixEvent[]): {
+  client: OwnMembershipClient;
+  sendStateEvent: Mock<OwnMembershipClient["sendStateEvent"]>;
+} {
+  const state = new RoomState(ROOM_ID);
+  state.setStateEvents(events);
+  const sendStateEvent = vi
+    .fn<OwnMembershipClient["sendStateEvent"]>()
+    .mockResolvedValue({ event_id: "$new" });
+  const client: OwnMembershipClient = {
+    getRoom: (roomId) =>
+      roomId === ROOM_ID ? ({ currentState: state } as Room) : null,
+    getUserId: () => USER_ID,
+    getDeviceId: () => DEVICE_ID,
+    sendStateEvent,
+  };
+  return { client, sendStateEvent };
+}
+
+function installableClient(): {
+  client: KeySendClient & OwnMembershipClient;
+  send: Mock<KeySendClient["encryptAndSendToDevice"]>;
+  sendStateEvent: Mock<OwnMembershipClient["sendStateEvent"]>;
+} {
+  const { client: sendClient, send } = keySendClient();
+  const { client: stateClient, sendStateEvent } = ownMembershipClient([
+    membershipEvent(membershipContent()),
+  ]);
+  return {
+    client: Object.assign(sendClient, stateClient),
+    send,
+    sendStateEvent,
+  };
+}
