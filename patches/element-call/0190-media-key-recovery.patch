+        .spyOn(watchdog, "onParticipantGone")
+        .mockImplementation(() => {}),
+      onConnectionClosed: vi
+        .spyOn(watchdog, "onConnectionClosed")
+        .mockImplementation(() => {}),
+    };
+  }
+
+  afterEach(() => {
+    uninstallKeyRecovery();
+  });
+
