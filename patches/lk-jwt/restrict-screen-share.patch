+// ── LIVEKIT_RESTRICT_SCREEN_SHARE ─────────────────────────────────────────────
+
+/// (room_id, event_type, as_user_id, as_token) of every state read.
+type StateReads = Arc<Mutex<Vec<(String, String, String, String)>>>;
+
+/// Deps for a screen share test: `sub` is the OpenID subject, `power_levels`
+/// the answer of the `m.room.power_levels` read (`None`: not mocked, a read
+/// panics).
+fn restrict_deps(
+    sub: &str,
+    power_levels: Option<Result<Option<serde_json::Value>, String>>,
+) -> (HandlerTestDeps, StateReads) {
+    let reads: StateReads = Arc::default();
+    let recorded = reads.clone();
+    let room_state_fn: Option<RoomStateFn> = power_levels.map(|answer| {
+        Box::new(
+            move |room: &str, event_type: &str, user: &str, token: &str| {
+                recorded.lock().unwrap().push((
+                    room.to_owned(),
+                    event_type.to_owned(),
+                    user.to_owned(),
+                    token.to_owned(),
+                ));
+                let answer = answer.clone();
+                Box::pin(async move { answer }) as BoxFuture<'static, _>
+            },
+        ) as RoomStateFn
+    });
+    let deps = HandlerTestDeps {
+        exchange_openid_userinfo_fn: exchange_openid_userinfo_ok(sub),
+        create_livekit_room_fn: Some(Box::new(|_, _, _| Ok(()))),
+        is_joined_fn: is_joined_ok(true),
+        room_state_fn,
+        ..Default::default()
+    };
+    (deps, reads)
+}
+
+fn restrict_handler(deps: HandlerTestDeps, restrict: bool) -> Arc<Handler> {
+    let handler = new_delegation_app_service_handler(deps);
+    handler.set_restrict_screen_share(restrict);
+    handler
+}
+
+/// The `canPublishSources` of a minted JWT (empty when absent).
+fn jwt_sources(jwt: &str) -> Vec<String> {
+    parse_jwt_claims(jwt, "secret")["video"]["canPublishSources"]
+        .as_array()
+        .map(|a| {
+            a.iter()
+                .filter_map(|v| v.as_str().map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+const SOURCES_ALL: [&str; 4] = ["camera", "microphone", "screen_share", "screen_share_audio"];
+const SOURCES_CAM_MIC: [&str; 2] = ["camera", "microphone"];
+
+/// Mints a token on the legacy, the standalone and the application-service
+/// route for `@user:example.com` in `!testRoom:example.com` and returns the
+/// three JWTs.
+async fn mint_on_every_route(handler: &Arc<Handler>) -> Vec<(&'static str, String)> {
+    let legacy = handler
+        .process_legacy_sfu_request(&membership_legacy_request(
+            "example.com",
+            "!testRoom:example.com",
+        ))
+        .await
+        .expect("legacy")
+        .jwt;
+    let standalone = handler
+        .process_sfu_request(&valid_sfu_request())
+        .await
+        .expect("get_token")
+        .jwt;
+    let mut cs_req = valid_get_token_cs_request();
+    cs_req.url = default_auth().lk_url;
+    let cs = handler
+        .process_get_token_cs_request(cs_req, GET_TOKEN_CS_MXID)
+        .await
+        .expect("get_token cs")
+        .jwt;
+    vec![("legacy", legacy), ("get_token", standalone), ("cs", cs)]
+}
+
+fn power_levels_for(user: &str, power: i64) -> serde_json::Value {
+    serde_json::json!({ "users": { user: power }, "users_default": 0 })
+}
