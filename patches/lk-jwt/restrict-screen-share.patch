+/// How long a room state read (LIVEKIT_RESTRICT_SCREEN_SHARE) may take.
+pub(crate) const ROOM_STATE_TIMEOUT: Duration = Duration::from_secs(3);
+
+/// `GET {cs_api_url}/_matrix/client/v3/{segments...}?user_id=<user>` with the
+/// AS token. `Ok(None)` is a 404 `M_NOT_FOUND`; every other non-2xx status,
+/// transport failure or unparseable body is an error.
+async fn get_json_as_user(
+    skip_verify_tls: bool,
+    cs_api_url: &CsApiUrl,
+    segments: &[&str],
+    as_user_id: &str,
+    as_token: &str,
+) -> Result<Option<serde_json::Value>, String> {
+    let mut endpoint = url::Url::parse(cs_api_url.as_str())
+        .map_err(|e| format!("invalid client-server API URL: {e}"))?;
+    {
+        let mut path = endpoint
+            .path_segments_mut()
+            .map_err(|_| "invalid client-server API URL: cannot be a base".to_string())?;
+        path.pop_if_empty();
+        path.extend(["_matrix", "client", "v3"]);
+        path.extend(segments);
+    }
+    endpoint
+        .query_pairs_mut()
+        .append_pair("user_id", as_user_id);
+
+    let resp = http_client(skip_verify_tls)
+        .get(endpoint.clone())
+        .bearer_auth(as_token)
+        .timeout(ROOM_STATE_TIMEOUT)
+        .send()
+        .await
+        .map_err(|e| {
+            let msg = error_chain(&e);
+            debug!(url = %endpoint, err = %msg, "room state read");
+            format!("failed to read room state: {msg}")
+        })?;
+
+    let status = resp.status();
+    if status == reqwest::StatusCode::NOT_FOUND {
+        #[derive(Deserialize, Default)]
+        struct ErrBody {
+            #[serde(default)]
+            errcode: String,
+        }
+        let body: ErrBody = resp.json().await.unwrap_or_default();
+        return if body.errcode == "M_NOT_FOUND" {
+            Ok(None)
+        } else {
+            Err("failed to read room state: http status code 404".to_owned())
+        };
+    }
+    if !status.is_success() {
+        return Err(format!(
+            "failed to read room state: http status code {}",
+            status.as_u16()
+        ));
+    }
+    resp.json::<serde_json::Value>()
+        .await
+        .map(Some)
+        .map_err(|e| format!("failed to parse room state response: {e}"))
+}
+
 /// The production [`Deps`] implementation — all behaviour comes from the
 /// trait's default methods.
 #[derive(Default)]
