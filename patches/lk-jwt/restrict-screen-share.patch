+#[cfg(test)]
+mod tests {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+
+    use async_trait::async_trait;
+    use serde_json::json;
+
+    use super::*;
+
+    const ALICE: &str = "@alice:example.com";
+    const BOB: &str = "@bob:example.com";
+
+    #[test]
+    fn sources_lists() {
+        assert_eq!(sources_for(false), ["camera", "microphone"]);
+        assert_eq!(
+            sources_for(true),
+            ["camera", "microphone", "screen_share", "screen_share_audio"]
+        );
+    }
+
+    #[test]
+    fn power_users_entry_wins() {
+        let pl = json!({ "users": { ALICE: 100, BOB: 10 }, "users_default": 5, "kick": 60 });
+        assert_eq!(power_and_kick(&pl, ALICE), Some((100, 60)));
+        assert_eq!(power_and_kick(&pl, BOB), Some((10, 60)));
+    }
+
+    #[test]
+    fn power_falls_back_to_users_default() {
+        let pl = json!({ "users": { ALICE: 100 }, "users_default": 50 });
+        assert_eq!(power_and_kick(&pl, BOB), Some((50, 50)));
+    }
+
+    #[test]
+    fn power_defaults_kick_50_and_users_default_0() {
+        assert_eq!(power_and_kick(&json!({}), BOB), Some((0, 50)));
+        assert_eq!(power_and_kick(&json!({ "users": {} }), BOB), Some((0, 50)));
+        assert_eq!(
+            power_and_kick(&json!({ "kick": null, "users_default": null }), BOB),
+            Some((0, 50))
+        );
+    }
+
+    #[test]
+    fn power_accepts_numeric_strings() {
+        let pl = json!({ "users": { ALICE: "100" }, "kick": "50" });
+        assert_eq!(power_and_kick(&pl, ALICE), Some((100, 50)));
+    }
+
+    #[test]
+    fn power_malformed_content_is_none() {
+        assert_eq!(power_and_kick(&json!([]), ALICE), None);
+        assert_eq!(power_and_kick(&json!("x"), ALICE), None);
+        assert_eq!(power_and_kick(&json!({ "users": [] }), ALICE), None);
+        assert_eq!(
+            power_and_kick(&json!({ "users": { ALICE: "high" } }), ALICE),
+            None
+        );
+        assert_eq!(
+            power_and_kick(&json!({ "users": { ALICE: 1.5 } }), ALICE),
+            None
+        );
+        assert_eq!(power_and_kick(&json!({ "kick": true }), ALICE), None);
+        assert_eq!(power_and_kick(&json!({ "users_default": [] }), ALICE), None);
+        // A malformed entry of somebody else does not matter.
+        assert_eq!(
+            power_and_kick(&json!({ "users": { BOB: "high" } }), ALICE),
+            Some((0, 50))
+        );
+    }
+
+    #[test]
+    fn room_versions_with_unlimited_creators() {
+        for v in ["12", "13", "org.matrix.hydra.11"] {
+            assert!(creators_have_unlimited_power(v), "{v}");
+        }
+        for v in ["1", "9", "10", "11", "", "custom", "12x"] {
+            assert!(!creators_have_unlimited_power(v), "{v}");
+        }
+    }
+
+    #[test]
+    fn create_parse() {
+        assert_eq!(
+            parse_create(&json!({ "creator": ALICE, "room_version": "10" })),
+            Some(CreateInfo {
+                room_version: "10".into(),
+                creator: Some(ALICE.into()),
+                additional_creators: vec![],
+            })
+        );
+        assert_eq!(
+            parse_create(&json!({ "room_version": "12", "additional_creators": [BOB, 7] })),
+            Some(CreateInfo {
+                room_version: "12".into(),
+                creator: None,
+                additional_creators: vec![BOB.into()],
+            })
+        );
+        assert_eq!(parse_create(&json!({})).unwrap().room_version, "1");
+        assert_eq!(parse_create(&json!({ "room_version": 12 })), None);
+        assert_eq!(parse_create(&json!({ "additional_creators": "x" })), None);
+        assert_eq!(parse_create(&json!([])), None);
+    }
+
+    /// Scripted answers: (kind, key) -> result. Kind is "state" or "event".
+    #[derive(Default)]
+    struct Script {
+        answers: HashMap<(&'static str, String), Result<Option<Value>, String>>,
+        calls: Mutex<Vec<String>>,
+    }
+
+    impl Script {
+        fn state(mut self, event_type: &str, r: Result<Option<Value>, String>) -> Self {
+            self.answers.insert(("state", event_type.to_owned()), r);
+            self
+        }
+        fn event(mut self, event_id: &str, r: Result<Option<Value>, String>) -> Self {
+            self.answers.insert(("event", event_id.to_owned()), r);
+            self
+        }
+        fn calls(&self) -> Vec<String> {
+            self.calls.lock().unwrap().clone()
+        }
+    }
+
+    #[async_trait]
+    impl Deps for Script {
+        async fn get_room_state_content(
+            &self,
+            _cs_api_url: &CsApiUrl,
+            _room_id: &str,
+            event_type: &str,
+            _as_user_id: &str,
+            _as_token: &str,
+        ) -> Result<Option<Value>, String> {
+            self.calls
+                .lock()
+                .unwrap()
+                .push(format!("state:{event_type}"));
+            self.answers
+                .get(&("state", event_type.to_owned()))
+                .cloned()
+                .unwrap_or(Ok(None))
+        }
+
+        async fn get_room_event(
+            &self,
+            _cs_api_url: &CsApiUrl,
+            _room_id: &str,
+            event_id: &str,
+            _as_user_id: &str,
+            _as_token: &str,
+        ) -> Result<Option<Value>, String> {
+            self.calls.lock().unwrap().push(format!("event:{event_id}"));
+            self.answers
+                .get(&("event", event_id.to_owned()))
+                .cloned()
+                .unwrap_or(Ok(None))
+        }
+    }
+
+    async fn decide(script: &Script, room: &str, user: &str) -> bool {
+        may_share_screen(script, &CsApiUrl("http://hs".into()), room, user, "as").await
+    }
+
+    const ROOM: &str = "!room:example.com";
+    const ROOM12: &str = "!createEventHash";
+
+    #[tokio::test]
+    async fn host_at_kick_level_shares_with_one_request() {
+        let s = Script::default().state(
+            "m.room.power_levels",
+            Ok(Some(json!({ "users": { ALICE: 50 } }))),
+        );
+        assert!(decide(&s, ROOM, ALICE).await);
+        assert_eq!(s.calls(), ["state:m.room.power_levels"]);
+    }
+
+    #[tokio::test]
+    async fn member_below_kick_does_not_share() {
+        let s = Script::default().state(
+            "m.room.power_levels",
+            Ok(Some(
+                json!({ "users": { ALICE: 100 }, "users_default": 49 }),
+            )),
+        );
+        assert!(!decide(&s, ROOM, BOB).await);
+        // A pre-12 room's power levels event is complete: no create read.
+        assert_eq!(s.calls(), ["state:m.room.power_levels"]);
+    }
+
+    #[tokio::test]
+    async fn custom_kick_level_is_honoured() {
+        let s = Script::default().state(
+            "m.room.power_levels",
+            Ok(Some(json!({ "users": { ALICE: 50, BOB: 70 }, "kick": 60 }))),
+        );
+        assert!(!decide(&s, ROOM, ALICE).await);
+        assert!(decide(&s, ROOM, BOB).await);
+    }
+
+    #[tokio::test]
+    async fn malformed_power_levels_do_not_share() {
+        let s = Script::default().state("m.room.power_levels", Ok(Some(json!({ "users": 7 }))));
+        assert!(!decide(&s, ROOM, ALICE).await);
+        let s = Script::default().state("m.room.power_levels", Ok(Some(json!([1, 2]))));
+        assert!(!decide(&s, ROOM, ALICE).await);
+    }
+
+    #[tokio::test]
+    async fn read_errors_do_not_share() {
+        let s = Script::default().state("m.room.power_levels", Err("http status code 500".into()));
+        assert!(!decide(&s, ROOM, ALICE).await);
+        assert!(!decide(&s, ROOM12, ALICE).await);
+    }
+
+    #[tokio::test]
+    async fn without_power_levels_event_the_creator_has_100() {
+        let s = Script::default().state(
+            "m.room.create",
+            Ok(Some(json!({ "creator": ALICE, "room_version": "10" }))),
+        );
+        assert!(decide(&s, ROOM, ALICE).await);
+        assert!(!decide(&s, ROOM, BOB).await);
+        assert_eq!(
+            s.calls(),
+            [
+                "state:m.room.power_levels",
+                "state:m.room.create",
+                "state:m.room.power_levels",
+                "state:m.room.create"
+            ]
+        );
+    }
+
+    #[tokio::test]
+    async fn without_power_levels_and_without_creator_field_nobody_shares() {
+        // Room version 11 has no `creator` in the content.
+        let s = Script::default().state("m.room.create", Ok(Some(json!({ "room_version": "11" }))));
+        assert!(!decide(&s, ROOM, ALICE).await);
+        // No create event at all.
+        let s = Script::default();
+        assert!(!decide(&s, ROOM, ALICE).await);
+        // Unreadable create event.
+        let s = Script::default().state("m.room.create", Err("boom".into()));
+        assert!(!decide(&s, ROOM, ALICE).await);
+        // Malformed create event.
+        let s = Script::default().state("m.room.create", Ok(Some(json!({ "room_version": 10 }))));
+        assert!(!decide(&s, ROOM, ALICE).await);
+    }
+
+    #[tokio::test]
+    async fn power_levels_event_beats_the_creator_field_before_v12() {
+        // With a power levels event the creator has only what it states.
+        let s = Script::default()
+            .state("m.room.power_levels", Ok(Some(json!({ "users": {} }))))
+            .state(
+                "m.room.create",
+                Ok(Some(json!({ "creator": ALICE, "room_version": "10" }))),
+            );
+        assert!(!decide(&s, ROOM, ALICE).await);
+    }
+
+    #[tokio::test]
+    async fn v12_creator_is_the_sender_of_the_create_event() {
+        let s = Script::default()
+            .state(
+                "m.room.power_levels",
+                Ok(Some(json!({ "users": { BOB: 50 } }))),
+            )
+            .state("m.room.create", Ok(Some(json!({ "room_version": "12" }))))
+            .event(
+                "$createEventHash",
+                Ok(Some(json!({ "sender": ALICE, "type": "m.room.create" }))),
+            );
+        assert!(decide(&s, ROOM12, ALICE).await);
+        // Bob is listed at 50: no create read needed.
+        assert!(decide(&s, ROOM12, BOB).await);
+        // Carol is neither.
+        assert!(!decide(&s, ROOM12, "@carol:example.com").await);
+    }
+
+    #[tokio::test]
+    async fn v12_additional_creator_shares_without_the_event_read() {
+        let s = Script::default()
+            .state("m.room.power_levels", Ok(Some(json!({}))))
+            .state(
+                "m.room.create",
+                Ok(Some(
+                    json!({ "room_version": "12", "additional_creators": [BOB] }),
+                )),
+            );
+        assert!(decide(&s, ROOM12, BOB).await);
+        assert!(!s.calls().iter().any(|c| c.starts_with("event:")));
+    }
+
+    #[tokio::test]
+    async fn v12_create_event_unreadable_does_not_share() {
+        let s = Script::default()
+            .state("m.room.create", Ok(Some(json!({ "room_version": "12" }))))
+            .event("$createEventHash", Err("http status code 403".into()));
+        assert!(!decide(&s, ROOM12, ALICE).await);
+        let s = Script::default().state("m.room.create", Ok(Some(json!({ "room_version": "12" }))));
+        assert!(!decide(&s, ROOM12, ALICE).await);
+        let s = Script::default()
+            .state("m.room.create", Ok(Some(json!({ "room_version": "12" }))))
+            .event(
+                "$createEventHash",
+                Ok(Some(json!({ "type": "m.room.create" }))),
+            );
+        assert!(!decide(&s, ROOM12, ALICE).await);
+    }
+}
