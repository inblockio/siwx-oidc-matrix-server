+// Copyright 2026 Element Creations Ltd.
+//
+// SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-Element-Commercial
+// Please see LICENSE files in the repository root for full details.
+
+//! LIVEKIT_RESTRICT_SCREEN_SHARE: whether a caller may publish a screen.
+//!
+//! A caller may share the screen when their power level in the room is at
+//! least the room's `kick` level (default 50). The power is read from the
+//! homeserver as the caller (application-service masquerading), so only what
+//! the caller can see is read. Every failure means "may not": the policy
+//! fails closed, and the token request itself still succeeds with the
+//! camera and the microphone.
+
+use serde_json::Value;
+
+use crate::helper::{CsApiUrl, Deps};
+
+/// The sources of a caller below the kick level.
+pub const SOURCES_BASE: [&str; 2] = ["camera", "microphone"];
+/// The sources of a caller at or above the kick level.
+pub const SOURCES_WITH_SCREEN: [&str; 4] =
+    ["camera", "microphone", "screen_share", "screen_share_audio"];
+
+/// The `kick` level of a room without an explicit one.
+const DEFAULT_KICK: i64 = 50;
+
+/// The LiveKit `canPublishSources` list for a caller.
+pub fn sources_for(may_share_screen: bool) -> Vec<String> {
+    let sources: &[&str] = if may_share_screen {
+        &SOURCES_WITH_SCREEN
+    } else {
+        &SOURCES_BASE
+    };
+    sources.iter().map(|s| (*s).to_owned()).collect()
+}
+
+/// A power level as Matrix allows it: an integer, or (old room versions) a
+/// string holding one.
+fn level(value: &Value) -> Option<i64> {
+    value
+        .as_i64()
+        .or_else(|| value.as_str().and_then(|s| s.trim().parse().ok()))
+}
+
+/// `(power of user, kick level)` from the content of an `m.room.power_levels`
+/// event, or `None` when the content is malformed in a field that matters.
+pub fn power_and_kick(content: &Value, user_id: &str) -> Option<(i64, i64)> {
+    let obj = content.as_object()?;
+    let optional = |key: &str, default: i64| match obj.get(key) {
+        None | Some(Value::Null) => Some(default),
+        Some(v) => level(v),
+    };
+    let kick = optional("kick", DEFAULT_KICK)?;
+    let users_default = optional("users_default", 0)?;
+    let power = match obj.get("users") {
+        None | Some(Value::Null) => users_default,
+        Some(Value::Object(users)) => match users.get(user_id) {
+            Some(v) => level(v)?,
+            None => users_default,
+        },
+        Some(_) => return None,
+    };
+    Some((power, kick))
+}
+
+/// Whether the room version gives its creators unlimited power instead of a
+/// level in the power levels event: room version 12 and later, and the
+/// `org.matrix.hydra.11` pre-release of it.
+pub fn creators_have_unlimited_power(room_version: &str) -> bool {
+    room_version == "org.matrix.hydra.11" || room_version.parse::<u32>().is_ok_and(|v| v >= 12)
+}
+
+/// The parts of an `m.room.create` content that decide who the creators are.
+#[derive(Debug, Default, PartialEq, Eq)]
+pub struct CreateInfo {
+    pub room_version: String,
+    /// `content.creator`, present up to room version 10.
+    pub creator: Option<String>,
+    /// `content.additional_creators` (room version 12).
+    pub additional_creators: Vec<String>,
+}
+
+/// Parses the content of an `m.room.create` event. A missing room version
+/// means version 1.
+pub fn parse_create(content: &Value) -> Option<CreateInfo> {
+    let obj = content.as_object()?;
+    let room_version = match obj.get("room_version") {
+        None | Some(Value::Null) => "1".to_owned(),
+        Some(Value::String(v)) => v.clone(),
+        Some(_) => return None,
+    };
+    let creator = obj
+        .get("creator")
+        .and_then(Value::as_str)
+        .map(str::to_owned);
+    let additional_creators = match obj.get("additional_creators") {
+        None | Some(Value::Null) => Vec::new(),
+        Some(Value::Array(list)) => list
+            .iter()
+            .filter_map(|v| v.as_str().map(str::to_owned))
+            .collect(),
+        Some(_) => return None,
+    };
+    Some(CreateInfo {
+        room_version,
+        creator,
+        additional_creators,
+    })
+}
+
+/// Decides whether `user_id` (a local user) may share the screen in
+/// `room_id`. Reads at most the power levels event, the create event and, for
+/// a room of version 12 or later, the create event itself (for its sender).
+/// Never fails: any error is "no".
+pub async fn may_share_screen(
+    deps: &dyn Deps,
+    cs_api_url: &CsApiUrl,
+    room_id: &str,
+    user_id: &str,
+    as_token: &str,
+) -> bool {
+    // A client-supplied room ID that is not one never reaches a URL.
+    if !room_id.starts_with('!') {
+        return false;
+    }
+    let power_levels = match deps
+        .get_room_state_content(
+            cs_api_url,
+            room_id,
+            "m.room.power_levels",
+            user_id,
+            as_token,
+        )
+        .await
+    {
+        Ok(content) => content,
+        Err(err) => {
+            tracing::warn!(room = %room_id, user = %user_id, err = %err,
+                "Screen share: power levels unreadable, camera and microphone only");
+            return false;
+        }
+    };
+    if let Some(content) = &power_levels {
+        match power_and_kick(content, user_id) {
+            None => {
+                tracing::warn!(room = %room_id, user = %user_id,
+                    "Screen share: malformed power levels, camera and microphone only");
+                return false;
+            }
+            Some((power, kick)) if power >= kick => return true,
+            Some(_) => {}
+        }
+        // Room versions before 12 have a server part in the room ID. There
+        // the power levels event is complete: nobody has a power the event
+        // does not state.
+        if room_id.contains(':') {
+            return false;
+        }
+    }
+
+    // No power levels event (the creator has 100, anybody else 0), or a
+    // room of version 12 (creators are above every level and are not listed
+    // in the event).
+    let create = match deps
+        .get_room_state_content(cs_api_url, room_id, "m.room.create", user_id, as_token)
+        .await
+    {
+        Ok(Some(content)) => content,
+        Ok(None) => return false,
+        Err(err) => {
+            tracing::warn!(room = %room_id, user = %user_id, err = %err,
+                "Screen share: create event unreadable, camera and microphone only");
+            return false;
+        }
+    };
+    let Some(info) = parse_create(&create) else {
+        return false;
+    };
+    if creators_have_unlimited_power(&info.room_version) {
+        if info.additional_creators.iter().any(|c| c == user_id) {
+            return true;
+        }
+        // The creating user is the sender of the create event, whose ID is
+        // the room ID with a `$` sigil.
+        let Some(hash) = room_id.strip_prefix('!').filter(|h| !h.is_empty()) else {
+            return false;
+        };
+        return match deps
+            .get_room_event(cs_api_url, room_id, &format!("${hash}"), user_id, as_token)
+            .await
+        {
+            Ok(Some(event)) => event.get("sender").and_then(Value::as_str) == Some(user_id),
+            Ok(None) => false,
+            Err(err) => {
+                tracing::warn!(room = %room_id, user = %user_id, err = %err,
+                    "Screen share: create event unreadable, camera and microphone only");
+                false
+            }
+        };
+    }
+    power_levels.is_none() && info.creator.as_deref() == Some(user_id)
+}
