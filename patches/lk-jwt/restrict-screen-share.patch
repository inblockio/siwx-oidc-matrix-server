+/// Answers a scripted room state / event request.
+async fn answer_room_state(
+    state: Arc<Mutex<HsState>>,
+    room_id: String,
+    key: String,
+    query: HashMap<String, String>,
+    headers: HeaderMap,
+) -> (StatusCode, Json<serde_json::Value>) {
+    let authorization = headers
+        .get(axum::http::header::AUTHORIZATION)
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or_default()
+        .to_owned();
+    let (delay_ms, scripted) = {
+        let mut state = state.lock().unwrap();
+        state.room_state_requests.push(RoomStateRequest {
+            authorization,
+            room_id: room_id.clone(),
+            event_type: key.clone(),
+            user_id: query.get("user_id").cloned().unwrap_or_default(),
+        });
+        (
+            state.room_state_delay_ms,
+            state.room_state.get(&(room_id, key)).cloned(),
+        )
+    };
+    if delay_ms > 0 {
+        tokio::time::sleep(std::time::Duration::from_millis(delay_ms)).await;
+    }
+    match scripted {
+        Some((status, body)) => (
+            StatusCode::from_u16(status).unwrap(),
+            Json(body.unwrap_or_else(|| json!({ "errcode": "M_UNKNOWN", "error": "scripted" }))),
+        ),
+        None => (
+            StatusCode::NOT_FOUND,
+            Json(json!({ "errcode": "M_NOT_FOUND", "error": "Event not found." })),
+        ),
+    }
+}
+
+/// Handler for `GET /rooms/{room_id}/state/{event_type}/`.
+async fn handle_room_state(
+    State(state): State<Arc<Mutex<HsState>>>,
+    Path((room_id, event_type)): Path<(String, String)>,
+    Query(query): Query<HashMap<String, String>>,
+    headers: HeaderMap,
+) -> impl IntoResponse {
+    answer_room_state(state, room_id, event_type, query, headers).await
+}
+
+/// Handler for `GET /rooms/{room_id}/event/{event_id}`.
+async fn handle_room_event(
+    State(state): State<Arc<Mutex<HsState>>>,
+    Path((room_id, event_id)): Path<(String, String)>,
+    Query(query): Query<HashMap<String, String>>,
+    headers: HeaderMap,
+) -> impl IntoResponse {
+    answer_room_state(state, room_id, format!("event:{event_id}"), query, headers).await
+}
