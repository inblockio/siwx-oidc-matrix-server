diff --git a/integration-tests/tests/sfu_get.rs b/integration-tests/tests/sfu_get.rs
index 84e0521..30cdc0d 100644
--- a/integration-tests/tests/sfu_get.rs
+++ b/integration-tests/tests/sfu_get.rs
@@ -1249,3 +1249,203 @@ async fn require_membership_off_does_not_ask_the_homeserver() {
