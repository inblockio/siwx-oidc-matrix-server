     expect_no_is_joined_requests(&hs);
 }
+
+// ── LIVEKIT_RESTRICT_SCREEN_SHARE ─────────────────────────────────────────────
+
+const RESTRICT_AS_TOKEN: &str = "as_token";
+const ROOM: &str = "!room:example.com";
+const CAMERA_MIC: [&str; 2] = ["camera", "microphone"];
+const ALL_SOURCES: [&str; 4] = ["camera", "microphone", "screen_share", "screen_share_audio"];
+
+/// Application-service configuration plus LIVEKIT_RESTRICT_SCREEN_SHARE=true,
+/// with the fake homeserver as the configured homeserver.
+fn restrict_screen_share_env(hs: &FakeHomeserver) -> HashMap<String, String> {
+    HashMap::from([
+        ("LIVEKIT_AS_TOKEN".to_owned(), RESTRICT_AS_TOKEN.to_owned()),
+        ("LIVEKIT_HS_TOKEN".to_owned(), "hs_token".to_owned()),
+        (
+            "LIVEKIT_HS_SERVER_NAME".to_owned(),
+            hs.server_name().to_owned(),
+        ),
+        (
+            "LIVEKIT_RESTRICT_SCREEN_SHARE".to_owned(),
+            "true".to_owned(),
+        ),
+    ])
+}
+
+/// The `canPublishSources` grant of the minted JWT (empty when absent).
+fn granted_sources(body: &str) -> Vec<String> {
+    let response: Value = serde_json::from_str(body).expect("response is not JSON");
+    let claims = decode_livekit_jwt(response["jwt"].as_str().unwrap_or_default());
+    claims["video"]["canPublishSources"]
+        .as_array()
+        .map(|a| {
+            a.iter()
+                .filter_map(|v| v.as_str().map(str::to_owned))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+async fn start_restricted(hs: &FakeHomeserver, sfu: &FakeSfu, restrict: bool) -> Service {
+    let mut extra_env = restrict_screen_share_env(hs);
+    if !restrict {
+        extra_env.clear();
+    }
+    Service::start(ServiceConfig {
+        full_access_homeservers: vec![hs.server_name().to_owned()],
+        cs_api_url_overrides: hs.cs_api_url_override(),
+        livekit_url: Some(sfu.url().to_owned()),
+        extra_env,
+        ..Default::default()
+    })
+    .await
+}
+
+/// The caller at or above the kick level gets every screen source, and the
+/// power was read as the caller with the AS token.
+#[tokio::test]
+async fn restrict_screen_share_host_gets_screen_sources() {
+    let hs = FakeHomeserver::new().await;
+    let host = hs.new_user("host");
+    let sfu = FakeSfu::new().await;
+    hs.set_room_state(
+        ROOM,
+        "m.room.power_levels",
+        200,
+        Some(json!({ "users": { host.user_id.clone(): 100 }, "users_default": 0 })),
+    );
+    let svc = start_restricted(&hs, &sfu, true).await;
+
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &host).to_string()).await;
+
+    assert_eq!(status, 200, "body: {body}");
+    assert_eq!(granted_sources(&body), ALL_SOURCES);
+    let reads = hs.room_state_requests();
+    assert_eq!(reads.len(), 1, "one power read: {reads:?}");
+    assert_eq!(reads[0].room_id, ROOM);
+    assert_eq!(reads[0].event_type, "m.room.power_levels");
+    assert_eq!(reads[0].user_id, host.user_id);
+    assert_eq!(
+        reads[0].authorization,
+        format!("Bearer {RESTRICT_AS_TOKEN}")
+    );
+    assert_eq!(sfu.create_room_requests().len(), 1);
+}
+
+/// A member at power 0 (users_default) gets camera and microphone only.
+#[tokio::test]
+async fn restrict_screen_share_member_gets_camera_and_microphone() {
+    let hs = FakeHomeserver::new().await;
+    let host = hs.new_user("host");
+    let guest = hs.new_user("guest");
+    let sfu = FakeSfu::new().await;
+    hs.set_room_state(
+        ROOM,
+        "m.room.power_levels",
+        200,
+        Some(json!({ "users": { host.user_id.clone(): 100 }, "users_default": 0 })),
+    );
+    let svc = start_restricted(&hs, &sfu, true).await;
+
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &guest).to_string()).await;
+
+    assert_eq!(status, 200, "body: {body}");
+    assert_eq!(granted_sources(&body), CAMERA_MIC);
+    let response: Value = serde_json::from_str(&body).unwrap();
+    let claims = decode_livekit_jwt(response["jwt"].as_str().unwrap());
+    assert_eq!(claims["video"]["canPublish"].as_bool(), Some(true));
+    assert_eq!(hs.room_state_requests()[0].user_id, guest.user_id);
+}
+
+/// No power levels event: the creator is 100, anybody else 0.
+#[tokio::test]
+async fn restrict_screen_share_without_power_levels_event_the_creator_shares() {
+    let hs = FakeHomeserver::new().await;
+    let creator = hs.new_user("creator");
+    let other = hs.new_user("other");
+    let sfu = FakeSfu::new().await;
+    hs.set_room_state(
+        ROOM,
+        "m.room.create",
+        200,
+        Some(json!({ "creator": creator.user_id.clone(), "room_version": "10" })),
+    );
+    let svc = start_restricted(&hs, &sfu, true).await;
+
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &creator).to_string()).await;
+    assert_eq!(status, 200, "body: {body}");
+    assert_eq!(granted_sources(&body), ALL_SOURCES);
+
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &other).to_string()).await;
+    assert_eq!(status, 200, "body: {body}");
+    assert_eq!(granted_sources(&body), CAMERA_MIC);
+}
+
+/// A failing power read (500) fails closed: camera and microphone, and the
+/// token request still succeeds.
+#[tokio::test]
+async fn restrict_screen_share_read_error_fails_closed() {
+    let hs = FakeHomeserver::new().await;
+    let host = hs.new_user("host");
+    let sfu = FakeSfu::new().await;
+    hs.set_room_state(ROOM, "m.room.power_levels", 500, None);
+    let svc = start_restricted(&hs, &sfu, true).await;
+
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &host).to_string()).await;
+
+    assert_eq!(status, 200, "body: {body}");
+    assert_eq!(granted_sources(&body), CAMERA_MIC);
+    assert_eq!(sfu.create_room_requests().len(), 1);
+}
+
+/// A power read that takes longer than the 3 s limit fails closed too.
+#[tokio::test]
+async fn restrict_screen_share_read_timeout_fails_closed() {
+    let hs = FakeHomeserver::new().await;
+    let host = hs.new_user("host");
+    let sfu = FakeSfu::new().await;
+    hs.set_room_state(
+        ROOM,
+        "m.room.power_levels",
+        200,
+        Some(json!({ "users": { host.user_id.clone(): 100 } })),
+    );
+    hs.set_room_state_delay(6_000);
+    let svc = start_restricted(&hs, &sfu, true).await;
+
+    let started = std::time::Instant::now();
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &host).to_string()).await;
+
+    assert_eq!(status, 200, "body: {body}");
+    assert_eq!(granted_sources(&body), CAMERA_MIC);
+    assert!(
+        started.elapsed() < Duration::from_secs(5),
+        "the read must be cut off at about 3 s, took {:?}",
+        started.elapsed()
+    );
+}
+
+/// Without the flag the endpoint stays upstream-compatible: the power levels
+/// are never read and the token carries no source restriction.
+#[tokio::test]
+async fn restrict_screen_share_off_reads_nothing_and_does_not_restrict() {
+    let hs = FakeHomeserver::new().await;
+    let guest = hs.new_user("guest");
+    let sfu = FakeSfu::new().await;
+    hs.set_room_state(ROOM, "m.room.power_levels", 500, None);
+    let svc = start_restricted(&hs, &sfu, false).await;
+
+    let (status, body) = post_sfu_get(&svc, sfu_get_request(&hs, &guest).to_string()).await;
+
+    assert_eq!(status, 200, "body: {body}");
+    assert!(
+        granted_sources(&body).is_empty(),
+        "no source restriction without the flag: {body}"
+    );
+    assert!(
+        hs.room_state_requests().is_empty(),
+        "no state read expected"
+    );
+}
