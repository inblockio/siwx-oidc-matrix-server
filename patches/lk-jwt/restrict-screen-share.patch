+/// Off (the default): no state read at all, and no source restriction.
+#[tokio::test]
+async fn test_restrict_screen_share_off_reads_nothing() {
+    let (deps, reads) = restrict_deps("@user:example.com", None);
+    let handler = restrict_handler(deps, false);
+    for (route, jwt) in mint_on_every_route(&handler).await {
+        assert!(jwt_sources(&jwt).is_empty(), "{route}: no restriction");
+    }
+    assert!(reads.lock().unwrap().is_empty());
+    handler.close().await;
+}
+
+/// On: a caller at or above the kick level gets the screen sources on every
+/// route, and the power is read as the caller with the AS token.
+#[tokio::test]
+async fn test_restrict_screen_share_host_gets_screen_sources() {
+    let (deps, reads) = restrict_deps(
+        "@user:example.com",
+        Some(Ok(Some(power_levels_for("@user:example.com", 100)))),
+    );
+    let handler = restrict_handler(deps, true);
+    for (route, jwt) in mint_on_every_route(&handler).await {
+        assert_eq!(jwt_sources(&jwt), SOURCES_ALL, "{route}");
+        let video = &parse_jwt_claims(&jwt, "secret")["video"];
+        assert_eq!(video["canPublish"].as_bool(), Some(true), "{route}");
+    }
+    let reads = reads.lock().unwrap().clone();
+    assert_eq!(reads.len(), 3, "one power read per token");
+    for (room, event_type, user, token) in reads.iter() {
+        assert_eq!(room, "!testRoom:example.com");
+        assert_eq!(event_type, "m.room.power_levels");
+        assert_eq!(user, "@user:example.com");
+        assert_eq!(token, "as_token");
+    }
+    handler.close().await;
