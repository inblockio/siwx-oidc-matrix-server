+
+package allocation
+
+import (
+	"encoding/binary"
+	"net"
+	"sync/atomic"
+
+	"github.com/pion/stun/v3"
+
+	"github.com/pion/turn/v5/internal/proto"
+)
+
+// Downlink padding (inblock.io): when a fixed size is configured, every media
+// packet the server relays to a client is sent as a STUN Data indication
+// padded to that size, so the relayed flow carries no per-packet size
+// information (audio is normally ~200 bytes, video ~1200, which makes relayed
+// calls stand out from bulk TLS traffic on the same host).
+//
+// The padding rides an unregistered STUN attribute inside the Data indication,
+// not extra bytes between messages: TURN-over-TCP framing is self-delimiting
+// (see proto.STUNConn), so anything between messages would corrupt the stream.
+// Comprehension-optional attribute types (0x8000-0xFFFF) must be ignored by
+// receivers that do not understand them (RFC 8489 s. 14.2), so no client
+// change is needed. The Data indication is the base TURN delivery mechanism
+// every client implements; with padding active the server stops using the
+// ChannelData optimization for server-to-client media (RFC 5766 s. 11.7 says
+// the server sends a ChannelData message when a channel is bound - a
+// deliberate deviation, accepted for the traffic-shape goal).
+//
+// Only server-to-client media is padded. Client-to-server messages and TURN
+// control traffic (allocate/refresh/permission responses) are untouched: the
+// client side of those is the browser's, which this server cannot change, and
+// control responses are rare.
+const (
+	// stunAttrTypePadding is unregistered and in the comprehension-optional
+	// range: receivers that do not know it must skip it.
+	stunAttrTypePadding stun.AttrType = 0x8070
+
+	// stunHeaderSize mirrors proto.stunHeaderSize, kept local so the padding
+	// code has no new cross-package surface.
+	stunHeaderSize = 20
+)
+
+// downlinkPadTarget is the configured fixed message size, 0 = off. It is set
+// once through SetDownlinkPadTarget before the server starts accepting
+// allocations; the server's allocations are created strictly after that, so
+// the plain (non-atomic-read) Store here only guards against torn writes on
+// 32-bit platforms.
+var downlinkPadTarget atomic.Int32
+
+// SetDownlinkPadTarget enables downlink padding when bytes is > 0 and disables
+// it when 0. Values below 0 are ignored. Must be called before turn.NewServer,
+// never after (see the var's comment).
+func SetDownlinkPadTarget(bytes int32) {
+	downlinkPadTarget.Store(bytes)
+}
+
+// buildPaddedDataIndication returns a Data indication carrying payload from
+// srcAddr, padded to target bytes when it would be shorter. It returns nil
+// when srcAddr is not a UDP address or the indication cannot be built; the
+// caller then falls back to the normal ChannelData / Data indication paths.
+func buildPaddedDataIndication(payload []byte, srcAddr net.Addr, target int32) []byte {
+	udpAddr, ok := srcAddr.(*net.UDPAddr)
+	if !ok {
+		return nil
+	}
+
+	msg, err := stun.Build(
+		stun.TransactionID,
+		stun.NewType(stun.MethodData, stun.ClassIndication),
+		proto.PeerAddress{IP: udpAddr.IP, Port: udpAddr.Port},
+		proto.Data(payload),
+	)
+	if err != nil {
+		return nil
+	}
+	return padStunMessage(msg.Raw, target)
+}
+
+// padStunMessage appends the padding attribute to raw until it is target
+// bytes (up to 3 bytes short, since STUN attributes are 4-byte aligned). raw
+// must be exactly one complete STUN message; anything else is returned
+// unchanged (fail-open to normal behaviour).
+func padStunMessage(raw []byte, target int32) []byte {
+	if len(raw) < stunHeaderSize || !stun.IsMessage(raw) {
+		return raw
+	}
+	attrLen := int(target) - len(raw) - 4 // 4 = attribute header
+	if attrLen < 0 {
+		// Already at (or within one attribute of) the target: leave it.
+		return raw
+	}
+	attrLen -= attrLen % 4
+
+	bodyLen := int(binary.BigEndian.Uint16(raw[2:4]))
+	if bodyLen+stunHeaderSize != len(raw) {
+		return raw
+	}
+
+	out := make([]byte, 0, len(raw)+4+attrLen)
+	out = append(out, raw...)
+	var attrHeader [4]byte
+	binary.BigEndian.PutUint16(attrHeader[0:2], uint16(stunAttrTypePadding))
+	binary.BigEndian.PutUint16(attrHeader[2:4], uint16(attrLen)) // zeros are the padding
+	out = append(out, attrHeader[:]...)
+	out = append(out, make([]byte, attrLen)...)
+
+	binary.BigEndian.PutUint16(out[2:4], uint16(bodyLen+4+attrLen))
+	return out
+}
