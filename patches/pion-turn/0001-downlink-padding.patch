+package allocation
+
+import (
+	"bytes"
+	"encoding/binary"
+	"net"
+	"testing"
+
+	"github.com/pion/stun/v3"
+
+	"github.com/pion/turn/v5/internal/proto"
+)
+
+func TestBuildPaddedDataIndication(t *testing.T) {
+	// A short, audio-sized payload padded up to the target.
+	payload := bytes.Repeat([]byte{0xA5}, 160)
+	peer := &net.UDPAddr{IP: net.ParseIP("172.21.0.5"), Port: 20123}
+
+	raw := buildPaddedDataIndication(payload, peer, 1300)
+	if raw == nil {
+		t.Fatal("expected a padded indication, got nil")
+	}
+
+	// Padded to the target, within STUN's 4-byte attribute alignment.
+	if len(raw) > 1300 || len(raw) < 1300-3 {
+		t.Fatalf("padded size %d not within [1297, 1300]", len(raw))
+	}
+
+	msg := &stun.Message{Raw: raw}
+	if err := msg.Decode(); err != nil {
+		t.Fatalf("padded indication does not decode: %v", err)
+	}
+	if !stun.IsMessage(raw) || msg.Type != stun.NewType(stun.MethodData, stun.ClassIndication) {
+		t.Fatalf("not a Data indication: %v", msg.Type)
+	}
+
+	var gotPeer proto.PeerAddress
+	if err := gotPeer.GetFrom(msg); err != nil {
+		t.Fatalf("XOR-PEER-ADDRESS missing: %v", err)
+	}
+	if gotPeer.String() != peer.String() {
+		t.Fatalf("peer %v, want %v", gotPeer, peer)
+	}
+
+	var gotData proto.Data
+	if err := gotData.GetFrom(msg); err != nil {
+		t.Fatalf("DATA missing: %v", err)
+	}
+	if !bytes.Equal(gotData, payload) {
+		t.Fatal("DATA payload altered by padding")
+	}
+
+	// The declared STUN body length must cover the whole message, so the
+	// receiver's framing (proto.STUNConn) stays intact.
+	if bodyLen := int(binary.BigEndian.Uint16(raw[2:4])); bodyLen+20 != len(raw) {
+		t.Fatalf("body length %d does not cover message of %d bytes", bodyLen, len(raw))
+	}
+
+	// The padding attribute is present and is the last one.
+	if last := msg.Attributes[len(msg.Attributes)-1]; last.Type != stunAttrTypePadding {
+		t.Fatalf("last attribute type %v, want padding %v", last.Type, stunAttrTypePadding)
+	}
+}
+
+func TestBuildPaddedDataIndicationLargePayload(t *testing.T) {
+	// A video-sized payload at or above the target passes through unpadded,
+	// still as a Data indication.
+	payload := bytes.Repeat([]byte{0x5A}, 1280)
+	peer := &net.UDPAddr{IP: net.ParseIP("172.21.0.5"), Port: 20100}
+
+	raw := buildPaddedDataIndication(payload, peer, 1300)
+	if raw == nil {
+		t.Fatal("expected an indication, got nil")
+	}
+	msg := &stun.Message{Raw: raw}
+	if err := msg.Decode(); err != nil {
+		t.Fatalf("does not decode: %v", err)
+	}
+	var gotData proto.Data
+	if err := gotData.GetFrom(msg); err != nil || !bytes.Equal(gotData, payload) {
+		t.Fatalf("payload altered (err %v)", err)
+	}
+}
+
+func TestBuildPaddedDataIndicationNonUDP(t *testing.T) {
+	// A non-UDP source address cannot become a PeerAddress: nil, so the
+	// caller falls back to the normal paths.
+	if raw := buildPaddedDataIndication([]byte{1}, &net.TCPAddr{}, 1300); raw != nil {
+		t.Fatalf("expected nil for a TCP address, got %d bytes", len(raw))
+	}
+}
+
+func TestPadStunMessageRefusesNonMessage(t *testing.T) {
+	// Anything that is not exactly one complete STUN message is left alone.
+	for _, tc := range [][]byte{
+		nil,
+		[]byte{0x00},
+		bytes.Repeat([]byte{0x00}, 10), // too short for a header
+		append(append([]byte{0x00, 0x17}, 0x00, 0x05), make([]byte, 16)...), // 20-byte header whose length field lies about the body
+	} {
+		if got := padStunMessage(tc, 1300); !bytes.Equal(got, tc) {
+			t.Fatalf("input %v was modified", tc)
+		}
+	}
+}
