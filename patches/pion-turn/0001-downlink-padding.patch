+
+// SetDownlinkPadTarget enables fixed-size downlink padding for the embedded
+// TURN server (see internal/allocation/downlink_padding.go): every media
+// packet relayed to a client is sent as a STUN Data indication padded to
+// bytes. bytes <= 0 disables it (upstream behaviour). Must be called before
+// NewServer; a change after the server has started has no effect.
+func SetDownlinkPadTarget(bytes int32) {
+	allocation.SetDownlinkPadTarget(bytes)
+}
