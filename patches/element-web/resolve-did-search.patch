+      "canonical": "did:key:z6mkmwzijj2k3ckqvqnmmgvkefmhdse4zxrfvqksxdmgba4v",
+      "localpart": "4qhlwf2qqvk7sqfw",
+      "legacy_localpart": "did-key-z6mkmwzijj2k3ckqvqnmmgvkefmhdse4zxrfvqksxdmgba4v"
