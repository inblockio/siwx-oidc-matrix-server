+// @vitest-environment happy-dom
+
+import React from "react";
+import { describe, it, expect } from "vitest";
+import { render } from "test-utils-rtl";
+
+import { DMRoomTile } from "./DMRoomTile";
+import { DirectoryMember } from "../../../../utils/direct-messages";
+import { DidSearchMember } from "../../../../utils/didSearchMember";
+
+describe("DMRoomTile DID search marker", () => {
+    const user = { user_id: "@0f2g2c0d3vclsu3i:home.server", display_name: "Alice" };
+
+    it.each([
+        [{ verification: "verified" } as const, "DID verified"],
+        [{ verification: "unverified", reason: "unchecked" } as const, "DID unverified: signing key unreachable"],
+        [{ verification: "unverified", reason: "unpublished" } as const, "DID unverified: not yet published"],
+    ])("marks a DID search hit %o", (state, text) => {
+        const { container } = render(
+            <DMRoomTile member={new DidSearchMember(user, { userId: user.user_id, ...state })} />,
+        );
+        expect(container.textContent).toContain(`${user.user_id} · ${text}`);
+    });
+
+    it("renders no marker for an ordinary directory result, whatever its display name claims", () => {
+        const { container } = render(
+            <DMRoomTile member={new DirectoryMember({ ...user, display_name: "Alice (DID verified)" })} />,
+        );
+        expect(container.textContent).not.toContain(" · DID");
+    });
+});
