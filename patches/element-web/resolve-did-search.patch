+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { type MatrixClient } from "matrix-js-sdk/src/matrix";
+
+import {
+    canonicaliseDid,
+    clearResolverDiscoveryCache,
+    DID_PROFILE_FIELD,
+    didSearchOptionsFromConfig,
+    legacyLocalpartForDid,
+    localpartForDid,
