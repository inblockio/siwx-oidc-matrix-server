+} from "./didLocalpart";
+
+/**
+ * These are the SAME vectors pinned by siwx-oidc's `src/mxid.rs` tests
+ * (`PKH_EXPECTED`, `KEY_UPPER_EXPECTED`, `KEY_LOWER_EXPECTED`). This file is a
+ * hand-maintained mirror of that Rust module, and nothing links the two, so
+ * these constants are the only thing standing between a silent drift and a
+ * client that looks up the wrong address. If one of these fails, do not "fix"
+ * the expectation — the derivation changed, and changing it silently reassigns
+ * Matrix accounts.
+ */
+const PKH_LOWER = "did:pkh:eip155:1:0x7a760ea15d76f935c8646b449af488c2b0021734";
+const PKH_MIXED = "did:pkh:eip155:1:0x7A760ea15d76F935c8646b449AF488c2B0021734";
