+/**
+ * siwx-oidc's golden vector FILE, embedded verbatim. The Rust test
+ * `tests/localpart_vectors.rs` proves the file is what `mxid.rs` computes, and
+ * siwx-oidc-matrix-server's `scripts/check-did-localpart-vectors.sh` proves this
+ * copy is byte-identical to the file -- so the chain "server derivation ==
+ * fixture == this mirror" is checked end to end instead of trusted. Replace the
+ * whole block from the fixture; never edit a value by hand.
+ */
+// BEGIN siwx-oidc tests/fixtures/localpart-vectors.json
+const GOLDEN = JSON.parse(`{
+  "_comment": "Golden vectors for siwx_oidc::mxid (canonicalize, localpart_for, legacy_localpart). The source of truth for every hand-copied mirror of the derivation (Element Web resolve-did-search patch, e2e/browser/mxid-helper.mjs). Enforced by tests/localpart_vectors.rs. APPEND ONLY: a changed value means the derivation changed, which reassigns Matrix accounts.",
+  "vectors": [
+    {
+      "did": "did:pkh:eip155:1:0x7a760ea15d76f935c8646b449af488c2b0021734",
+      "canonical": "did:pkh:eip155:1:0x7a760ea15d76f935c8646b449af488c2b0021734",
+      "localpart": "37rb2h7bdij3o1qm",
+      "legacy_localpart": "did-pkh-eip155-1-0x7a760ea15d76f935c8646b449af488c2b0021734"
+    },
+    {
+      "did": "did:pkh:eip155:1:0x7A760ea15d76F935c8646b449AF488c2B0021734",
+      "canonical": "did:pkh:eip155:1:0x7a760ea15d76f935c8646b449af488c2b0021734",
+      "localpart": "37rb2h7bdij3o1qm",
+      "legacy_localpart": "did-pkh-eip155-1-0x7a760ea15d76f935c8646b449af488c2b0021734"
+    },
+    {
+      "did": "did:key:z6MkmWziJJ2k3ckqVqnmMGVKefMhDSe4ZxrfvqksxDMGBa4v",
+      "canonical": "did:key:z6MkmWziJJ2k3ckqVqnmMGVKefMhDSe4ZxrfvqksxDMGBa4v",
