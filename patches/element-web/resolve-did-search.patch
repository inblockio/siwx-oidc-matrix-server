+/**
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+import { _t } from "../languageHandler";
+import { DirectoryMember } from "./direct-messages";
+import { type DidMatch } from "./didLocalpart";
+
+/**
+ * A user found by DID search, carrying how far the DID binding was checked, so
+ * the invite dialog can mark the result.
+ */
+export class DidSearchMember extends DirectoryMember {
+    public constructor(
+        userDirResult: { user_id: string; display_name?: string; avatar_url?: string },
+        public readonly didMatch: DidMatch,
+    ) {
+        super(userDirResult);
+    }
+}
+
+/**
+ * The marker shown next to a DID search result.
+ *
+ * Rendered from our own state, never from anything the found user controls: a
+ * display name reading "(DID verified)" must not be able to pass for this.
+ */
+export function didMatchMarker(match: DidMatch): string {
+    if (match.verification === "verified") return _t("user_info|did_search_verified");
+    return match.reason === "unpublished"
+        ? _t("user_info|did_search_unverified_unpublished")
+        : _t("user_info|did_search_unverified_unchecked");
+}
