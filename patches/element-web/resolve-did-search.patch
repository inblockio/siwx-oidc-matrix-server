+import { type MatrixClient, type SyncUserProfile } from "matrix-js-sdk/src/matrix";
+
+import { clearIssuerKeysCache, fetchPublicJson, PromiseCache, type ProofVerdict, verifyDidProof } from "./didProof";
+
+/**
+ * The MSC4133 profile field an identity provider publishes a user's DID into.
+ *
+ * This literal is one side of a THREE-sided contract — provider
+ * (siwx-oidc `did_assertion::DID_PROFILE_FIELD`), verifier (`siwx-oidc-auth`),
+ * and homeserver (Synapse's `experimental_features.msc4133_key_denylist`,
+ * which is what makes the field unwritable by its own subject). The three
+ * deploy independently and fail APART: renaming it here alone means every
+ * account reads as "no DID".
+ *
+ * Defined in this module rather than in `useAttestedDid` so that resolving a
+ * DID stays free of React: the hook re-exports it, so importers of either
+ * module see one constant.
+ */
+export const DID_PROFILE_FIELD = "io.inblock.did";
+
+/**
+ * Resolve a DID to the Matrix user it belongs to.
+ *
+ * # Why this can exist at all
+ *
+ * A DID can never *be* an MXID. Synapse's `MXID_LOCALPART_ALLOWED_CHARACTERS`
+ * (1.159.0) is `a-z 0-9 - / _ . = +`: no colon — and a colon is structurally
+ * impossible anyway, since the first one in an MXID ends the localpart — and no
+ * uppercase, which alone rules out `did:key`, whose multibase payload is
+ * case-sensitive key material. So `@did:key:z6Mk…:server` is not a user ID that
+ * can be typed, stored or routed.
+ *
+ * What IS possible is the forward direction: siwx-oidc derives the localpart
+ * from the DID by a pure function, so a client that knows that function can
+ * compute the candidate address offline and then simply ask whether it exists.
+ *
+ * # This is a HAND-MAINTAINED MIRROR of siwx-oidc's `src/mxid.rs`
+ *
+ * It is the third copy (after `e2e/browser/mxid-helper.mjs`), and nothing links
+ * them — they drift silently. A previous hand-copy of `localpart_for` diverged
+ * by unconditionally lowercasing every DID, which is exactly the bug class that
+ * maps two different public keys onto one account (siwx-oidc#17).
+ *
+ * That hazard is neutralised here by never trusting the derivation on its own:
+ * {@link resolveDidToUserId} reads the provider-attested `io.inblock.did` back
+ * off the candidate profile and requires it to match the DID that was searched
+ * for. A divergent derivation therefore yields **no result**, never the wrong
+ * user — it can cost a false negative, it cannot misdirect. `didLocalpart.test.ts`
+ * pins the same vectors as `mxid.rs`'s own tests so drift is caught in CI first.
+ *
+ * Since the provider grew `GET /resolve`, this mirror is the FALLBACK, not the
+ * primary path: our own homeserver is asked through its resolver first, and the
+ * mirror runs only when no resolver answers -- which is also how a federated
+ * server running this stack is reached without the browser sending it the DID.
+ * The mirror is kept for exactly those two cases (see {@link resolveDid}).
+ *
+ * Since 2026-09-28 a match is also checked cryptographically: the ES256 proof
+ * beside the published DID is verified against the keys of the issuer the
+ * candidate's own homeserver advertises (`didProof.ts`), and the result says
+ * whether that succeeded (see {@link DidMatch}).
+ */
+
+const BASE36_ALPHABET = "0123456789abcdefghijklmnopqrstuvwxyz";
+const OUTPUT_WIDTH = 16;
+const DIGEST_BYTES_KEPT = 10; // 80 bits — see the "why 80 bits" note in src/mxid.rs
+
+/**
+ * `mxid::canonicalize`. The case rule is method-aware and is NOT cosmetic:
+ *
+ * - `did:pkh:*` is lowercased. The mixed case in an `0x…` address is an EIP-55
+ *   checksum over the same address, not separate identity.
+ * - `did:key:*` / `did:peer:*` keep their case. These are multibase base58btc,
+ *   where case is part of the encoded key bytes.
+ */
+export function canonicaliseDid(did: string): string {
+    return did.startsWith("did:pkh:") ? did.toLowerCase() : did;
+}
+
+/**
+ * `mxid::legacy_localpart` — the pre-2026-09 derivation. Permanent
+ * infrastructure, not dead code: an account provisioned under it keeps it
+ * forever, because Synapse has no user-rename API. Any lookup that checks only
+ * the modern shape silently fails to find every account created before the
+ * migration.
+ */
+export function legacyLocalpartForDid(did: string): string {
+    return did.replaceAll(":", "-").toLowerCase();
+}
+
+/**
+ * `mxid::localpart_for` — exactly 16 lowercase base36 characters, one
+ * alphanumeric run, no separators (matrix.org's MSC4284 policy server refuses
+ * the long multi-word legacy shape).
+ */
+export async function localpartForDid(did: string): Promise<string> {
+    const bytes = new TextEncoder().encode(canonicaliseDid(did));
+    const digest = new Uint8Array(await crypto.subtle.digest("SHA-256", bytes));
+
+    let n = 0n;
+    for (const byte of digest.subarray(0, DIGEST_BYTES_KEPT)) {
+        n = (n << 8n) | BigInt(byte);
+    }
+    let out = "";
+    while (n > 0n) {
+        out = BASE36_ALPHABET[Number(n % 36n)] + out;
+        n /= 36n;
+    }
+    return out.padStart(OUTPUT_WIDTH, BASE36_ALPHABET[0]);
+}
+
+/**
+ * A parsed search term: the DID, and optionally the homeserver it was pinned to.
+ *
+ * A DID names a KEY, not a server -- so a bare DID can only be looked for on the
+ * searcher's own homeserver. The optional `did:...@server.org` suffix is what
+ * makes a federated lookup expressible at all. `@` is safe as the separator
+ * because W3C DID Core's method-specific-id grammar does not admit it, so the
+ * split is unambiguous for every DID method.
+ */
+export interface DidQuery {
+    did: string;
+    /** Present only when the term pinned one explicitly. */
+    serverName?: string;
+}
+
+const DID_PATTERN = /^did:[a-z0-9]+:[A-Za-z0-9._%:-]+$/;
+// Matrix server_name: a DNS name or IPv4 literal with an optional port. IPv6
+// literals are not matched; the cost of that is a search that finds nothing,
+// never a wrong answer.
+const SERVER_PATTERN = /^[A-Za-z0-9][A-Za-z0-9.-]*(?::\d{1,5})?$/;
+
+/**
+ * Parse a search term into a DID and an optional homeserver, or `null` if it is
+ * not DID-shaped -- which is the common case, since this runs on every keystroke
+ * in a box people mostly type names into.
+ *
+ * Deliberately a shape test, not a validity test: whether this DID names anybody
+ * is the homeserver's answer, one request later.
+ */
+export function parseDidQuery(term: string): DidQuery | null {
+    const trimmed = term.trim();
+    if (!trimmed.startsWith("did:")) return null;
+
+    const at = trimmed.indexOf("@");
+    const did = at === -1 ? trimmed : trimmed.slice(0, at);
+    const serverName = at === -1 ? undefined : trimmed.slice(at + 1);
+
+    if (!DID_PATTERN.test(did)) return null;
+    if (serverName !== undefined && !SERVER_PATTERN.test(serverName)) return null;
+    return serverName === undefined ? { did } : { did, serverName };
+}
+
+/** Whether a search term is worth spending profile lookups on. */
+export function looksLikeDid(term: string): boolean {
+    return parseDidQuery(term) !== null;
+}
+
+/**
+ * A federated profile lookup is proxied by our homeserver to theirs, so an
+ * unreachable or slow peer stalls this request rather than failing it. The
+ * search box must not hang on that: past this bound the answer is "not found",
+ * which is also what the caller would have rendered anyway.
+ */
+const RESOLVE_TIMEOUT_MS = 10_000;
+
+/**
+ * How long the resolver step (discovery + the `/resolve` call) may take before
+ * the lookup falls back to the formula. Well inside {@link RESOLVE_TIMEOUT_MS},
+ * so a slow resolver still leaves the fallback time to run: a resolver that is
+ * down must cost a delay, never the result.
+ */
+const RESOLVER_BUDGET_MS = 4_000;
+
+/**
+ * How long verifying one proof (issuer pinning, discovery, JWKS, signature) may
+ * take. Past it the proof counts as UNCHECKED: the result is shown, marked
+ * unverified, exactly as if the keys had been unreachable.
+ */
+const VERIFY_BUDGET_MS = 4_000;
+
+/** How long a homeserver's auth metadata (resolver, issuer) is remembered. */
+const DISCOVERY_TTL_MS = 10 * 60_000;
+
+function withTimeout<T>(work: Promise<T>, ms: number, fallback: T): Promise<T> {
+    return Promise.race([work, new Promise<T>((resolve) => setTimeout(() => resolve(fallback), ms))]);
+}
+
+// ---------------------------------------------------------------------------
+// The authoritative path: the provider's own `GET /resolve`
+// ---------------------------------------------------------------------------
+
+/**
+ * The key under which siwx-oidc advertises its `GET /resolve` endpoint in its
+ * OpenID provider metadata. Synapse's `/_matrix/client/v1/auth_metadata`
+ * forwards that document with unknown keys intact (its `ServerMetadata` model
+ * is `extra="allow"`; `account_management_uri` reaches clients the same way),
+ * so any homeserver delegating auth to siwx-oidc advertises its resolver
+ * through the one discovery document every OAuth-aware client already reads.
+ */
+export const RESOLVE_ENDPOINT_METADATA_KEY = "io.inblock.resolve_endpoint";
+
+/**
+ * The `SdkConfig` key holding this feature's options, e.g.
+ * `"io.inblock.did_search": { "remote_resolvers": true }`.
+ */
+export const DID_SEARCH_CONFIG_KEY = "io.inblock.did_search";
+
+export interface ResolveDidOptions {
+    /**
+     * Also ask a PINNED REMOTE homeserver's resolver, discovered through that
+     * server's `.well-known/matrix/client` and `auth_metadata`.
+     *
+     * Off by default, because it is the one step that makes the searcher's
+     * BROWSER send the searched DID to another organisation: that party then
+     * learns the searcher's IP address alongside the DID being looked for,
+     * which the federated profile read (our homeserver asking theirs) never
+     * reveals. It also only works where the remote edge's CORS policy admits
+     * this origin. The result is verified the same way either way, so turning
+     * it on changes which account is found in edge cases (see
+     * {@link resolveDid}), never how much a match is trusted.
+     *
+     * (Proof verification of a remote match does contact the remote's
+     * well-known, auth metadata, discovery and JWKS regardless of this flag,
+     * but those requests name only the server and its issuer, never the DID.)
+     */
+    remoteResolvers?: boolean;
+    /** Injected in tests; defaults to the global `fetch`. */
+    fetchFn?: typeof fetch;
+}
+
+/** Read the options from `config.json`; absent or malformed means the defaults. */
+export function didSearchOptionsFromConfig(config: unknown): ResolveDidOptions {
+    const section = isRecord(config) ? config[DID_SEARCH_CONFIG_KEY] : undefined;
+    return { remoteResolvers: isRecord(section) && section["remote_resolvers"] === true };
+}
+
+type ResolverAnswer =
+    /** The provider named the account for this DID on this server. */
+    | { kind: "account"; userId: string }
+    /** The provider says no account exists for this DID on this server, under any shape. */
+    | { kind: "none" }
+    /** No usable answer: no resolver, CORS, 429, 5xx, timeout, malformed body. */
+    | { kind: "unavailable" };
+
+const UNAVAILABLE: ResolverAnswer = { kind: "unavailable" };
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/** The server half of `@localpart:server` (everything after the FIRST colon), or null. */
+export function serverNameOf(userId: string): string | null {
+    if (!userId.startsWith("@")) return null;
+    const colon = userId.indexOf(":");
+    return colon > 1 ? userId.slice(colon + 1) : null;
+}
+
+/** An endpoint URL a resolver may be fetched from; anything else is ignored. */
+function usableEndpoint(raw: unknown, allowHttp: boolean): string | null {
+    if (typeof raw !== "string") return null;
+    try {
+        const url = new URL(raw);
+        if (url.protocol === "https:" || (allowHttp && url.protocol === "http:")) return url.toString();
+    } catch {
+        // fall through
+    }
+    return null;
+}
+
+const authMetadataCache = new PromiseCache<Record<string, unknown> | null>(DISCOVERY_TTL_MS);
+
+/** Test hook: forget every discovered resolver, issuer and JWKS. */
+export function clearResolverDiscoveryCache(): void {
+    authMetadataCache.clear();
+    clearIssuerKeysCache();
+}
+
+/**
+ * The auth metadata `serverName` advertises, cached per server. It is the one
+ * document both the resolver discovery and the issuer PINNING read.
+ *
+ * - **Own homeserver:** through the client (`/_matrix/client/v1/auth_metadata`).
+ * - **Remote homeserver:** its `.well-known/matrix/client` -> `base_url` ->
+ *   `auth_metadata`. These requests carry the server name only, never a DID.
+ */
+function serverAuthMetadata(
+    client: MatrixClient,
+    serverName: string,
+    own: boolean,
+    fetchFn: typeof fetch,
+): Promise<Record<string, unknown> | null> {
+    return authMetadataCache.get(serverName, async () => {
+        if (own) {
+            const metadata: unknown = await client.getAuthMetadata();
+            return isRecord(metadata) ? metadata : null;
+        }
+        // `.well-known/matrix/client` lives on the bare hostname, never on a port.
+        const host = serverName.replace(/:\d+$/, "");
+        const wellKnown = await fetchPublicJson(fetchFn, `https://${host}/.well-known/matrix/client`);
+        const homeserver = isRecord(wellKnown) ? wellKnown["m.homeserver"] : undefined;
+        const baseUrl = usableEndpoint(isRecord(homeserver) ? homeserver.base_url : undefined, false);
+        if (!baseUrl) return null;
+        const metadata = await fetchPublicJson(
+            fetchFn,
+            `${baseUrl.replace(/\/+$/, "")}/_matrix/client/v1/auth_metadata`,
+        );
+        return isRecord(metadata) ? metadata : null;
+    });
+}
+
+/**
+ * Where `serverName`'s DID resolver lives, or null when it has none we may use.
+ *
+ * - **Own homeserver:** the advertised key in our own `auth_metadata`; failing
+ *   that, `{issuer}/resolve`. The issuer guess is allowed ONLY here: it is our
+ *   own deployment's provider, the answer is verified like any other, and a
+ *   provider without the route simply 404s into the formula fallback. It is
+ *   what lets this work against a siwx-oidc that predates the advertisement.
+ * - **Pinned remote homeserver** (only with `remoteResolvers`): the advertised
+ *   key in that server's `auth_metadata`. Never a guess: a remote issuer that
+ *   does not advertise a resolver is not assumed to be siwx-oidc.
+ */
+async function discoverResolver(
+    client: MatrixClient,
+    serverName: string,
+    own: boolean,
+    fetchFn: typeof fetch,
+): Promise<string | null> {
+    let metadata: Record<string, unknown> | null;
+    try {
+        metadata = await serverAuthMetadata(client, serverName, own, fetchFn);
+    } catch {
+        return null;
+    }
+    if (!metadata) return null;
+    const advertised = usableEndpoint(metadata[RESOLVE_ENDPOINT_METADATA_KEY], own);
+    if (advertised || !own) return advertised;
+    if (typeof metadata.issuer !== "string") return null;
+    const issuer = metadata.issuer.endsWith("/") ? metadata.issuer : metadata.issuer + "/";
+    try {
+        return usableEndpoint(new URL("resolve", issuer).toString(), true);
+    } catch {
+        return null;
+    }
+}
+
+/**
+ * The issuer `userId`'s OWN homeserver advertises: the only issuer whose keys
+ * may verify a proof about that user. Never taken from the proof itself, whose
+ * `iss` is attacker-chosen text until it has been compared with this. Rejects
+ * when the homeserver's metadata cannot be read or names no usable issuer.
+ */
+async function pinnedIssuerFor(client: MatrixClient, userId: string, fetchFn: typeof fetch): Promise<string> {
+    const serverName = serverNameOf(userId);
+    if (!serverName) throw new Error("not an MXID");
+    const own = serverName === client.getDomain();
+    const metadata = await serverAuthMetadata(client, serverName, own, fetchFn);
+    const issuer = usableEndpoint(metadata?.issuer, own);
+    if (!issuer || typeof metadata?.issuer !== "string") throw new Error("no usable issuer advertised");
+    return metadata.issuer;
+}
+
+/**
+ * Ask `serverName`'s resolver which account the DID has there.
+ *
+ * An answer counts only if it is about THAT server: a `mxid` on any other
+ * server is discarded as unusable, so a resolver cannot redirect a search to a
+ * homeserver the searcher did not ask about.
+ */
+async function askResolver(
+    client: MatrixClient,
+    did: string,
+    serverName: string,
+    own: boolean,
+    fetchFn: typeof fetch,
+): Promise<ResolverAnswer> {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), RESOLVER_BUDGET_MS);
+    try {
+        const endpoint = await withTimeout(
+            discoverResolver(client, serverName, own, fetchFn),
+            RESOLVER_BUDGET_MS,
+            null,
+        );
+        if (!endpoint) return UNAVAILABLE;
+        const url = new URL(endpoint);
+        url.searchParams.set("did", did);
+        const body = await fetchPublicJson(fetchFn, url.toString(), controller.signal);
+        if (!isRecord(body) || typeof body.exists !== "boolean" || typeof body.mxid !== "string") {
+            return UNAVAILABLE;
+        }
+        if (serverNameOf(body.mxid) !== serverName) return UNAVAILABLE;
+        return body.exists ? { kind: "account", userId: body.mxid } : { kind: "none" };
+    } catch {
+        return UNAVAILABLE;
+    } finally {
+        clearTimeout(timer);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Resolution
+// ---------------------------------------------------------------------------
+
+/**
+ * A DID search hit, and how far it could be checked.
+ *
+ * - `verified`: the account publishes the searched DID, and the ES256 proof
+ *   beside it verifies against the keys of the issuer its own homeserver
+ *   advertises, bound to this exact MXID (see `didProof.ts`).
+ * - `unverified`, `reason: "unchecked"`: the proof is present and passed every
+ *   check that needs no keys, but the issuer's discovery or JWKS could not be
+ *   reached (CORS, network, timeout). Shown, marked.
+ * - `unverified`, `reason: "unpublished"`: OUR OWN homeserver's resolver named
+ *   this account, but it has no signed DID in its profile yet (it has not
+ *   signed in since publication started, or the provider's key is ephemeral).
+ *   Only an own-server resolver hit can produce this; the formula and a remote
+ *   resolver are not trusted to name an account on their own.
+ */
+export interface DidMatch {
+    userId: string;
+    verification: "verified" | "unverified";
+    reason?: "unchecked" | "unpublished";
+}
+
+/**
+ * Find the Matrix user whose provider-attested DID is the one searched for, or
+ * `null`.
+ *
+ * Accepts either `did:key:z6Mk...` (looked for on the caller's own homeserver)
+ * or `did:key:z6Mk...@peer.example.org` (looked for on that one).
+ *
+ * # Two ways to find the candidate
+ *
+ * 1. **The provider's resolver, when it answers.** siwx-oidc's `GET /resolve`
+ *    applies the real derivation AND the real grandfathering rule
+ *    (`localpart::resolve_identity`: legacy shape first), so it cannot drift
+ *    from the provider and it names the canonical account even in the
+ *    split-brain case where both shapes exist. Used for our own homeserver
+ *    always, and for a pinned remote one when `remoteResolvers` is on. When it
+ *    answers, its answer is FINAL: "this account" means only that account is
+ *    checked, and "no account" means no result, without falling back to a
+ *    formula that could only second-guess it.
+ * 2. **The hand-copied formula, when it does not.** No resolver, CORS refusal,
+ *    a 429 from the edge limiter, a 5xx, a timeout (see
+ *    {@link RESOLVER_BUDGET_MS}) or a malformed answer all land here: both
+ *    candidate localparts are derived locally and tried on `serverName`, legacy
+ *    first (the provider's own grandfathering order). This is the path that
+ *    reaches any federated server running this stack without the searcher's
+ *    browser ever sending the DID to it, because Synapse proxies the profile
+ *    read over federation (`on_profile_query`).
+ *
+ * # One way to accept it
+ *
+ * **Every candidate is read back through our own homeserver, and its published
+ * `io.inblock.did` must be the searched DID.** Then the ES256 proof beside it
+ * is verified (`didProof.ts`): `sub` must be the searched DID, `mxid` must be
+ * the candidate (a copied proof fails here), `iss` must be the issuer the
+ * candidate's own homeserver advertises, and the signature must verify with
+ * that issuer's key for the proof's `kid` (retired keys included). A proof that
+ * fails any of these hides the candidate. A proof whose keys cannot be reached
+ * shows it, marked unverified. A candidate without a proof is hidden, EXCEPT
+ * when our own homeserver's resolver named it: that alone is enough to show
+ * the account, marked unverified (see {@link DidMatch}).
+ *
+ * # What a verified match across federation does and does not prove
+ *
+ * It proves the peer's identity provider (the issuer its homeserver
+ * advertises) attested this DID for this MXID, so a result no longer depends on
+ * the peer's profile write ACL. It does NOT protect against a malicious peer
+ * OPERATOR, who controls both the homeserver and the issuer it advertises and
+ * can therefore sign any binding it likes. See `didProof.ts`.
+ *
+ * Never throws: every failure -- no extended-profile support, no such user, an
+ * absent or malformed field, an unreachable peer, a network error -- is `null`
+ * or an unverified marker, because the caller is a search box that must keep
+ * working.
+ */
+export async function resolveDid(
+    client: MatrixClient,
+    term: string,
+    options: ResolveDidOptions = {},
+): Promise<DidMatch | null> {
+    const query = parseDidQuery(term);
+    if (!query) return null;
+
+    const ownServer = client.getDomain();
+    const serverName = query.serverName ?? ownServer;
+    if (!serverName || !globalThis.crypto?.subtle) return null;
+
+    return withTimeout(
+        probe(client, query.did, serverName, serverName === ownServer, options),
+        RESOLVE_TIMEOUT_MS,
+        null,
+    );
+}
+
+/** {@link resolveDid}, reduced to the user ID. Verified and unverified hits alike. */
+export async function resolveDidToUserId(
+    client: MatrixClient,
+    term: string,
+    options: ResolveDidOptions = {},
+): Promise<string | null> {
+    return (await resolveDid(client, term, options))?.userId ?? null;
+}
+
+async function probe(
+    client: MatrixClient,
+    did: string,
+    serverName: string,
+    own: boolean,
+    options: ResolveDidOptions,
+): Promise<DidMatch | null> {
+    try {
+        if ((await client.doesServerSupportExtendedProfiles()) === false) return null;
+    } catch {
+        return null;
+    }
+
+    const wanted = canonicaliseDid(did);
+    const fetchFn = options.fetchFn ?? globalThis.fetch?.bind(globalThis);
+
+    let answer: ResolverAnswer = UNAVAILABLE;
+    if (fetchFn && (own || options.remoteResolvers)) {
+        answer = await askResolver(client, did, serverName, own, fetchFn);
+    }
+
+    let candidates: string[];
+    switch (answer.kind) {
+        case "none":
+            return null;
+        case "account":
+            candidates = [answer.userId];
+            break;
+        case "unavailable":
+            // LEGACY FIRST, the order siwx-oidc's `localpart::resolve_identity`
+            // uses: an identity with a legacy account signs in to THAT account,
+            // so when both shapes publish the DID (the D4 split-brain), the
+            // legacy one is the canonical answer and the fallback must agree
+            // with the resolver it stands in for.
+            candidates = [...new Set([legacyLocalpartForDid(did), await localpartForDid(did)])].map(
+                (localpart) => `@${localpart}:${serverName}`,
+            );
+            break;
+    }
+    // Decision (Tim, 2026-09-28): our OWN resolver naming an account is enough
+    // to show it before it has published a signed DID. Only this source: the
+    // formula is a guess and a remote resolver is another organisation's word.
+    const ownResolverHit = own && answer.kind === "account";
+
+    for (const userId of candidates) {
+        const field = await readDidField(client, userId);
+        // A published DID that is not the searched one disqualifies the
+        // candidate whatever named it: a lying resolver gets no result.
+        if (field && canonicaliseDid(field.did) !== wanted) continue;
+        if (!field?.proof) {
+            if (ownResolverHit) return { userId, verification: "unverified", reason: "unpublished" };
+            continue;
+        }
+        const verdict = await withTimeout<ProofVerdict>(
+            verifyDidProof({
+                jws: field.proof,
+                expectedDid: wanted,
+                expectedMxid: userId,
+                pinnedIssuer: () => pinnedIssuerFor(client, userId, fetchFn ?? rejectingFetch),
+                canonicalise: canonicaliseDid,
+                fetchFn: fetchFn ?? rejectingFetch,
+            }),
+            VERIFY_BUDGET_MS,
+            { kind: "unchecked", reason: "verification timed out" },
+        );
+        if (verdict.kind === "verified") return { userId, verification: "verified" };
+        if (verdict.kind === "unchecked") return { userId, verification: "unverified", reason: "unchecked" };
+        // Rejected: hidden. The next formula candidate may still be genuine.
+        // A value that no longer verifies must not outlive this search in the
+        // client's profile cache either (see readDidField).
+        await forgetCachedDidField(client, userId);
+    }
+    return null;
+}
+
+/** Stands in when there is no global fetch: every key lookup is then "unchecked". */
+const rejectingFetch: typeof fetch = () => Promise.reject(new Error("no fetch available"));
+
+type DidField = { did: string; proof?: string };
+
+/** The `{did, proof?}` object in a raw profile value, or null when absent or malformed. */
+function parseDidField(raw: unknown): DidField | null {
+    if (!isRecord(raw) || typeof raw.did !== "string") return null;
+    // `proof` is absent (not null, not "") when the provider's key is
+    // ephemeral; anything that is not a non-empty string counts as absent.
+    return typeof raw.proof === "string" && raw.proof ? { did: raw.did, proof: raw.proof } : { did: raw.did };
+}
+
+/**
+ * The homeserver saying the profile does not exist: no such account, or a
+ * deactivated one. Any 404 counts, whatever its errcode: an unknown user is
+ * `M_NOT_FOUND`, but a user deactivated with erasure answers
+ * `404 M_UNKNOWN "No row found (profiles)"` (Synapse 1.161, seen live on dev).
+ */
+function isProfileNotFound(e: unknown): boolean {
+    return isRecord(e) && e.httpStatus === 404;
+}
+
+/**
+ * The `{did, proof?}` object in `userId`'s profile, or null when absent or
+ * malformed. Read FRESH from the homeserver whenever it answers.
+ *
+ * # Why not `getExtendedProfileProperty`
+ *
+ * matrix-js-sdk's `getExtendedProfileProperty` is cache-first: the first read
+ * of a key writes the value through to the client store (IndexedDB in Element)
+ * and every later read returns that copy without asking the server again. Only
+ * a sync `profile_updates` entry (MSC4429, for keys in the sync filter, which
+ * this one is not) ever refreshes it. So a DID that was unpublished, rebound or
+ * deactivated after the first search would keep answering from the cache
+ * forever. `getExtendedProfile` bypasses that cache (it returns the whole
+ * profile, which the cache cannot), so it is the read that decides.
+ *
+ * # Keeping the cache honest
+ *
+ * The cached copy is also what other surfaces read (`useAttestedDid`), so a
+ * fresh answer is written back over it: a changed value overwrites the cached
+ * one, a field the server no longer has is removed from the cached profile, and
+ * an account the server no longer knows (any 404) loses its cached profile
+ * altogether. The cache is consulted only when the homeserver cannot
+ * answer at all (network error, 5xx, an unreachable federated peer), and then
+ * the candidate still has to pass proof verification; a cached value that
+ * fails it is evicted by the caller ({@link forgetCachedDidField}).
+ */
+async function readDidField(client: MatrixClient, userId: string): Promise<DidField | null> {
+    let profile: Record<string, unknown>;
+    try {
+        profile = await client.getExtendedProfile(userId);
+    } catch (e) {
+        if (isProfileNotFound(e)) {
+            await forgetCachedProfile(client, userId);
+            return null;
+        }
+        // The homeserver could not answer: the cached copy is all there is.
+        try {
+            return parseDidField(await client.getExtendedProfileProperty(userId, DID_PROFILE_FIELD));
+        } catch {
+            // The overwhelmingly common case: no such user, or a user with no
+            // published DID. Not worth a log line per keystroke.
+            return null;
+        }
+    }
+    const raw = isRecord(profile) ? profile[DID_PROFILE_FIELD] : undefined;
+    await syncCachedDidField(client, userId, raw);
+    return parseDidField(raw);
+}
+
+/**
+ * Bring a cached copy of `userId`'s DID field in line with what the server
+ * just said (`fresh === undefined`: the server has no such field). Writes only
+ * where a cached copy exists; never throws.
+ */
+async function syncCachedDidField(client: MatrixClient, userId: string, fresh: unknown): Promise<void> {
+    try {
+        const store = client.store;
+        const cached = await store?.getUserProfile(userId);
+        if (!cached || cached[DID_PROFILE_FIELD] === undefined) return;
+        if (fresh === undefined) {
+            await forgetCachedDidField(client, userId);
+        } else {
+            // Read off the wire as JSON, so it is JSON: the cast only restates that.
+            const value = fresh as SyncUserProfile[string];
+            await store.storeUserProfiles(new Map([[userId, { ...cached, [DID_PROFILE_FIELD]: value }]]));
+        }
+    } catch {
+        // A cache we cannot write is a cache we will read past next time anyway.
+    }
+}
+
+/** Drop the DID field from `userId`'s cached profile (the whole entry when nothing else is left). */
+async function forgetCachedDidField(client: MatrixClient, userId: string): Promise<void> {
+    try {
+        const store = client.store;
+        const cached = await store?.getUserProfile(userId);
+        if (!cached || cached[DID_PROFILE_FIELD] === undefined) return;
+        const { [DID_PROFILE_FIELD]: _dropped, ...rest } = cached;
+        if (Object.keys(rest).length) {
+            await store.storeUserProfiles(new Map([[userId, rest]]));
+        } else {
+            await store.removeUserProfiles([userId]);
+        }
+    } catch {
+        // See syncCachedDidField.
+    }
+}
+
+/** Drop `userId`'s whole cached profile: the homeserver says the account does not exist. */
+async function forgetCachedProfile(client: MatrixClient, userId: string): Promise<void> {
+    try {
+        const store = client.store;
+        if (await store?.getUserProfile(userId)) await store.removeUserProfiles([userId]);
+    } catch {
+        // See syncCachedDidField.
+    }
+}
diff --git a/apps/web/src/utils/didProof.ts b/apps/web/src/utils/didProof.ts
new file mode 100644
index 0000000..b702f82
--- /dev/null
+++ b/apps/web/src/utils/didProof.ts
@@ -0,0 +1,303 @@
+/**
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+/**
+ * Client-side verification of the ES256 proof siwx-oidc publishes next to a
+ * user's DID in the `io.inblock.did` profile field.
+ *
+ * # The wire contract
+ *
+ * Defined in siwx-oidc's `src/did_assertion.rs` header comment, and mirrored by
+ * the Rust verifier in `siwx-oidc-auth/src/did_assertion.rs`:
+ *
+ *     compact JWS, ES256, header {"alg":"ES256","typ":"JWT","kid":...}
+ *     payload {"iss":<issuer>,"sub":<exact-case DID>,"mxid":<@local:server>,"iat":<secs>}
+ *     signature = raw r||s, exactly 64 bytes, over the RECEIVED signing input
+ *
+ * # What a VERIFIED result proves, and what it cannot
+ *
+ * It proves that the identity provider which the candidate's OWN homeserver
+ * names as its issuer signed "this DID belongs to this MXID". That removes the
+ * need to trust the homeserver's profile write ACL, and it makes a copied proof
+ * worthless (the `mxid` claim binds it to one account).
+ *
+ * It CANNOT protect against a malicious remote operator: whoever runs a
+ * homeserver also chooses the issuer it advertises, so an operator who controls
+ * both can mint a valid proof for any DID. A signature moves the trust from
+ * "that server's profile ACL" to "that server's issuer", which is the same
+ * organisation. Only a proof by the DID's own key would close that, and this
+ * wire format does not carry one.
+ *
+ * # Three outcomes
+ *
+ * - `verified`: every check passed.
+ * - `unchecked`: the keys could not be obtained (discovery or JWKS unreachable,
+ *   CORS refusal, timeout, a malformed document). Nothing was learned, so the
+ *   caller may show the result, marked as unverified.
+ * - `rejected`: the proof is present and FAILS a check: malformed, wrong alg,
+ *   `sub` or `mxid` not the expected values, `iss` not the pinned issuer, a
+ *   `kid` the reachable JWKS does not hold, or a bad signature. The caller hides
+ *   the result.
+ *
+ * Note the asymmetry this implies: an attacker who can make the keys
+ * unreachable gets at most `unchecked`, never `verified`, which is why
+ * `unchecked` must stay visibly distinct from `verified` in the UI.
+ */
+
+export type ProofVerdict =
+    | { kind: "verified" }
+    | { kind: "unchecked"; reason: string }
+    | { kind: "rejected"; reason: string };
+
+/** How long one discovery or JWKS fetch may take. */
+const FETCH_TIMEOUT_MS = 4_000;
+
+/** How long an issuer's discovery document and JWKS are remembered. */
+const KEYS_TTL_MS = 10 * 60_000;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * GET a public JSON document, with no credentials and no referrer.
+ *
+ * Every caller in this module fetches only server names and issuer URLs; the
+ * searched DID is never part of a URL, header or body here. That is what keeps
+ * verification from telling a remote organisation who is being looked for.
+ */
+export async function fetchPublicJson(fetchFn: typeof fetch, url: string, signal?: AbortSignal): Promise<unknown> {
+    const controller = new AbortController();
+    const timer = setTimeout(() => controller.abort(), FETCH_TIMEOUT_MS);
+    const onAbort = (): void => controller.abort();
+    signal?.addEventListener("abort", onAbort);
+    try {
+        const res = await fetchFn(url, {
+            signal: controller.signal,
+            credentials: "omit",
+            referrerPolicy: "no-referrer",
+            headers: { Accept: "application/json" },
+        });
+        if (!res.ok) throw new Error(`HTTP ${res.status}`);
+        return await res.json();
+    } finally {
+        clearTimeout(timer);
+        signal?.removeEventListener("abort", onAbort);
+    }
+}
+
+/**
+ * A small TTL cache of promises. A promise that REJECTS is dropped, so an
+ * unreachable issuer is retried on the next search instead of being remembered
+ * as unreachable for ten minutes.
+ */
+export class PromiseCache<T> {
+    private readonly entries = new Map<string, { expires: number; value: Promise<T> }>();
+
+    public constructor(private readonly ttlMs: number) {}
+
+    public get(key: string, factory: () => Promise<T>, refresh = false): Promise<T> {
+        const hit = this.entries.get(key);
+        if (!refresh && hit && hit.expires > Date.now()) return hit.value;
+        const value = factory();
+        const entry = { expires: Date.now() + this.ttlMs, value };
+        this.entries.set(key, entry);
+        value.catch(() => {
+            if (this.entries.get(key) === entry) this.entries.delete(key);
+        });
+        return value;
+    }
+
+    public clear(): void {
+        this.entries.clear();
+    }
+}
+
+/** Issuer URLs compare with trailing slashes removed, as the Rust verifier does. */
+export function normaliseIssuer(issuer: string): string {
+    return issuer.replace(/\/+$/, "");
+}
+
+interface IssuerKeys {
+    keys: Record<string, unknown>[];
+}
+
+const keysCache = new PromiseCache<IssuerKeys>(KEYS_TTL_MS);
+
+/** Test hook: forget every cached discovery document and JWKS. */
+export function clearIssuerKeysCache(): void {
+    keysCache.clear();
+}
+
+/**
+ * The published verification keys of `issuer`, which the caller has already
+ * PINNED (it came from the candidate homeserver's auth metadata, never from the
+ * token). Rejects on anything that prevents learning the keys.
+ *
+ * - discovery is `{issuer}/.well-known/openid-configuration`, and its `issuer`
+ *   must equal the pinned one (OpenID Connect Discovery 1.0 section 4.3);
+ * - `jwks_uri` must share the issuer's origin, so the one field a document can
+ *   still choose cannot send key resolution to a host nobody vouched for;
+ * - siwx-oidc's JWKS lists the live key AND every retired key (`oidc::jwks`),
+ *   so proofs minted before a key rotation keep verifying by their `kid`.
+ */
+function issuerKeys(issuer: string, fetchFn: typeof fetch, refresh: boolean): Promise<IssuerKeys> {
+    return keysCache.get(
+        normaliseIssuer(issuer),
+        async () => {
+            const base = normaliseIssuer(issuer);
+            const discovery = await fetchPublicJson(fetchFn, `${base}/.well-known/openid-configuration`);
+            if (!isRecord(discovery) || typeof discovery.issuer !== "string") {
+                throw new Error("discovery document has no issuer");
+            }
+            if (normaliseIssuer(discovery.issuer) !== base) {
+                throw new Error("discovery document names a different issuer");
+            }
+            if (typeof discovery.jwks_uri !== "string") throw new Error("discovery document has no jwks_uri");
+            const jwksUri = new URL(discovery.jwks_uri);
+            if (jwksUri.origin !== new URL(base).origin) throw new Error("jwks_uri is not on the issuer's origin");
+            const jwks = await fetchPublicJson(fetchFn, jwksUri.toString());
+            if (!isRecord(jwks) || !Array.isArray(jwks.keys)) throw new Error("JWKS has no keys array");
+            return { keys: jwks.keys.filter(isRecord) };
+        },
+        refresh,
+    );
+}
+
+function b64urlToBytes(value: string): Uint8Array<ArrayBuffer> {
+    if (!/^[A-Za-z0-9_-]*$/.test(value)) throw new Error("not unpadded base64url");
+    const b64 = value.replace(/-/g, "+").replace(/_/g, "/") + "===".slice((value.length + 3) % 4);
+    const binary = atob(b64);
+    const out = new Uint8Array(binary.length);
+    for (let i = 0; i < binary.length; i++) out[i] = binary.charCodeAt(i);
+    return out;
+}
+
+function decodeJsonPart(part: string): Record<string, unknown> {
+    const parsed: unknown = JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(b64urlToBytes(part)));
+    if (!isRecord(parsed)) throw new Error("not a JSON object");
+    return parsed;
+}
+
+/** Whether a JWK may verify an ES256 signature under its own RFC 7517 restrictions. */
+function usableForEs256(jwk: Record<string, unknown>): boolean {
+    if (jwk.kty !== "EC" || jwk.crv !== "P-256") return false;
+    if (typeof jwk.x !== "string" || typeof jwk.y !== "string") return false;
+    if (jwk.use !== undefined && jwk.use !== "sig") return false;
+    if (jwk.alg !== undefined && jwk.alg !== "ES256") return false;
+    if (jwk.key_ops !== undefined && !(Array.isArray(jwk.key_ops) && jwk.key_ops.includes("verify"))) return false;
+    return true;
+}
+
+export interface VerifyDidProofParams {
+    /** The compact JWS from the profile object's `proof` member. */
+    jws: string;
+    /** The DID that was SEARCHED for, already canonical (see `canonicaliseDid`). */
+    expectedDid: string;
+    /** The MXID of the profile the proof was read from. Mandatory: it is the replay guard. */
+    expectedMxid: string;
+    /**
+     * Resolves to the issuer the candidate's OWN homeserver advertises, or
+     * rejects when that cannot be learned. Called only after the checks that
+     * need no network have passed.
+     */
+    pinnedIssuer: () => Promise<string>;
+    /** Canonicalisation applied to `sub` before comparing (method-aware, see `canonicaliseDid`). */
+    canonicalise: (did: string) => string;
+    fetchFn: typeof fetch;
+}
+
+/**
+ * Verify an `io.inblock.did` proof. Never throws.
+ *
+ * Order, cheapest and network-free first:
+ *
+ * 1. three parts, a JSON header with `alg` ES256, no `crit`, a string `kid`
+ *    (algorithm confusion and `none` die here, before any key is fetched);
+ * 2. `sub` equals the searched DID and `mxid` equals the candidate MXID. A
+ *    genuine proof copied into another profile fails here: that is the replay
+ *    attack the `mxid` claim exists to stop;
+ * 3. the issuer is PINNED from the candidate's homeserver, and `iss` must equal
+ *    it. Keys are never looked up from the token's own `iss`;
+ * 4. the JWKS comes from that issuer's discovery `jwks_uri` and the key is
+ *    selected by `kid` with no fallback. An unknown `kid` forces one JWKS
+ *    refresh (a key may have rotated since it was cached) before rejecting;
+ * 5. the signature is exactly 64 raw bytes and is verified over the RECEIVED
+ *    signing input, never a re-serialisation of the decoded JSON.
+ */
+export async function verifyDidProof(params: VerifyDidProofParams): Promise<ProofVerdict> {
+    const reject = (reason: string): ProofVerdict => ({ kind: "rejected", reason });
+    const unchecked = (reason: string): ProofVerdict => ({ kind: "unchecked", reason });
+
+    const parts = params.jws.split(".");
+    if (parts.length !== 3) return reject("not a compact JWS");
+    const [headerB64, payloadB64, signatureB64] = parts;
+
+    let header: Record<string, unknown>;
+    let claims: Record<string, unknown>;
+    let signature: Uint8Array<ArrayBuffer>;
+    try {
+        header = decodeJsonPart(headerB64);
+        claims = decodeJsonPart(payloadB64);
+        signature = b64urlToBytes(signatureB64);
+    } catch {
+        return reject("malformed JWS encoding");
+    }
+
+    if (header.alg !== "ES256") return reject("alg is not ES256");
+    if (header.crit !== undefined) return reject("crit header present");
+    if (typeof header.kid !== "string" || !header.kid) return reject("no kid");
+    const kid = header.kid;
+
+    if (typeof claims.sub !== "string" || params.canonicalise(claims.sub) !== params.expectedDid) {
+        return reject("sub is not the searched DID");
+    }
+    // Byte-exact, deliberately not case-folded: a profile at `@Alice:server`
+    // must not satisfy a proof bound to `@alice:server`.
+    if (claims.mxid !== params.expectedMxid) return reject("mxid is not the candidate (replayed proof)");
+    if (typeof claims.iss !== "string") return reject("no iss");
+    if (signature.length !== 64) return reject("signature is not 64 raw bytes");
+
+    let issuer: string;
+    try {
+        issuer = await params.pinnedIssuer();
+    } catch {
+        return unchecked("the candidate homeserver's issuer could not be learned");
+    }
+    if (normaliseIssuer(claims.iss) !== normaliseIssuer(issuer)) {
+        return reject("iss is not the issuer the candidate's homeserver advertises");
+    }
+
+    let jwk: Record<string, unknown> | undefined;
+    try {
+        jwk = (await issuerKeys(issuer, params.fetchFn, false)).keys.find((k) => k.kid === kid);
+        if (!jwk) jwk = (await issuerKeys(issuer, params.fetchFn, true)).keys.find((k) => k.kid === kid);
+    } catch {
+        return unchecked("the issuer's discovery document or JWKS is unreachable");
+    }
+    if (!jwk) return reject("kid is not in the issuer's JWKS");
+    if (!usableForEs256(jwk)) return reject("the kid's JWK cannot verify ES256");
+
+    try {
+        const key = await crypto.subtle.importKey(
+            "jwk",
+            { kty: "EC", crv: "P-256", x: jwk.x as string, y: jwk.y as string, ext: true },
+            { name: "ECDSA", namedCurve: "P-256" },
+            false,
+            ["verify"],
+        );
+        const ok = await crypto.subtle.verify(
+            { name: "ECDSA", hash: "SHA-256" },
+            key,
+            signature,
+            new TextEncoder().encode(`${headerB64}.${payloadB64}`),
+        );
+        return ok ? { kind: "verified" } : reject("bad signature");
+    } catch {
+        return reject("the kid's JWK is not a valid P-256 key");
+    }
+}
