+    const oldestKey = `${userId}|oldestIndexedTs`;
+    const oldestBlob = await encryptJson(dek, { ts: rawEvents[0].origin_server_ts }, oldestKey);
+    const cpId = "someopaquehmacid=";
+    const cpBlob = await encryptJson(
+        dek,
