+        room_id: RELOAD_ROOMS[i % RELOAD_ROOMS.length],
+        // Descending timestamps, so a reload that kept row order rather than sorting is visible.
+        origin_server_ts: SCALE_BASE_TS + (RELOAD_EVENT_COUNT - i),
