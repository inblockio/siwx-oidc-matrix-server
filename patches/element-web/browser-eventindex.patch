+async function withRawDb<T>(fn: (db: IDBDatabase) => Promise<T>, version?: number): Promise<T> {
+    const db = await idbPromise(indexedDB.open(EVENTINDEX_DB_NAME, version));
+    try {
+        return await fn(db);
+    } finally {
+        db.close();
+    }
