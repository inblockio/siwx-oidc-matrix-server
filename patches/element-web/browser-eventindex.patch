+        // chunk, in which the old chunkIdx-based cursor could never shift (review-pr-e.md's own
+        // "why the suite cannot see either" section; this is what killed mutants M5/M26).
+        setChunkTargetBytesOverrideForTesting(400);
+        const N = 10;
