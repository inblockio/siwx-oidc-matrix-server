+    ...Array.from({ length: 6 }, (_unused, j) => tied(`$tie${j}`, TIE_TS)),
+    tied("$tienewer0", TIE_TS + 1),
+    ...Array.from({ length: 6 }, (_unused, j) => tied(`$tie${j + 6}`, TIE_TS)),
+    tied("$tienewer1", TIE_TS + 1),
