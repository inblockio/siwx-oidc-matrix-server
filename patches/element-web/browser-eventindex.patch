+            `EventIndex: manifest loaded in ${(now() - started).toFixed(1)}ms, ${this.manifest.size} entries, ${pageCount} pages`,
+        );
+    }
+
+    /**
+     * Exact `Math.min` of every {@link manifest} entry's `originServerTs`, or `undefined` if the
