+/**
+ * Whether the "Copy Markdown" action applies to this event: a message that is not redacted, decrypted, of a text
+ * type, and that displays something (`displaysSomething`). It does not convert the message: it runs on every
+ * context menu render, and the conversion runs only when the action is clicked. Never throws.
+ */
+export function canCopyMarkdown(event: MatrixEvent): boolean {
+    try {
+        if (event.getType() !== EventType.RoomMessage || event.isState()) return false;
+        if (event.isRedacted() || event.isDecryptionFailure()) return false;
+        if (!COPYABLE_MSGTYPES.includes(event.getContent().msgtype ?? "")) return false;
+        return displaysSomething(event);
+    } catch (e) {
+        logger.error("Copy Markdown: cannot tell whether a message is copyable", e);
+        return false;
+    }
+}
