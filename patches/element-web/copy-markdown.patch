+describe("r9 property: Element-composed Markdown is copied as typed, a changed rendering never is", () => {
+    const SEED = 20261004;
+    const COUNT = 500;
+
+    /** mulberry32 again: the one of the AC3 property test is private to its block. */
+    function prng(seed: number): () => number {
+        let a = seed >>> 0;
+        return () => {
+            a = (a + 0x6d2b79f5) >>> 0;
+            let t = a;
+            t = Math.imul(t ^ (t >>> 15), t | 1);
+            t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+        };
+    }
+
+    /**
+     * Random Markdown of the kind people type: paragraphs with soft and hard breaks, emphasis, code, links, images,
+     * strikethrough, escapes, entities, headings, nested lists, quotes, fenced blocks, rules, tables and task items.
+     * It keeps clear of the documented residuals: no two-paragraph item inside a message that is one list, no emphasis
+     * inside a bare URL, no escaped pipe in a table cell, no single tilde.
+     */
+    function generator(seed: number): () => string {
+        const rnd = prng(seed);
+        const int = (n: number): number => Math.floor(rnd() * n);
+        const pick = <T>(items: readonly T[]): T => items[int(items.length)];
+        const WORDS = [
+            "alpha",
+            "beta",
+            "gamma",
+            "delta",
+            "x1",
+            "snake_case",
+            "caf\u00e9",
+            "\u4e2d\u6587",
+            "42",
+            "a.b",
+            "50%",
+        ];
+        const atom = (): string => {
+            const r = rnd();
+            if (r < 0.42) return pick(WORDS);
+            if (r < 0.49) return `**${pick(WORDS)}**`;
+            if (r < 0.56) return `*${pick(WORDS)}*`;
+            if (r < 0.63) return "`" + pick(WORDS) + "`";
+            if (r < 0.71) return `[${pick(WORDS)}](https://example.org/${pick(WORDS).replace(/\W/g, "")})`;
+            if (r < 0.75) return `<https://example.org/${int(100)}>`;
+            if (r < 0.79) return `~~${pick(WORDS)}~~`;
+            if (r < 0.83) return `![${pick(WORDS)}](mxc://example.org/${int(1000)})`;
+            if (r < 0.88) return pick(["\\*", "\\_", "\\[", "&amp;", "&copy;"]);
+            if (r < 0.94) return `**${pick(WORDS)} *${pick(WORDS)}***`;
+            return pick(["3 * 4", "a_b_c", "x < y"]);
+        };
+        const line = (): string => Array.from({ length: 1 + int(5) }, atom).join(" ");
+        const paragraph = (): string => {
+            const rows = Array.from({ length: 1 + int(3) }, line);
+            return rows.map((row, i) => (i < rows.length - 1 && rnd() < 0.2 ? row + "  " : row)).join("\n");
+        };
+        const block = (): string => {
+            const r = rnd();
+            if (r < 0.3) return paragraph();
+            if (r < 0.38) return "#".repeat(1 + int(6)) + " " + line();
+            if (r < 0.52) {
+                const items = Array.from({ length: 2 + int(2) }, () => {
+                    const nested = rnd() < 0.3 ? `\n  - ${line()}` : "";
+                    return `- ${line()}${nested}`;
+                });
+                return items.join(rnd() < 0.2 ? "\n\n" : "\n");
+            }
+            if (r < 0.6) {
+                const start = 1 + int(8);
+                return Array.from({ length: 2 + int(2) }, (_, i) => `${start + i}. ${line()}`).join("\n");
+            }
+            if (r < 0.66)
+                return Array.from({ length: 1 + int(2) }, () => "> " + line()).join(rnd() < 0.3 ? "\n>\n" : "\n");
+            if (r < 0.73) {
+                const code = Array.from({ length: 1 + int(3) }, () =>
+                    pick(["let x = 1;", "<b>x</b> & y", "a | b", "*not* emphasis", "  indented"]),
+                );
+                return "```" + pick(["", "js", "rust"]) + "\n" + code.join("\n") + "\n```";
+            }
+            if (r < 0.77) return pick(["---", "***"]);
+            if (r < 0.88) {
+                const cols = 2 + int(2);
+                const row = (): string => "| " + Array.from({ length: cols }, atom).join(" | ") + " |";
+                const delim =
+                    "|" + Array.from({ length: cols }, () => pick(["---", ":--", "--:", ":-:"])).join("|") + "|";
+                return [row(), delim, ...Array.from({ length: 1 + int(3) }, row)].join("\n");
+            }
+            if (r < 0.95)
+                return Array.from({ length: 2 + int(2) }, () => `- [${pick([" ", "x"])}] ${line()}`).join("\n");
+            return `${line()}\n${pick(["===", "---"])}`;
+        };
+        return () => Array.from({ length: 1 + int(4) }, block).join("\n\n");
+    }
+
+    const FORMAT = "org.matrix.custom.html";
+
+    /** A text letter of the HTML (outside tags and entities) turned into another one. */
+    function mutateText(htmlText: string, rnd: () => number): string | undefined {
+        const spots: number[] = [];
+        let inTag = false;
+        let inEntity = false;
+        for (let i = 0; i < htmlText.length; i++) {
+            const c = htmlText[i];
+            if (inTag) inTag = c !== ">";
+            else if (c === "<") inTag = true;
+            else if (inEntity) inEntity = c !== ";";
+            else if (c === "&") inEntity = true;
+            else if (/[a-z]/.test(c)) spots.push(i);
+        }
+        if (!spots.length) return undefined;
+        const at = spots[Math.floor(rnd() * spots.length)];
+        return htmlText.slice(0, at) + (htmlText[at] === "q" ? "z" : "q") + htmlText.slice(at + 1);
+    }
+
+    it("the generator is deterministic and covers the constructs", () => {
+        const a = generator(SEED);
+        const b = generator(SEED);
+        const messages = Array.from({ length: COUNT }, a);
+        expect(Array.from({ length: COUNT }, b)).toEqual(messages);
+        const all = messages.join("\n");
+        for (const part of [
+            "**",
+            "`",
+            "](https://",
+            "![",
+            "~~",
+            "\n- ",
+            "\n  - ",
+            "\n1. ",
+            "\n> ",
+            "```",
+            "\n|---|",
+            "- [x] ",
+            "\n---",
+            "  \n",
+            "\n===",
+        ]) {
+            expect(all).toContain(part);
+        }
+    });
+
+    it(`${COUNT} random messages as Element sends them: the source is copied, byte for byte`, () => {
+        const gen = generator(SEED);
+        const failures: string[] = [];
+        for (let i = 0; i < COUNT; i++) {
+            const md = gen();
+            if (!isSafeMarkdown(md) || !gfmCellsSafe(md)) continue;
+            for (const forceHTML of [true, false]) {
+                const formatted = htmlSerializeFromMdIfNeeded(md, { forceHTML });
+                // Residual: plain text with a backslash escape is sent as an HTML message with no tag, and its line
+                // breaks are newlines in that text, which are a space to HTML (the spec lists it)
+                if (formatted !== undefined && !formatted.includes("<") && md.trimEnd().includes("\n")) continue;
+                const content: IContent = { msgtype: "m.text", body: md };
+                if (formatted !== undefined) Object.assign(content, { format: FORMAT, formatted_body: formatted });
+                const got = copyMarkdownWithPath(content, false);
+                if (got.path !== "source" || got.md !== md.trimEnd())
+                    failures.push(
+                        `#${i} forceHTML=${forceHTML} ${got.path}: ${JSON.stringify(md)} -> ${JSON.stringify(formatted)}`,
+                    );
+            }
+        }
+        expect(failures.slice(0, 5)).toEqual([]);
+    }, 60_000);
+
+    it(`${COUNT} random messages with a changed rendering: never copied as the source`, () => {
+        const gen = generator(SEED + 1);
+        const rnd = prng(SEED + 2);
+        const failures: string[] = [];
+        let mutations = 0;
+        for (let i = 0; i < COUNT; i++) {
+            const md = gen();
+            const formatted = htmlSerializeFromMdIfNeeded(md, { forceHTML: true })!;
+            const variants: Array<[string, string | undefined]> = [
+                ["a letter of the text changed", mutateText(formatted, rnd)],
+                [
+                    "a link destination changed",
+                    formatted.includes('href="https://example.org/')
+                        ? formatted.replace('href="https://example.org/', 'href="https://evil.example/')
+                        : undefined,
+                ],
+                [
+                    "an image source changed",
+                    formatted.includes('src="mxc://example.org/')
+                        ? formatted.replace('src="mxc://example.org/', 'src="mxc://evil.example/')
+                        : undefined,
+                ],
+                ["a paragraph added", formatted + "<p>extra</p>"],
+                ["a script added", formatted + "<script>x</script>"],
+                ["a link added", formatted + ' <a href="https://evil.example/">x</a>'],
+                [
+                    "a block removed",
+                    formatted.includes("</p>") ? formatted.slice(formatted.indexOf("</p>") + 4) : undefined,
+                ],
+            ];
+            for (const [what, changed] of variants) {
+                // The empty formatted_body is no HTML at all: the message is plain (spec step 3), so it is skipped
+                if (changed === undefined || changed === formatted || changed === "") continue;
+                mutations++;
+                const got = copyMarkdownWithPath(
+                    { msgtype: "m.text", body: md, format: FORMAT, formatted_body: changed },
+                    false,
+                );
+                if (got.path === "source" || got.path === "source+mentions")
+                    failures.push(`#${i} ${what}: ${JSON.stringify(md)} -> ${JSON.stringify(changed)}`);
+            }
+        }
+        expect(mutations).toBeGreaterThan(COUNT * 3);
+        expect(failures.slice(0, 5)).toEqual([]);
+    }, 60_000);
+});
