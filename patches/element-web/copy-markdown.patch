+        expect(gfmCellsSafe("| a |\n| - |\n    z\n[p]: https://img.example.invalid/p.png\n\n![t][p]")).toBe(false);
+        // the delimiter line of a one-column table needs no pipe
+        expect(gfmCellsSafe("| a |\n:-:\n    z\n[r]: javascript:alert(1)\n\n[x][r]")).toBe(false);
+        expect(gfmCellsSafe("| a |\n---\n[r]: x")).toBe(false);
+        // inside a quote or a list
+        expect(gfmCellsSafe("> | a |\n> | - |\n> [r]: x")).toBe(false);
