+        lines("| a\\|b | c |", "| --- | --- |", "| **1** | 2 3 |"),
+    ],
+    [
+        "table without thead, with caption and a short row",
+        "<table><caption>Cap</caption><tr><td>h1</td><td>h2</td></tr><tr><td>x</td></tr></table>",
