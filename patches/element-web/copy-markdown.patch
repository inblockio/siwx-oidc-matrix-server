+export function trimWs(s: string): string {
+    let start = 0;
+    let end = s.length;
+    while (start < end && isWs(s[start])) start++;
+    while (end > start && isWs(s[end - 1])) end--;
+    return s.slice(start, end);
+}
+
+/** Trimmed of ASCII whitespace at the end only. */
+export function trimEndWs(s: string): string {
+    let end = s.length;
+    while (end > 0 && isWs(s[end - 1])) end--;
+    return s.slice(0, end);
+}
