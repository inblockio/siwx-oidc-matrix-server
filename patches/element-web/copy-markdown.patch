+/** The ASCII whitespace set of the rule: space, tab, LF, CR, FF. No-break space, U+FEFF and VT are not in it. */
+const isWs = (c: string): boolean => c === " " || c === "\t" || c === "\r" || c === "\n" || c === "\f";
+const isAsciiDigit = (c: string | undefined): boolean => c !== undefined && c >= "0" && c <= "9";
