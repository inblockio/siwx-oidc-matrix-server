+/*
+ * Inline output is assembled as a string that carries private-use marker characters. `resolveInline` turns the
+ * markers into Markdown once the whole run is known, because whether `**` may stay depends on the characters next
+ * to it, which only exist after the neighbours have been rendered. Markers in the source text are removed.
+ */
+/** A hard break; resolved per block. */
+const BR = "\uE000";
+/** Emphasis kinds, indexes into the marker strings below. */
+const EM = 0;
+const STRONG = 1;
+const DEL = 2;
+const MARKS = ["*", "**", "~~"];
+const OPEN = "\uE001\uE002\uE003";
+const CLOSE = "\uE004\uE005\uE006";
+/** Brackets an unbreakable piece of output (code span, link, image, maths, autolink). */
+const ATOM_START = "\uE007";
+const ATOM_END = "\uE008";
+const MARKERS = /[\uE000-\uE008]/g;
+
+const clean = (s: string): string => s.replace(MARKERS, "");
+const atom = (s: string): string => ATOM_START + s + ATOM_END;
