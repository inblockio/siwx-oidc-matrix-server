+// The real parser behind a spy, so that a test can tell the conversion (which parses its output to check it) from
+// a cheap check that never parses Markdown. And Element's own send path behind a spy: it makes the fixtures of the
+// tests below, and a test shows that the rule itself never calls it (it reads the raw content only). `spy: true`
+// keeps the real implementations; unlike a factory it also works in vitest browser mode (see
+// vitest.browser.copy-md.config.ts, which runs the conformance vectors in Chromium).
+vi.mock("commonmark", async (importOriginal) => {
+    const real = await importOriginal<typeof import("commonmark")>();
+    return {
+        ...real,
+        Parser: vi.fn(function (...args: ConstructorParameters<typeof real.Parser>) {
