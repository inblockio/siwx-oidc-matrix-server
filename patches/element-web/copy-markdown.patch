+interface Vector {
+    id: string;
+    note: string;
+    content: IContent;
+    strip_reply_fallback: boolean;
+    expected: string;
+    path: CopyPath;
+}
+const VECTORS = vectorFile as unknown as {
+    version: number;
+    generated_with: Record<string, string>;
+    vectors: Vector[];
+};
