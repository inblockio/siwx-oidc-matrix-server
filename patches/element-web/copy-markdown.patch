+}
+
+function link(el: Element, text: string): string {
+    const href = clean(el.getAttribute("href") ?? "");
+    if (!href || !isPermittedHref(href)) return text;
+    if (
+        el.textContent === href &&
+        /^(https?|mailto|ftp):/i.test(href) &&
+        !/[\s<>]/.test(href) &&
+        CM_AUTOLINK_URI.test(href)
+    )
+        return atom(`<${autolinkUrl(href)}>`);
+    return atom(`[${resolveInline(text)}](${encodeUrl(href)})`);
+}
+
+/**
+ * CommonMark's absolute URI: a 2 to 32 character scheme, a colon, then no ASCII control character, space, `<` or `>`.
+ * Anything else is not an autolink and its backticks would go live, so it is written as a link instead.
+ */
+// oxlint-disable-next-line no-control-regex
+const CM_AUTOLINK_URI = /^[A-Za-z][A-Za-z0-9+.-]{1,31}:[^\x00-\x20\x7f<>]*$/;
+
+/**
+ * Percent-encodes what would end a link destination (ASCII control characters, whitespace, parentheses, angle
+ * brackets) and `|`, which in a GFM table row ends a cell before any link syntax is read. Renderers decode a
+ * destination's backslash escapes and entities, which can turn a harmless relative href into `javascript:`, so a
+ * backslash and an `&` that starts an entity are encoded too: one followed by `#` (a browser decodes a numeric
+ * reference in an attribute without its semicolon, and marked writes the destination into the attribute as it
+ * got it) or by a name and a semicolon.
+ */
+function encodeUrl(url: string): string {
+    return url.replace(
+        // oxlint-disable-next-line no-control-regex
+        /[\x00-\x20\x7f\s()<>\\|]|&(?=#|[A-Za-z0-9]+;)/g,
+        (c) => (c === "(" ? "%28" : c === ")" ? "%29" : encodeURIComponent(c)),
+    );
+}
+
+/** An autolink has no destination syntax to protect, so only the `|` that would end a table cell is encoded. */
+function autolinkUrl(url: string): string {
+    return url.replaceAll("|", "%7C");
+}
+
+interface Tok {
+    kind: "text" | "atom" | "br" | "open" | "close";
+    /** The output text; empty for delimiters, whose text is `MARKS[mark]`. */
+    s: string;
+    mark: number;
+}
+
+/** Splits marked-up inline output into tokens. A text token is one code point or one backslash escape. */
+function tokenize(s: string): Tok[] {
+    const toks: Tok[] = [];
+    for (let i = 0; i < s.length;) {
+        const c = s[i];
+        const open = OPEN.indexOf(c);
+        const close = CLOSE.indexOf(c);
+        if (c === BR) {
+            toks.push({ kind: "br", s: BR, mark: -1 });
+            i++;
+        } else if (open >= 0 || close >= 0) {
+            toks.push({ kind: open >= 0 ? "open" : "close", s: "", mark: open >= 0 ? open : close });
+            i++;
+        } else if (c === ATOM_START) {
+            const end = s.indexOf(ATOM_END, i);
+            const stop = end < 0 ? s.length : end;
+            toks.push({ kind: "atom", s: s.slice(i + 1, stop), mark: -1 });
+            i = stop + 1;
+        } else {
+            const len =
+                c === "\\" && /[!-/:-@[-`{-~]/.test(s[i + 1] ?? "")
+                    ? 2
+                    : String.fromCodePoint(s.codePointAt(i)!).length;
+            toks.push({ kind: "text", s: s.slice(i, i + len), mark: -1 });
+            i += len;
+        }
+    }
+    return toks;
+}
+
+const isDelim = (t: Tok): boolean => t.kind === "open" || t.kind === "close";
+const isWhitespace = (c: string): boolean => /^\s/.test(c);
+const isPunctuation = (c: string): boolean => /^[\p{P}\p{S}]/u.test(c);
+
+/** The first character of what a token writes, as a renderer sees it next to a delimiter run. */
+function firstChar(t: Tok): string {
+    if (t.kind === "br") return "\n";
+    return String.fromCodePoint((isDelim(t) ? MARKS[t.mark] : t.s).codePointAt(0)!);
+}
+
+function lastChar(t: Tok): string {
+    if (t.kind === "br") return "\n";
+    return Array.from(isDelim(t) ? MARKS[t.mark] : t.s).pop()!;
+}
+
+type CharClass = "ws" | "punct" | "word";
+
+/**
+ * CommonMark's character classes. commonmark.js (and markdown-it) read an astral character as lone UTF-16
+ * units, which are neither whitespace nor punctuation, while the spec calls an astral symbol punctuation. Emphasis
+ * must work under both readings, so callers check `lenient` true and false.
+ */
+function classOf(c: string, lenient: boolean): CharClass {
+    if (isWhitespace(c)) return "ws";
+    if (lenient && c.length > 1) return "word";
+    return isPunctuation(c) ? "punct" : "word";
+}
+
+/** CommonMark 0.31 left- and right-flanking for the characters before and after a delimiter run. */
+function flanking(before: string, after: string, lenient: boolean): { left: boolean; right: boolean } {
+    const b = classOf(before, lenient);
+    const a = classOf(after, lenient);
+    return {
+        left: a !== "ws" && (a !== "punct" || b !== "word"),
+        right: b !== "ws" && (b !== "punct" || a !== "word"),
+    };
+}
+
+/** Removes the tokens at the given indexes. */
+function removeAt(toks: Tok[], indexes: number[]): void {
+    for (const i of indexes.sort((a, b) => b - a)) toks.splice(i, 1);
+}
+
+/** A maximal run of delimiter tokens of one character, which is what a CommonMark parser sees as one run. */
+interface Run {
+    ch: string;
+    /** Token range [lo, hi). */
+    lo: number;
+    hi: number;
+    chars: number;
+    before: string;
+    after: string;
+}
+
+function findRuns(toks: Tok[]): Run[] {
+    const runs: Run[] = [];
+    for (let i = 0; i < toks.length;) {
+        if (!isDelim(toks[i])) {
+            i++;
+            continue;
+        }
+        const ch = MARKS[toks[i].mark][0];
+        let j = i;
+        let chars = 0;
+        while (j < toks.length && isDelim(toks[j]) && MARKS[toks[j].mark][0] === ch)
+            chars += MARKS[toks[j++].mark].length;
+        runs.push({
+            ch,
+            lo: i,
+            hi: j,
+            chars,
+            before: i === 0 ? " " : lastChar(toks[i - 1]),
+            after: j === toks.length ? " " : firstChar(toks[j]),
+        });
+        i = j;
+    }
+    return runs;
+}
+
+interface Delimiter {
+    run: number;
+    ch: string;
+    orig: number;
+    left: number;
+    canOpen: boolean;
+    canClose: boolean;
+}
+
+/**
+ * Runs the CommonMark emphasis algorithm (spec 0.31, "process emphasis", as commonmark.js has it, including the
+ * rule of three) on the runs and returns how many characters each opening run gave each closing run, keyed
+ * "opener:closer".
+ */
+function matchRuns(runs: Run[], lenient: boolean): Map<string, number> {
+    const matches = new Map<string, number>();
+    const stack: Delimiter[] = runs.map((r, run) => {
+        const { left, right } = flanking(r.before, r.after, lenient);
+        return { run, ch: r.ch, orig: r.chars, left: r.chars, canOpen: left, canClose: right };
+    });
+    const bottoms = new Map<string, Delimiter | undefined>();
+    let c = 0;
+    while (c < stack.length) {
+        const closer = stack[c];
+        if (!closer.canClose) {
+            c++;
+            continue;
+        }
+        const bottomKey = `${closer.ch}${closer.canOpen}${closer.orig % 3}`;
+        let o = c - 1;
+        let found = false;
+        for (; o >= 0 && stack[o] !== bottoms.get(bottomKey); o--) {
+            const opener = stack[o];
+            const odd =
+                (closer.canOpen || opener.canClose) && closer.orig % 3 !== 0 && (opener.orig + closer.orig) % 3 === 0;
+            if (opener.ch === closer.ch && opener.canOpen && !odd) {
+                found = true;
+                break;
+            }
+        }
+        if (found) {
+            const opener = stack[o];
+            const use = closer.left >= 2 && opener.left >= 2 ? 2 : 1;
+            opener.left -= use;
+            closer.left -= use;
+            const key = `${opener.run}:${closer.run}`;
+            matches.set(key, (matches.get(key) ?? 0) + use);
+            stack.splice(o + 1, c - o - 1); // delimiters between them can no longer match
+            c = o + 1;
+            if (opener.left === 0) {
+                stack.splice(o, 1);
+                c--;
+            }
+            if (closer.left === 0) stack.splice(c, 1);
+        } else {
+            bottoms.set(bottomKey, stack[c - 1]);
+            if (closer.canOpen) c++;
+            else stack.splice(c, 1);
+        }
+    }
+    return matches;
+}
+
+/** A change to the tokens that touches only the indexes from `start` to `end`. */
+type Edit = { start: number; end: number } & ({ drop: number[] } | { from: number; to: number });
+
+function edit(change: { drop: number[] } | { from: number; to: number }): Edit {
+    const indexes = "drop" in change ? change.drop : [change.from, change.to];
+    return { ...change, start: Math.min(...indexes), end: Math.max(...indexes) };
+}
+
+/** Applies the edits, which must not overlap and must be sorted by position, from the last to the first. */
+function applyEdits(toks: Tok[], edits: Edit[]): void {
+    for (const e of edits.reverse()) {
+        if ("drop" in e) removeAt(toks, e.drop);
+        else toks.splice(e.to, 0, ...toks.splice(e.from, 1));
+    }
+}
+
+/**
+ * Makes the changes that move the tokens closer to valid Markdown and returns true, or returns false when they
+ * are valid. Every change shrinks the tokens or moves a text token out of an emphasis run, so repeating ends.
+ */
+function normaliseStep(toks: Tok[]): boolean {
+    // Pair every delimiter with its partner. They come from nested `wrap` calls, so they always nest.
+    const partner: number[] = new Array<number>(toks.length).fill(-1);
+    const stack: number[] = [];
+    for (let i = 0; i < toks.length; i++) {
+        if (toks[i].kind === "open") stack.push(i);
+        else if (toks[i].kind === "close") {
+            const j = stack.pop();
+            if (j === undefined || toks[j].mark !== toks[i].mark) {
+                removeAt(toks, [i]);
+                return true;
+            }
+            partner[i] = j;
+            partner[j] = i;
+        }
+    }
+    if (stack.length) {
+        removeAt(toks, stack);
+        return true;
+    }
+
+    const doomed = new Set<number>();
+    const doom = (...indexes: number[]): void => {
+        if (indexes.some((i) => doomed.has(i))) return; // overlaps a change made in this pass; the next one gets it
+        indexes.forEach((i) => doomed.add(i));
+    };
+    const active = [0, 0, 0];
+    for (let i = 0; i < toks.length; i++) {
+        const t = toks[i];
+        const next = toks[i + 1];
+        if (t.kind === "open" && next?.kind === "close")
+            doom(i, i + 1); // nothing inside
+        else if (t.kind === "close" && next?.kind === "open" && t.mark === next.mark)
+            doom(i, i + 1); // one run
+        else if (t.kind === "open" && active[t.mark] > 0) doom(i, partner[i]); // already inside this kind
+        if (t.kind === "open") active[t.mark]++;
+        else if (t.kind === "close") active[t.mark]--;
+    }
+    if (doomed.size) {
+        removeAt(toks, [...doomed]);
+        return true;
+    }
+
+    // Every run must flank the way its delimiters need, under either reading of astral characters.
+    const runs = findRuns(toks);
+    const edits: Edit[] = [];
+    let end = -1;
+    for (const run of runs) {
+        const modes = [flanking(run.before, run.after, false), flanking(run.before, run.after, true)];
+        const tokens = toks.slice(run.lo, run.hi);
+        const firstOpen = run.lo + tokens.findIndex((t) => t.kind === "open");
+        const lastClose = run.lo + tokens.map((t) => t.kind).lastIndexOf("close");
+        let change: Edit | undefined;
+        if (firstOpen >= run.lo && !modes.every((m) => m.left)) {
+            // Move the offending character from inside the opening run to just before it, else drop the pairs.
+            const inside = toks[run.hi];
+            change =
+                inside?.kind === "text" || inside?.kind === "br"
+                    ? edit({ from: run.hi, to: firstOpen })
+                    : edit({ drop: pairsOf(tokens, run.lo, "open", partner) });
+        } else if (lastClose >= run.lo && !modes.every((m) => m.right)) {
+            const inside = toks[run.lo - 1];
+            change =
+                inside?.kind === "text" || inside?.kind === "br"
+                    ? edit({ from: run.lo - 1, to: lastClose })
+                    : edit({ drop: pairsOf(tokens, run.lo, "close", partner) });
+        }
+        if (change && change.start > end) {
+            edits.push(change);
+            end = change.end;
+        }
+    }
+    if (edits.length) {
+        applyEdits(toks, edits);
+        return true;
+    }
+
+    // A parser must pair the runs the way the HTML nested them: ambiguous runs (flanking both ways, the rule of
+    // three) can pair differently, and then the delimiters of the pairs it got wrong are dropped.
+    const runOf = new Map<number, number>();
+    runs.forEach((r, k) => {
+        for (let t = r.lo; t < r.hi; t++) runOf.set(t, k);
+    });
+    const wanted = new Map<string, number>();
+    const owner = new Map<string, number[]>();
+    toks.forEach((t, i) => {
+        if (t.kind !== "open") return;
+        const key = `${runOf.get(i)}:${runOf.get(partner[i])}`;
+        wanted.set(key, (wanted.get(key) ?? 0) + MARKS[t.mark].length);
+        if (!owner.has(key)) owner.set(key, []);
+        owner.get(key)!.push(i, partner[i]);
+    });
+    const wrong = new Set<number>();
+    for (const lenient of [false, true]) {
+        const got = matchRuns(runs, lenient);
+        for (const [key, chars] of wanted) if (got.get(key) !== chars) owner.get(key)!.forEach((i) => wrong.add(i));
+    }
+    if (wrong.size) {
+        removeAt(toks, [...wrong]);
+        return true;
+    }
+    return false;
+}
+
+/** The indexes of every delimiter of `kind` in a run and of its partner. */
+function pairsOf(run: Tok[], start: number, kind: "open" | "close", partner: number[]): number[] {
+    const out: number[] = [];
+    run.forEach((t, k) => {
+        if (t.kind === kind) out.push(start + k, partner[start + k]);
+    });
+    return out;
+}
+
+/**
+ * Turns the markers of one inline run into Markdown. Emphasis stays only where its delimiters are valid
+ * CommonMark flanking runs: a punctuation character at the edge of the content that stops them being valid moves
+ * outside (`**Note:**x` becomes `**Note**:x`), adjacent runs of one kind merge, and what cannot be made valid
+ * is dropped, keeping its text. The start and end of the run count as whitespace.
+ */
+function resolveInline(s: string): string {
+    const toks = tokenize(s);
+    while (normaliseStep(toks)) {
+        /* each step makes its repairs */
+    }
+    const merged = mergeCodeSpans(toks);
+    return merged
+        .map((t, i) => {
+            if (isDelim(t)) return MARKS[t.mark];
+            // A `!` right before a link would make it an image. Only here is it known what the `!` touches,
+            // because dropping emphasis can put a link next to it.
+            const next = merged[i + 1];
+            return t.kind === "text" && t.s === "!" && next?.kind === "atom" && next.s.startsWith("[") ? "\\!" : t.s;
+        })
+        .join("");
+}
+
+const WORD = /[\p{L}\p{N}]/u;
+
+/**
+ * A run of text that starts with http:// or https:// (not glued to a word) and ends at whitespace, `<` or `>`. The
+ * scheme is matched as ASCII only: with the `i` and `u` flags together, U+017F (long s) would match the `s` of
+ * `https`, and what that "scheme" is not is then no scheme for any later check.
+ */
+const BARE_URL = /(?<![\p{L}\p{N}])[hH][tT][tT][pP][sS]?:\/\/[^\s<>\p{Cc}]+/gu;
+
+/** Trailing punctuation a GFM extended autolink leaves outside, plus an unbalanced closing parenthesis. */
+function trimUrl(url: string): string {
+    for (;;) {
+        const last = url[url.length - 1];
+        const unbalanced = last === ")" && url.split(")").length > url.split("(").length;
+        if (!unbalanced && !"?!.,:*_~'\"".includes(last)) return url;
+        url = url.slice(0, -1);
+    }
+}
+
+/**
+ * Escapes text so it renders as itself. With `autolink`, a bare http(s) URL is written as a `<url>` autolink with
+ * nothing escaped inside: Element shows it as a link (linkify), and backslashes in it would end up in the href.
+ */
+function escapeText(text: string, autolink = false): string {
+    let out = "";
+    let at = 0;
+    if (autolink) {
+        for (const match of text.matchAll(BARE_URL)) {
+            const url = trimUrl(match[0]);
+            if (url.length <= url.indexOf("://") + 3) continue; // nothing after the scheme
+            out += escapeRange(text, at, match.index) + atom(`<${autolinkUrl(url)}>`);
+            at = match.index + url.length;
+        }
+    }
+    return out + escapeRange(text, at, text.length);
+}
+
+/** Escapes `text.slice(from, to)`; `_` looks at the neighbouring characters of the whole text. */
+function escapeRange(text: string, from: number, to: number): string {
+    let out = text.slice(from, to).replace(/[\\`*[\]<~|]/g, "\\$&");
+    out = out.replace(/&(?=#?[a-zA-Z0-9]+;)/g, "\\&");
+    out = out.replace(/_/g, (m: string, i: number, s: string) => {
+        const prev = i === 0 ? text[from - 1] : s[i - 1];
+        const next = i === s.length - 1 ? text[to] : s[i + 1];
+        return WORD.test(prev ?? "") && WORD.test(next ?? "") ? m : "\\_";
+    });
+    return out;
+}
+
+/**
+ * Escapes text at the start of a line that CommonMark would otherwise read as block syntax, and a line that a GFM
+ * renderer would read as the delimiter row of a one-column table (`:-:`, `-:`, `:-`; with a `|` it would need a raw
+ * pipe, and every pipe in text is escaped). Such a row makes the line before it a table header and cuts the
+ * paragraph there, so a backtick before the cut no longer pairs with one after it.
+ */
+function escapeLineStart(line: string): string {
+    const [, indent, rest] = /^( {0,3})([\s\S]*)$/.exec(line)!;
+    if (
+        rest.startsWith(">") ||
+        /^#{1,6}(\s|$)/.test(rest) ||
+        /^[-+*](\s|$)/.test(rest) ||
+        /^(=+|-+)\s*$/.test(rest) ||
+        /^:?-+:?\s*$/.test(rest)
+    ) {
+        return `${indent}\\${rest}`;
+    }
+    const ordered = /^(\d{1,9})([.)])(\s|$)/.exec(rest);
+    if (ordered) return `${indent}${ordered[1]}\\${rest.slice(ordered[1].length)}`;
+    return line;
+}
