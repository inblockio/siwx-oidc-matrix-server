+        '<u>under</u> x<sub>2</sub> e<sup>x</sup> <font color="red">red</font> <span data-mx-color="#ff0000">c</span> <span data-mx-bg-color="#00ff00">bg</span>',
+        "under x2 ex red c bg",
+    ],
+    [
+        "spoiler keeps its text, no /spoiler",
+        'a <span data-mx-spoiler>secret</span> and <span data-mx-spoiler="why">another</span>',
+        "a secret and another",
+    ],
+    ["headings", "<h1>One</h1>\n<h3>Three</h3>", lines("# One", "", "### Three")],
+    ["paragraphs", "<p>a</p>\n<p>b</p>", lines("a", "", "b")],
+    ["br is a backslash hard break", "line1<br>line2<br />line3", lines("line1\\", "line2\\", "line3")],
+    ["trailing br at the end of a block is dropped", "<p>x<br></p>", "x"],
+    ["whitespace collapses outside pre", "<p>a\n   b</p>", "a b"],
+    ["inline code", "use <code>a*b</code> here", "use `a*b` here"],
+    ["inline code containing a backtick", "<code>a`b</code>", "``a`b``"],
+    ["inline code starting with a backtick is padded", "<code>`x</code>", "`` `x ``"],
+    [
+        "fenced code with language",
+        '<pre><code class="language-rust">fn main() {}\n</code></pre>',
+        lines("```rust", "fn main() {}", "```"),
+    ],
+    [
+        "fence is longer than the inner backtick run",
+        "<pre><code>a ``` b\n</code></pre>",
