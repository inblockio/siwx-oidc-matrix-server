+    ["nested blockquote", "<blockquote><blockquote><p>deep</p></blockquote></blockquote>", "> > deep"],
+    ["unordered list", "<ul>\n<li>a</li>\n<li>b</li>\n</ul>", lines("- a", "- b")],
+    ["ordered list honours start", '<ol start="3">\n<li>c</li>\n<li>d</li>\n</ol>', lines("3. c", "4. d")],
+    ["ordered list start 0", '<ol start="0">\n<li>z</li>\n</ol>', "0. z"],
+    [
+        "nested unordered list indents to the content column",
+        "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>",
+        lines("- a", "  - b"),
+    ],
+    [
+        "nested ordered list indents to the content column",
+        "<ol>\n<li>x\n<ol>\n<li>y</li>\n</ol>\n</li>\n</ol>",
+        lines("1. x", "   1. y"),
+    ],
+    [
+        "continuation paragraph stays inside its item",
+        "<ul>\n<li>\n<p>p1</p>\n<p>p2</p>\n</li>\n<li>\n<p>q</p>\n</li>\n</ul>",
+        lines("- p1", "", "  p2", "- q"),
+    ],
+    ["horizontal rule", "<p>above</p>\n<hr />\n<p>below</p>", lines("above", "", "---", "", "below")],
+    [
+        "link text escaped, URL percent-encoded",
+        '<a href="https://example.com/a b(c)">see [this]</a>',
+        "[see \\[this\\]](https://example.com/a%20b%28c%29)",
+    ],
+    [
+        "link whose text is its URL becomes an autolink",
+        '<a href="https://example.com/x_y">https://example.com/x_y</a>',
+        "<https://example.com/x_y>",
+    ],
+    [
+        "formatted link text",
+        '<a href="https://example.com/">a <strong>b</strong></a>',
