+/**
+ * The vectors whose converter golden is what a conforming HTML5 parser builds. The converter (G4, out of scope for the
+ * rule) parses `formatted_body` with DOMParser, and happy-dom is not a conforming parser: it does not reconstruct
+ * formatting elements (R-1), does not treat `</br>` as `<br>`, reads `href=x/>` differently. The unit run checks the
+ * PATH of these vectors only (the rule never touches a DOM, so the path is the same everywhere); the Chromium run
+ * (`vitest.browser.copy-md.config.ts`) checks the golden byte for byte, as every port must.
+ */
+const HTML5_ONLY = new Set([
+    "r1-p-link",
+    "r1-blockquote-link",
+    "r1-list-link",
+    "r1-heading-link",
+    "r1-two-paragraphs-link",
+    "r1-bold",
+    "r1-code",
+    "r1-reply-link",
+    "r1-reply-text-loss",
+    "b1-unquoted-attribute",
+    "b3-void-end-tag",
+]);
+const IN_BROWSER = typeof navigator !== "undefined" && !navigator.userAgent.includes("HappyDOM");
+/** Whether this run (happy-dom or Chromium) can check the golden of a vector byte for byte. */
+const checksGolden = (v: { id: string }): boolean => IN_BROWSER || !HTML5_ONLY.has(v.id);
+
+function eventOf(content: IContent): MatrixEvent {
+    return new MatrixEvent({
+        type: EventType.RoomMessage,
+        room_id: "!r:example.org",
+        event_id: "$v",
+        sender: "@a:example.org",
+        content,
+    });
+}
+
+/** Steps 1 and 2 of the spec, written out independently of the implementation: what a `source` vector copies. */
+function sourceOfVector(v: Vector): string {
+    let body: string = v.content.body;
+    if (v.strip_reply_fallback) {
+        const l = body.split("\n");
+        while (l.length && l[0].startsWith("> ")) l.shift();
+        if (l[0] === "") l.shift();
+        body = l.join("\n");
+    }
+    return trimEndAscii(body);
+}
