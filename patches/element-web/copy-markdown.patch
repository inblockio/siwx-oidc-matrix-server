+function destinationNormalised(raw: string): string {
+    let pre = "";
+    for (let i = 0; i < raw.length; i++) {
+        const c = raw[i];
+        if (c === "[") pre += "%5B";
+        else if (c === "]") pre += "%5D";
+        else if (c === "%" && !(isHex(raw[i + 1]) && isHex(raw[i + 2]))) pre += "%25";
+        else pre += c;
+    }
+    return hrefNormalised(pre);
+}
+
+function linksNormalised(inlines: Inline[]): Inline[] {
+    return mapNested(
+        inlines.map((node): Inline => {
+            if (node.t === "link") return { t: "link", href: destinationNormalised(node.href), c: node.c };
+            if (node.t === "image") {
+                return {
+                    t: "image",
+                    src: destinationNormalised(node.src),
+                    alt: trimWs(node.alt.replace(WS_RUN, " ")),
+                };
+            }
+            return node;
+        }),
+        linksNormalised,
+    );
+}
+
+// ---- Equality and the mention splice -----------------------------------------------------------------------------
+
+/**
+ * Structural deep equality of two canonical trees, plain data. OPAQUE (`null`) is a distinct result that never equals
+ * anything, itself included: a null on either side is no match.
+ */
+export function canonEqual(a: Block[] | null, b: Block[] | null): boolean {
+    if (a === null || b === null) return false;
+    return isEqual(a, b);
+}
+
+const PILL_HREF = /^https:\/\/matrix\.to\/#\/[@!#]/;
+
+/** The `a` elements with an href attribute, in document order. */
+function anchorsWithHref(root: HtmlEl): HtmlEl[] {
+    const found: HtmlEl[] = [];
+    const walk = (el: HtmlEl): void => {
+        for (const kid of el.kids) {
+            if (kid.k !== "el") continue;
+            if (kid.name === "a" && attrOf(kid, "href") !== undefined) found.push(kid);
+            walk(kid);
+        }
+    };
+    walk(root);
+    return found;
+}
+/**
+ * The candidate source for a message with mention pills (spec 3). Element writes a pill into `formatted_body` as
+ * `<a href="https://matrix.to/#/@user:server">Name</a>` and into `body` as just `Name`. Walking `source` with a
+ * cursor, the next occurrence of each pill's name is replaced with `[Name](href)` (the form Element's own
+ * `mdSerialize` writes, `\`, `[` and `]` of the name escaped). The pills are those of the message's own tree: the
+ * reply fallback (A3) is removed first. Undefined when the formatted_body is opaque, there is no pill, an href holds
+ * ASCII whitespace, `<`, `>`, `(` or `)`, or a name is not found. The candidate is only a proposal: the caller accepts
+ * it through canonical equality, so a wrong occurrence can cause a fallback, never a wrong copy.
+ */
+export function spliceMentions(source: string, formattedBody: string, stripReply = false): string | undefined {
+    const tree = guard(() => buildTree(formattedBody, stripReply));
+    if (tree === null) return undefined;
+    const pills = anchorsWithHref(tree.root)
+        .map((a) => ({ name: textOf(a), href: attrOf(a, "href") ?? "" }))
+        .filter((pill) => PILL_HREF.test(pill.href));
+    if (!pills.length) return undefined;
+    let out = "";
+    let cursor = 0;
+    for (const { name, href } of pills) {
+        if (/[ \t\r\n\f<>()]/.test(href)) return undefined;
+        const at = source.indexOf(name, cursor);
+        if (at === -1) return undefined;
+        out += `${source.slice(cursor, at)}[${name.replace(/[[\\\]]/g, "\\$&")}](${href})`;
+        cursor = at + name.length;
+    }
+    return out + source.slice(cursor);
+}
