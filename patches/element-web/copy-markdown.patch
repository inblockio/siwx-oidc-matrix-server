+ * Whether a message displays anything that "Copy Markdown" would copy, decided without converting it: any visible text
+ * outside the elements Element drops (the reply fallback, scripts and styles among them), an image Element shows, or
+ * maths with some tex. A body that is only whitespace, a reply fallback or such elements has nothing to copy.
+ */
+function displaysSomething(event: MatrixEvent): boolean {
+    const { formatted, body } = messageSource(event);
+    if (formatted === undefined) return VISIBLE.test(body);
+    const stack: Node[] = [new DOMParser().parseFromString(formatted, "text/html").body];
+    for (let node = stack.pop(); node; node = stack.pop()) {
+        for (const child of Array.from(node.childNodes)) {
+            if (child.nodeType === Node.TEXT_NODE) {
+                if (VISIBLE.test(child.nodeValue ?? "")) return true;
+            } else if (child.nodeType === Node.ELEMENT_NODE && !DROPPED.has(child.nodeName)) {
