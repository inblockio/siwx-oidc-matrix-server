+            .map((c) => renderInline(c, ctx))
+            .join("");
+    switch (el.nodeName) {
+        case "BR":
+            return BR;
+        case "STRONG":
+        case "B":
+            return wrap(STRONG, children());
+        case "EM":
+        case "I":
+            return wrap(EM, children());
+        case "DEL":
+        case "S":
+        case "STRIKE":
+            return wrap(DEL, children());
+        case "CODE": {
