+ * it comes back as the table that was typed. A plain body is accepted only when it is text-only paragraphs (no code,
+ * HTML, link or image node), so a table split cannot cut anything open in it. A message from another client, a bot,
+ * the rich text editor or one with a mention (a pill is a link the `body` cannot reproduce) fails the check, and so
+ * does a source that is not safe Markdown, or whose pieces are not safe once a GFM table cuts every line at its
+ * pipes (`gfmCellsSafe`, applied to both kinds of candidate). The result is `undefined` then, and the converter runs. Nothing in here
+ * throws, apart from the event's own content getter, which the caller's catch deals with.
+ */
+function senderMarkdown(event: MatrixEvent): string | undefined {
+    const content = event.getContent();
+    if (typeof content.body !== "string") return undefined;
+    try {
+        const candidate = (event.replyEventId ? stripPlainReply(content.body) : content.body).trimEnd();
+        if (candidate === "") return undefined;
+        let expected = usableFormattedBody(content);
+        // The reply fallback is not the sender's: Element prepends it to the `formatted_body` after serialising.
+        if (expected?.startsWith("<mx-reply>") && expected.includes(REPLY_END)) {
+            expected = expected.slice(expected.indexOf(REPLY_END) + REPLY_END.length);
+        }
+        const sent = htmlSerializeFromMdIfNeeded(candidate) || undefined;
+        if (expected) {
+            return sent === expected && isSafeMarkdown(candidate) && gfmCellsSafe(candidate) ? candidate : undefined;
+        }
+        // Element sent plain text: nothing to compare with, so the source must read as exactly its own characters.
+        return sent === undefined && readsAsItself(candidate) && gfmCellsSafe(candidate) ? candidate : undefined;
+    } catch (e) {
+        logger.error("Copy Markdown: cannot tell whether the sender's own Markdown can be copied", e);
+        return undefined;
+    }
+}
+
+/**
+ * Whether CommonMark reads `md` as exactly its own characters: paragraphs of text and soft breaks and nothing else (no
+ * markup, no escape, no entity, no hard break), so that it needs no escaping to render as itself.
+ */
+function readsAsItself(md: string): boolean {
+    const paragraphs: string[] = [];
+    const walker = new commonmark.Parser().parse(md).walker();
+    for (let step = walker.next(); step; step = walker.next()) {
+        if (!step.entering) continue;
+        const { node } = step;
+        switch (node.type) {
+            case "document":
+                break;
+            case "paragraph":
+                paragraphs.push("");
+                break;
+            case "text":
+                paragraphs[paragraphs.length - 1] += node.literal ?? "";
+                break;
+            case "softbreak":
+                paragraphs[paragraphs.length - 1] += "\n";
+                break;
+            default:
+                return false;
+        }
+    }
+    return paragraphs.join("\n\n") === md;
+}
+
+/** The escaped displayed text of a message, for when the conversion threw. */
+function lastResortOfEvent(event: MatrixEvent): string {
+    try {
+        const { formatted, body } = messageSource(event);
+        return lastResortMarkdown(formatted === undefined ? body : displayedText(formatted));
+    } catch {
+        return "";
+    }
+}
+
+/** The `formatted_body` of a message when it has a usable one: HTML, a string, and not blank. */
+function usableFormattedBody(content: IContent): string | undefined {
+    return content.format === "org.matrix.custom.html" &&
+        typeof content.formatted_body === "string" &&
+        content.formatted_body.trim() !== ""
+        ? content.formatted_body
+        : undefined;
+}
+
+/** What a message displays: its `formatted_body` when it has a usable one, else its plain `body` (reply fallback removed). */
+function messageSource(event: MatrixEvent): { formatted?: string; body: string } {
+    const content = event.getContent();
+    const formatted = usableFormattedBody(content);
+    if (formatted !== undefined) return { formatted, body: "" };
+    let body = typeof content.body === "string" ? content.body : "";
+    if (event.replyEventId) body = stripPlainReply(body);
+    return { body };
+}
+
+/** The Markdown for a message, and whether the safety net replaced it with escaped text. Exported for tests. */
+export function convertEvent(event: MatrixEvent): { md: string; fellBack: boolean } {
+    const { formatted, body } = messageSource(event);
+    if (formatted !== undefined) {
+        // DOMParser yields an inert document: nothing in it executes.
+        const doc = new DOMParser().parseFromString(formatted, "text/html");
+        return withSafetyNet(renderBlocks(doc.body, { inTable: false, inLink: false }).join("\n\n"), () =>
+            textOf(doc.body),
+        );
+    }
+    return withSafetyNet(plainToMarkdown(body), () => body);
+}
+
+/**
+ * Whether `md` is Markdown a renderer shows as text, emphasis, code and the links and images Element shows: it
+ * holds no raw HTML (inline or block), no link whose destination Element's sanitiser would strip (judged after
+ * the parser decoded entities and escapes), and no image that is not an `mxc://` one. Parsed with commonmark, as
+ * Element's own `Markdown` class does.
+ */
+export function isSafeMarkdown(md: string): boolean {
+    const walker = new commonmark.Parser().parse(md).walker();
+    for (let step = walker.next(); step; step = walker.next()) {
+        if (!step.entering) continue;
+        const { node } = step;
+        switch (node.type) {
+            case "html_inline":
+            case "html_block":
+                return false;
+            case "link":
+                if (!isPermittedHref(node.destination ?? "")) return false;
+                break;
+            case "image":
+                if (!(node.destination ?? "").startsWith("mxc://")) return false;
+                break;
+        }
+    }
+    return true;
+}
+
+/**
+ * Whether no cell of a GFM table in `md` holds what `isSafeMarkdown` would refuse. `isSafeMarkdown` parses with
+ * CommonMark, which has no tables, but a GFM renderer cuts a row at every unescaped pipe BEFORE it parses inline
+ * syntax, so it can cut open a code span that CommonMark saw and expose raw HTML or a link in a cell. A line without
+ * a pipe can be a one-cell row, so every line is checked, not only those with a pipe. The lines of a code block
+ * (fenced or indented) are left out: a table cannot cut into one.
+ *
+ * Each line is split the way cmark-gfm does: a backslash escapes the next character, so `\|` does not split and
+ * the pipe of `\\|` does. In each piece `\|` becomes `|`, as GFM unescapes it before the inline parse, and the piece
+ * is trimmed. A cell is inline content, so it is judged after a prefix that rules out any block syntax: a cell
+ * that starts with a fence, an indent, `#`, `>` or `-` must not hide HTML inside a block. Over-rejecting only means
+ * a fallback to the converter. Exported for tests.
+ */
+export function gfmCellsSafe(md: string): boolean {
+    const inCode = new Set<number>();
+    const walker = new commonmark.Parser().parse(md).walker();
+    for (let step = walker.next(); step; step = walker.next()) {
+        const { node, entering } = step;
+        if (!entering || node.type !== "code_block" || !node.sourcepos) continue;
+        for (let line = node.sourcepos[0][0]; line <= node.sourcepos[1][0]; line++) inCode.add(line);
+    }
+    // The same line endings as CommonMark, so that its line numbers are ours
+    const mdLines = md.split(/\r\n|\n|\r/);
+    for (let i = 0; i < mdLines.length; i++) {
+        if (inCode.has(i + 1)) continue;
+        for (const piece of gfmCells(mdLines[i])) {
+            if (piece !== "" && !isSafeMarkdown("x " + piece)) return false;
+        }
+    }
+    return true;
+}
+
+/** The pieces a GFM renderer cuts a line into at its unescaped pipes: `\|` is a pipe in the piece, which is trimmed. */
+function gfmCells(line: string): string[] {
+    const pieces: string[] = [];
+    let piece = "";
+    for (let i = 0; i < line.length; i++) {
+        if (line[i] === "\\" && i + 1 < line.length) {
+            piece += line[i] + line[++i];
+        } else if (line[i] === "|") {
+            pieces.push(piece);
+            piece = "";
+        } else {
+            piece += line[i];
+        }
+    }
+    pieces.push(piece);
+    return pieces.map((p) => p.replace(/\\\|/g, "|").trim());
+}
+
+/**
+ * The safety net: `md` when it is safe, else the plain text of what Element displayed (`displayed`, called only
+ * then) with its Markdown escaped, else, if even that is not safe, with every ASCII punctuation character escaped.
+ * Exported for tests.
+ */
+export function withSafetyNet(md: string, displayed: () => string): { md: string; fellBack: boolean } {
+    if (isSafeMarkdown(md)) return { md, fellBack: false };
+    const text = displayed();
+    const escaped = plainToMarkdown(text);
+    return { md: isSafeMarkdown(escaped) ? escaped : lastResortMarkdown(text), fellBack: true };
+}
+
+/** Plain text as Markdown with every ASCII punctuation character backslash-escaped. Exported for tests. */
+export function lastResortMarkdown(text: string): string {
+    return plainToMarkdown(text, true);
+}
+
+/** Elements that sit on a line of their own in `textOf`, as `BLOCKS` sit in a paragraph of their own. */
+const LINE_BREAKING = new Set(["LI", "TR", "CAPTION"]);
+
+/**
+ * The text of a formatted body that a reader sees: block elements and `br` as line breaks, table cells apart, the
+ * elements Element drops (and images) left out. Exported for tests, which pass the HTML.
+ */
+export function displayedText(formattedBody: string): string {
+    return textOf(new DOMParser().parseFromString(formattedBody, "text/html").body);
+}
+
+function textOf(root: Node): string {
+    let out = "";
+    // Ends `out` with `count` line breaks, counting those it already ends with; nothing before the first text.
+    const breakTo = (count: number, pre: boolean): void => {
+        if (out === "") return;
+        if (!pre) out = out.replace(/ +$/, "");
+        out += "\n".repeat(Math.max(0, count - /\n*$/.exec(out)![0].length));
+    };
+    const walk = (node: Node, pre: boolean): void => {
+        for (const child of Array.from(node.childNodes)) {
+            if (child.nodeType === Node.TEXT_NODE) {
+                let text = child.nodeValue ?? "";
+                if (!pre) {
+                    text = text.replace(/[\t\n\r ]+/g, " ");
+                    if (out === "" || out.endsWith("\n")) text = text.replace(/^ /, "");
+                }
+                out += text;
+            } else if (child.nodeType === Node.ELEMENT_NODE && !DROPPED.has(child.nodeName)) {
+                const name = child.nodeName;
+                if (name === "BR") {
+                    out += "\n";
+                } else if (name !== "IMG") {
+                    const lines = BLOCKS.has(name) ? 2 : LINE_BREAKING.has(name) ? 1 : 0;
+                    if (lines) breakTo(lines, pre);
+                    walk(child, pre || name === "PRE");
+                    if (lines) breakTo(lines, pre);
+                    else if (name === "TD" || name === "TH") out += " ";
+                }
+            }
+        }
+    };
+    walk(root, false);
+    return out.replace(/^\n+|\n+$/g, "");
+}
+
+/**
+ * A plain message as Markdown that renders as the literal text. With `strict`, every ASCII punctuation character
+ * is escaped and nothing is recognised (no bare URL becomes a link): no parser can read markup into it.
+ */
+function plainToMarkdown(body: string, strict = false): string {
+    const paragraphs: string[][] = [[]];
+    for (const raw of body.split(/\r\n|\r|\n/)) {
+        // Leading spaces and tabs become no-break spaces: Element shows them (pre-wrap), and four spaces in
+        // Markdown would turn the line into an indented code block.
+        const line = raw
+            .replace(/\s+$/, "")
+            .replace(/^[ \t]+/, (ws) => ws.replace(/[ \t]/g, (c) => (c === "\t" ? "\u00a0".repeat(4) : "\u00a0")));
+        if (line === "") {
+            if (paragraphs[paragraphs.length - 1].length) paragraphs.push([]);
+            continue;
+        }
+        paragraphs[paragraphs.length - 1].push(
+            strict
+                ? clean(line).replace(/[!-/:-@[-`{-~]/g, "\\$&")
+                : escapeLineStart(resolveInline(escapeText(clean(line), true))),
+        );
+    }
+    return paragraphs
+        .filter((p) => p.length)
+        .map((p) => p.join("\\\n"))
+        .join("\n\n");
+}
+
+function renderBlocks(parent: Node, ctx: Ctx): string[] {
+    const blocks: string[] = [];
+    let run: Node[] = [];
+    const flush = (): void => {
+        const text = renderInlineRun(run, ctx);
+        run = [];
+        if (text) blocks.push(text);
+    };
+    for (const child of Array.from(parent.childNodes)) {
+        if (child.nodeType === Node.ELEMENT_NODE && DROPPED.has(child.nodeName)) continue;
+        if (child.nodeType === Node.ELEMENT_NODE && isBlock(child as Element)) {
+            flush();
+            const block = renderBlock(child as Element, ctx);
+            if (block) blocks.push(block);
+        } else {
+            run.push(child);
+        }
+    }
+    flush();
+    return blocks;
+}
+
+function isBlock(el: Element): boolean {
+    return BLOCKS.has(el.nodeName);
+}
+
+function renderBlock(el: Element, ctx: Ctx): string {
+    switch (el.nodeName) {
+        case "P":
+            return renderInlineRun(Array.from(el.childNodes), ctx);
+        case "H1":
+        case "H2":
+        case "H3":
+        case "H4":
+        case "H5":
+        case "H6": {
+            // Heading text is inline content, so no block can start in it and its line starts need no escape. A run of
+            // # after a space is the one thing that ends a heading (the closing sequence), so its first # is escaped.
+            const text = inlineRunLines(Array.from(el.childNodes), ctx)
+                .join(" ")
+                .replace(/\n/g, " ")
+                .replace(/(^|[ \t])(#+)$/, "$1\\$2");
+            return `${"#".repeat(Number(el.nodeName[1]))} ${text}`;
+        }
+        case "SUMMARY":
+            return renderInlineRun(Array.from(el.childNodes), ctx, STRONG);
+        case "BLOCKQUOTE":
+            return renderBlocks(el, ctx)
+                .join("\n\n")
+                .split("\n")
+                .map((l) => (l === "" ? ">" : `> ${l}`))
+                .join("\n");
+        case "UL":
+        case "OL":
+            return renderList(el, ctx);
+        case "PRE":
+            return renderPre(el, ctx);
+        case "HR":
+            return "---";
+        case "TABLE":
+            return renderTable(el, ctx);
+        case "DIV":
+            if (el.hasAttribute("data-mx-maths"))
+                return `$$\n${mathsSafe(clean(el.getAttribute("data-mx-maths")!), true, ctx.inTable)}\n$$`;
+            return renderBlocks(el, ctx).join("\n\n");
+        default: // DETAILS and anything else block-level: render its children
+            return renderBlocks(el, ctx).join("\n\n");
+    }
+}
+
+function renderList(el: Element, ctx: Ctx): string {
+    const ordered = el.nodeName === "OL";
+    const start = Number.parseInt(el.getAttribute("start") ?? "1", 10);
+    let n = Number.isFinite(start) ? start : 1;
+    const items: string[] = [];
+    for (const li of Array.from(el.children)) {
+        if (li.nodeName !== "LI") continue;
+        const marker = ordered ? `${n++}. ` : "- ";
+        const indent = " ".repeat(marker.length);
+        const loose = Array.from(li.children).some((c) => c.nodeName === "P");
+        const body = renderBlocks(li, ctx).join(loose ? "\n\n" : "\n");
+        items.push(
+            marker +
+                body
+                    .split("\n")
+                    .map((l, i) => (i === 0 || l === "" ? l : indent + l))
+                    .join("\n"),
+        );
+    }
+    return items.join("\n");
+}
+
+/** The info strings a fence keeps: language names such as `rust`, `c++`, `c#`, `objective-c`. */
+const INFO_STRING = /^[\w.+#-]+$/;
+
+function renderPre(el: Element, ctx: Ctx): string {
+    const code = el.firstElementChild?.nodeName === "CODE" ? el.firstElementChild : null;
+    let language = "";
+    for (const cls of Array.from(code?.classList ?? [])) {
+        if (cls.startsWith("language-") && !cls.startsWith("language-_")) {
+            language = cls.slice("language-".length);
+            break;
+        }
+    }
+    // The class is sender-controlled and the info string is not escapable: a backtick in it is no fence at all and
+    // turns the code that follows into live Markdown. Only a plain token stays.
+    if (!INFO_STRING.test(language)) language = "";
+    let text = (el.textContent ?? "").replace(/\n$/, "");
+    if (ctx.inTable) text = text.replace(/\|/g, "\\|");
+    const fence = "`".repeat(Math.max(3, longestBacktickSequence(text) + 1));
+    return `${fence}${language}\n${text}\n${fence}`;
+}
+
+function renderTable(el: Element, ctx: Ctx): string {
+    const rows = Array.from(el.querySelectorAll("tr")).map((tr) =>
+        Array.from(tr.children)
+            .filter((c) => c.nodeName === "TD" || c.nodeName === "TH")
+            .map((c) => renderCell(c, ctx)),
+    );
+    if (!rows.length) return "";
+    const width = Math.max(...rows.map((r) => r.length));
+    const row = (r: string[]): string => `| ${Array.from({ length: width }, (_, i) => r[i] ?? "").join(" | ")} |`;
+    const table = [row(rows[0]), `| ${Array(width).fill("---").join(" | ")} |`, ...rows.slice(1).map(row)].join("\n");
+    const caption = Array.from(el.children).find((c) => c.nodeName === "CAPTION");
+    const captionText = caption ? renderInlineRun(Array.from(caption.childNodes), ctx) : "";
+    return captionText ? `${captionText}\n\n${table}` : table;
+}
+
+/**
+ * One table cell. GFM splits a row into cells before it parses any inline syntax, so a backtick in one cell cannot
+ * pair with a backtick in another, which is how the whole table reads to commonmark. The net therefore judges the
+ * cell on its own too, the way GFM parses it (`\|` read as `|`): a cell that is not safe in isolation becomes the
+ * escaped plain text of what it displays.
+ */
+function renderCell(cell: Element, ctx: Ctx): string {
+    const md = renderBlocks(cell, { ...ctx, inTable: true })
+        .join(" ")
+        .replace(/\\\n/g, " ")
+        .replace(/\n/g, " ")
+        .trim();
+    if (isSafeMarkdown(md.replace(/\\\|/g, "|"))) return md;
+    const text = textOf(cell).replace(/\s+/g, " ").trim();
+    const escaped = plainToMarkdown(text);
+    return isSafeMarkdown(escaped.replace(/\\\|/g, "|")) ? escaped : lastResortMarkdown(text);
+}
+
+/** The lines of a run of inline nodes: split at hard breaks, trimmed, blank lines at either end dropped. */
+function inlineRunLines(nodes: Node[], ctx: Ctx, emphasis?: number): string[] {
+    let joined = nodes.map((n) => renderInline(n, ctx)).join("");
+    if (emphasis !== undefined) joined = wrap(emphasis, joined);
+    const lines = resolveInline(joined)
+        .split(BR)
+        .map((l) => l.trim());
+    while (lines.length && lines[lines.length - 1] === "") lines.pop();
+    while (lines.length && lines[0] === "") lines.shift();
+    return lines;
+}
+
+/** Renders a run of inline nodes as one block: lines split at hard breaks, trimmed, line starts escaped. */
+function renderInlineRun(nodes: Node[], ctx: Ctx, emphasis?: number): string {
+    return inlineRunLines(nodes, ctx, emphasis).map(escapeLineStart).join("\\\n");
+}
+
+function renderInline(node: Node, ctx: Ctx): string {
+    if (node.nodeType === Node.TEXT_NODE) {
+        const text = clean((node.nodeValue ?? "").replace(/[\t\n\r ]+/g, " "));
+        return escapeText(text, !ctx.inLink);
+    }
+    if (node.nodeType !== Node.ELEMENT_NODE) return "";
+    const el = node as Element;
+    if (DROPPED.has(el.nodeName)) return "";
+    const children = (): string =>
+        Array.from(el.childNodes)
+            .map((c) => renderInline(c, ctx))
+            .join("");
+    switch (el.nodeName) {
+        case "BR":
+            return BR;
+        case "STRONG":
+        case "B":
+            return wrap(STRONG, children());
+        case "EM":
+        case "I":
+            return wrap(EM, children());
+        case "DEL":
+        case "S":
+        case "STRIKE":
+            return wrap(DEL, children());
+        case "CODE": {
+            const text = clean((el.textContent ?? "").replace(/\n/g, " "));
+            // An empty span would be written as a bare pair of backticks, which can pair with a later fence.
+            return text === "" ? "" : atom(codeSpan(text, ctx.inTable));
+        }
+        case "A":
+            return link(
+                el,
+                Array.from(el.childNodes)
+                    .map((c) => renderInline(c, { ...ctx, inLink: true }))
+                    .join(""),
+            );
+        case "IMG": {
+            const src = displayedImageSrc(clean(el.getAttribute("src") ?? ""));
+            if (src === null) return "";
+            // One line, as text nodes are: a line break in the alt would start a block (heading, list) mid-image.
+            const alt = escapeText(clean(el.getAttribute("alt") ?? "").replace(/\s+/g, " "));
+            return atom(`![${alt}](${encodeUrl(src)})`);
+        }
+        case "SPAN":
+            if (el.hasAttribute("data-mx-maths")) {
+                return atom(`$${mathsSafe(clean(el.getAttribute("data-mx-maths")!), false, ctx.inTable)}$`);
+            }
+            return children();
+        default: // u, sub, sup, font, colour and spoiler spans, unknown tags: keep the text
+            return children();
+    }
+}
+
+/** Marks `text` as emphasis, moving edge whitespace and hard breaks outside; `resolveInline` places the delimiters. */
+function wrap(kind: number, text: string): string {
+    const m = /^([\s\uE000]*)([\s\S]*?)([\s\uE000]*)$/.exec(text)!;
+    return m[2] ? `${m[1]}${OPEN[kind]}${m[2]}${CLOSE[kind]}${m[3]}` : text;
+}
+
+/**
+ * The tex of a maths node is sender-controlled and invisible in Element, and it is emitted between `$`. Two
+ * normalisations that leave the maths as TeX reads it keep Markdown from restructuring it:
+ * - Inline tex becomes one line (TeX reads a line break in math mode as a space), so a line cannot start a heading.
+ *   A `%` comment ends at its line, so it is cut before the lines are joined.
+ * - Display tex loses its blank lines (a blank line is an error in math mode), so no paragraph or link reference
+ *   definition can start inside it, and every line is indented by four spaces (TeX ignores leading space). The `$$`
+ *   line before it opens a paragraph, and an indented line cannot start any block inside a paragraph (no table
+ *   delimiter row, heading, quote, list, fence or HTML block), so it stays text. In a table cell the lines are
+ *   joined into one line anyway, and no indent is needed.
+ * A `<` that could open a tag, comment, declaration, processing instruction or autolink gets a space after it
+ * (TeX ignores it, CommonMark no longer sees HTML). In inline maths a `<name` that runs to the end of the tex is
+ * left alone: the closing `$` follows it, which no tag or autolink can continue through, so `$a<b$` stays as is.
+ * Whatever Markdown can still read into the tex (a backtick pairing with a later code span) is caught by
+ * `isSafeMarkdown`, and, in a table, by the judgement of each cell on its own.
+ */
+function mathsSafe(tex: string, display: boolean, inTable: boolean): string {
+    const lines = tex.split(/\r\n|\r|\n/);
+    const oneLine = display
+        ? lines
+              .filter((l) => /[^ \t]/.test(l))
+              .map((l) => (inTable ? l : `    ${l}`))
+              .join("\n")
+        : lines.length > 1
+          ? lines.map(texWithoutComment).join(" ")
+          : tex;
+    const opensHtml = display ? /<(?=[A-Za-z/!?])/g : /<(?=[A-Za-z/!?])(?![A-Za-z][A-Za-z0-9+.-]*$)/g;
+    const safe = oneLine.replace(opensHtml, "< ");
+    return inTable ? safe.replace(/\|/g, "\\|") : safe;
+}
+
+/** A line of tex without its comment: a `%` that no backslash escapes starts one, and it runs to the end of the line. */
+function texWithoutComment(line: string): string {
+    for (let i = 0; i < line.length; i++) {
+        if (line[i] === "\\") i++;
+        else if (line[i] === "%") return line.slice(0, i);
+    }
+    return line;
+}
+
+/**
+ * The text a code span shows, read back from what `codeSpan` wrote: the fence is the leading run of backticks (the
+ * padding keeps a backtick of the text out of it), and a parser strips one padding space from each end.
+ */
+function codeSpanText(span: string): string {
+    const fence = /^`+/.exec(span)![0].length;
+    const inner = span.slice(fence, span.length - fence);
+    return /^ [\s\S]* $/.test(inner) && /[^ ]/.test(inner) ? inner.slice(1, -1) : inner;
+}
+
+const isCodeSpan = (t: Tok): boolean => t.kind === "atom" && t.s.startsWith("`");
+
+/**
+ * Two code spans side by side would have their backticks run together into one longer run that closes nothing (or
+ * the wrong span), and what it leaves unpaired can expose the code that follows. They are written as one span.
+ */
+function mergeCodeSpans(toks: Tok[]): Tok[] {
+    const out: Tok[] = [];
+    for (const t of toks) {
+        const last = out[out.length - 1];
+        if (last && isCodeSpan(last) && isCodeSpan(t)) {
+            out[out.length - 1] = { ...last, s: codeSpan(codeSpanText(last.s) + codeSpanText(t.s), false) };
+        } else {
+            out.push(t);
+        }
+    }
+    return out;
+}
+
+/** In a table cell a `|` must be written `\|` (GFM unescapes it before it parses the cell), even in a code span. */
+function codeSpan(text: string, inTable: boolean): string {
+    if (inTable) text = text.replace(/\|/g, "\\|");
+    const fence = "`".repeat(longestBacktickSequence(text) + 1);
+    const pad = text.startsWith("`") || text.endsWith("`") ? " " : "";
+    return `${fence}${pad}${text}${pad}${fence}`;
+}
+
+/**
+ * Whether Element's sanitiser keeps this href: sanitize-html with `allowedSchemes: PERMITTED_URL_SCHEMES` and
+ * `allowProtocolRelative: false` (its `launder` dependency does the check). A relative href has no scheme and
+ * is kept. Anything else is stripped, which leaves the link text with no link.
+ */
+function isPermittedHref(href: string): boolean {
+    // Browsers ignore characters up to U+0020 inside a URL, so the sanitiser removes them before it looks.
+    let h = Array.from(href)
+        .filter((c) => c.charCodeAt(0) > 0x20)
+        .join("");
+    for (;;) {
+        const start = h.indexOf("<!--");
+        const end = start === -1 ? -1 : h.indexOf("-->", start + 4);
+        if (end === -1) break;
+        h = h.slice(0, start) + h.slice(end + 3);
+    }
+    const scheme = /^([a-zA-Z][a-zA-Z0-9.+-]*):/.exec(h);
+    if (!scheme) return !/^[/\\]{2}/.test(h);
