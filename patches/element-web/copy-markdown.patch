+ * pulldown-cmark with no options or comrak with no extensions), then the normalisation of spec 2.3. `null` when the
+ * source is opaque (a titled link or image, a table the GFM rules would read differently).
+ */
+export function canonMd(md: string): Block[] | null {
+    return guard(() => {
+        if (hasJsOnlyWhitespaceAtEdge(md)) opaque();
