+}
+
+const MEDIA_API_MXC = /\/_matrix\/media\/r0\/(?:download|thumbnail)\/(.+?)\/(.+?)(?:[?/]|$)/;
+
+/**
+ * The mxc URI of the image Element renders for this `src`, or null when it renders none. Element's `img`
+ * transform keeps `mxc://` sources, maps legacy media API URLs to their mxc URI, and for every other source
+ * returns an `<img>` with no attributes at all (no src, no alt), which shows nothing.
+ */
+function displayedImageSrc(src: string): string | null {
+    if (src.startsWith("mxc://")) return src;
