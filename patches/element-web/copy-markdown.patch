+// @vitest-environment happy-dom
+
+import { describe, it, expect, vi } from "vitest";
+import { EventType, MatrixEvent, MsgType } from "matrix-js-sdk/src/matrix";
+import * as commonmark from "commonmark";
+
+import { htmlSerializeFromMdIfNeeded } from "../editor/serialize";
+import {
+    canCopyMarkdown,
+    convertEvent,
+    displayedText,
+    eventToMarkdown as publicEventToMarkdown,
+    gfmCellsSafe,
+    isSafeMarkdown,
+    lastResortMarkdown,
+    withSafetyNet,
+} from "./eventToMarkdown";
+
+// The real parser behind a spy, so that a test can tell the conversion (which parses its output to check it) from
+// a cheap check that never parses Markdown.
+vi.mock("commonmark", async (importOriginal) => {
+    const real = await importOriginal<typeof import("commonmark")>();
+    return {
+        ...real,
+        Parser: vi.fn(function (...args: ConstructorParameters<typeof real.Parser>) {
+            return new real.Parser(...args);
+        }),
+    };
+});
+
+// Element's own send path behind a spy, so that a test can make it throw and tell the conversion from a cheap check
+// that never calls it.
+vi.mock("../editor/serialize", async (importOriginal) => {
+    const real = await importOriginal<typeof import("../editor/serialize")>();
+    return { ...real, htmlSerializeFromMdIfNeeded: vi.fn(real.htmlSerializeFromMdIfNeeded) };
+});
+
+const lines = (...l: string[]): string => l.join("\n");
+
+/**
+ * The converter under test. Every case in this file goes through the AC3 safety net check: an ordinary message
+ * must convert directly, as safe Markdown, without falling back to escaped text, and the public entry point must
+ * agree with `convertEvent`. Cases that expect a fallback call `convertEvent` themselves.
+ */
+function eventToMarkdown(event: MatrixEvent): string {
+    const { md, fellBack } = convertEvent(event);
+    expect(fellBack).toBe(false);
+    expect(isSafeMarkdown(md)).toBe(true);
+    expect(publicEventToMarkdown(event)).toBe(md);
+    return md;
+}
+
+/**
+ * Plain bodies that Element sends as plain text and that CommonMark reads as exactly themselves. Rule 5 of R1 copies
+ * them verbatim, the sender's own source, where the converter alone would escape them (URLs, pipes) or strip private-use
+ * characters. [name, body]
+ */
+const VERBATIM_PLAIN: Array<[name: string, body: string]> = [
+    ["an underscore inside a word", "snake_case_name"],
+    ["a lone asterisk", "a * b"],
+    ["soft line breaks and a blank line", lines("one", "two", "", "three")],
+    ["a URL-only message", "https://matrix.org/_matrix/client/versions"],
+    ["a URL on each of two lines", "https://a.example/1\nhttps://b.example/2"],
+    ["a real URL after a long-s one", "http\u017f://a.example/x https://b.example/y"],
+    ["private-use characters", "a\uE001b\uE004c\uE007d\uE000e"],
+    ["a pipe", "a|b"],
+    ["a pipe between a URL and text", "https://a.example/x | y"],
+    ["a pipe, then a line that may be a delimiter row", "a | b\n:-:"],
+    ["a table and nothing else", lines("| train | driver |", "|---|---|", "| core | Alice |")],
+];
+
+/**
+ * The converter alone, as `eventToMarkdown` above checks it, for a plain body. The public entry point agrees with it,
+ * except for the bodies in `VERBATIM_PLAIN`: rule 5 of R1 applies to them and the public copy is the body itself.
+ */
+function converted(event: MatrixEvent): string {
+    const { md, fellBack } = convertEvent(event);
+    expect(fellBack).toBe(false);
+    expect(isSafeMarkdown(md)).toBe(true);
+    const body: string = event.getContent().body;
+    expect(publicEventToMarkdown(event)).toBe(VERBATIM_PLAIN.some(([, b]) => b === body) ? body : md);
+    return md;
+}
+
+function html(formattedBody: string, msgtype: string = MsgType.Text, body = "fallback"): MatrixEvent {
+    return new MatrixEvent({
+        type: EventType.RoomMessage,
+        room_id: "!r:example.org",
+        event_id: "$e",
+        sender: "@a:example.org",
+        content: { msgtype, body, format: "org.matrix.custom.html", formatted_body: formattedBody },
+    });
+}
+
+function plain(body: string, extra: object = {}): MatrixEvent {
+    return new MatrixEvent({
+        type: EventType.RoomMessage,
+        room_id: "!r:example.org",
+        event_id: "$p",
+        sender: "@a:example.org",
+        content: { msgtype: MsgType.Text, body, ...extra },
+    });
+}
+
+/** Every raw-HTML node CommonMark finds in `md`. Clean Markdown yields []. */
+function htmlNodes(md: string): string[] {
+    const walker = new commonmark.Parser().parse(md).walker();
+    const found: string[] = [];
+    let step;
+    while ((step = walker.next())) {
+        const { node, entering } = step;
+        if (entering && (node.type === "html_inline" || node.type === "html_block")) found.push(node.literal ?? "");
+    }
+    return found;
+}
+
+/** Splits a GFM table row on every `|` that a backslash does not escape; `\|` becomes `|` inside a cell. */
+function gfmCells(row: string): string[] {
+    const cells: string[] = [];
+    let cell = "";
+    for (let i = 0; i < row.length; i++) {
+        if (row[i] === "\\" && row[i + 1] === "|") {
+            cell += "|";
+            i++;
+        } else if (row[i] === "|") {
+            cells.push(cell);
+            cell = "";
+        } else {
+            cell += row[i];
+        }
+    }
+    cells.push(cell);
+    return cells.slice(1, -1).map((c) => c.trim());
+}
+
+/** Renders Markdown with CommonMark, to prove what a renderer would show rather than only what we emit. */
+function renderMd(md: string): string {
+    return new commonmark.HtmlRenderer().render(new commonmark.Parser().parse(md));
+}
+
+/** [name, HTML input, expected Markdown, substrings the CommonMark rendering must contain, and must not contain] */
+type Case = [name: string, input: string, expected: string, rendered?: string[], absent?: string[]];
+
+/** The Markdown holds no raw HTML, and CommonMark renders it to contain (and not contain) the given substrings. */
+function expectClean(md: string, rendered: string[] = [], absent: string[] = []): void {
+    expect(htmlNodes(md)).toEqual([]);
+    const out = renderMd(md);
+    for (const part of rendered) expect(out).toContain(part);
+    for (const part of absent) expect(out).not.toContain(part);
+}
+
+const HTML_CASES: Array<[name: string, input: string, expected: string]> = [
+    ["strong/em/b/i", "<strong>bold</strong> and <em>it</em> and <b>b</b> <i>i</i>", "**bold** and *it* and **b** *i*"],
