+ *    mentions spliced in, is the copy if it is canonically the formatted body (`canonMd` equals `canonHtml`, neither
+ *    is opaque) and safe. 5. Otherwise the converter runs on the formatted body.
+ */
+export function copyMarkdownWithPath(content: IContent, stripReplyFallback: boolean): { md: string; path: CopyPath } {
+    const body: unknown = content.body;
+    const source = typeof body === "string" ? trimEndWs(stripReplyFallback ? stripPlainReply(body) : body) : undefined;
+    const formatted: unknown = content.format === HTML_FORMAT ? content.formatted_body : undefined;
+    if (typeof formatted !== "string" || formatted === "" || (stripReplyFallback && isReplyFallbackOnly(formatted))) {
+        if (source !== undefined && source !== "" && parseable(source) && isSafeSource(source))
+            return { md: source, path: "source" };
+        return { md: convertSafely(content, stripReplyFallback), path: "escaped" };
+    }
+    if (source !== undefined && parseable(source)) {
+        try {
+            const message = canonHtml(formatted, stripReplyFallback);
+            if (message !== null) {
+                if (canonEqual(canonMd(source), message) && isSafeSource(source)) return { md: source, path: "source" };
+                const spliced = spliceMentions(source, formatted, stripReplyFallback);
+                if (
+                    spliced !== undefined &&
+                    spliced !== source &&
+                    parseable(spliced) &&
+                    canonEqual(canonMd(spliced), message) &&
+                    isSafeSource(spliced)
