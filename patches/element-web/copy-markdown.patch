+/**
+ * Converts a message to clean CommonMark + GFM for "Copy Markdown".
+ *
+ * The HTML in `formatted_body` is converted, not stripped: everything Markdown can express is kept,
+ * everything it cannot is reduced to its text, and no HTML is ever emitted. A plain `body` is escaped
+ * so it renders as the literal text Element displayed. The one exception is a message composed in Element as Markdown,
+ * which is copied as the Markdown its sender typed (`senderMarkdown`).
+ *
+ * "No HTML" holds by construction: the converted Markdown is parsed back with commonmark (`isSafeMarkdown`), and
+ * a message whose Markdown holds raw HTML, a link Element would not show or a non-mxc image is copied as escaped
+ * plain text of what Element displayed instead (`withSafetyNet`). Ordinary messages never reach that fallback.
+ */
+
+const COPYABLE_MSGTYPES: string[] = [MsgType.Text, MsgType.Notice, MsgType.Emote];
+const DROPPED = new Set(["MX-REPLY", "SCRIPT", "STYLE", "NOSCRIPT", "TEXTAREA", "OPTION"]);
+const BLOCKS = new Set([
+    "P",
+    "DIV",
+    "H1",
+    "H2",
+    "H3",
+    "H4",
+    "H5",
+    "H6",
+    "BLOCKQUOTE",
+    "UL",
+    "OL",
+    "PRE",
+    "HR",
+    "TABLE",
+    "DETAILS",
+    "SUMMARY",
