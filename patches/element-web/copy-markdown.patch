+];
+
+describe("eventToMarkdown", () => {
+    it("the HTML-residue detector is not vacuous", () => {
+        expect(htmlNodes("a <u>b</u>")).not.toEqual([]);
+        expect(htmlNodes("<div>\nx\n</div>")).not.toEqual([]);
+        expect(htmlNodes("<https://example.com/>")).toEqual([]);
+    });
+
+    it.each(HTML_CASES)("%s", (_name, input, expected) => {
+        const md = eventToMarkdown(html(input));
+        expect(md).toBe(expected);
+        expect(htmlNodes(md)).toEqual([]);
+    });
+
+    it("emote: no /me command", () => {
+        expect(eventToMarkdown(html("<em>waves</em>", MsgType.Emote, "waves"))).toBe("*waves*");
+    });
+
+    it("blank formatted_body falls back to the plain body", () => {
+        expect(eventToMarkdown(html("  ", MsgType.Text, "plain *b*"))).toBe("plain \\*b\\*");
+    });
+
+    it("plain body: escaped, newlines are hard breaks, blank lines are paragraphs", () => {
+        const md = eventToMarkdown(plain("hello *world*\nline two\n\n\nnew para"));
+        expect(md).toBe(lines("hello \\*world\\*\\", "line two", "", "new para"));
+        expect(htmlNodes(md)).toEqual([]);
+    });
+
+    it("plain body: literal HTML is escaped, never re-parsed", () => {
+        const md = eventToMarkdown(plain("a <b>bold</b> claim"));
+        expect(md).toBe("a \\<b>bold\\</b> claim");
+        expect(htmlNodes(md)).toEqual([]);
+    });
+
+    it("plain body: line-start markers are escaped", () => {
+        expect(eventToMarkdown(plain("# not a heading\n1. not a list"))).toBe(
+            lines("\\# not a heading\\", "1\\. not a list"),
+        );
+    });
+
+    it("plain body: the reply fallback is stripped", () => {
+        const ev = plain("> <@bob:example.org> orig\n\nanswer", {
+            "m.relates_to": { "m.in_reply_to": { event_id: "$orig" } },
+        });
+        expect(eventToMarkdown(ev)).toBe("answer");
+    });
+
+    it("edits: the latest revision is copied", () => {
+        const original = html("<p>old</p>", MsgType.Text, "old");
+        const replacement = new MatrixEvent({
+            type: EventType.RoomMessage,
+            room_id: "!r:example.org",
+            event_id: "$edit",
+            sender: "@a:example.org",
+            content: {
+                "msgtype": MsgType.Text,
+                "body": "* new",
+                "m.new_content": {
+                    msgtype: MsgType.Text,
+                    body: "**new**",
+                    format: "org.matrix.custom.html",
+                    formatted_body: "<strong>new</strong>",
+                },
+                "m.relates_to": { rel_type: "m.replace", event_id: "$e" },
+            },
+        });
