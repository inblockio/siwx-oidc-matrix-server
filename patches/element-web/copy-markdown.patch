+    ],
+    [
+        "user mention keeps its matrix.to link",
+        '<a href="https://matrix.to/#/@alice:example.org">Alice</a>: hi',
+        "[Alice](https://matrix.to/#/@alice:example.org): hi",
+    ],
+    [
+        "image keeps the mxc URI",
+        '<img src="mxc://example.org/abc" alt="cat *pic*">',
