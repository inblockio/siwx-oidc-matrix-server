+describe("v2.2 B5: link destinations", () => {
+    const a = (h: string): string => `<p><a href="${h}">x</a></p>`;
+    const hrefOf = (html: string): string | undefined => {
+        const para0 = canonHtml(html)?.[0] as { c: Inline[] } | undefined;
+        return (para0?.c[0] as { href?: string } | undefined)?.href;
+    };
+
+    it("both sides write [ as %5B, ] as %5D and a % without two hex digits as %25, then normalise", () => {
+        expect(hrefOf(a("https://e.org/?a[]=1"))).toBe("https://e.org/?a%5B%5D=1");
+        expect(hrefOf(a("https://e.org/100%"))).toBe("https://e.org/100%25");
+        expect(hrefOf(a("https://e.org/%zz"))).toBe("https://e.org/%25zz");
+        expect(hrefOf(a("https://e.org/%4"))).toBe("https://e.org/%254");
+        expect(hrefOf(a("https://e.org/%41%5b%5D%25"))).toBe("https://e.org/A%5B%5D%25");
+        const md = canonMd("[x](https://e.org/?a[]=1&b=100%)")?.[0] as { c: Inline[] };
+        expect((md.c[0] as { href: string }).href).toBe("https://e.org/?a%5B%5D=1&b=100%25");
+        for (const [mdSource, html] of [
+            ["[x](https://e.org/?a[]=1)", a("https://e.org/?a%5B%5D=1")],
+            ["[x](https://e.org/?a%5B%5D=1)", a("https://e.org/?a[]=1")],
+            ["[x](https://e.org/100%)", a("https://e.org/100%")],
+            ["[x](https://e.org/100%25)", a("https://e.org/100%")],
+        ]) {
+            expect([mdSource, canonEqual(canonMd(mdSource), canonHtml(html))]).toEqual([mdSource, true]);
+        }
+    });
+
+    it("HTML side: a backslash, tab, LF or CR in an href or src (after decoding) is opaque", () => {
+        for (const bad of [
+            "https://e.org/a\\b",
+            "https://e.org/a&#92;b",
+            "https://e.org/a&#x5C;b",
+            "https://e.org/a\tb",
+            "https://e.org/a&#9;b",
+            "https://e.org/a\nb",
+            "https://e.org/a&#10;b",
+            "https://e.org/a\r\nb",
