+ */
+export function eventToMarkdown(event: MatrixEvent): string {
+    try {
+        return senderMarkdown(event) ?? convertEvent(event).md;
+    } catch (e) {
+        logger.error("Copy Markdown: conversion failed, copying the escaped text instead", e);
+        return lastResortOfEvent(event);
+    }
