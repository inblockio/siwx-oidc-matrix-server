+
+// @vitest-environment happy-dom
+
+// inblock.io vendored patch (patches/element-web/sw-media-401-token-retry.patch): a media request that gets a 401
+// with the stored access token waits, bounded, for the app to store a refreshed one and retries once.
+
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+
+import * as StorageAccess from "../utils/StorageAccess";
+import { persistTokens } from "../utils/tokens/tokens";
+
+const USER_ID = "@alice:example.com";
+const DEVICE_ID = "ABCDEFG";
+const ACCESS_TOKEN = "stored_access_token";
+
+type Listener = (event: any) => void;
+
+/**
+ * The listeners the service worker registered on the global scope, keyed by event type.
+ *
+ * Everything below the `fetch` handler is module-private, so driving that handler is the only way in. We capture
+ * the registrations rather than dispatching real events so that the `message` exchange with the "tab" can be
+ * answered synchronously.
+ */
+const listeners = new Map<string, Set<Listener>>();
+
+vi.spyOn(global, "addEventListener").mockImplementation(((type: string, listener: Listener) => {
+    if (!listeners.has(type)) listeners.set(type, new Set());
+    listeners.get(type)!.add(listener);
+}) as typeof global.addEventListener);
+
+vi.spyOn(global, "removeEventListener").mockImplementation(((type: string, listener: Listener) => {
+    listeners.get(type)?.delete(listener);
+}) as typeof global.removeEventListener);
+
+// Importing the service worker registers its listeners, via the spies above.
+await import("./index");
+
+function emit(type: string, event: unknown): void {
+    for (const listener of listeners.get(type) ?? []) {
+        listener(event);
+    }
+}
+
+describe("serviceworker media retry after a refreshed access token", () => {
+    let storage: Record<string, Record<string, unknown>>;
+    let homeserver: string;
+    let homeserverCount = 0;
+    /** Answers media requests. `token` is the access token the service worker sent. */
+    let mediaResponse: (token?: string) => Response;
+    let requests: { url: string; token?: string }[];
+    let tabAnswers: boolean;
+
+    const tab = {
+        postMessage: vi.fn(({ responseKey }: { responseKey: string }) => {
+            if (!tabAnswers) return;
+            emit("message", { data: { responseKey, userId: USER_ID, deviceId: DEVICE_ID, homeserver } });
+        }),
+    };
+    const mediaRequests = (): { url: string; token?: string }[] =>
+        requests.filter((r) => !r.url.endsWith("/_matrix/client/versions"));
+    const refreshTokenIn = (ms: number): void => {
+        setTimeout(() => void persistTokens(undefined, { accessToken: "refreshed_access_token" }), ms);
+    };
+
+    beforeEach(async () => {
+        storage = {};
+        tabAnswers = true;
+        tab.postMessage.mockClear();
+        vi.spyOn(StorageAccess, "idbSave").mockImplementation(async (table, key, data) => {
+            storage[table] = { ...storage[table], [String(key)]: data };
+        });
+        vi.spyOn(StorageAccess, "idbLoad").mockImplementation(async (table, key) => storage[table]?.[String(key)]);
+
+        homeserver = `https://hs-${++homeserverCount}.example.com`;
+        requests = [];
+        mediaResponse = (token) =>
+            token === "refreshed_access_token" ? new Response("media") : new Response("", { status: 401 });
+        vi.stubGlobal(
+            "fetch",
+            vi.fn(async (input: URL | string, init?: RequestInit) => {
+                const url = input.toString();
+                const authorization = (init?.headers as Record<string, string> | undefined)?.Authorization;
+                const token = authorization?.replace(/^Bearer /, "");
+                requests.push({ url, token });
+                if (url.endsWith("/_matrix/client/versions"))
+                    return new Response(JSON.stringify({ versions: ["v1.11"] }));
+                return mediaResponse(token);
+            }),
+        );
+        vi.stubGlobal("clients", { get: vi.fn().mockResolvedValue(tab) });
+
+        vi.spyOn(console, "error").mockImplementation(() => {});
+        vi.spyOn(console, "log").mockImplementation(() => {});
+        vi.spyOn(console, "warn").mockImplementation(() => {});
+
+        await persistTokens(undefined, { accessToken: ACCESS_TOKEN });
+    });
+
+    afterEach(() => {
+        vi.unstubAllGlobals();
+    });
+
+    function interceptMediaRequest(): Promise<Response> {
+        let responded: Promise<Response> | undefined;
+        emit("fetch", {
+            request: { method: "GET", url: `${homeserver}/_matrix/media/v3/download/example.com/abc123` },
+            clientId: "client-1",
+            respondWith: (response: Promise<Response>) => {
+                responded = response;
+            },
+        });
+        expect(responded).toBeDefined();
+        return responded!;
+    }
+
+    it("retries once with the refreshed token", async () => {
+        refreshTokenIn(1200);
+        const response = await interceptMediaRequest();
+
+        expect(response.status).toBe(200);
+        expect(mediaRequests().map((r) => r.token)).toEqual([ACCESS_TOKEN, "refreshed_access_token"]);
+        expect(console.log).toHaveBeenCalledWith(
+            "[ServiceWorker] retrying media request with a refreshed access token",
+        );
+    });
+
+    it("keeps the 401 when no new token appears, within the wall-clock bound", async () => {
+        const started = Date.now();
+        const response = await interceptMediaRequest();
+        const elapsed = Date.now() - started;
+
+        expect(response.status).toBe(401);
+        expect(mediaRequests()).toHaveLength(1);
+        expect(elapsed).toBeGreaterThanOrEqual(4900);
+        expect(elapsed).toBeLessThan(6000);
+    }, 10000);
+
+    it("stays within the bound when the tab stops answering, and leaves no listeners behind", async () => {
+        const listenersBefore = listeners.get("message")?.size ?? 0;
+        const responded = interceptMediaRequest();
+        await vi.waitFor(() => expect(mediaRequests()).toHaveLength(1));
+        tabAnswers = false;
+        const started = Date.now();
+        const response = await responded;
+
+        expect(response.status).toBe(401);
+        expect(Date.now() - started).toBeLessThan(6000);
+        // Let the last postMessage timeout fire, then every listener the retry added must be gone.
+        await new Promise((resolve) => setTimeout(resolve, 1100));
+        expect(listeners.get("message")?.size ?? 0).toBe(listenersBefore);
+    }, 15000);
+
+    it("shares one wait between concurrent requests rejected with the same token", async () => {
+        refreshTokenIn(1200);
+        const responses = await Promise.all(Array.from({ length: 20 }, () => interceptMediaRequest()));
+
+        expect(responses.map((r) => r.status)).toEqual(Array(20).fill(200));
+        // 20 initial lookups, then about one per 500 ms poll for the single shared wait, not one per request.
+        expect(tab.postMessage.mock.calls.length).toBeLessThan(20 + 6);
+    }, 10000);
+
+    it("does not retry against a different homeserver", async () => {
+        const original = homeserver;
+        setTimeout(() => {
+            homeserver = "https://other.example.com";
+            void persistTokens(undefined, { accessToken: "refreshed_access_token" });
+        }, 600);
+        let responded: Promise<Response> | undefined;
+        emit("fetch", {
+            request: { method: "GET", url: `${original}/_matrix/media/v3/download/example.com/abc123` },
+            clientId: "client-1",
+            respondWith: (response: Promise<Response>) => {
+                responded = response;
+            },
+        });
+        const response = await responded!;
+
+        expect(response.status).toBe(401);
+        expect(mediaRequests()).toHaveLength(1);
+    }, 10000);
+
+    it("cancels the body of the 401 it discards", async () => {
+        const rejected = new Response(JSON.stringify({ errcode: "M_UNKNOWN_TOKEN" }), { status: 401 });
+        const cancel = vi.spyOn(rejected.body!, "cancel");
+        mediaResponse = (token) => (token === "refreshed_access_token" ? new Response("media") : rejected);
+        refreshTokenIn(300);
+
+        const response = await interceptMediaRequest();
+
+        expect(response.status).toBe(200);
+        expect(cancel).toHaveBeenCalled();
+    });
+});
