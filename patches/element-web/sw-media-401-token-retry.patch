+// How long a media request that got a 401 waits for the app to store a refreshed access token. A wall-clock bound
+// on the whole wait: the sw-boot.js liveness canary (config/element-sw-boot.js, guard E) treats a media fetch that
+// takes 8 s as a wedged service worker, so this must stay well under that.
+const REFRESH_WAIT_MS = 5000;
+const REFRESH_POLL_MS = 500;
+
+// One waiter per rejected token, shared by every media request that got a 401 with it (the same pattern as
+// serverSupportChecks): a room full of thumbnails would otherwise poll the tab once per image.
+const refreshWaiters: { [rejectedToken: string]: Promise<AuthData | undefined> | undefined } = {};
+
+type AuthData = { accessToken: string; homeserver: string };
+
+function waitForRefreshedAuth(client: unknown, rejectedToken: string): Promise<AuthData | undefined> {
+    if (!refreshWaiters[rejectedToken]) {
+        refreshWaiters[rejectedToken] = pollForRefreshedAuth(
+            client,
+            rejectedToken,
+            Date.now() + REFRESH_WAIT_MS,
+        ).finally(() => {
+            refreshWaiters[rejectedToken] = undefined;
+        });
+    }
+    return refreshWaiters[rejectedToken];
+}
+
+// Read the stored credentials until the access token differs from the rejected one, or the deadline passes. Every
+// read is capped by the time left, so a tab that stops answering cannot stretch the wait. Returns undefined when no
+// new token appears (for example the session really is gone): the caller then keeps the 401.
+async function pollForRefreshedAuth(
+    client: unknown,
+    rejectedToken: string,
+    deadline: number,
+): Promise<AuthData | undefined> {
+    for (;;) {
+        const remaining = deadline - Date.now();
+        if (remaining <= 0) return undefined;
+        try {
+            const auth = await withTimeout(getAuthData(client), remaining);
+            if (auth?.accessToken && auth.accessToken !== rejectedToken) return auth;
+        } catch {
+            // Storage mid-update, or the tab went away: keep trying until the deadline.
+        }
+        const pause = Math.min(REFRESH_POLL_MS, deadline - Date.now());
+        if (pause <= 0) return undefined;
+        await new Promise<void>((resolve) => setTimeout(resolve, pause));
+    }
+}
+
+function withTimeout<T>(promise: Promise<T>, ms: number): Promise<T | undefined> {
+    let timeoutId: ReturnType<typeof setTimeout> | undefined;
+    const timeout = new Promise<undefined>((resolve) => {
+        timeoutId = setTimeout(() => resolve(undefined), ms);
+    });
+    return Promise.race([promise, timeout]).finally(() => clearTimeout(timeoutId));
+}
+
+// The retry must go to the same homeserver as the request: if the session changed server meanwhile, keep the 401.
+function isSameOrigin(homeserver: string, url: URL): boolean {
+    try {
+        return new URL(homeserver).origin === url.origin;
+    } catch {
+        return false;
+    }
+}
