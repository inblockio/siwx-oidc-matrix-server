 import "fake-indexeddb/auto";
 
-import { describe, it, expect } from "vitest";
+import { describe, it, expect, vi } from "vitest";
 
 import { idbDelete, idbLoad, idbSave } from "./StorageAccess";
 
@@ -47,4 +47,43 @@ describe("StorageAccess", () => {
         await expect(() => idbLoad(NONEXISTENT_TABLE, "whatever")).rejects.toThrow();
         await expect(() => idbDelete(NONEXISTENT_TABLE, "whatever")).rejects.toThrow();
     });
+
+    // inblock.io sw-idb-reconnect.patch: a cached connection must not outlive a version change or a close.
+    it("lets another context delete the database and reopens it afterwards", async () => {
+        await idbSave("account", "reconnect", "before");
+        await new Promise<void>((resolve, reject) => {
+            const request = indexedDB.deleteDatabase("matrix-react-sdk");
+            request.onsuccess = (): void => resolve();
+            request.onerror = (): void => reject(request.error);
+            request.onblocked = (): void => reject(new Error("blocked: the cached connection ignored versionchange"));
+        });
+        expect(await idbLoad("account", "reconnect")).toBeUndefined();
+        await idbSave("account", "reconnect", "after");
+        expect(await idbLoad("account", "reconnect")).toEqual("after");
+    });
+
+    it("reopens once when the cached connection is closing", async () => {
+        await idbSave("account", "closing", "value");
+        const transaction = vi.spyOn(IDBDatabase.prototype, "transaction").mockImplementationOnce(() => {
+            throw new DOMException("The database connection is closing.", "InvalidStateError");
+        });
+        try {
+            expect(await idbLoad("account", "closing")).toEqual("value");
+            expect(transaction).toHaveBeenCalledTimes(2);
+        } finally {
+            transaction.mockRestore();
+        }
+    });
+
+    it("does not retry an error that is not about the connection", async () => {
+        const transaction = vi.spyOn(IDBDatabase.prototype, "transaction").mockImplementation(() => {
+            throw new DOMException("No such store.", "NotFoundError");
+        });
+        try {
+            await expect(idbLoad("account", "x")).rejects.toThrow("No such store.");
+            expect(transaction).toHaveBeenCalledTimes(1);
+        } finally {
+            transaction.mockRestore();
+        }
+    });
 });
