diff --git a/apps/web/src/hooks/useAttestedDid.ts b/apps/web/src/hooks/useAttestedDid.ts
new file mode 100644
index 0000000..22a15bb
--- /dev/null
+++ b/apps/web/src/hooks/useAttestedDid.ts
@@ -0,0 +1,107 @@
+/**
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+import { useEffect, useState } from "react";
+import { logger as rootLogger } from "matrix-js-sdk/src/logger";
+
+import { useMatrixClientContext } from "../contexts/MatrixClientContext";
+
+const logger = rootLogger.getChild("useAttestedDid");
+
+/**
+ * The MSC4133 profile field an identity provider publishes a user's DID into.
+ *
+ * This literal is one side of a THREE-sided contract — provider
+ * (siwx-oidc `did_assertion::DID_PROFILE_FIELD`), verifier
+ * (`siwx-oidc-auth`), and homeserver (Synapse's
+ * `experimental_features.msc4133_key_denylist`, which is what makes the field
+ * unwritable by its own subject). The three deploy independently and fail
+ * APART: renaming it here alone means every account reads as "no DID".
+ */
+export const DID_PROFILE_FIELD = "io.inblock.did";
+
+export interface AttestedDid {
+    /** The DID exactly as published. Never normalised: `did:key` case is key material. */
+    did: string;
+    /** Whether the provider attached a signature over the DID↔MXID binding. */
+    signed: boolean;
+}
+
+/**
+ * Read the DID published in a user's profile, if there is one.
+ *
+ * Deliberately a plain read with no verification: this is a **discovery hint**,
+ * not an authorization source. The signature is what a relying party checks
+ * offline; what makes the value trustworthy *in this client* is that the
+ * homeserver refuses a write to this field from anyone but the provider. A
+ * client-side ES256 check would need the provider's JWKS and would still prove
+ * only that the provider once said this — so the honest UI move is to show the
+ * value, show whether it is signed, and claim nothing further.
+ *
+ * Every failure — no such field (404), a server without extended profiles, a
+ * malformed value, a network error — yields `undefined`, i.e. the row simply
+ * does not render. This sits in the member-info panel of every user, so it must
+ * never throw and never block.
+ */
+export function useAttestedDid(userId: string | undefined): AttestedDid | undefined {
+    const client = useMatrixClientContext();
+    const [attested, setAttested] = useState<AttestedDid | undefined>();
+
+    useEffect(() => {
+        let cancelled = false;
+        (async (): Promise<void> => {
+            if (!userId) {
+                setAttested(undefined);
+                return;
+            }
+            try {
+                if ((await client.doesServerSupportExtendedProfiles()) === false) {
+                    if (!cancelled) setAttested(undefined);
+                    return;
+                }
+                const raw = await client.getExtendedProfileProperty(userId, DID_PROFILE_FIELD);
+                if (cancelled) return;
+                // The wire contract is an OBJECT, `{did, proof?}`, written as one
+                // atomic PUT. `proof` is absent — not null, not "" — when the
+                // provider's signing key is ephemeral. Anything that does not
+                // match that shape is not ours to render.
+                const did =
+                    typeof raw === "object" && raw !== null && typeof (raw as Record<string, unknown>).did === "string"
+                        ? ((raw as Record<string, unknown>).did as string)
+                        : undefined;
+                if (!did || !did.startsWith("did:")) {
+                    setAttested(undefined);
+                    return;
+                }
+                const proof = (raw as Record<string, unknown>).proof;
+                setAttested({ did, signed: typeof proof === "string" && proof.length > 0 });
+            } catch (ex) {
+                // A user with no published DID is the COMMON case, and it arrives
+                // as a 404. Debug, never warn: this runs for every member panel
+                // opened on every homeserver, most of which publish nothing.
+                logger.debug(`No attested DID for ${userId}`, ex);
+                if (!cancelled) setAttested(undefined);
+            }
+        })();
+        return () => {
+            cancelled = true;
+        };
+    }, [client, userId]);
+
+    return attested;
+}
+
+/**
+ * Shorten a DID for display while keeping both ends, which is where the
+ * distinguishing bytes are: the method prefix identifies the key type, and the
+ * tail is what a human compares when checking one DID against another. The copy
+ * button always copies the WHOLE value.
+ */
+export function abbreviateDid(did: string, head = 18, tail = 6): string {
+    if (did.length <= head + tail + 1) return did;
+    return `${did.slice(0, head)}…${did.slice(-tail)}`;
+}
