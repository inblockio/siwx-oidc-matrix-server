+            }),
+        ]);
+    }
+
+    const msg = (ageMs: number): MatrixEvent =>
+        mkMessage({ event: true, room: roomId, user: "@u:server", ts: Date.now() - ageMs });
+
+    beforeEach(() => {
+        const client = createTestClient();
+        room = new Room(roomId, client, "@me:server");
+        vi.spyOn(client, "getRoom").mockImplementation((id) => (id === roomId ? room : null));
+        vi.spyOn(MatrixClientPeg, "get").mockReturnValue(client);
+        setPolicy({ max_lifetime: DAY });
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    describe("feature on", () => {
+        beforeEach(() => {
+            putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+        });
+
+        it("hides an event older than max_lifetime", () => {
+            expect(shouldHideEvent(msg(2 * DAY))).toBe(true);
+        });
+
+        it("shows an event within max_lifetime", () => {
+            expect(shouldHideEvent(msg(DAY / 2))).toBe(false);
+        });
+
+        it("shows old events when the room has no usable policy", () => {
+            setPolicy({ min_lifetime: 0 });
+            expect(shouldHideEvent(msg(500 * DAY))).toBe(false);
+        });
+
+        it("does not hide an old state event", () => {
+            const topic = mkEvent({
+                event: true,
+                type: "m.room.topic",
+                room: roomId,
+                user: "@u:server",
+                skey: "",
+                content: { topic: "t" },
+                ts: Date.now() - 5 * DAY,
+            });
+            expect(shouldHideEvent(topic)).toBe(false);
+        });
+    });
+
+    describe("key absent (stock behaviour)", () => {
+        it("hides nothing in a room carrying a short max_lifetime", () => {
+            setPolicy({ max_lifetime: 1000 });
+            expect(shouldHideEvent(msg(500 * DAY))).toBe(false);
+            expect(shouldHideEvent(msg(0))).toBe(false);
+        });
+    });
+});
