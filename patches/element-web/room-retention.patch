+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const DAY = 86400000;
+const SLACK_MS = 250;
+const roomId = "!retention:example.com";
+
+describe("RoomNotificationState with room retention", () => {
+    let client: MatrixClient;
+    let room: Room;
+    let state: RoomNotificationState | undefined;
+
+    const message = (id: string, ageMs: number): MatrixEvent =>
+        new MatrixEvent({
+            room_id: roomId,
+            event_id: id,
+            sender: "@other:example.com",
