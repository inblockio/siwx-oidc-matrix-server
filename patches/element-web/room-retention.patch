+
+    function setPolicy(content: object): void {
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: roomId,
+                user: "@admin:example.com",
+                skey: "",
+                content,
+            }),
+        ]);
+    }
+
+    /** Builds the state for a room whose events expire `inMs` after now (oldest first), with a server count of 2. */
+    async function createState(expireInMs: number[]): Promise<RoomNotificationState> {
+        const events = expireInMs.map((inMs, i) => message(`$e${i}`, DAY - inMs));
+        await room.addLiveEvents(events, { addToState: false });
+        room.setUnreadNotificationCount(NotificationCountType.Total, 2);
+        state = new RoomNotificationState(room, false);
+        return state;
+    }
+
+    beforeEach(() => {
+        vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout", "Date"] });
+        client = stubClient();
+        room = new Room(roomId, client, "@me:example.com", { pendingEventOrdering: PendingEventOrdering.Detached });
+        vi.mocked(client.getRoom).mockImplementation((id: string | undefined) => (id === roomId ? room : null));
+        putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+        setPolicy({ max_lifetime: DAY });
+    });
+
+    afterEach(() => {
+        state?.destroy();
+        state = undefined;
+        vi.useRealTimers();
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    it("drops the count at the moment the last unread event expires, without any other event", async () => {
+        const s = await createState([5000, 20000]);
+        const listener = vi.fn();
+        s.addListener(NotificationStateEvents.Update, listener);
+        expect(s.count).toBe(2);
+        expect(s.level).toBe(NotificationLevel.Notification);
+
+        vi.advanceTimersByTime(5000 + SLACK_MS + 50); // the first event is gone, the second is still alive
+        expect(s.count).toBe(2);
+
+        vi.advanceTimersByTime(15000);
+        expect(s.count).toBe(0);
+        expect(s.level).toBe(NotificationLevel.None);
+        expect(listener).toHaveBeenCalled();
+    });
+
+    it("holds at most one timer, and none once the count is gone", async () => {
+        await createState([5000, 20000]);
+        expect(vi.getTimerCount()).toBe(1);
+        vi.advanceTimersByTime(5000 + SLACK_MS + 50);
+        expect(vi.getTimerCount()).toBe(1);
+        vi.advanceTimersByTime(15000);
+        expect(vi.getTimerCount()).toBe(0);
+    });
+
+    it("clears its timer when destroyed", async () => {
+        const s = await createState([5000]);
+        expect(vi.getTimerCount()).toBe(1);
+        s.destroy();
+        expect(vi.getTimerCount()).toBe(0);
+    });
+
+    it("arms no timer when there is nothing to drop", async () => {
+        await room.addLiveEvents([message("$e0", DAY - 5000)], { addToState: false });
+        state = new RoomNotificationState(room, false); // server count 0
+        expect(vi.getTimerCount()).toBe(0);
+    });
+
+    it("arms no timer when the key is absent, and keeps the count", async () => {
+        SdkConfig.reset();
+        const s = await createState([5000]);
+        expect(vi.getTimerCount()).toBe(0);
+        vi.advanceTimersByTime(DAY);
+        expect(s.count).toBe(2);
+    });
+
+    it("arms no timer in a room without a policy, and keeps the count", async () => {
+        room.currentState.setStateEvents([]);
+        setPolicy({});
+        const s = await createState([5000]);
+        expect(vi.getTimerCount()).toBe(0);
+        vi.advanceTimersByTime(DAY);
+        expect(s.count).toBe(2);
+    });
+
+    it("arms no timer when the policy is Off, and keeps the count", async () => {
+        setPolicy({ min_lifetime: 0 });
+        const s = await createState([5000]);
+        expect(vi.getTimerCount()).toBe(0);
+        vi.advanceTimersByTime(DAY);
+        expect(s.count).toBe(2);
+    });
+});
