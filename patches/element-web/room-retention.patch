+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+import React, { type JSX, useEffect, useState } from "react";
+import { type Room } from "matrix-js-sdk/src/matrix";
+import { logger } from "matrix-js-sdk/src/logger";
+
+import { _t } from "../../../../../languageHandler";
+import Modal from "../../../../../Modal";
+import ErrorDialog from "../../../dialogs/ErrorDialog";
+import StyledRadioGroup from "../../../elements/StyledRadioGroup";
+import SettingsFieldset from "../../SettingsFieldset";
+import { Caption } from "../../../typography/Caption";
+import { useMatrixClientContext } from "../../../../../contexts/MatrixClientContext";
+import {
+    ROOM_RETENTION_EVENT_TYPE,
+    getRetentionConfig,
+    getRoomMaxLifetime,
+    labelForLifetime,
+    retentionContentFor,
+} from "../../../../../utils/RoomRetention";
+
+const OFF = "off";
+
+interface Props {
+    room: Room;
+}
+
+/**
+ * Room settings: how long messages stay in the room ("disappearing messages").
+ * Renders nothing when the `io.inblock.room_retention` config key is absent. The owner re-renders it when the room's
+ * retention state changes.
+ */
+export function RoomRetentionSection({ room }: Props): JSX.Element | null {
+    const client = useMatrixClientContext();
+    // The value just chosen, shown until the room state catches up or the change fails.
+    const [pending, setPending] = useState<number | null | undefined>(undefined);
+
+    const cfg = getRetentionConfig();
+    const current = getRoomMaxLifetime(room);
+
+    useEffect(() => {
+        setPending(undefined);
+    }, [current]);
+
+    if (!cfg) return null;
+
+    const shown = pending === undefined ? current : pending;
+    const canChange = room.currentState.mayClientSendStateEvent(ROOM_RETENTION_EVENT_TYPE, client);
+
+    const options: Array<{ value: string; label: string }> = [{ value: OFF, label: labelForLifetime(null, cfg) }];
+    for (const choice of cfg.choices) {
+        if (!options.some((o) => o.value === String(choice.ms))) {
+            options.push({ value: String(choice.ms), label: choice.label });
+        }
+    }
+    // A value set elsewhere that is not in the list stays visible and selected.
+    if (shown !== null && !options.some((o) => o.value === String(shown))) {
+        options.push({ value: String(shown), label: labelForLifetime(shown, cfg) });
+    }
+
+    const onChange = async (value: string): Promise<void> => {
+        if (!canChange) return;
+        const ms = value === OFF ? null : Number(value);
+        setPending(ms);
+        try {
+            await client.sendStateEvent(room.roomId, ROOM_RETENTION_EVENT_TYPE, retentionContentFor(ms), "");
+        } catch (e) {
+            logger.error("Failed to change room retention", e);
+            setPending(undefined);
+            Modal.createDialog(ErrorDialog, {
+                title: _t("common|error"),
+                description: _t("room_retention|update_failed"),
+            });
+        }
+    };
+
+    return (
+        <SettingsFieldset legend={_t("room_retention|legend")}>
+            <StyledRadioGroup
+                name="roomRetention"
+                value={shown === null ? OFF : String(shown)}
+                onChange={onChange}
+                disabled={!canChange}
+                definitions={options}
+            />
+            {!canChange && <Caption>{_t("room_retention|admin_only")}</Caption>}
+        </SettingsFieldset>
+    );
+}
diff --git a/apps/web/src/components/views/settings/tabs/room/SecurityRoomSettingsTab.roomRetention.test.tsx b/apps/web/src/components/views/settings/tabs/room/SecurityRoomSettingsTab.roomRetention.test.tsx
