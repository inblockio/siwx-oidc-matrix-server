+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import React from "react";
+import { vi, describe, it, expect, beforeEach, afterEach } from "vitest";
+import { act, fireEvent, render, screen, waitFor, within } from "test-utils-rtl";
+import { clearAllModals, flushPromises, stubClient } from "test-utils";
+import { EventType, JoinRule, MatrixEvent, Room, RoomStateEvent } from "matrix-js-sdk/src/matrix";
+import { KnownMembership, type RoomPowerLevelsEventContent } from "matrix-js-sdk/src/types";
+
+import SecurityRoomSettingsTab from "./SecurityRoomSettingsTab";
+import MatrixClientContext from "../../../../../contexts/MatrixClientContext";
+import SettingsStore from "../../../../../settings/SettingsStore";
+import SdkConfig from "../../../../../SdkConfig";
+
+const RETENTION = "m.room.retention";
+const PROD_CHOICES = [
+    { ms: 86400000, label: "1 day" },
+    { ms: 604800000, label: "7 days" },
+    { ms: 1209600000, label: "2 weeks" },
+    { ms: 2419200000, label: "4 weeks" },
+    { ms: 3628800000, label: "6 weeks" },
+    { ms: 7776000000, label: "3 months" },
+];
+
+describe("<SecurityRoomSettingsTab /> room retention picker", () => {
+    const client = vi.mocked(stubClient());
+    const userId = client.credentials.userId!; // the power level checks use the client's own user id
+    const roomId = "!room:server.org";
+
+    const enableFeature = (choices: Array<{ ms: number; label: string }> = PROD_CHOICES): void => {
+        SdkConfig.put({ "io.inblock.room_retention": { choices } } as Parameters<typeof SdkConfig.put>[0]);
+    };
+
+    const getComponent = (room: Room) =>
+        render(<SecurityRoomSettingsTab room={room} closeSettingsFn={vi.fn()} />, {
+            wrapper: ({ children }) => (
+                <MatrixClientContext.Provider value={client}>{children}</MatrixClientContext.Provider>
+            ),
+        });
+
+    const stateEvent = (type: string, content: object, sender = userId): MatrixEvent =>
+        new MatrixEvent({ type, content, sender, state_key: "", room_id: roomId });
+
+    const makeRoom = (retention?: object, powerLevels?: Partial<RoomPowerLevelsEventContent>): Room => {
+        const room = new Room(roomId, client, userId);
+        const events = [
+            stateEvent(EventType.RoomCreate, { version: "test" }),
+            stateEvent(EventType.RoomJoinRules, { join_rule: JoinRule.Invite }),
+        ];
+        if (retention) events.push(stateEvent(RETENTION, retention));
+        if (powerLevels) {
+            // the room needs our member for the power level to count
+            events.push(
+                new MatrixEvent({
+                    type: EventType.RoomMember,
+                    content: { membership: KnownMembership.Join },
+                    sender: userId,
+                    state_key: userId,
+                    room_id: roomId,
+                }),
+                stateEvent(EventType.RoomPowerLevels, powerLevels),
+            );
+        }
+        room.currentState.setStateEvents(events);
+        return room;
+    };
+
+    const section = (): HTMLElement => screen.getByRole("group", { name: "Disappearing messages" });
+    const optionLabels = (): string[] =>
+        within(section())
+            .getAllByRole("radio")
+            .map((r) => r.closest("label")?.textContent ?? "");
+    const selected = (): string[] =>
+        within(section())
+            .getAllByRole("radio")
+            .filter((r) => (r as HTMLInputElement).checked)
+            .map((r) => r.closest("label")?.textContent ?? "");
+
+    beforeEach(async () => {
+        client.sendStateEvent.mockReset().mockResolvedValue({ event_id: "test" });
+        vi.spyOn(client.getCrypto()!, "isEncryptionEnabledInRoom").mockResolvedValue(false);
+        client.getClientWellKnown.mockReturnValue(undefined);
+        vi.spyOn(SettingsStore, "getValue").mockRestore();
+        await clearAllModals();
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+    });
+
+    describe("key absent", () => {
+        it("shows no Disappearing messages section, also for a room that carries a retention policy", async () => {
+            const room = makeRoom({ max_lifetime: 120000 });
+            getComponent(room);
+            await flushPromises();
+
+            expect(screen.getByText("Who can read history?")).toBeInTheDocument(); // the tab did render
+            expect(screen.queryByText("Disappearing messages")).not.toBeInTheDocument();
+            expect(screen.queryByRole("group", { name: "Disappearing messages" })).not.toBeInTheDocument();
+        });
+    });
+
+    describe("options", () => {
+        it("offers Off and the configured choices in config order", async () => {
+            enableFeature();
+            getComponent(makeRoom());
+            await flushPromises();
+
+            expect(optionLabels()).toEqual(["Off", "1 day", "7 days", "2 weeks", "4 weeks", "6 weeks", "3 months"]);
+            expect(selected()).toEqual(["Off"]);
+        });
+
+        it("keeps the order of an unsorted config", async () => {
+            enableFeature([
+                { ms: 604800000, label: "A week" },
+                { ms: 3600000, label: "An hour" },
+            ]);
+            getComponent(makeRoom());
+            await flushPromises();
+
+            expect(optionLabels()).toEqual(["Off", "A week", "An hour"]);
+        });
+
+        it.each([
+            ["an empty content", {}],
+            ["a null max_lifetime", { max_lifetime: null }],
+            ["a min_lifetime of 0 only", { min_lifetime: 0 }],
+        ])("shows Off selected for %s", async (_name, content) => {
+            enableFeature();
+            getComponent(makeRoom(content));
+            await flushPromises();
+
+            expect(selected()).toEqual(["Off"]);
+            expect(optionLabels()).toHaveLength(7);
+        });
+
+        it("shows the label of a matching choice as selected", async () => {
+            enableFeature();
+            getComponent(makeRoom({ max_lifetime: 1209600000 }));
+            await flushPromises();
+
+            expect(selected()).toEqual(["2 weeks"]);
+            expect(optionLabels()).toEqual(["Off", "1 day", "7 days", "2 weeks", "4 weeks", "6 weeks", "3 months"]);
+        });
+
+        it("adds one custom option, selected, for a value outside the list", async () => {
+            enableFeature();
+            getComponent(makeRoom({ max_lifetime: 120000 }));
+            await flushPromises();
+
+            const labels = optionLabels();
+            expect(labels).toHaveLength(8);
+            expect(labels.slice(0, 7)).toEqual(["Off", "1 day", "7 days", "2 weeks", "4 weeks", "6 weeks", "3 months"]);
+            expect(labels[7]).toBe("Custom (2m)");
+            expect(selected()).toEqual(["Custom (2m)"]);
+        });
+    });
+
+    describe("changing the value", () => {
+        it.each(PROD_CHOICES)("sends the exact max_lifetime for $label", async ({ ms, label }) => {
+            enableFeature();
+            const room = makeRoom();
+            getComponent(room);
+            await flushPromises();
+
+            fireEvent.click(within(section()).getByLabelText(label));
+            await flushPromises();
+
+            expect(client.sendStateEvent).toHaveBeenCalledTimes(1);
+            expect(client.sendStateEvent).toHaveBeenCalledWith(roomId, RETENTION, { max_lifetime: ms }, "");
+        });
+
+        it("sends exactly { min_lifetime: 0 } for Off", async () => {
+            enableFeature();
+            getComponent(makeRoom({ max_lifetime: 604800000 }));
+            await flushPromises();
+            expect(selected()).toEqual(["7 days"]);
+
+            fireEvent.click(within(section()).getByLabelText("Off"));
+            await flushPromises();
+
+            expect(client.sendStateEvent).toHaveBeenCalledTimes(1);
+            expect(client.sendStateEvent).toHaveBeenCalledWith(roomId, RETENTION, { min_lifetime: 0 }, "");
+            expect(vi.mocked(client.sendStateEvent).mock.calls[0][2]).toStrictEqual({ min_lifetime: 0 });
+        });
+
+        it("shows the chosen value while the change is on its way", async () => {
+            enableFeature();
+            getComponent(makeRoom());
+            await flushPromises();
+
+            fireEvent.click(within(section()).getByLabelText("4 weeks"));
+            await flushPromises();
+
+            expect(selected()).toEqual(["4 weeks"]);
+        });
+
+        it("rolls the selection back and shows a translated error when the send fails", async () => {
+            enableFeature();
+            client.sendStateEvent.mockRejectedValue(new Error("M_FORBIDDEN: nope"));
+            getComponent(makeRoom({ max_lifetime: 604800000 }));
+            await flushPromises();
+
+            fireEvent.click(within(section()).getByLabelText("1 day"));
+
+            const dialog = await screen.findByRole("dialog");
+            expect(dialog).toHaveTextContent("Failed to change disappearing messages");
+            expect(dialog.textContent).not.toContain("M_FORBIDDEN");
+            expect(dialog.textContent).not.toContain("nope");
+            expect(selected()).toEqual(["7 days"]);
+        });
+    });
+
+    describe("permissions", () => {
+        const noRight: Partial<RoomPowerLevelsEventContent> = {
+            users: { [userId]: 50 },
+            state_default: 50,
+            events: { [RETENTION]: 100 },
+        };
+
+        it("is disabled for a user below the power level, shows the value and the admin-only hint", async () => {
+            enableFeature();
+            getComponent(makeRoom({ max_lifetime: 1209600000 }, noRight));
+            await flushPromises();
+
+            const radios = within(section()).getAllByRole("radio");
+            expect(radios.length).toBe(7);
+            for (const r of radios) expect(r).toBeDisabled();
+            expect(selected()).toEqual(["2 weeks"]);
+            expect(screen.getByText("Only room admins can change this.")).toBeInTheDocument();
+
+            fireEvent.click(within(section()).getByLabelText("1 day"));
+            await flushPromises();
+            expect(client.sendStateEvent).not.toHaveBeenCalled();
+            expect(selected()).toEqual(["2 weeks"]);
+        });
+
+        it("is enabled without the hint for a user who may send the event", async () => {
+            enableFeature();
+            getComponent(makeRoom({ max_lifetime: 1209600000 }, { users: { [userId]: 100 }, state_default: 50 }));
+            await flushPromises();
+
+            for (const r of within(section()).getAllByRole("radio")) expect(r).toBeEnabled();
+            expect(screen.queryByText("Only room admins can change this.")).not.toBeInTheDocument();
+        });
+    });
+
+    describe("room state", () => {
+        it("updates the shown value when a retention event arrives from another client", async () => {
+            enableFeature();
+            const room = makeRoom({ max_lifetime: 604800000 });
+            getComponent(room);
+            await flushPromises();
+            expect(selected()).toEqual(["7 days"]);
+
+            const incoming = stateEvent(RETENTION, { max_lifetime: 2419200000 }, "@bob:server.org");
+            act(() => {
+                room.currentState.setStateEvents([incoming]);
+                client.emit(RoomStateEvent.Events, incoming, room.currentState, null);
+            });
+
+            await waitFor(() => expect(selected()).toEqual(["4 weeks"]));
+        });
+    });
+});
