+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { describe, it, expect, afterEach, beforeAll } from "vitest";
+import { MatrixEvent, type MatrixClient } from "matrix-js-sdk/src/matrix";
+import { createTestClient } from "test-utils";
+
+import { hasText, textForEvent } from "./TextForEvent";
+import SdkConfig from "./SdkConfig";
+
+const PROD_CHOICES = [
+    { ms: 86400000, label: "1 day" },
+    { ms: 604800000, label: "7 days" },
+    { ms: 1209600000, label: "2 weeks" },
+    { ms: 2419200000, label: "4 weeks" },
+    { ms: 3628800000, label: "6 weeks" },
+    { ms: 7776000000, label: "3 months" },
+];
+
+const retentionEvent = (content: object, prevContent?: object, sender = "@alice:example.com"): MatrixEvent =>
+    new MatrixEvent({
+        type: "m.room.retention",
+        state_key: "",
+        sender,
+        room_id: "!room:example.com",
+        content,
+        unsigned: prevContent ? { prev_content: prevContent } : {},
+    });
+
+describe("textForEvent for m.room.retention", () => {
+    let client: MatrixClient;
+
+    beforeAll(() => {
+        client = createTestClient();
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+    });
+
+    const enableFeature = (): void => {
+        SdkConfig.put({ "io.inblock.room_retention": { choices: PROD_CHOICES } } as Parameters<
+            typeof SdkConfig.put
+        >[0]);
+    };
+
+    describe("key absent (stock behaviour)", () => {
+        it("gives no text for a retention event", () => {
+            const ev = retentionEvent({ max_lifetime: 120000 });
+            expect(textForEvent(ev, client)).toBe("");
+            expect(textForEvent(ev, client, true)).toBe("");
+            expect(hasText(ev, client)).toBe(false);
+        });
+
+        it("gives no text for an Off event either", () => {
+            const ev = retentionEvent({ min_lifetime: 0 }, { max_lifetime: 86400000 });
+            expect(textForEvent(ev, client)).toBe("");
+            expect(hasText(ev, client)).toBe(false);
+        });
+    });
+
+    describe("feature on", () => {
+        it("names the sender and the configured label", () => {
+            enableFeature();
+            const ev = retentionEvent({ max_lifetime: 86400000 });
+            expect(textForEvent(ev, client)).toBe(
+                "@alice:example.com set messages in this room to disappear after 1 day.",
+            );
+            expect(hasText(ev, client)).toBe(true);
+        });
+
+        it("uses the label of a matching choice, whoever wrote it", () => {
+            enableFeature();
+            const ev = retentionEvent({ max_lifetime: 1209600000 }, { max_lifetime: 86400000 }, "@bob:example.com");
+            expect(textForEvent(ev, client)).toBe(
+                "@bob:example.com set messages in this room to disappear after 2 weeks.",
+            );
+        });
+
+        it("names a custom value", () => {
+            enableFeature();
+            const ev = retentionEvent({ max_lifetime: 120000 });
+            expect(textForEvent(ev, client)).toBe(
+                "@alice:example.com set messages in this room to disappear after Custom (2m).",
+            );
+        });
+
+        it("uses the Off wording for { min_lifetime: 0 } after a value", () => {
+            enableFeature();
+            const ev = retentionEvent({ min_lifetime: 0 }, { max_lifetime: 86400000 });
+            expect(textForEvent(ev, client)).toBe("@alice:example.com turned off disappearing messages.");
+            expect(hasText(ev, client)).toBe(true);
+        });
+
+        it("uses the Off wording for an empty content after a value", () => {
+            enableFeature();
+            const ev = retentionEvent({}, { max_lifetime: 604800000 });
+            expect(textForEvent(ev, client)).toBe("@alice:example.com turned off disappearing messages.");
+        });
+
+        it("gives no text when the value equals the previous one", () => {
+            enableFeature();
+            const ev = retentionEvent({ max_lifetime: 86400000 }, { max_lifetime: 86400000 });
+            expect(textForEvent(ev, client)).toBe("");
+            expect(hasText(ev, client)).toBe(false);
+        });
+
+        it("gives no text when Off follows Off (also in another spelling)", () => {
+            enableFeature();
+            const ev = retentionEvent({ min_lifetime: 0 }, {});
+            expect(textForEvent(ev, client)).toBe("");
+            expect(hasText(ev, client)).toBe(false);
+        });
+    });
+});
