+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+Room retention ("disappearing messages"): client-side rules for `m.room.retention`.
+Every code path that uses this module starts with the "feature on?" check; with the
+`io.inblock.room_retention` config key absent the client behaves as stock Element.
+*/
+
+import { type MatrixEvent, type Room } from "matrix-js-sdk/src/matrix";
+
+import SdkConfig from "../SdkConfig";
+import { MatrixClientPeg } from "../MatrixClientPeg";
+import { _t } from "../languageHandler";
+import { formatDuration } from "../DateUtils";
+
+export const ROOM_RETENTION_CONFIG_KEY = "io.inblock.room_retention";
+export const ROOM_RETENTION_EVENT_TYPE = "m.room.retention";
+
+export interface RetentionChoice {
+    ms: number;
+    label: string;
+}
+
+export interface RetentionConfig {
+    choices: RetentionChoice[];
+}
+
+function isPlainObject(value: unknown): value is Record<string, unknown> {
+    return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+function isPositiveInteger(value: unknown): value is number {
+    return typeof value === "number" && Number.isInteger(value) && value > 0;
+}
+
+/**
+ * Parse the `io.inblock.room_retention` value out of a config object.
+ * @returns null when the feature is off (key absent, null, a string, an array, ...).
+ */
+export function retentionConfigFrom(config: unknown): RetentionConfig | null {
+    const section = isPlainObject(config) ? config[ROOM_RETENTION_CONFIG_KEY] : undefined;
+    if (!isPlainObject(section)) return null;
+
+    const choices: RetentionChoice[] = [];
+    if (Array.isArray(section["choices"])) {
+        for (const entry of section["choices"] as unknown[]) {
+            if (!isPlainObject(entry)) continue;
+            const { ms, label } = entry;
+            if (isPositiveInteger(ms) && typeof label === "string" && label !== "") {
+                choices.push({ ms, label });
+            }
+        }
+    }
+    return { choices };
+}
+
+export function getRetentionConfig(): RetentionConfig | null {
+    return retentionConfigFrom(SdkConfig.get());
+}
+
+export function isRetentionEnabled(): boolean {
+    return getRetentionConfig() !== null;
+}
+
+/** The `max_lifetime` of an `m.room.retention` content, or null (= Off) when it has no usable one. */
+export function maxLifetimeFromContent(content: unknown): number | null {
+    if (!isPlainObject(content)) return null;
+    const value = content["max_lifetime"];
+    return isPositiveInteger(value) ? value : null;
+}
+
+/** The room's current `max_lifetime` (state key ""), or null when the room has no policy. */
+export function getRoomMaxLifetime(room: Room | null | undefined): number | null {
+    if (!room) return null;
+    try {
+        const ev = room.currentState.getStateEvents(ROOM_RETENTION_EVENT_TYPE, "");
+        return ev ? maxLifetimeFromContent(ev.getContent()) : null;
+    } catch {
+        return null;
+    }
+}
+
+/** The content to send for a choice; null = Off, written as `min_lifetime: 0` (a running Synapse ignores `{}`). */
+export function retentionContentFor(ms: number | null): { max_lifetime: number } | { min_lifetime: 0 } {
+    if (ms === null || !isPositiveInteger(ms)) return { min_lifetime: 0 };
+    return { max_lifetime: ms };
+}
+
+const UNITS_MS = [86400000, 3600000, 60000, 1000];
+
+/** The label for a lifetime: Off, the configured label of a matching choice, or a custom one. */
+export function labelForLifetime(ms: number | null, cfg: RetentionConfig): string {
+    if (ms === null) return _t("common|off");
+    const choice = cfg.choices.find((c) => c.ms === ms);
+    if (choice) return choice.label;
+    // formatDuration rounds to its largest unit; only use it when the value is exact in that unit
+    const unit = UNITS_MS.find((u) => ms >= u);
+    const duration = unit !== undefined && ms % unit === 0 ? formatDuration(ms) : `${ms} ms`;
+    return _t("room_retention|custom", { duration });
+}
+
+/**
+ * Whether the event is past its room's `max_lifetime`. Never throws.
+ * False when the feature is off, for state events, local echoes, unknown rooms and rooms without a policy.
+ */
+export function isEventExpired(ev: MatrixEvent, now: number = Date.now()): boolean {
+    try {
+        if (!isRetentionEnabled()) return false;
+        if (ev.isState()) return false;
+        if (ev.isSending()) return false;
+        const roomId = ev.getRoomId();
+        if (!roomId) return false;
+        const ts = ev.getTs();
+        if (typeof ts !== "number" || !Number.isFinite(ts) || ts <= 0) return false;
+        const room = MatrixClientPeg.get()?.getRoom(roomId);
+        const max = getRoomMaxLifetime(room);
+        if (max === null) return false;
+        return now - ts > max;
+    } catch {
+        return false;
+    }
+}
+
+/**
+ * Milliseconds until the earliest not-yet-expired event in `events` expires (never below 0, so the event is
+ * expired just after the delay), or null when the feature is off, the room has no policy or nothing is left to
+ * expire. Callers cap a `setTimeout` at 2^31-1 ms.
+ */
+export function nextExpiryDelay(
+    events: MatrixEvent[],
+    room: Room | null | undefined,
+    now: number = Date.now(),
+): number | null {
+    try {
+        if (!isRetentionEnabled()) return null;
+        const max = getRoomMaxLifetime(room);
+        if (max === null) return null;
+        let next: number | null = null;
+        for (const ev of events) {
+            if (ev.isState() || ev.isSending()) continue;
+            const ts = ev.getTs();
+            if (typeof ts !== "number" || !Number.isFinite(ts) || ts <= 0) continue;
+            const remaining = ts + max - now;
+            if (remaining < 0) continue; // already expired
+            if (next === null || remaining < next) next = remaining;
+        }
+        return next;
+    } catch {
+        return null;
+    }
+}
+
+const tickListeners = new Set<() => void>();
+
+/**
+ * Subscribes to the expiry tick: the one timer of a MessagePanel calls `emitRetentionTick` when an event of the
+ * panel expires, so a component that does not re-render with the panel (a reply quote) can look again without a
+ * timer of its own. Returns the unsubscribe function.
+ */
+export function onRetentionTick(listener: () => void): () => void {
+    tickListeners.add(listener);
+    return () => {
+        tickListeners.delete(listener);
+    };
+}
+
+/** Called by the expiry timer of a MessagePanel after it has re-rendered; every listener sees the new time. */
+export function emitRetentionTick(): void {
+    for (const listener of tickListeners) {
+        try {
+            listener();
+        } catch {
+            // one failing listener must not stop the others
+        }
+    }
+}
