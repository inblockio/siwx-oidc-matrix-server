+    });
+
+    it("sends the receipt for an old event when the policy is Off, as stock", async () => {
+        setPolicy({ min_lifetime: 0 });
+        const ev = message("$old", 3 * DAY);
+        await readTimeline(ev);
+        expect(client.sendReadReceipt).toHaveBeenCalledWith(ev, ReceiptType.Read);
+    });
+});
