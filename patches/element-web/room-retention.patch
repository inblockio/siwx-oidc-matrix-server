+
+// @vitest-environment happy-dom
+
+import { vi, describe, beforeEach, afterEach, it, expect } from "vitest";
+
+import { createClientWithCreds } from "./createMatrixClient";
+import SettingsStore from "../settings/SettingsStore";
+import SdkConfig from "../SdkConfig";
+import { ROOM_RETENTION_CONFIG_KEY } from "./RoomRetention";
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+describe("createMatrixClient: SDK retention and the room retention feature", () => {
+    function create(labsRetention: boolean): boolean {
+        vi.spyOn(SettingsStore, "getValue").mockImplementation((name) => name === "feature_retention" && labsRetention);
+        const client = createClientWithCreds({
+            homeserverUrl: "https://test.dummy",
+            userId: "@user:test.dummy",
+            accessToken: "access_token",
+        });
+        return client._unstable_shouldApplyMessageRetention;
+    }
+
+    beforeEach(() => {
+        vi.stubGlobal("localStorage", {
+            getItem: vi.fn().mockReturnValue(null),
+            setItem: vi.fn(),
+            removeItem: vi.fn(),
+        });
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+        vi.unstubAllGlobals();
+    });
+
+    describe("key absent (stock behaviour)", () => {
+        it("passes the labs setting through when it is on", () => {
+            expect(create(true)).toBe(true);
+        });
+
+        it("passes the labs setting through when it is off", () => {
+            expect(create(false)).toBe(false);
+        });
+    });
+
+    describe("key present", () => {
+        beforeEach(() => {
+            putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+        });
+
+        it("forces the SDK retention off even when the labs setting is on", () => {
+            expect(create(true)).toBe(false);
+        });
+
+        it("keeps it off when the labs setting is off", () => {
+            expect(create(false)).toBe(false);
+        });
+    });
+});
