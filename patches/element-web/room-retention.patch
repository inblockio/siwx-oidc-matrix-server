+import { useFetchedPinnedEvents } from "./usePinnedEvents";
+import MatrixClientContext from "../contexts/MatrixClientContext";
+import SdkConfig from "../SdkConfig";
+import { MatrixClientPeg } from "../MatrixClientPeg";
+import { ROOM_RETENTION_CONFIG_KEY, ROOM_RETENTION_EVENT_TYPE } from "../utils/RoomRetention";
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const DAY = 86400000;
+
+describe("useFetchedPinnedEvents and room retention", () => {
+    const roomId = "!room:server";
+    const userId = "@alice:server";
+    const oldId = "$old:server";
+    const freshId = "$fresh:server";
+    // Stable identity: the hook memoises on this array.
+    const pinnedIds = [oldId, freshId];
+
+    let client: MatrixClient;
+    let room: Room;
+    let fetched: Record<string, MatrixEvent>;
+
+    const makeEvent = (id: string, ageMs: number): MatrixEvent =>
+        new MatrixEvent({
+            type: EventType.RoomMessage,
+            sender: userId,
+            room_id: roomId,
+            event_id: id,
+            origin_server_ts: Date.now() - ageMs,
+            content: { msgtype: "m.text", body: id },
+        });
+
+    const wrapper = ({ children }: PropsWithChildren): React.JSX.Element => (
+        <MatrixClientContext.Provider value={client}>{children}</MatrixClientContext.Provider>
+    );
+
+    const ids = (events: MatrixEvent[]): (string | undefined)[] => events.map((e) => e.getId()).sort();
+
+    beforeEach(() => {
+        client = stubClient();
+        room = new Room(roomId, client, userId);
+        vi.spyOn(client, "getRoom").mockReturnValue(room);
+        vi.spyOn(MatrixClientPeg, "get").mockReturnValue(client);
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: roomId,
+                user: "@admin:server",
+                skey: "",
+                content: { max_lifetime: DAY },
+            }),
+        ]);
+        fetched = {
+            [oldId]: makeEvent(oldId, 3 * DAY),
+            [freshId]: makeEvent(freshId, DAY / 2),
+        };
+        vi.spyOn(client, "fetchRoomEvent").mockImplementation(
+            async (_room: string, id: string) => fetched[id].event as never,
+        );
+        vi.spyOn(client, "relations").mockResolvedValue({ events: [] });
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    it("does not return an expired pinned event, and keeps a fresh one in the same room", async () => {
+        putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+        const { result } = renderHook(() => useFetchedPinnedEvents(room, pinnedIds), { wrapper });
+        await waitFor(() => expect(result.current).toHaveLength(1));
+        expect(ids(result.current)).toEqual([freshId]);
+    });
+
+    it("returns every pinned event when the config key is absent (stock behaviour)", async () => {
+        const { result } = renderHook(() => useFetchedPinnedEvents(room, pinnedIds), { wrapper });
+        await waitFor(() => expect(result.current).toHaveLength(2));
+        expect(ids(result.current)).toEqual([freshId, oldId]);
+    });
+    // I2: the banner and the pinned messages card keep the room open across the expiry
+    describe("when a pinned event expires while the hook is mounted", () => {
+        const SLACK_MS = 250;
+        beforeEach(() => {
+            fetched[oldId] = makeEvent(oldId, DAY - 10000);
+            vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout", "Date"] });
+        });
+        afterEach(() => {
+            vi.useRealTimers();
+        });
+
+        it("drops the pinned event when its time passes, without a reload, and keeps the fresh one", async () => {
+            putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+            const { result } = renderHook(() => useFetchedPinnedEvents(room, pinnedIds), { wrapper });
+            await vi.waitFor(() => expect(result.current).toHaveLength(2));
+
+            await act(async () => {
+                await vi.advanceTimersByTimeAsync(10000 + SLACK_MS + 50);
+            });
+            expect(ids(result.current)).toEqual([freshId]);
+        });
+
+        it("arms one timer, and none once nothing is left to expire", async () => {
+            putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+            const { result, unmount } = renderHook(() => useFetchedPinnedEvents(room, pinnedIds), { wrapper });
+            await vi.waitFor(() => expect(result.current).toHaveLength(2));
+            expect(vi.getTimerCount()).toBe(1);
+            await act(async () => {
+                await vi.advanceTimersByTimeAsync(10000 + SLACK_MS + 50);
+            });
+            expect(vi.getTimerCount()).toBe(1); // re-armed for the fresh one
+            unmount();
+            expect(vi.getTimerCount()).toBe(0);
+        });
+
+        it("arms no timer and keeps the event when the config key is absent", async () => {
+            const { result } = renderHook(() => useFetchedPinnedEvents(room, pinnedIds), { wrapper });
+            await vi.waitFor(() => expect(result.current).toHaveLength(2));
+            expect(vi.getTimerCount()).toBe(0);
+            await act(async () => {
+                await vi.advanceTimersByTimeAsync(20000);
+            });
+            expect(ids(result.current)).toEqual([freshId, oldId]);
+        });
+    });
+});
