+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { EventEmitter } from "node:events";
+import {
+    EventType,
+    type MatrixClient,
+    type MatrixEvent,
+    MsgType,
+    type Room,
+    type Thread,
+} from "matrix-js-sdk/src/matrix";
+import { waitFor } from "test-utils-rtl";
+import { vi, describe, it, expect, afterEach } from "vitest";
+import { mkEvent } from "test-utils";
+
+import { TimelineRenderingType } from "../../../../contexts/RoomContext";
+import { ThreadMessagePreviewViewModel } from "./ThreadSummaryViewModel";
+import SdkConfig from "../../../../SdkConfig";
+import { MatrixClientPeg } from "../../../../MatrixClientPeg";
+import { ROOM_RETENTION_CONFIG_KEY, ROOM_RETENTION_EVENT_TYPE } from "../../../../utils/RoomRetention";
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+vi.mock("../../../../dispatcher/dispatcher", () => ({
+    __esModule: true,
+    default: { dispatch: vi.fn(), register: vi.fn(), unregister: vi.fn() },
+}));
+
+const DAY = 86400000;
+const roomId = "!room:example.org";
+const userId = "@alice:example.org";
+
+/** A thread whose last reply was sent `ageMs` ago, in a room whose policy is `max_lifetime: DAY`. */
+function makePreviewVm(ageMs: number): ThreadMessagePreviewViewModel {
+    const retention = mkEvent({
+        event: true,
+        type: ROOM_RETENTION_EVENT_TYPE,
+        room: roomId,
+        user: "@admin:server",
+        skey: "",
+        content: { max_lifetime: DAY },
+    });
+    const room = new EventEmitter() as unknown as Room;
+    Object.assign(room, {
+        roomId,
+        getMember: vi.fn(),
+        client: new EventEmitter(),
+        currentState: {
+            getStateEvents: vi.fn((type: string) => (type === ROOM_RETENTION_EVENT_TYPE ? retention : null)),
+        },
+    });
+    vi.spyOn(MatrixClientPeg, "get").mockReturnValue({ getRoom: () => room } as unknown as MatrixClient);
+
+    const lastReply: MatrixEvent = mkEvent({
+        event: true,
+        id: "$lastreply",
+        type: EventType.RoomMessage,
+        room: roomId,
+        user: userId,
+        ts: Date.now() - ageMs,
+        content: { msgtype: MsgType.Text, body: "The last reply" },
+    });
+    const thread = Object.assign(new EventEmitter(), { id: "$root", length: 2, room, replyToEvent: lastReply });
+
+    return new ThreadMessagePreviewViewModel({
+        cli: { decryptEventIfNeeded: vi.fn().mockResolvedValue(undefined) } as unknown as MatrixClient,
+        thread: thread as unknown as Thread,
+        room,
+        timelineRenderingType: TimelineRenderingType.Room,
+        lowBandwidth: false,
+        useOnlyCurrentProfiles: false,
+        showDisplayName: false,
+    });
+}
+
+describe("ThreadMessagePreviewViewModel and room retention", () => {
+    afterEach(() => {
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    describe("feature on", () => {
+        it("does not show the text of an expired last reply", async () => {
+            putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+            const vm = makePreviewVm(3 * DAY);
+            await new Promise((resolve) => setTimeout(resolve, 20));
+            expect(vm.getSnapshot().isVisible).toBe(false);
+            expect(vm.getSnapshot().previewContent).toBeUndefined();
+        });
+
+        it("shows the text of a last reply that is still within max_lifetime", async () => {
+            putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+            const vm = makePreviewVm(DAY / 2);
+            await waitFor(() => expect(vm.getSnapshot().isVisible).toBe(true));
+            expect(vm.getSnapshot().previewContent).toBe("The last reply");
+        });
+    });
+
+    describe("key absent (stock behaviour)", () => {
+        it("shows the text of an old last reply in a room carrying a short max_lifetime", async () => {
+            const vm = makePreviewVm(100 * DAY);
+            await waitFor(() => expect(vm.getSnapshot().isVisible).toBe(true));
+            expect(vm.getSnapshot().previewContent).toBe("The last reply");
+        });
+    });
+});
