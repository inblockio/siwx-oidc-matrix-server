+/**
+ * Room retention: true when the server's count for the main timeline of this room can only be made of expired
+ * events. Synapse keeps counting them and refuses a read receipt for them, so the count would stick for good.
+ * Safe direction only: false when the feature is off, the room has no policy, the loaded timeline is empty, an
+ * unread event that is still alive is loaded, or nothing says the count is made of expired events. Reaching the read
+ * position proves it only when at least one expired event lies after it: with none, the unread events are alive or
+ * older than the read position, so the server's count stays. Any alive event of someone else that is not a state
+ * event blocks the suppression (the server may count it although Element draws nothing for it, for example a
+ * redacted message). The policy's own notice (a state event, never expires, drawn but never counted), reactions and
+ * edits do not.
+ */
+/** Alive events that the server's default push rules never count: the policy notice, reactions and edits. */
+function isNeverCounted(ev: MatrixEvent): boolean {
+    if (ev.isState()) return ev.getType() === ROOM_RETENTION_EVENT_TYPE;
+    return ev.getType() === EventType.Reaction || ev.isRelation(RelationType.Replace);
+}
+
+function isUnreadCountOnlyExpired(room: Room): boolean {
+    if (!isRetentionEnabled() || getRoomMaxLifetime(room) === null) return false;
+    const events = room.getLiveTimeline().getEvents();
+    let sawExpired = false;
+    // newest first, up to the read position
+    for (let i = events.length - 1; i >= 0; i--) {
+        const ev = events[i];
+        const id = ev.getId();
+        if (id && room.hasUserReadEvent(room.myUserId, id)) return sawExpired;
+        if (isEventExpired(ev)) sawExpired = true;
+        else if (isNeverCounted(ev)) continue;
+        else if (!ev.isState() && ev.getSender() !== room.myUserId) return false; // the server may count it, even if Element draws nothing
+        else if (eventTriggersUnreadCount(room.client, ev)) return false;
+    }
+    // Events that are not loaded are older than the oldest loaded one, so they are expired when that one is.
+    return sawExpired;
+}
