+
+// @vitest-environment happy-dom
+
+import { vi, describe, it, expect, beforeEach, afterEach, type Mocked } from "vitest";
+import {
+    EventType,
+    MatrixEvent,
+    NotificationCountType,
+    PendingEventOrdering,
+    ReceiptType,
+    Room,
+    type MatrixClient,
+} from "matrix-js-sdk/src/matrix";
+import { mkEvent, stubClient } from "test-utils";
+import { createMessageEventContent } from "test-utils/events";
+
+import { determineUnreadState } from "./RoomNotifs";
+import { NotificationLevel } from "./stores/notifications/NotificationLevel";
+import SdkConfig from "./SdkConfig";
+import { ROOM_RETENTION_CONFIG_KEY, ROOM_RETENTION_EVENT_TYPE } from "./utils/RoomRetention";
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const DAY = 86400000;
+const roomId = "!retention:example.com";
+const me = "@me:example.com";
+
+describe("determineUnreadState with room retention", () => {
+    let client: Mocked<MatrixClient>;
+    let room: Room;
+
+    const message = (id: string, ageMs: number, sender = "@other:example.com"): MatrixEvent =>
+        new MatrixEvent({
+            room_id: roomId,
+            event_id: id,
+            sender,
+            origin_server_ts: Date.now() - ageMs,
+            type: EventType.RoomMessage,
+            content: createMessageEventContent(`text ${id}`),
+        });
+
+    function setPolicy(content: object): void {
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: roomId,
+                user: "@admin:example.com",
+                skey: "",
+                content,
+            }),
+        ]);
+    }
+
+    /** The server's counts, as the SDK holds them after a /sync. */
+    function serverCounts(total: number, highlight = 0): void {
+        room.setUnreadNotificationCount(NotificationCountType.Total, total);
+        room.setUnreadNotificationCount(NotificationCountType.Highlight, highlight);
+    }
+
+    const readUpTo = (eventId: string): void => {
+        room.addReceipt(
+            new MatrixEvent({
+                type: EventType.Receipt,
+                content: { [eventId]: { [ReceiptType.Read]: { [me]: { ts: Date.now() } } } },
+            }),
+        );
+    };
+
+    beforeEach(() => {
+        client = stubClient() as Mocked<MatrixClient>;
+        room = new Room(roomId, client, me, { pendingEventOrdering: PendingEventOrdering.Detached });
+        client.getRoom.mockImplementation((id: string | undefined) => (id === roomId ? room : null));
+        putConfig({ [ROOM_RETENTION_CONFIG_KEY]: { choices: [] } });
+        setPolicy({ max_lifetime: DAY });
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    describe("feature on, room with a policy", () => {
+        it("shows no count when every unread event has expired", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY), message("$c", 2 * DAY)], {
+                addToState: false,
+            });
+            serverCounts(3);
+            const { level, count } = determineUnreadState(room);
+            expect(count).toBe(0);
+            expect(level).toBe(NotificationLevel.None);
+        });
+
+        it("shows no highlight either when the highlighted event has expired", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY)], { addToState: false });
+            serverCounts(2, 1);
+            const { level, count } = determineUnreadState(room);
+            expect(count).toBe(0);
+            expect(level).toBe(NotificationLevel.None);
+        });
+
+        it("keeps the server count when one unread event is still alive", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY), message("$c", 1000)], {
+                addToState: false,
+            });
+            serverCounts(3);
+            const { level, count } = determineUnreadState(room);
+            expect(count).toBe(3);
+            expect(level).toBe(NotificationLevel.Notification);
+        });
+
+        it("keeps the highlight when the highlighted event is still alive", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 1000)], { addToState: false });
+            serverCounts(2, 1);
+            const { level } = determineUnreadState(room);
+            expect(level).toBe(NotificationLevel.Highlight);
+        });
+
+        it("keeps the server count when the loaded timeline is empty", () => {
+            serverCounts(3);
+            const { level, count } = determineUnreadState(room);
+            expect(count).toBe(3);
+            expect(level).toBe(NotificationLevel.Notification);
+        });
+
+        it("keeps the server count when nothing loaded has expired and nothing says what the count is made of", async () => {
+            // an alive event that never counts as unread: the unread ones may be older than what is loaded
+            const join = mkEvent({
+                event: true,
+                type: EventType.RoomMember,
+                room: roomId,
+                user: "@other:example.com",
+                skey: "@other:example.com",
+                content: { membership: "join" },
+            });
+            await room.addLiveEvents([join], { addToState: false });
+            serverCounts(3);
+            expect(determineUnreadState(room).count).toBe(3);
+        });
+
+        it("does not hide an unread event that is alive and newer than the read position", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2000), message("$c", 1000)], {
+                addToState: false,
+            });
+            readUpTo("$b");
+            serverCounts(1);
+            expect(determineUnreadState(room).count).toBe(1);
+        });
+
+        it("shows no count when the alive events are all read and the rest has expired", async () => {
+            // an expired event after the read position is what proves the count is made of expired events
+            await room.addLiveEvents(
+                [message("$a", 3 * DAY), message("$b", 2000), message("$c", 1000), message("$d", 2 * DAY)],
+                { addToState: false },
+            );
+            readUpTo("$c");
+            serverCounts(1);
+            expect(determineUnreadState(room).count).toBe(0);
+        });
+
+        it("ignores events of our own when looking for an alive unread event", async () => {
+            // an event of ours is the read position, and an expired event after it is what the count is made of
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 1000, me), message("$c", 2 * DAY)], {
+                addToState: false,
+            });
+            serverCounts(1);
+            expect(determineUnreadState(room).count).toBe(0);
+        });
+
+        it("keeps the server count when the newest event is our own and an older one from someone else is alive", async () => {
+            await room.addLiveEvents([message("$a", 2000), message("$b", 1000, me)], { addToState: false });
+            serverCounts(1);
+            expect(determineUnreadState(room).count).toBe(1);
+        });
+
+        it("keeps the server count when the newest event counts as read and nothing after it has expired", async () => {
+            await room.addLiveEvents([message("$a", 2000), message("$b", 1000)], { addToState: false });
+            vi.spyOn(room, "hasUserReadEvent").mockImplementation((_userId, eventId) => eventId === "$b");
+            serverCounts(1);
+            expect(determineUnreadState(room).count).toBe(1);
+        });
+
+        it("shows no count when three expired unread events lie after the read position", async () => {
+            await room.addLiveEvents(
+                [message("$a", 2000), message("$b", 3 * DAY), message("$c", 3 * DAY), message("$d", 2 * DAY)],
+                { addToState: false },
+            );
+            readUpTo("$a");
+            serverCounts(3);
+            expect(determineUnreadState(room).count).toBe(0);
+        });
+
+        // I24: the notice for the policy itself is a state event, never expires and is drawn, but the server never counts it
+        it("shows no count when the only alive event after the read position is the retention notice", async () => {
+            const notice = mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: roomId,
+                user: "@admin:example.com",
+                skey: "",
+                content: { max_lifetime: DAY },
+            });
+            await room.addLiveEvents(
+                [
+                    message("$a", 4 * DAY),
+                    notice,
+                    message("$b", 3 * DAY),
+                    message("$c", 2 * DAY),
+                    message("$d", 2 * DAY),
+                ],
+                { addToState: false },
+            );
+            readUpTo("$a");
+            serverCounts(3);
+            const { level, count } = determineUnreadState(room);
+            expect(count).toBe(0);
+            expect(level).toBe(NotificationLevel.None);
+        });
+
+        it("still keeps the server count when an alive message follows the retention notice", async () => {
+            const notice = mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: roomId,
+                user: "@admin:example.com",
+                skey: "",
+                content: { max_lifetime: DAY },
+            });
+            await room.addLiveEvents([message("$a", 4 * DAY), notice, message("$b", 3 * DAY), message("$c", 1000)], {
+                addToState: false,
+            });
+            readUpTo("$a");
+            serverCounts(2);
+            expect(determineUnreadState(room).count).toBe(2);
+        });
+
+        // I10: an alive event with no renderer (or redacted) does not "trigger unread" for Element, yet the server may count it
+        it("keeps the server count when an alive event without a renderer follows expired ones", async () => {
+            const custom = new MatrixEvent({
+                room_id: roomId,
+                event_id: "$custom",
+                sender: "@other:example.com",
+                origin_server_ts: Date.now() - 1000,
+                type: "org.example.unrendered",
+                content: { body: "x" },
+            });
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY), custom], { addToState: false });
+            serverCounts(3);
+            expect(determineUnreadState(room).count).toBe(3);
+        });
+
+        it("shows no count when the only alive events after the expired ones are reactions", async () => {
+            const reaction = new MatrixEvent({
+                room_id: roomId,
+                event_id: "$react",
+                sender: "@other:example.com",
+                origin_server_ts: Date.now() - 1000,
+                type: EventType.Reaction,
+                content: { "m.relates_to": { rel_type: "m.annotation", event_id: "$b", key: "x" } },
+            });
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY), reaction], {
+                addToState: false,
+            });
+            serverCounts(2);
+            expect(determineUnreadState(room).count).toBe(0);
+        });
+
+        it("keeps the server count when an alive redacted message follows expired ones", async () => {
+            const redacted = message("$r", 1000);
+            redacted.makeRedacted(
+                new MatrixEvent({ type: EventType.RoomRedaction, sender: "@other:example.com", content: {} }),
+                room,
+            );
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY), redacted], {
+                addToState: false,
+            });
+            serverCounts(3);
+            expect(determineUnreadState(room).count).toBe(3);
+        });
+
+        it("shows no activity dot when the server count is 0 and everything unread has expired", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY)], { addToState: false });
+            serverCounts(0);
+            expect(determineUnreadState(room).level).toBe(NotificationLevel.None);
+        });
+
+        it("keeps the activity dot when the server count is 0 and an unread event is still alive", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 1000)], { addToState: false });
+            serverCounts(0);
+            expect(determineUnreadState(room).level).toBe(NotificationLevel.Activity);
+        });
+
+        it("leaves thread counts as they are", async () => {
+            await room.addLiveEvents([message("$a", 3 * DAY)], { addToState: false });
+            serverCounts(1);
+            room.setThreadUnreadNotificationCount("$thread", NotificationCountType.Total, 4);
+            expect(determineUnreadState(room, undefined, true).count).toBe(4);
+            expect(determineUnreadState(room, undefined, false).count).toBe(0);
+        });
+    });
+
+    it("keeps the server count when the key is absent", async () => {
+        SdkConfig.reset();
+        await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY)], { addToState: false });
+        serverCounts(2, 1);
+        const { level, count } = determineUnreadState(room);
+        expect(count).toBe(2);
+        expect(level).toBe(NotificationLevel.Highlight);
+    });
+
+    it("keeps the activity dot when the key is absent", async () => {
+        SdkConfig.reset();
+        await room.addLiveEvents([message("$a", 3 * DAY), message("$b", 2 * DAY)], { addToState: false });
+        serverCounts(0);
+        expect(determineUnreadState(room).level).toBe(NotificationLevel.Activity);
+    });
+
+    it("keeps the server count in a room without a policy", async () => {
+        room.currentState.setStateEvents([]);
+        setPolicy({});
+        await room.addLiveEvents([message("$a", 30 * DAY), message("$b", 20 * DAY)], { addToState: false });
+        serverCounts(2);
+        expect(determineUnreadState(room).count).toBe(2);
+    });
+
+    it("keeps the server count when the policy is Off", async () => {
+        setPolicy({ min_lifetime: 0 });
+        await room.addLiveEvents([message("$a", 30 * DAY), message("$b", 20 * DAY)], { addToState: false });
+        serverCounts(2);
+        expect(determineUnreadState(room).count).toBe(2);
+    });
+});
