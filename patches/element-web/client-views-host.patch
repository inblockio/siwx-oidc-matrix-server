+function pendingEventsOf(client: MatrixClient, roomId: string): MatrixEvent[] {
+    try {
+        return client.getRoom(roomId)?.getPendingEvents() ?? [];
+    } catch {
+        return []; // a room that does not keep a detached pending list
+    }
+}
