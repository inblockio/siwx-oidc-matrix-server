+/** A9 log out: a sign-out action on `UserMenuViewModel` (none in v1.12.32; Element signs out under Settings, Account). */
+export const AWAITS_LOGOUT =
+    "a sign-out action on UserMenuViewModel (none in v1.12.32: Settings, Account has SignOutButton)";
+
+/** How long Element may take, after the user confirmed, to announce that it signed out. */
+export const LOGOUT_TIMEOUT_MS = 30_000;
+
+let logoutRunning = false;
+/** Set once `logout` is dispatched, cleared by `on_logged_out`: the page leaves the session, a later call must not start another. */
+let signOutDispatched = false;
+
+/**
+ * A9 log out. AWAITS: see `AWAITS_LOGOUT`. This is the whole sign-out path, the same decision as Element's own sign-out
+ * button (`UserProfileSettings.tsx` `SignOutButton`, lines 86-91):
+ *  - `shouldShowLogoutDialog(client)` (true whenever the client has crypto) -> Element's `LogoutDialog`. It decides by key
+ *    backup: another verified device or an active backup -> a plain "Sign out" confirm; no backup / no recovery -> an offer
+ *    to set up recovery (which is NOT a sign-out: `cancelled`) next to "I don't want my encrypted messages" (the sign-out).
+ *    Its confirm dispatches `logout`; dismissing it signs nobody out, so `cancelled`.
+ *  - no crypto -> `logout` is dispatched at once.
+ * `logout` makes `MatrixChat` hang up calls and run `Lifecycle.logout()`: the logout request (a failed one still ends the
+ * session in the page, the token then stays valid on the server: Element's own behaviour), then `onLoggedOut()`, which
+ * announces `on_logged_out`, stops the client and clears all storage (`localStorage.clear()`, IndexedDB, caches). The page
+ * then leaves the session and unmounts the kit, so the caller normally never sees the `done` that follows `on_logged_out`.
+ */
+export async function logout(client: MatrixClient): Promise<ActionOutcome> {
+    // Also once `logout` is dispatched and Element's own sign-out runs on (hang-up of calls, then `Lifecycle.logout()`, which
+    // sets `isLoggingOut` only later): the 30 s timeout does not re-arm a retry.
+    if (logoutRunning || signOutDispatched || isLoggingOut())
+        throw new ClientViewActionError("failed", "a sign-out is already running");
+    logoutRunning = true;
+    try {
+        // Listen before anything dispatches `logout`, so the announcement cannot be missed.
+        let loggedOut: () => void = () => {};
+        const announced = new Promise<void>((resolve) => (loggedOut = resolve));
+        let token: string | undefined = defaultDispatcher.register((p) => {
+            if (p.action === "logout") signOutDispatched = true; // ours or the LogoutDialog's confirm
+            if (p.action === Action.OnLoggedOut) {
+                signOutDispatched = false;
+                loggedOut();
+                drop();
+            }
+        });
+        // Kept after a timeout while a dispatched sign-out runs on, so `on_logged_out` still clears the flag.
+        const drop = (): void => {
+            if (token !== undefined) defaultDispatcher.unregister(token);
+            token = undefined;
+        };
+        try {
+            if (await shouldShowLogoutDialog(client)) {
+                const { finished } = Modal.createDialog(LogoutDialog);
+                const [confirmed] = await finished;
+                if (!confirmed) return { status: "cancelled" };
+            } else {
+                signOutDispatched = true; // the dispatcher delivers a tick later
+                defaultDispatcher.dispatch({ action: "logout" });
+            }
+            await new Promise<void>((resolve, reject) => {
+                const timer = setTimeout(
+                    () =>
+                        reject(
+                            new ClientViewActionError(
+                                "failed",
+                                "Element did not sign out in time: reload the page before trying again",
+                            ),
+                        ),
+                    LOGOUT_TIMEOUT_MS,
+                );
+                void announced.then(() => {
+                    clearTimeout(timer);
+                    resolve();
+                });
+            });
+            return { status: "done" };
+        } finally {
+            if (!signOutDispatched) drop();
+        }
+    } catch (e) {
+        throw toActionError(e);
+    } finally {
+        logoutRunning = false;
+    }
+}
diff --git a/apps/web/src/client-views/InterimLogout.test.ts b/apps/web/src/client-views/InterimLogout.test.ts
new file mode 100644
index 0000000..caa5079
--- /dev/null
+++ b/apps/web/src/client-views/InterimLogout.test.ts
@@ -0,0 +1,148 @@
+/*
+ * Copyright 2026 inblock.io
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+// @vitest-environment happy-dom
+
+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+import { type MatrixClient } from "matrix-js-sdk/src/matrix";
+
+// Loaded first: with the registry patch "resolve-did-search" (`DidSearchMember extends DirectoryMember`) a cold
+// `utils/direct-messages` load reaches `InviteDialog` back through `RoomInvite` while still evaluating; entering
+// through `InviteDialog` first evaluates the cycle in the safe order. A no-op in the stock tree.
+import "../components/views/dialogs/InviteDialog";
+import Modal from "../Modal";
+import defaultDispatcher from "../dispatcher/dispatcher";
+import { Action } from "../dispatcher/actions";
+import { logout, LOGOUT_TIMEOUT_MS } from "./InterimActions";
+import { ClientViewActionError } from "./types";
+
+const logoutDialog = vi.hoisted(() => ({ shouldShow: vi.fn() }));
+const lifecycle = vi.hoisted(() => ({ isLoggingOut: vi.fn(() => false) }));
+vi.mock("../Lifecycle", () => lifecycle);
+vi.mock("../Modal", () => ({ default: { createDialog: vi.fn() } }));
+vi.mock("../components/views/dialogs/LogoutDialog", () => ({
+    default: class LogoutDialog {},
+    shouldShowLogoutDialog: logoutDialog.shouldShow,
+}));
+
+/* A9: the same decision as Element's SignOutButton (dialog or direct logout), and what each answer means. */
+describe("A9 log out (InterimActions.logout)", () => {
+    const client = {} as MatrixClient;
+    let dispatched: string[];
+    let token: string;
+
+    beforeEach(() => {
+        vi.useFakeTimers();
+        dispatched = [];
+        token = defaultDispatcher.register((p) => void dispatched.push(p.action));
+    });
+    afterEach(() => {
+        defaultDispatcher.unregister(token);
+        vi.useRealTimers();
+    });
+
+    /** A fake LogoutDialog: its `finished` is the dialog's own answer; `confirm` also dispatches `logout` like the real one. */
+    const openDialog = (): { answer: (confirmed: boolean) => void } => {
+        let resolve: (v: unknown[]) => void = () => {};
+        const finished = new Promise<unknown[]>((r) => (resolve = r));
+        vi.mocked(Modal.createDialog).mockReturnValue({ finished, close: vi.fn() } as never);
+        return {
+            answer: (confirmed) => {
+                if (confirmed) defaultDispatcher.dispatch({ action: "logout" }, true);
+                resolve([confirmed]);
+            },
+        };
+    };
+
+    it("opens Element's LogoutDialog when the client has crypto, and a dismissed dialog is cancelled (still signed in)", async () => {
+        logoutDialog.shouldShow.mockResolvedValue(true);
+        const dialog = openDialog();
+        const result = logout(client);
+        await vi.advanceTimersByTimeAsync(0);
+        expect(Modal.createDialog).toHaveBeenCalledOnce();
+        dialog.answer(false);
+        expect(await result).toEqual({ status: "cancelled" });
+        expect(dispatched).not.toContain("logout");
+    });
+
+    it("a confirmed dialog signs out: done once Element announced on_logged_out", async () => {
+        logoutDialog.shouldShow.mockResolvedValue(true);
+        const dialog = openDialog();
+        const result = logout(client);
+        await vi.advanceTimersByTimeAsync(0);
+        dialog.answer(true);
+        await vi.advanceTimersByTimeAsync(10);
+        defaultDispatcher.dispatch({ action: Action.OnLoggedOut }, true);
+        expect(await result).toEqual({ status: "done" });
+        expect(dispatched).toContain("logout");
+    });
+
+    it("without crypto there is no dialog: logout is dispatched at once", async () => {
+        logoutDialog.shouldShow.mockResolvedValue(false);
+        vi.mocked(Modal.createDialog).mockClear();
+        const result = logout(client);
+        await vi.advanceTimersByTimeAsync(10);
+        expect(Modal.createDialog).not.toHaveBeenCalled();
+        expect(dispatched).toContain("logout");
+        defaultDispatcher.dispatch({ action: Action.OnLoggedOut }, true);
+        expect((await result).status).toBe("done");
+    });
+
+    it("fails when Element does not announce the sign-out in time, and allows one sign-out at a time", async () => {
+        logoutDialog.shouldShow.mockResolvedValue(false);
+        const first = logout(client);
+        const second = logout(client);
+        await expect(second).rejects.toBeInstanceOf(ClientViewActionError);
+        const failed = first.catch((e: unknown) => e);
+        await vi.advanceTimersByTimeAsync(LOGOUT_TIMEOUT_MS + 100);
+        const error = await failed;
+        expect(error).toBeInstanceOf(ClientViewActionError);
+        expect((error as ClientViewActionError).code).toBe("failed");
+        // the sign-out was dispatched and the page has not left yet: a retry is refused, nothing is dispatched twice
+        dispatched.length = 0;
+        vi.mocked(Modal.createDialog).mockClear();
+        await expect(logout(client)).rejects.toBeInstanceOf(ClientViewActionError);
+        expect(dispatched).not.toContain("logout");
+        expect(Modal.createDialog).not.toHaveBeenCalled();
+        // Element announces it: the flag is cleared
+        defaultDispatcher.dispatch({ action: Action.OnLoggedOut }, true);
+        await vi.advanceTimersByTimeAsync(10);
+        logoutDialog.shouldShow.mockResolvedValue(true);
+        const dialog = openDialog();
+        const next = logout(client);
+        await vi.advanceTimersByTimeAsync(0);
+        dialog.answer(false);
+        expect(await next).toEqual({ status: "cancelled" });
+    });
+
+    it("a dismissed dialog does not arm the guard", async () => {
+        logoutDialog.shouldShow.mockResolvedValue(true);
+        const one = openDialog();
+        const first = logout(client);
+        await vi.advanceTimersByTimeAsync(0);
+        one.answer(false);
+        expect(await first).toEqual({ status: "cancelled" });
+        const two = openDialog();
+        const again = logout(client);
+        await vi.advanceTimersByTimeAsync(0);
+        two.answer(false);
+        expect(await again).toEqual({ status: "cancelled" });
+    });
+
+    it("refuses a retry while Element's own sign-out still runs (after the timeout cleared the guard)", async () => {
+        logoutDialog.shouldShow.mockResolvedValue(false);
+        lifecycle.isLoggingOut.mockReturnValue(true);
+        try {
+            vi.mocked(Modal.createDialog).mockClear();
+            await expect(logout(client)).rejects.toBeInstanceOf(ClientViewActionError);
+            expect(dispatched).not.toContain("logout");
+            expect(Modal.createDialog).not.toHaveBeenCalled();
+        } finally {
+            lifecycle.isLoggingOut.mockReturnValue(false);
+        }
+    });
+});
diff --git a/apps/web/src/client-views/PinAction.pinning.test.ts b/apps/web/src/client-views/PinAction.pinning.test.ts
new file mode 100644
index 0000000..5073f6a
--- /dev/null
+++ b/apps/web/src/client-views/PinAction.pinning.test.ts
@@ -0,0 +1,238 @@
+/*
+ * Copyright 2026 inblock.io
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+// @vitest-environment happy-dom
+
+import { vi, describe, it, expect, beforeEach, afterEach } from "vitest";
+import {
+    ConnectionError,
+    EventTimeline,
+    EventType,
+    type MatrixClient,
+    MatrixError,
+    MatrixEvent,
+    Room,
+} from "matrix-js-sdk/src/matrix";
+import { createTestClient } from "test-utils";
+
+import PinningUtils from "../utils/PinningUtils";
+import { setPinned, type PinTarget } from "./PinAction";
+
+/* M6 B2 fix round 2: `setPinned` over the REAL `PinningUtils.pinOrUnpinEvent` against a simulated homeserver. The pin's
+ * outcome is the state write's outcome; the paired read-pins account-data write fails on its own timing and must neither
+ * fail a landed pin nor release the room's queue early (grok r2: host F1, track F1, track F2). */
+describe("setPinned over pinOrUnpinEvent: the state write decides", () => {
+    const roomId = "!room:example.org";
+    const userId = "@alice:example.org";
+    let client: MatrixClient;
+    let server: string[];
+    let local: string[];
+
+    const message = (id: string): MatrixEvent =>
+        new MatrixEvent({
+            type: EventType.RoomMessage,
+            sender: userId,
+            content: { body: "hello", msgtype: "m.text" },
+            room_id: roomId,
+            origin_server_ts: 0,
+            event_id: id,
+        });
+    const target = (id: string): PinTarget => {
+        const ev = message(id);
+        return {
+            pinned: () => local.includes(id),
+            canPin: () => true,
+            press: () => PinningUtils.pinOrUnpinEvent(client, ev),
+        };
+    };
+    /** The state PUT: accepted (or refused) after `putMs`, the sync that carries it follows `syncMs` later. */
+    const homeserver = (putMs: number, syncMs: number, refuseFirst?: Error): void => {
+        let calls = 0;
+        vi.mocked(client.sendStateEvent).mockImplementation(
+            ((_r: string, _t: string, content: { pinned: string[] }) =>
+                new Promise((resolve, reject) =>
+                    setTimeout(() => {
+                        if (refuseFirst && calls++ === 0) return reject(refuseFirst);
+                        server = [...content.pinned];
+                        setTimeout(() => (local = [...server]), syncMs);
+                        resolve({ event_id: "$state" });
+                    }, putMs),
+                )) as never,
+        );
+    };
+    /** The first state PUT is answered with `error` after `putMs`, whether or not the homeserver applied it (`lands`,
+     * shown by the sync `syncMs` later); later PUTs are accepted. */
+    const lostAnswer = (putMs: number, syncMs: number, error: Error, lands: boolean): void => {
+        let calls = 0;
+        vi.mocked(client.sendStateEvent).mockImplementation(
+            ((_r: string, _t: string, content: { pinned: string[] }) =>
+                new Promise((resolve, reject) =>
+                    setTimeout(() => {
+                        const first = calls++ === 0;
+                        if (!first || lands) {
+                            server = [...content.pinned];
+                            setTimeout(() => (local = [...server]), syncMs);
+                        }
+                        if (first) reject(error);
+                        else resolve({ event_id: "$state" });
+                    }, putMs),
+                )) as never,
+        );
+    };
+    const accountData = (ms: number, error: Error): void => {
+        vi.mocked(client.setRoomAccountData).mockImplementation(
+            (() => new Promise((_res, rej) => setTimeout(() => rej(error), ms))) as never,
+        );
+    };
+
+    beforeEach(() => {
+        vi.useFakeTimers();
+        client = createTestClient();
+        const room = new Room(roomId, client, userId);
+        client.getRoom = vi.fn().mockReturnValue(room);
+        server = [];
+        local = [];
+        vi.spyOn(room.getLiveTimeline().getState(EventTimeline.FORWARDS)!, "getStateEvents").mockReturnValue({
+            // @ts-ignore a state event as far as pinOrUnpinEvent reads it
+            getContent: () => ({ pinned: local }),
+        });
+    });
+    afterEach(() => vi.useRealTimers());
+
+    // host F1 / track F2: the sibling write fails at once, the state PUT is slow; the next pin must wait for it.
+    it("a pin behind a failing account-data write and a slow state PUT is not dropped by the next pin", async () => {
+        accountData(200, new Error("500"));
+        homeserver(8000, 500);
+        const a = setPinned(roomId, target("$a"), true);
+        const b = setPinned(roomId, target("$b"), true);
+        await vi.advanceTimersByTimeAsync(40000);
+        await expect(a).resolves.toMatchObject({ status: "done" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect([...server].sort()).toEqual(["$a", "$b"]);
+    });
+
+    // track F1: the state write landed, then the account-data write is refused with M_FORBIDDEN.
+    it("a pin that landed is done when only the account-data write is forbidden", async () => {
+        accountData(400, new MatrixError({ errcode: "M_FORBIDDEN", error: "no" }, 403));
+        homeserver(100, 200);
+        const a = setPinned(roomId, target("$a"), true);
+        await vi.advanceTimersByTimeAsync(40000);
+        await expect(a).resolves.toMatchObject({ status: "done" });
+        expect(server).toEqual(["$a"]);
+    });
+
+    it("a refused state PUT is a failed pin, the next one in the room still runs", async () => {
+        accountData(100, new Error("500"));
+        homeserver(300, 100, new MatrixError({ errcode: "M_BAD_JSON", error: "no" }, 400));
+        const a = setPinned(roomId, target("$a"), true);
+        const b = setPinned(roomId, target("$b"), true);
+        const ra = a.catch((e) => e);
+        await vi.advanceTimersByTimeAsync(40000);
+        expect(await ra).toMatchObject({ code: "failed" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+    });
+
+    // grok r3 F1: the state PUT is answered with a lost connection, the homeserver applied it, the sync shows it later; the
+    // next pin in the room must build on that list, not on the local one that does not hold it yet.
+    it("a pin whose answer was lost but landed is not overwritten by the next pin in the room", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 2000, new ConnectionError("down after the write"), true);
+        const a = setPinned(roomId, target("$a"), true);
+        const b = setPinned(roomId, target("$b"), true);
+        await vi.advanceTimersByTimeAsync(40000);
+        await expect(a).resolves.toMatchObject({ status: "done" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect([...server].sort()).toEqual(["$a", "$b"]);
+    });
+
+    it("a lost answer that never landed is a network error after the wait, then the next pin runs", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 100, new ConnectionError("down"), false);
+        const a = setPinned(roomId, target("$a"), true);
+        const b = setPinned(roomId, target("$b"), true);
+        const ra = a.catch((e) => e);
+        await vi.advanceTimersByTimeAsync(5000);
+        expect(server).toEqual([]);
+        await vi.advanceTimersByTimeAsync(40000);
+        expect(await ra).toMatchObject({ code: "network" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect(server).toEqual(["$b"]);
+    });
+
+    it("a 5xx answer hides a landed write the same way", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 2000, new MatrixError({ errcode: "M_UNKNOWN", error: "oops" }, 502), true);
+        const a = setPinned(roomId, target("$a"), true);
+        const b = setPinned(roomId, target("$b"), true);
+        await vi.advanceTimersByTimeAsync(40000);
+        await expect(a).resolves.toMatchObject({ status: "done" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect([...server].sort()).toEqual(["$a", "$b"]);
+    });
+
+    it("a definite refusal (403) is a clean failure at once, the next pin runs without a wait", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 100, new MatrixError({ errcode: "M_FORBIDDEN", error: "no" }, 403), false);
+        const a = setPinned(roomId, target("$a"), true);
+        const b = setPinned(roomId, target("$b"), true);
+        const ra = a.catch((e) => e);
+        await vi.advanceTimersByTimeAsync(1500);
+        expect(await ra).toMatchObject({ code: "forbidden" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect(server).toEqual(["$b"]);
+    });
+
+    // grok r4 F1: the bridge is disposed while the state PUT's answer is lost; the wait is not cut short, so the room's
+    // queue is not released onto a local list that does not hold the landed write yet.
+    it("a dispose during a lost answer does not release the queue: the next pin builds on the landed list", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 2000, new ConnectionError("down after the write"), true);
+        let disposed = false;
+        const a = setPinned(roomId, target("$a"), true, () => disposed);
+        const b = setPinned(roomId, target("$b"), true);
+        setTimeout(() => (disposed = true), 100);
+        await vi.advanceTimersByTimeAsync(40000);
+        await expect(a).resolves.toMatchObject({ status: "done" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect([...server].sort()).toEqual(["$a", "$b"]);
+    });
+
+    it("a dispose during a lost answer: a queued unpin does not answer done on the stale list", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 2000, new ConnectionError("down after the write"), true);
+        let disposed = false;
+        const a = setPinned(roomId, target("$a"), true, () => disposed);
+        const b = setPinned(roomId, target("$a"), false);
+        setTimeout(() => (disposed = true), 100);
+        await vi.advanceTimersByTimeAsync(40000);
+        await expect(a).resolves.toMatchObject({ status: "done" });
+        await expect(b).resolves.toMatchObject({ status: "done" });
+        expect(server).toEqual([]);
+    });
+
+    it("a lost answer that never landed, bridge disposed: network after the full wait, not failed", async () => {
+        accountData(100, new Error("500"));
+        lostAnswer(300, 100, new ConnectionError("down"), false);
+        let disposed = false;
+        const a = setPinned(roomId, target("$a"), true, () => disposed);
+        const ra = a.catch((e) => e);
+        setTimeout(() => (disposed = true), 100);
+        await vi.advanceTimersByTimeAsync(5000);
+        expect(server).toEqual([]);
+        await vi.advanceTimersByTimeAsync(40000);
+        expect(await ra).toMatchObject({ code: "network" });
+    });
+
+    it("a disposed bridge writes nothing: failed, the PUT is never sent", async () => {
+        homeserver(100, 100);
+        const a = setPinned(roomId, target("$a"), true, () => true);
+        const ra = a.catch((e) => e);
+        await vi.advanceTimersByTimeAsync(5000);
+        expect(await ra).toMatchObject({ code: "failed" });
+        expect(client.sendStateEvent).not.toHaveBeenCalled();
+    });
+});
diff --git a/apps/web/src/client-views/PinAction.test.ts b/apps/web/src/client-views/PinAction.test.ts
new file mode 100644
index 0000000..b969063
--- /dev/null
+++ b/apps/web/src/client-views/PinAction.test.ts
@@ -0,0 +1,231 @@
+/*
+ * Copyright 2026 inblock.io
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+import { describe, it, expect, vi } from "vitest";
+import { ConnectionError, MatrixError } from "matrix-js-sdk/src/matrix";
+
+import { setPinned, type PinTarget } from "./PinAction";
+import { ROOM_ACTION_TIMEOUT_MS } from "./RoomActions";
+
+/* M11 Y4: RoomActions statically imports the DM helper, whose chain loads FileBodyViewModel (module-level window.btoa,
+   absent in this test's env). The pin press never starts a DM, so the helper is mocked as RoomActions.test.ts does. */
+vi.mock("../utils/direct-messages", () => ({
+    startDmOnFirstMessage: vi.fn(),
+    DirectoryMember: class {
+        public constructor(private readonly result: { user_id: string }) {}
+        public get userId(): string {
+            return this.result.user_id;
+        }
+    },
+}));
+
+/* M6 B2: the pin press is the homeserver's answer, `done` needs the state to show it, calls for a room run in turn. */
+function target(
+    over: Partial<PinTarget> & { state?: { pinned: boolean } } = {},
+): PinTarget & { state: { pinned: boolean } } {
+    const state = over.state ?? { pinned: false };
+    return {
+        state,
+        pinned: () => state.pinned,
+        canPin: () => true,
+        press: vi.fn(async () => {
+            state.pinned = !state.pinned;
+        }),
+        ...over,
+    } as PinTarget & { state: { pinned: boolean } };
+}
+
+describe("setPinned", () => {
+    it("presses once when the state differs and is done when the state shows it", async () => {
+        const t = target();
+        await expect(setPinned("!a", t, true)).resolves.toEqual({ status: "done", roomId: "!a" });
+        expect(t.press).toHaveBeenCalledTimes(1);
+    });
+
+    it("does not press when the message is already as asked", async () => {
+        const t = target({ state: { pinned: true } });
+        await expect(setPinned("!a", t, true)).resolves.toMatchObject({ status: "done" });
+        expect(t.press).not.toHaveBeenCalled();
+    });
+
+    it("is forbidden, without a press, where Element offers no pin", async () => {
+        const t = target({ canPin: () => false });
+        await expect(setPinned("!a", t, true)).rejects.toMatchObject({ code: "forbidden" });
+        expect(t.press).not.toHaveBeenCalled();
+    });
+
+    it("maps a refused press: M_FORBIDDEN is forbidden, a 4xx answer failed, a lost answer network", async () => {
+        const refuse = (e: unknown) => target({ press: vi.fn(async () => Promise.reject(e)) });
+        await expect(
+            setPinned("!a", refuse(new MatrixError({ errcode: "M_FORBIDDEN", error: "no" }, 403)), true),
+        ).rejects.toMatchObject({ code: "forbidden" });
+        await expect(
+            setPinned("!a", refuse(new MatrixError({ errcode: "M_BAD_JSON", error: "no" }, 400)), true),
+        ).rejects.toMatchObject({ code: "failed" });
+        vi.useFakeTimers();
+        try {
+            for (const lost of [new ConnectionError("down"), new Error("500")]) {
+                const seen = setPinned("!a", refuse(lost), true).then(
+                    () => "done",
+                    (e: unknown) => e,
+                );
+                await vi.advanceTimersByTimeAsync(ROOM_ACTION_TIMEOUT_MS + 200);
+                expect(await seen).toMatchObject({ code: "network" });
+            }
+        } finally {
+            vi.useRealTimers();
+        }
+    });
+
+    it("a definite refusal (M_FORBIDDEN) is reported at once, without the wait", async () => {
+        const t = target({
+            press: vi.fn(async () => Promise.reject(new MatrixError({ errcode: "M_FORBIDDEN", error: "no" }, 403))),
+        });
+        await expect(setPinned("!a", t, true)).rejects.toMatchObject({ code: "forbidden" });
+    });
+
+    // r3: an answer that is not a definite refusal (lost connection, timeout, 5xx) can hide an accepted write, so it is
+    // held for the 15 s list wait and reported as "may still apply" (network), never as a clean failure.
+    it("an ambiguous rejection is held for the list wait, then reported as network", async () => {
+        vi.useFakeTimers();
+        try {
+            const t = target({ press: vi.fn(async () => Promise.reject(new Error("500"))) });
+            const seen = setPinned("!a", t, true).then(
+                () => "done",
+                (e: unknown) => e,
+            );
+            let settled = false;
+            void seen.then(() => (settled = true));
+            await vi.advanceTimersByTimeAsync(ROOM_ACTION_TIMEOUT_MS - 1000);
+            expect(settled).toBe(false);
+            await vi.advanceTimersByTimeAsync(2000);
+            expect(await seen).toMatchObject({ code: "network" });
+        } finally {
+            vi.useRealTimers();
+        }
+    });
+
+    it("a press that rejects with a lost connection is done when the list already shows the change", async () => {
+        const state = { pinned: false };
+        const t = target({
+            state,
+            press: vi.fn(async () => {
+                state.pinned = true;
+                throw new ConnectionError("down after the write");
+            }),
+        });
+        await expect(setPinned("!a", t, true)).resolves.toEqual({ status: "done", roomId: "!a" });
+    });
+
+    // grok track F1 (second half): the list flips in the last sleep before the wait ends.
+    it("looks once more when the wait ends: a change that arrived in the last sleep is done", async () => {
+        vi.useFakeTimers();
+        try {
+            const state = { pinned: false };
+            const t = target({
+                state,
+                press: vi.fn(async () => {
+                    setTimeout(() => (state.pinned = true), ROOM_ACTION_TIMEOUT_MS - 20);
+                }),
+            });
+            const p = setPinned("!a", t, true);
+            await vi.advanceTimersByTimeAsync(ROOM_ACTION_TIMEOUT_MS + 200);
+            await expect(p).resolves.toMatchObject({ status: "done" });
+        } finally {
+            vi.useRealTimers();
+        }
+    });
+
+    it("waits for the state: done only once it shows the change", async () => {
+        vi.useFakeTimers();
+        try {
+            const t = target({ press: vi.fn(async () => {}) });
+            let settled = false;
+            const p = setPinned("!a", t, true).then((r) => {
+                settled = true;
+                return r;
+            });
+            await vi.advanceTimersByTimeAsync(500);
+            expect(settled).toBe(false);
+            t.state.pinned = true;
+            await vi.advanceTimersByTimeAsync(100);
+            await expect(p).resolves.toMatchObject({ status: "done" });
+        } finally {
+            vi.useRealTimers();
+        }
+    });
+
+    it("is network when the state never shows the change", async () => {
+        vi.useFakeTimers();
+        try {
+            const t = target({ press: vi.fn(async () => {}) });
+            const p = setPinned("!a", t, true);
+            const seen = p.then(
+                () => undefined,
+                (e: unknown) => e,
+            );
+            await vi.advanceTimersByTimeAsync(20_000);
+            expect(await seen).toMatchObject({ code: "network" });
+        } finally {
+            vi.useRealTimers();
+        }
+    });
+
+    it("runs the calls of one room in turn: the second reads the state the first left", async () => {
+        const order: string[] = [];
+        const state = { pinned: false };
+        let release!: () => void;
+        const first = target({
+            state,
+            press: vi.fn(async () => {
+                order.push("first start");
+                await new Promise<void>((r) => (release = r));
+                state.pinned = true;
+                order.push("first end");
+            }),
+        });
+        const second = target({
+            state,
+            press: vi.fn(async () => {
+                order.push("second");
+                state.pinned = false;
+            }),
+        });
+        const a = setPinned("!a", first, true);
+        const b = setPinned("!a", second, false);
+        await vi.waitFor(() => expect(order).toEqual(["first start"]));
+        release();
+        await Promise.all([a, b]);
+        expect(order).toEqual(["first start", "first end", "second"]);
+    });
+
+    it("does not hold one room's call behind another room's", async () => {
+        let release!: () => void;
+        const slow = target({
+            press: vi.fn(
+                () =>
+                    new Promise<void>((r) => {
+                        release = () => {
+                            slow.state.pinned = true;
+                            r();
+                        };
+                    }),
+            ),
+        });
+        const quick = target();
+        const held = setPinned("!slow", slow, true);
+        await expect(setPinned("!b", quick, true)).resolves.toMatchObject({ roomId: "!b" });
+        release();
+        await held;
+    });
+
+    it("does not press when the bridge is disposed", async () => {
+        const t = target({ press: vi.fn(async () => {}) });
+        await expect(setPinned("!a", t, true, () => true)).rejects.toMatchObject({ code: "failed" });
+        expect(t.press).not.toHaveBeenCalled();
+    });
+});
diff --git a/apps/web/src/client-views/PinAction.ts b/apps/web/src/client-views/PinAction.ts
new file mode 100644
index 0000000..1a47c5c
--- /dev/null
+++ b/apps/web/src/client-views/PinAction.ts
@@ -0,0 +1,83 @@
+/*
+ * Copyright 2026 inblock.io
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+/*
+ * M6 B2 pin / unpin: the action bar view-model's `onPinClick` (stock `PinningUtils.pinOrUnpinEvent`, which sends the room's
+ * `m.room.pinned_events` list built from Element's own state). It toggles, so it is called only when the message's pin
+ * state differs from the asked one. The outcome is read where the view-model leaves it: the returned promise is the
+ * state write's answer (a failing read-pins account-data write is not part of it), and the room state (which arrives with
+ * the sync) must show the change before `done`, also after an answer that may have hidden an accepted write. The pinned list
+ * is rebuilt from the local state on every press, so calls for one room run one after the other: an overlapping press would
+ * build its list from a state that does not hold the first one yet and drop it.
+ */
+
+import { MatrixError } from "matrix-js-sdk/src/matrix";
+
+import { toActionError } from "./actions";
+import { ROOM_ACTION_TIMEOUT_MS } from "./RoomActions";
+import { type ActionOutcome, ClientViewActionError } from "./types";
+
+/** What `setPinned` reads and does on one message. */
+export interface PinTarget {
+    /** `PinningUtils.isPinned`, read live. */
+    pinned(): boolean;
+    /** Element's rule for offering Pin (unpinned message) or Unpin (pinned message), read live. */
+    canPin(): boolean;
+    /** `EventTileActionBarViewModel.onPinClick`; rejects when the homeserver refuses. */
+    press(): Promise<void>;
+}
+
+const pinQueue = new Map<string, Promise<unknown>>();
+
+export function setPinned(
+    roomId: string,
+    target: PinTarget,
+    on: boolean,
+    isDisposed: () => boolean = () => false,
+): Promise<ActionOutcome> {
+    // Waits for the room's list to show the asked state; true when it did within `ms`.
+    const shows = async (ms: number): Promise<boolean> => {
+        const until = Date.now() + ms;
+        while (Date.now() < until) {
+            if (target.pinned() === on) return true;
+            await new Promise((r) => setTimeout(r, 50));
+        }
+        return target.pinned() === on;
+    };
+    const run = async (): Promise<ActionOutcome> => {
+        // Before the press only: once a write may be on its way, a dispose does not end the wait (it would release the
+        // room's queue onto a list that does not hold that write yet).
+        if (isDisposed()) throw new ClientViewActionError("failed", "the bridge was disposed");
+        if (!target.canPin()) throw new ClientViewActionError("forbidden", "Element offers no pin on this message");
+        if (target.pinned() === on) return { status: "done", roomId };
+        try {
+            await target.press();
+        } catch (e) {
+            // The press is the state write (the paired read-pins account-data write is a side effect that never rejects
+            // it, `PinningUtils.pinOrUnpinEvent`). A definite refusal (the homeserver answered with a 4xx, M_FORBIDDEN
+            // among them) left nothing behind and stands at once. Any other error (a lost connection, a timeout, a 5xx)
+            // can hide an accepted write that the list shows only with a later sync: the room's queue is held for the
+            // same wait as after a resolved press, so the next pin builds on the landed list instead of replacing it.
+            const error = toActionError(e);
+            const status = e instanceof MatrixError ? (e.httpStatus ?? 0) : 0;
+            if (error.code === "forbidden" || (status >= 400 && status < 500)) throw error;
+        }
+        if (await shows(ROOM_ACTION_TIMEOUT_MS)) return { status: "done", roomId };
+        throw new ClientViewActionError(
+            "network",
+            "the room's pinned list did not show the change in time; it may still apply",
+        );
+    };
+    const previous = pinQueue.get(roomId) ?? Promise.resolve();
+    const next = previous.then(run, run);
+    const tail = next.catch(() => undefined);
+    pinQueue.set(roomId, tail);
+    void tail.then(() => {
+        if (pinQueue.get(roomId) === tail) pinQueue.delete(roomId);
+    });
+    return next;
+}
diff --git a/apps/web/src/client-views/QuickReactAction.ts b/apps/web/src/client-views/QuickReactAction.ts
