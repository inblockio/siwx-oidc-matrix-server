+            expect(onChange).toHaveBeenCalledWith({ kind: "timeline", roomId: "!a:example.org" });
+            expect(bridge.timeline("!a:example.org")[0].call?.participants).toEqual([
+                { userId: "@carol:example.org", name: "Carol B.", avatarUrl: "http://hs/carol" },
+            ]);
+        });
