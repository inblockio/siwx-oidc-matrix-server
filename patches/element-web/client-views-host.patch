+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+/**
+ * Stock parity of the Rocket.Chat "face" host layer: the face is switched on by TWO config gates, `client_views`
+ * (a list of {id, name, url}) and `features.feature_client_views`. Without both, the app must behave as stock Element:
+ * no iframe, no `/kits/` URL requested or referenced, no "Switch to ..." menu entry, and a stored `clientView` value
+ * must not turn the face on. These tests use the real registry, the real ClientViewGate and the real UserMenuViewModel;
+ * only the heavy bridge and the call/pip overlays are stubbed (as in ClientViewGate.test.tsx).
+ */
+
+import React from "react";
+import { vi, describe, it, expect, beforeEach, afterEach, type MockedObject } from "vitest";
+import { render, screen, fireEvent } from "test-utils-rtl";
+import { type MatrixClient, TypedEventEmitter } from "matrix-js-sdk/src/matrix";
+import { UserMenu } from "@element-hq/web-shared-components";
+import {
+    getMockClientWithEventEmitter,
+    mockClientMethodsServer,
+    mockClientMethodsUser,
+    TestSDKContext,
+} from "test-utils";
+
+import { SDKContext } from "../contexts/SDKContext";
+import { SDKContextClass } from "../contexts/SDKContextClass";
+import { type OwnProfileStore } from "../stores/OwnProfileStore";
+import { UserMenuViewModel } from "../viewmodels/menus/UserMenuViewModel";
+import { MatrixDispatcher } from "../dispatcher/dispatcher";
+import SdkConfig from "../SdkConfig";
+import SettingsStore from "../settings/SettingsStore";
+import { SettingLevel } from "../settings/SettingLevel";
+import { ClientViewGate } from "./ClientViewGate";
+import { ViewModelBridge } from "./ViewModelBridge";
+import { clientViewsAvailable, getActiveClientView, getClientViews } from "./registry";
+
+vi.mock("./ViewModelBridge", () => ({
+    ViewModelBridge: vi.fn(
+        class {
+            public used = false;
+            public dispose = vi.fn();
+            public onReactionPicker = (): (() => void) => () => {};
+            public onThreadPanel = (): (() => void) => () => {};
+            public onCardPanel = (): (() => void) => () => {};
+        },
+    ),
+}));
+vi.mock("../components/structures/PipContainer", () => ({ PipContainer: () => <div data-testid="pip" /> }));
+vi.mock("../components/views/voip/AudioFeedArrayForLegacyCall", () => ({ default: () => <div /> }));
+vi.mock("../components/structures/MatrixClientContextProvider", () => ({
+    MatrixClientContextProvider: ({ children }: { children: React.ReactNode }) => <>{children}</>,
+}));
+
+const rocketchat = { id: "rocketchat", name: "Rocket.Chat", url: "/kits/rocketchat/index.html" };
+
+/** The two config gates are read untyped: put them in as the app reads them from config.json. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const FLAG_ON = { features: { feature_client_views: true } };
+
+describe("client views: stock parity", () => {
+    let client: MockedObject<MatrixClient>;
+    let ownProfileStore: OwnProfileStore;
+    let fetchSpy: ReturnType<typeof vi.spyOn>;
+
+    beforeEach(async () => {
+        localStorage.clear();
+        SettingsStore.reset(); // the stored device setting is cached per store, not only in localStorage
+        client = getMockClientWithEventEmitter({
+            ...mockClientMethodsUser(),
+            ...mockClientMethodsServer(),
+            getAuthMetadata: vi.fn(),
+            getSyncState: vi.fn().mockReturnValue("SYNCING"),
+        });
+        const sdkContext = new TestSDKContext();
+        // @ts-ignore UserMenuViewModel uses SDKContext in the constructor
+        SDKContextClass.instance = sdkContext;
+        sdkContext._client = client;
+        ownProfileStore = {
+            displayName: "Sally",
+            userStatus: undefined,
+            getHttpAvatarUrl: vi.fn(),
+            on: vi.fn(),
+            off: vi.fn(),
+        } as unknown as OwnProfileStore;
+        vi.mocked(ViewModelBridge).mockClear();
+        fetchSpy = vi.spyOn(globalThis, "fetch").mockRejectedValue(new Error("no network in this test"));
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+        localStorage.clear();
+        SettingsStore.reset();
+        document.body.className = "";
+        vi.restoreAllMocks();
+        SDKContextClass.instance.onLoggedOut();
+    });
+
+    /** A user who once picked the kit on this device (the stored device setting). */
+    const storeSelectedKit = (id = "rocketchat"): Promise<void> =>
+        SettingsStore.setValue("clientView", null, SettingLevel.DEVICE, id);
+
+    const sdk = {
+        legacyCallHandler: Object.assign(new TypedEventEmitter<string, any>(), {
+            getAllActiveCalls: vi.fn(() => []),
+        }),
+        roomViewStore: Object.assign(new TypedEventEmitter<string, any>(), { getRoomId: vi.fn(() => null) }),
+    } as unknown as SDKContextClass;
+
+    const renderGate = (): ReturnType<typeof render> =>
+        render(
+            <SDKContext.Provider value={sdk}>
+                <ClientViewGate client={client}>
+                    <div>stock UI</div>
+                </ClientViewGate>
+            </SDKContext.Provider>,
+        );
+
+    const menu = (): UserMenuViewModel =>
+        new UserMenuViewModel({ ownProfileStore }, new MatrixDispatcher(), client, false);
+
+    /** Everything that must hold in the stock state, whatever put us there. */
+    const expectStock = async (): Promise<void> => {
+        expect(clientViewsAvailable()).toBe(false);
+        expect(getActiveClientView()).toBeUndefined();
+
+        // the user menu offers no "Switch to ..." entry
+        const vm = menu();
+        vm.setOpen(true);
+        expect(vm.getSnapshot().views).toEqual([]);
+        const { unmount } = render(<UserMenu vm={vm} />);
+        expect(screen.getByRole("menuitem", { name: "All settings" })).toBeTruthy();
+        expect(screen.queryAllByRole("menuitem", { name: /^Switch to/ })).toHaveLength(0);
+        unmount();
+
+        // the shell renders stock: no iframe, no bridge, no look on the body, no /kits/ anywhere
+        const { container } = renderGate();
+        expect(screen.getByText("stock UI")).toBeTruthy();
+        expect(container.querySelector("iframe")).toBeNull();
+        expect(document.querySelector("iframe")).toBeNull();
+        expect(ViewModelBridge).not.toHaveBeenCalled();
+        expect(document.body.className).not.toContain("ClientViewFacelift");
+        expect(document.documentElement.outerHTML).not.toContain("/kits/");
+        expect(fetchSpy.mock.calls.filter(([url]: unknown[]) => String(url).includes("/kits/"))).toEqual([]);
+    };
+
+    describe("a. the face is off (absent key, absent flag, empty list)", () => {
+        it("client_views absent, flag off, a kit stored on this device", async () => {
+            putConfig({});
+            await storeSelectedKit();
+            await expectStock();
+        });
+
+        it("client_views absent, flag on, a kit stored on this device", async () => {
+            putConfig(FLAG_ON);
+            await storeSelectedKit();
+            await expectStock();
+        });
+
+        it("client_views set, flag off (absent), a kit stored on this device", async () => {
+            putConfig({ client_views: [rocketchat] });
+            await storeSelectedKit();
+            expect(getClientViews()).toEqual([rocketchat]); // the kit is known, only the flag keeps it off
+            await expectStock();
+        });
+
+        it("client_views set, flag explicitly false, a kit stored on this device", async () => {
+            putConfig({ client_views: [rocketchat], features: { feature_client_views: false } });
+            await storeSelectedKit();
+            await expectStock();
+        });
+
+        it("client_views empty, flag on, a kit stored on this device", async () => {
+            putConfig({ ...FLAG_ON, client_views: [] });
+            await storeSelectedKit();
+            await expectStock();
+        });
+    });
+
+    describe("b. only the rocketchat kit, flag on", () => {
+        beforeEach(() => putConfig({ ...FLAG_ON, client_views: [rocketchat] }));
+
+        it("the user menu offers exactly 'Switch to Rocket.Chat'", async () => {
+            expect(clientViewsAvailable()).toBe(true);
+            const vm = menu();
+            vm.setOpen(true);
+            expect(vm.getSnapshot().views).toEqual([{ id: "rocketchat", name: "Rocket.Chat" }]);
+            render(<UserMenu vm={vm} />);
+            expect(screen.getAllByRole("menuitem", { name: /^Switch to/ })).toHaveLength(1);
+            expect(screen.getByRole("menuitem", { name: "Switch to Rocket.Chat" })).toBeTruthy();
+        });
+
+        it("stays stock until the user has switched (the default view is stock)", async () => {
+            expect(getActiveClientView()).toBeUndefined();
+            const { container } = renderGate();
+            expect(screen.getByText("stock UI")).toBeTruthy();
+            expect(container.querySelector("iframe")).toBeNull();
+            expect(ViewModelBridge).not.toHaveBeenCalled();
+        });
+
+        it("control: after the switch the kit is mounted from its /kits/ URL (the stock assertions can fail)", async () => {
+            await storeSelectedKit();
+            expect(getActiveClientView()).toEqual(rocketchat);
+            const { container } = renderGate();
+            const frame = container.querySelector("iframe");
+            expect(frame).not.toBeNull();
+            expect(frame!.getAttribute("src")).toBe("/kits/rocketchat/index.html");
+            expect(screen.queryByText("stock UI")).toBeNull();
+            fireEvent.load(frame!); // no pending boot timer left behind
+        });
+    });
+
+    describe("c. malformed client_views entries behave like absent", () => {
+        it.each<[string, unknown]>([
+            ["an entry without url", [{ id: "rocketchat", name: "Rocket.Chat" }]],
+            ["an entry without name", [{ id: "rocketchat", url: "/kits/rocketchat/index.html" }]],
+            ["an entry with a non-string url", [{ id: "rocketchat", name: "Rocket.Chat", url: 7 }]],
+            ["an entry that is not an object", ["rocketchat", 7, null]],
+            ["a non-array (an object)", rocketchat],
+            ["a non-array (a string)", "/kits/rocketchat/index.html"],
+            ["a non-array (a number)", 1],
+        ])("%s, flag on, a kit stored on this device", async (_, clientViews) => {
+            putConfig({ ...FLAG_ON, client_views: clientViews });
+            await storeSelectedKit();
+            await expectStock();
+        });
+
+        // CHARACTERISATION, not a guarantee: the host layer does NOT restrict `url` to same-origin `/kits/`.
+        // registry.ts isDescriptor() only checks that id, name and url are strings (id non-empty, not "stock").
+        // ClientViewGate then mounts whatever string it is given as the iframe `src`. Restricting it would be a
+        // change to the host layer: flagged for the orchestrator, not invented here.
+        it.each(["https://elsewhere.example/kit/index.html", "//elsewhere.example/kit.html", "/not-kits/x.html"])(
+            "CHARACTERISATION: a url outside /kits/ (%s) is NOT ignored; the gate mounts it as the iframe src",
+            async (url) => {
+                putConfig({ ...FLAG_ON, client_views: [{ id: "x", name: "X", url }] });
+                expect(getClientViews()).toEqual([{ id: "x", name: "X", url }]);
+                await storeSelectedKit("x");
+                const { container } = renderGate();
+                expect(container.querySelector("iframe")!.getAttribute("src")).toBe(url);
+                fireEvent.load(container.querySelector("iframe")!);
+            },
+        );
+    });
+});
