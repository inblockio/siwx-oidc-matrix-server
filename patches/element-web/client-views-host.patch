+            localEvents = [encryptionEvent("~!local+bob:txn", { roomId: LOCAL })];
+            bridge.timeline(LOCAL);
+            emitted.length = 0;
+            h.cards[0].set({ state: "ENABLED_DM", userName: "Bob" });
