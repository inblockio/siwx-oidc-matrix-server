+/*
+ * Copyright 2026 inblock.io
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+/*
+ * K8 facelift (M14, R4): while the Rocket.Chat kit view is mounted, the host sets `mx_ClientViewFacelift_rocketchat`
+ * on document.body (facelift.ts) and the Element surfaces the kit opens (host panels, Element dialogs, menus, toasts)
+ * take Rocket.Chat's look. Style only: these are Compound token overrides, no selector reaches a component.
+ *
+ * Cascade: Element and Compound CSS sit in `@layer compound-tokens, compound-web, shared-components, app-web, ...`
+ * and Compound's palette is `.cpd-theme-light.cpd-theme-light` (0,2,0). This sheet is unlayered, and an unlayered
+ * rule beats every layered one whatever its specificity; `body.<class>.cpd-theme-light` (0,3,1) also beats the
+ * palette selector if a build ever folds this sheet into a layer. The high-contrast themes (`cpd-theme-light-hc`,
+ * `cpd-theme-dark-hc`) do not match and keep Element's own look.
+ *
+ * Method: override the palette primitives (`--cpd-color-gray-*`, `blue-*`, `red-*`, `green-*`, `orange-*`,
+ * `theme-bg`). Compound's semantic tokens are declared on the same body element and resolve through var(), so they
+ * follow. The few semantic tokens where Fuselage differs from Compound's mapping are then set on top.
+ *
+ * Sources (every value is a Fuselage design token, the same clone the kit bundles; `rocket.chat/node_modules/
+ * @rocket.chat/fuselage-tokens@0.35.0/dist/`): colors.json (n/b/r/g/o scales), surface.json, font.json,
+ * stroke.json, button.json, typography.json. Hex values are annotated with the token name they come from.
+ */
+
+/* ---- light (surface.json light, font.json light, button.json light, stroke.json light) ---- */
+body.mx_ClientViewFacelift_rocketchat.cpd-theme-light {
+    /* palette primitives: gray scale = Fuselage neutrals (colors.json n100..n900) */
+    --cpd-color-theme-bg: #ffffff; /* surface.light, white */
+    --cpd-color-gray-100: #f7f8fa; /* n100, surface.tint */
+    --cpd-color-gray-200: #f7f8fa; /* n100, surface.disabled */
+    --cpd-color-gray-300: #f2f3f5; /* n200, surface.hover */
+    --cpd-color-gray-400: #e4e7ea; /* n400, surface.neutral / sidebar */
+    --cpd-color-gray-500: #d7dbe0; /* n450, surface.selected */
+    --cpd-color-gray-600: #cbced1; /* n500, stroke.light */
+    --cpd-color-gray-700: #9ea2a8; /* n600, font.annotation, stroke.medium */
+    --cpd-color-gray-800: #9ea2a8; /* n600 */
