+    /**
+     * A change of the room's retention policy (`m.room.retention`, state key "") re-reads the room list, so
+     * `ViewRoom.retention` appears, changes and goes with it. Nothing is watched while retention is not configured.
+     */
+    private watchRetentionPolicy(room: Room): () => void {
+        if (!isRetentionEnabled()) return () => {};
+        const onState = (ev: MatrixEvent): void => {
+            if (isRetentionPolicyEvent(ev)) this.syncRooms();
+        };
+        const onCurrentState = (): void => this.syncRooms();
+        try {
+            room.on(RoomStateEvent.Events, onState);
+            room.on(RoomEvent.CurrentStateUpdated, onCurrentState);
+        } catch {
+            return () => {};
+        }
+        return () => {
+            room.off(RoomStateEvent.Events, onState);
+            room.off(RoomEvent.CurrentStateUpdated, onCurrentState);
+        };
+    }
