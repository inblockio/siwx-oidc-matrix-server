+import { useMemo } from "react";
+import { type Room } from "matrix-js-sdk/src/matrix";
+
+import { useRoomState } from "../useRoomState";
+import { isRetentionEnabled } from "../../utils/RoomRetention";
+import {
+    type RoomRetentionIndicator,
+    maxLifetimeOfState,
+    retentionIndicatorFor,
+} from "../../utils/RoomRetentionIndicator";
+
+/**
+ * The room's "messages are deleted after ..." indicator, following the room state: it appears, changes and goes
+ * when `m.room.retention` is set, changed or switched off. Undefined while the `io.inblock.room_retention` config
+ * key is absent or the room has no clean-up.
+ */
+export function useRoomRetentionIndicator(room: Room): RoomRetentionIndicator | undefined {
+    const maxLifetimeMs = useRoomState(room, (state) => (isRetentionEnabled() ? maxLifetimeOfState(state) : null));
+    return useMemo(() => retentionIndicatorFor(maxLifetimeMs), [maxLifetimeMs]);
+}
