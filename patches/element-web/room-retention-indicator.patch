+/*
+ * Copyright 2026 inblock.io
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+ * Please see LICENSE files in the repository root for full details.
+ */
+
+// @vitest-environment happy-dom
+
+import { vi, describe, it, expect, beforeEach, afterEach } from "vitest";
+import { type MatrixClient, PendingEventOrdering, Room, RoomStateEvent } from "matrix-js-sdk/src/matrix";
+import { stubClient, flushPromises, mkEvent } from "test-utils";
+
+import { ViewModelBridge } from "./ViewModelBridge";
+import RoomListStoreV3 from "../stores/room-list-v3/RoomListStoreV3";
+import { SortingAlgorithm } from "../stores/room-list-v3/skip-list/sorters";
+import { SDKContextClass } from "../contexts/SDKContextClass";
+import { CHATS_TAG } from "../stores/room-list-v3/section";
+import DMRoomMap from "../utils/DMRoomMap";
+import SdkConfig from "../SdkConfig";
+import { ROOM_RETENTION_CONFIG_KEY, ROOM_RETENTION_EVENT_TYPE } from "../utils/RoomRetention";
+
+/*
+ * The room list of the face carries each room's automatic message clean-up (`ViewRoom.retention`), from the room's
+ * `m.room.retention`, only while `io.inblock.room_retention` is set, and follows the setting live. Real room list
+ * view-model, bridge and rooms; only the store's list and the open room are faked.
+ */
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const DAY = 86400000;
+const ON = {
+    [ROOM_RETENTION_CONFIG_KEY]: {
+        choices: [
+            { ms: DAY, label: "1 day" },
+            { ms: 14 * DAY, label: "2 weeks" },
+        ],
+    },
+};
+const TWO_WEEKS = {
+    maxLifetimeMs: 14 * DAY,
+    period: "2 weeks",
+    listLabel: "Messages are deleted after 2 weeks",
+    headerText: "Messages here are deleted after 2 weeks",
+};
+
+describe("ViewModelBridge: ViewRoom.retention", () => {
+    let client: MatrixClient;
+    let bridge: ViewModelBridge | undefined;
+    let meeting: Room;
+    let plain: Room;
+
+    function setPolicy(room: Room, content: object, stateKey = ""): void {
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: room.roomId,
+                user: "@admin:server",
+                skey: stateKey,
+                content,
+            }),
+        ]);
+    }
+
+    const retentionOf = (room: Room): unknown => bridge!.rooms().find((r) => r.id === room.roomId)?.retention;
+    const hasKey = (room: Room): boolean => "retention" in (bridge!.rooms().find((r) => r.id === room.roomId) ?? {});
+    const start = async (): Promise<void> => {
+        bridge = new ViewModelBridge(client);
+        await flushPromises();
+    };
+
+    beforeEach(() => {
+        client = stubClient();
+        vi.spyOn(client, "getCrypto").mockReturnValue(undefined);
+        const mk = (id: string, name: string): Room => {
+            const room = new Room(id, client, client.getSafeUserId(), {
+                pendingEventOrdering: PendingEventOrdering.Detached,
+            });
+            room.name = name;
+            return room;
+        };
+        meeting = mk("!meeting:server", "Meeting");
+        plain = mk("!plain:server", "Plain");
+        vi.spyOn(client, "getRoom").mockImplementation((id) => [meeting, plain].find((r) => r.roomId === id) ?? null);
+        DMRoomMap.setShared({ getUserIdForRoomId: vi.fn().mockReturnValue(null) } as unknown as DMRoomMap);
+        vi.spyOn(RoomListStoreV3.instance, "getSortedRoomsInActiveSpace").mockImplementation(() => ({
+            spaceId: "home",
+            sections: [{ tag: CHATS_TAG, rooms: [meeting, plain] }],
+        }));
+        vi.spyOn(RoomListStoreV3.instance, "isLoadingRooms", "get").mockReturnValue(false);
+        vi.spyOn(RoomListStoreV3.instance, "activeSortAlgorithm", "get").mockReturnValue(SortingAlgorithm.Recency);
+        vi.spyOn(SDKContextClass.instance.spaceStore, "activeSpaceRoom", "get").mockReturnValue(null);
+        vi.spyOn(SDKContextClass.instance.roomViewStore, "getRoomId").mockReturnValue(null);
+    });
+
+    afterEach(() => {
+        bridge?.dispose?.();
+        bridge = undefined;
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    it("has no retention field without the config key, also for a room with a policy, and watches nothing", async () => {
+        setPolicy(meeting, { max_lifetime: 14 * DAY });
+        const before = meeting.listenerCount(RoomStateEvent.Events);
+        await start();
+        expect(bridge!.rooms().map((r) => r.id)).toEqual([meeting.roomId, plain.roomId]);
+        expect(hasKey(meeting)).toBe(false);
+        expect(hasKey(plain)).toBe(false);
+        expect(meeting.listenerCount(RoomStateEvent.Events)).toBe(before);
+    });
+
+    it("puts the period and Element's texts on the room with clean-up, and nothing on the room without", async () => {
+        putConfig(ON);
+        setPolicy(meeting, { max_lifetime: 14 * DAY });
+        await start();
+        expect(retentionOf(meeting)).toEqual(TWO_WEEKS);
+        expect(hasKey(plain)).toBe(false);
+    });
+
+    it("refreshes the field live and emits a rooms change: on, changed, off", async () => {
+        putConfig(ON);
+        await start();
+        const onChange = vi.fn();
+        bridge!.onChange(onChange);
+        expect(hasKey(meeting)).toBe(false);
+
+        setPolicy(meeting, { max_lifetime: 14 * DAY });
+        await flushPromises();
+        expect(retentionOf(meeting)).toEqual(TWO_WEEKS);
+        expect(onChange).toHaveBeenCalledWith({ kind: "rooms" });
+
+        onChange.mockClear();
+        setPolicy(meeting, { max_lifetime: DAY });
+        await flushPromises();
+        expect(retentionOf(meeting)).toEqual({
+            maxLifetimeMs: DAY,
+            period: "1 day",
+            listLabel: "Messages are deleted after 1 day",
+            headerText: "Messages here are deleted after 1 day",
+        });
+        expect(onChange).toHaveBeenCalledWith({ kind: "rooms" });
+
+        onChange.mockClear();
+        setPolicy(meeting, { min_lifetime: 0 });
+        await flushPromises();
+        expect(hasKey(meeting)).toBe(false);
+        expect(onChange).toHaveBeenCalledWith({ kind: "rooms" });
+        expect(hasKey(plain)).toBe(false);
+    });
+
+    it("ignores a retention event under another state key and other state events", async () => {
+        putConfig(ON);
+        await start();
+        const onChange = vi.fn();
+        bridge!.onChange(onChange);
+        setPolicy(meeting, { max_lifetime: DAY }, "other");
+        meeting.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: "m.room.topic",
+                room: meeting.roomId,
+                user: "@a:server",
+                skey: "",
+                content: {},
+            }),
+        ]);
+        await flushPromises();
+        expect(hasKey(meeting)).toBe(false);
+        expect(onChange).not.toHaveBeenCalledWith({ kind: "rooms" });
+    });
+
+    it("stops watching the rooms when disposed", async () => {
+        putConfig(ON);
+        const before = meeting.listenerCount(RoomStateEvent.Events);
+        await start();
+        expect(meeting.listenerCount(RoomStateEvent.Events)).toBeGreaterThan(before);
+        bridge!.dispose();
+        expect(meeting.listenerCount(RoomStateEvent.Events)).toBe(before);
+        bridge = undefined;
+    });
+});
