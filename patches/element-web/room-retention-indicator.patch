+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { vi, describe, it, expect, beforeEach, afterEach } from "vitest";
+import React from "react";
+import { type MatrixClient, PendingEventOrdering, Room } from "matrix-js-sdk/src/matrix";
+import { act, render, type RenderOptions, screen } from "test-utils-rtl";
+import { filterConsole, mkEvent, stubClient } from "test-utils";
+
+import RoomHeader from "./RoomHeader";
+import DMRoomMap from "../../../../utils/DMRoomMap";
+import RoomContext, { type RoomContextType } from "../../../../contexts/RoomContext";
+import { ScopedRoomContextProvider } from "../../../../contexts/ScopedRoomContext";
+import MatrixClientContext from "../../../../contexts/MatrixClientContext";
+import { SDKContext } from "../../../../contexts/SDKContext";
+import { SDKContextClass } from "../../../../contexts/SDKContextClass";
+import SettingsStore from "../../../../settings/SettingsStore";
+import SdkConfig from "../../../../SdkConfig";
+import { CallStore } from "../../../../stores/CallStore";
+import * as ShieldUtils from "../../../../utils/ShieldUtils";
+import { ROOM_RETENTION_CONFIG_KEY, ROOM_RETENTION_EVENT_TYPE } from "../../../../utils/RoomRetention";
+
+vi.mock("../../../../utils/ShieldUtils");
+vi.mock("../../../../hooks/right-panel/useCurrentPhase", () => ({
+    useCurrentPhase: () => ({ currentPhase: "foo", isOpen: false }),
+}));
+vi.mock("../../../../Modal");
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const DAY = 86400000;
+const CHOICES = [
+    { ms: DAY, label: "1 day" },
+    { ms: 14 * DAY, label: "2 weeks" },
+];
+const ON = { [ROOM_RETENTION_CONFIG_KEY]: { choices: CHOICES } };
+const HEADER_TEXT = "Messages here are deleted after 2 weeks";
+
+describe("RoomHeader: the automatic message clean-up line (m.room.retention)", () => {
+    filterConsole(
+        "[getType] Room !1:example.org does not have an m.room.create event",
+        "Age for event was not available, using `now - origin_server_ts` as a fallback. If the device clock is not correct issues might occur.",
+    );
+
+    const ROOM_ID = "!1:example.org";
+    let client: MatrixClient;
+    let room: Room;
+    let roomContext: RoomContextType;
+
+    function getWrapper(): RenderOptions {
+        return {
+            wrapper: ({ children }) => (
+                <SDKContext.Provider value={SDKContextClass.instance}>
+                    <MatrixClientContext.Provider value={client}>
+                        <ScopedRoomContextProvider {...roomContext}>{children}</ScopedRoomContextProvider>
+                    </MatrixClientContext.Provider>
+                </SDKContext.Provider>
+            ),
+        };
+    }
+
+    function setPolicy(content: object, stateKey = ""): void {
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: ROOM_ID,
+                user: "@admin:example.org",
+                skey: stateKey,
+                content,
+            }),
+        ]);
+    }
+
+    /** The name and info button (the header has a second "Room info" button among its icons). */
+    const infoButton = (): HTMLElement => document.querySelector<HTMLElement>("button.mx_RoomHeader_infoWrapper")!;
+
+    beforeEach(() => {
+        client = stubClient();
+        room = new Room(ROOM_ID, client, "@alice:example.org", {
+            pendingEventOrdering: PendingEventOrdering.Detached,
+        });
+        DMRoomMap.setShared({ getUserIdForRoomId: vi.fn() } as unknown as DMRoomMap);
+        vi.spyOn(ShieldUtils, "shieldStatusForRoom").mockResolvedValue(ShieldUtils.E2EStatus.Normal);
+        vi.spyOn(CallStore.instance, "getCall").mockReturnValue(null);
+        vi.spyOn(CallStore.instance, "getConfiguredRTCTransports").mockReturnValue([]);
+        roomContext = {
+            ...RoomContext,
+            roomId: ROOM_ID,
+            roomViewStore: { isViewingCall: vi.fn().mockReturnValue(false), on: vi.fn(), off: vi.fn(), emit: vi.fn() },
+        } as unknown as RoomContextType;
+    });
+
+    afterEach(() => {
+        SdkConfig.reset();
+        vi.resetAllMocks();
+        SettingsStore.reset();
+    });
+
+    it("shows nothing when the config key is absent, even for a room with a policy", () => {
+        setPolicy({ max_lifetime: 14 * DAY });
+        const { container } = render(<RoomHeader room={room} />, getWrapper());
+        expect(container.querySelector(".mx_RoomHeader_retention")).toBeNull();
+        expect(screen.queryByText(/deleted after/)).toBeNull();
+        expect(infoButton()).not.toHaveAttribute("aria-describedby");
+    });
+
+    it("shows nothing for a room without a policy when the key is set", () => {
+        putConfig(ON);
+        const { container } = render(<RoomHeader room={room} />, getWrapper());
+        expect(container.querySelector(".mx_RoomHeader_retention")).toBeNull();
+        expect(infoButton()).not.toHaveAttribute("aria-describedby");
+    });
+
+    it("shows nothing for a policy that is Off, has no max_lifetime or another state key", () => {
+        putConfig(ON);
+        setPolicy({ min_lifetime: 0 });
+        setPolicy({ max_lifetime: 14 * DAY }, "other");
+        const { container } = render(<RoomHeader room={room} />, getWrapper());
+        expect(container.querySelector(".mx_RoomHeader_retention")).toBeNull();
+    });
+
+    it("shows the clock and the text under the room name, visible without hovering", () => {
+        putConfig(ON);
+        setPolicy({ max_lifetime: 14 * DAY });
+        const { container } = render(<RoomHeader room={room} />, getWrapper());
+
+        const line = container.querySelector(".mx_RoomHeader_retention")!;
+        expect(line).toHaveTextContent(HEADER_TEXT);
+        expect(line.querySelector("svg")).toHaveAttribute("aria-hidden", "true");
+        // Below the heading, inside the same info box: the name and its line keep truncating side by side
+        const heading = container.querySelector(".mx_RoomHeader_heading")!;
+        expect(heading.parentElement).toBe(line.parentElement);
+        expect(heading.compareDocumentPosition(line) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+        expect(line.querySelector(".mx_RoomHeader_truncated")).toHaveTextContent(HEADER_TEXT);
+        // The info button's own label hides its content, so the line is its description
+        expect(infoButton()).toHaveAttribute("aria-describedby", line.id);
+        expect(infoButton()).toHaveAccessibleDescription(HEADER_TEXT);
+    });
+
+    it("appears, changes and disappears live with the room's setting", () => {
+        putConfig(ON);
+        const { container } = render(<RoomHeader room={room} />, getWrapper());
+        const line = (): Element | null => container.querySelector(".mx_RoomHeader_retention");
+        expect(line()).toBeNull();
+
+        act(() => setPolicy({ max_lifetime: 14 * DAY }));
+        expect(line()).toHaveTextContent(HEADER_TEXT);
+
+        act(() => setPolicy({ max_lifetime: DAY }));
+        expect(line()).toHaveTextContent("Messages here are deleted after 1 day");
+
+        act(() => setPolicy({ max_lifetime: 2 * 60000 }));
+        expect(line()).toHaveTextContent("Messages here are deleted after Custom (2m)");
+
+        act(() => setPolicy({ min_lifetime: 0 }));
+        expect(line()).toBeNull();
+        expect(infoButton()).not.toHaveAttribute("aria-describedby");
+    });
+});
