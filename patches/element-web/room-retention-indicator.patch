--- /dev/null
+++ b/apps/web/src/viewmodels/room-list/RoomListItemViewModel.retentionIndicator.test.tsx
@@ -0,0 +1,254 @@
+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+// @vitest-environment happy-dom
+
+import { vi, describe, it, expect, beforeEach, afterEach } from "vitest";
+import React from "react";
+import { type MatrixClient, PendingEventOrdering, Room, RoomEvent, RoomStateEvent } from "matrix-js-sdk/src/matrix";
+import { RoomListItemView } from "@element-hq/web-shared-components";
+import { act, render, screen } from "test-utils-rtl";
+import { createTestClient, flushPromises, mkEvent, tearDownAfterTest } from "test-utils";
+
+import { RoomNotificationState } from "../../stores/notifications/RoomNotificationState";
+import { RoomNotificationStateStore } from "../../stores/notifications/RoomNotificationStateStore";
+import { MessagePreviewStore } from "../../stores/message-preview";
+import SettingsStore from "../../settings/SettingsStore";
+import DMRoomMap from "../../utils/DMRoomMap";
+import { CallStore } from "../../stores/CallStore";
+import RoomListStoreV3 from "../../stores/room-list-v3/RoomListStoreV3";
+import SdkConfig from "../../SdkConfig";
+import { ROOM_RETENTION_CONFIG_KEY, ROOM_RETENTION_EVENT_TYPE } from "../../utils/RoomRetention";
+import { RoomListItemViewModel } from "./RoomListItemViewModel";
+
+// No hover menus: their buttons would sit inside the row's button outside a real list
+vi.mock("./utils", () => ({
+    hasAccessToOptionsMenu: vi.fn().mockReturnValue(false),
+    hasAccessToNotificationMenu: vi.fn().mockReturnValue(false),
+}));
+
+vi.mock("../../stores/CallStore", () => ({
+    __esModule: true,
+    CallStore: { instance: { getCall: vi.fn(), on: vi.fn(), off: vi.fn(), emit: vi.fn() } },
+    CallStoreEvent: { ConnectedCalls: "connected_calls" },
+}));
+
+/** The retention key is not in the typed config: put it in untyped, as the app reads it. */
+const putConfig = (config: object): void => SdkConfig.put(config as Parameters<typeof SdkConfig.put>[0]);
+
+const DAY = 86400000;
+const ON = {
+    [ROOM_RETENTION_CONFIG_KEY]: {
+        choices: [
+            { ms: DAY, label: "1 day" },
+            { ms: 14 * DAY, label: "2 weeks" },
+        ],
+    },
+};
+const LIST_LABEL = "Messages are deleted after 2 weeks";
+
+describe("RoomListItemViewModel: the retention clock (m.room.retention)", () => {
+    const ROOM_ID = "!room:server";
+    let client: MatrixClient;
+    let room: Room;
+    let vm: RoomListItemViewModel | undefined;
+
+    function setPolicy(content: object, stateKey = ""): void {
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: ROOM_RETENTION_EVENT_TYPE,
+                room: ROOM_ID,
+                user: "@admin:server",
+                skey: stateKey,
+                content,
+            }),
+        ]);
+    }
+
+    function setTopic(topic: string): void {
+        room.currentState.setStateEvents([
+            mkEvent({
+                event: true,
+                type: "m.room.topic",
+                room: ROOM_ID,
+                user: "@admin:server",
+                skey: "",
+                content: { topic },
+            }),
+        ]);
+    }
+
+    const create = (): RoomListItemViewModel => (vm = new RoomListItemViewModel({ room, client }));
+
+    beforeEach(() => {
+        client = createTestClient();
+        room = new Room(ROOM_ID, client, client.getSafeUserId(), {
+            pendingEventOrdering: PendingEventOrdering.Detached,
+        });
+        room.name = "A room with a really long name that has to truncate in the room list";
+        const notificationState = tearDownAfterTest(new RoomNotificationState(room, false));
+        vi.spyOn(RoomNotificationStateStore.instance, "getRoomState").mockReturnValue(notificationState);
+        DMRoomMap.setShared({ getUserIdForRoomId: vi.fn().mockReturnValue(undefined) } as unknown as DMRoomMap);
+        vi.spyOn(SettingsStore, "getValue").mockImplementation((setting) => {
+            if (setting === "RoomList.OrderedCustomSections") return [];
+            if (setting === "RoomList.CustomSectionData") return {};
+            return false;
+        });
+        vi.spyOn(SettingsStore, "watchSetting").mockImplementation(() => "watcher-id");
+        vi.spyOn(MessagePreviewStore.instance, "getPreviewForRoom").mockResolvedValue(null);
+        vi.spyOn(CallStore.instance, "getCall").mockReturnValue(null);
+        vi.spyOn(RoomListStoreV3.instance, "orderedSectionTags", "get").mockReturnValue([]);
+    });
+
+    afterEach(() => {
+        vm?.dispose();
+        vm = undefined;
+        SdkConfig.reset();
+        vi.restoreAllMocks();
+    });
+
+    describe("the view-model field retentionLabel", () => {
+        it("is absent without the config key, for a room with a policy, and nothing listens to the room state", () => {
+            setPolicy({ max_lifetime: 14 * DAY });
+            const before = room.listenerCount(RoomStateEvent.Events);
+            create();
+            expect(vm!.getSnapshot().retentionLabel).toBeUndefined();
+            expect(room.listenerCount(RoomStateEvent.Events)).toBe(before);
+        });
+
+        it("is absent for a room without a policy, Off, or a policy under another state key", () => {
+            putConfig(ON);
+            create();
+            expect(vm!.getSnapshot().retentionLabel).toBeUndefined();
+            setPolicy({ min_lifetime: 0 });
+            setPolicy({ max_lifetime: DAY }, "other");
+            expect(vm!.getSnapshot().retentionLabel).toBeUndefined();
+        });
+
+        it("is set from the room's max_lifetime with the configured period label", () => {
+            putConfig(ON);
+            setPolicy({ max_lifetime: 14 * DAY });
+            create();
+            expect(vm!.getSnapshot().retentionLabel).toBe(LIST_LABEL);
+        });
+
+        it("is set, changed and cleared live when the room's setting changes", () => {
+            putConfig(ON);
+            create();
+            const onChange = vi.fn();
+            vm!.subscribe(onChange);
+
+            setPolicy({ max_lifetime: 14 * DAY });
+            expect(vm!.getSnapshot().retentionLabel).toBe(LIST_LABEL);
+            setPolicy({ max_lifetime: DAY });
+            expect(vm!.getSnapshot().retentionLabel).toBe("Messages are deleted after 1 day");
+            setPolicy({ max_lifetime: 2 * 60000 });
+            expect(vm!.getSnapshot().retentionLabel).toBe("Messages are deleted after Custom (2m)");
+            setPolicy({ min_lifetime: 0 });
+            expect(vm!.getSnapshot().retentionLabel).toBeUndefined();
+            expect(onChange).toHaveBeenCalledTimes(4);
+        });
+
+        it("does not change on other state events, and survives a rebuild of the item", async () => {
+            putConfig(ON);
+            setPolicy({ max_lifetime: 14 * DAY });
+            create();
+            const onChange = vi.fn();
+            vm!.subscribe(onChange);
+            setTopic("hello");
+            expect(onChange).not.toHaveBeenCalled();
+            room.name = "Renamed";
+            room.emit(RoomEvent.Name, room);
+            await flushPromises();
+            expect(vm!.getSnapshot().name).toBe("Renamed");
+            expect(vm!.getSnapshot().retentionLabel).toBe(LIST_LABEL);
+        });
+
+        it("stops listening when disposed", () => {
+            putConfig(ON);
+            const before = room.listenerCount(RoomStateEvent.Events);
+            create();
+            expect(room.listenerCount(RoomStateEvent.Events)).toBe(before + 1);
+            vm!.dispose();
+            expect(room.listenerCount(RoomStateEvent.Events)).toBe(before);
+            setPolicy({ max_lifetime: DAY });
+            expect(vm!.getSnapshot().retentionLabel).toBeUndefined();
+        });
+    });
+
+    describe("the shared room list item view", () => {
+        function renderItem(): ReturnType<typeof render> {
+            return render(
+                <ul role="listbox" aria-label="Rooms">
+                    <RoomListItemView
+                        vm={vm!}
+                        role="option"
+                        isSelected={false}
+                        isFocused={false}
+                        onFocus={() => {}}
+                        isFirstItem={true}
+                        isLastItem={true}
+                        renderAvatar={() => <span data-testid="avatar" />}
+                    />
+                </ul>,
+            );
+        }
+
+        const option = (): HTMLElement => screen.getByRole("option");
+
+        it("renders no clock and no description without the config key (stock)", () => {
+            setPolicy({ max_lifetime: 14 * DAY });
+            create();
+            renderItem();
+            expect(screen.queryByTestId("room-retention-icon")).toBeNull();
+            expect(option()).not.toHaveAttribute("aria-describedby");
+            expect(screen.getByTestId("room-name")).toHaveTextContent(room.name);
+        });
+
+        it("renders no clock for a room without clean-up when the key is set", () => {
+            putConfig(ON);
+            create();
+            renderItem();
+            expect(screen.queryByTestId("room-retention-icon")).toBeNull();
+            expect(option()).not.toHaveAttribute("aria-describedby");
+        });
+
+        it("renders the clock before the room name with its label, and the row describes itself with it", () => {
+            putConfig(ON);
+            setPolicy({ max_lifetime: 14 * DAY });
+            create();
+            renderItem();
+            const icon = screen.getByTestId("room-retention-icon");
+            expect(icon).toHaveAttribute("role", "img");
+            expect(icon).toHaveAttribute("aria-label", LIST_LABEL);
+            const name = screen.getByTestId("room-name");
+            expect(icon.compareDocumentPosition(name) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+            // The name keeps its own truncating element and full-name title
+            expect(name).toHaveAttribute("title", room.name);
+            expect(name).toHaveTextContent(room.name);
+            // The row's description is the clock (its aria-label; the browser leg EW-RR3 checks the computed description,
+            // which dom-accessibility-api does not derive from an svg's aria-label under happy-dom)
+            expect(icon.id).not.toBe("");
+            expect(option()).toHaveAttribute("aria-describedby", icon.id);
+            // The row's accessible name is unchanged
+            expect(option()).toHaveAttribute("aria-label", `Open room ${room.name}`);
+        });
+
+        it("shows the clock and goes away live with the room's setting", () => {
+            putConfig(ON);
+            create();
+            renderItem();
+            expect(screen.queryByTestId("room-retention-icon")).toBeNull();
+            act(() => setPolicy({ max_lifetime: 14 * DAY }));
+            expect(screen.getByTestId("room-retention-icon")).toHaveAttribute("aria-label", LIST_LABEL);
+            act(() => setPolicy({ min_lifetime: 0 }));
+            expect(screen.queryByTestId("room-retention-icon")).toBeNull();
+            expect(option()).not.toHaveAttribute("aria-describedby");
+        });
+    });
+});
