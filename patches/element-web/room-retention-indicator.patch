@@ -0,0 +1,68 @@
+/*
+Copyright 2026 inblock.io
+
+SPDX-License-Identifier: AGPL-3.0-only OR GPL-3.0-only OR LicenseRef-Element-Commercial
+Please see LICENSE files in the repository root for full details.
+*/
+
+/*
+The room's "messages are deleted after ..." indicator: the clock before the room name in the room list and the line
+in the room header. Built on the rules of `RoomRetention.ts`: nothing is shown unless the `io.inblock.room_retention`
+config key is set and the room's `m.room.retention` (state key "") has a positive integer `max_lifetime`.
+*/
+
+import { type MatrixEvent, type Room, type RoomState } from "matrix-js-sdk/src/matrix";
+
+import { _t } from "../languageHandler";
+import {
+    ROOM_RETENTION_EVENT_TYPE,
+    getRetentionConfig,
+    labelForLifetime,
+    maxLifetimeFromContent,
+} from "./RoomRetention";
+
+/** What the indicator shows for a room whose messages are deleted automatically. */
+export interface RoomRetentionIndicator {
+    /** The room's `max_lifetime` in milliseconds. */
+    maxLifetimeMs: number;
+    /** The period as the Disappearing messages picker names it (`labelForLifetime`), e.g. "2 weeks". */
+    period: string;
+    /** The room list's clock: its accessible label and tooltip, "Messages are deleted after 2 weeks". */
+    listLabel: string;
+    /** The room header's line, visible without hovering, "Messages here are deleted after 2 weeks". */
+    headerText: string;
+}
+
+/** The `max_lifetime` of a room state's `m.room.retention` (state key ""), or null when it has none. Never throws. */
+export function maxLifetimeOfState(state: RoomState | null | undefined): number | null {
+    try {
+        const ev = state?.getStateEvents(ROOM_RETENTION_EVENT_TYPE, "");
+        return ev ? maxLifetimeFromContent(ev.getContent()) : null;
+    } catch {
+        return null;
+    }
+}
+
+/** The indicator for a `max_lifetime`; undefined when the config key is absent or the room has no clean-up. */
+export function retentionIndicatorFor(maxLifetimeMs: number | null): RoomRetentionIndicator | undefined {
+    const cfg = getRetentionConfig();
+    if (!cfg || maxLifetimeMs === null) return undefined;
+    const period = labelForLifetime(maxLifetimeMs, cfg);
+    return {
+        maxLifetimeMs,
+        period,
+        listLabel: _t("room_retention|indicator_list", { duration: period }),
+        headerText: _t("room_retention|indicator_header", { duration: period }),
+    };
+}
+
+/** The indicator for a room's current state; undefined when nothing is to be shown. */
+export function getRoomRetentionIndicator(room: Room | null | undefined): RoomRetentionIndicator | undefined {
+    if (!room || !getRetentionConfig()) return undefined;
+    return retentionIndicatorFor(maxLifetimeOfState(room.currentState));
+}
+
+/** Whether a state event sets the room's retention policy (`m.room.retention`, state key ""). */
+export function isRetentionPolicyEvent(ev: MatrixEvent): boolean {
+    return ev.getType() === ROOM_RETENTION_EVENT_TYPE && ev.getStateKey() === "";
+}
diff --git a/apps/web/src/viewmodels/room-list/RoomListItemViewModel.retentionIndicator.test.tsx b/apps/web/src/viewmodels/room-list/RoomListItemViewModel.retentionIndicator.test.tsx
